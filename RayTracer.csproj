<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>14</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

        <!--
        The server collector, rather than the workstation one the SDK defaults to.  A ray tracer is
        the workload it was made for: every core allocating hard, and nothing shared between them.
        Shadow rays are where that bites.  In the teapot scene 98.9% of all rays are shadow rays, and
        each one builds a list and two or three intersection objects to report what it found, which
        comes to some fourteen million objects for a 200x150 render and sixteen times that at gallery
        size.  All of it dies at once, which is the easy case for a collector, but not while every
        thread is queueing for the same heap.

        Measured, and pixel for pixel identical either way: the teapot 13.05s to 8.25s,
        a-stand-of-trees 8.26s to 6.41s, heightfield 1.15s to 0.92s, the candle 1.96s to 1.66s.  The
        gain follows how much of a scene is shadow rays, which is the same as how much of it allocates.
        -->
        <ServerGarbageCollection>true</ServerGarbageCollection>

        <!--
        Optimized in every configuration, Debug included.  A Debug build is otherwise compiled with
        optimization off, and the JIT then inlines nothing at all: every vector sum, every color
        product and every property read becomes a call of its own.  Renders are run from the Debug
        build, so that is what every render paid.

        Measured, and pixel for pixel identical either way, down to 16 bits a channel: focal-blur
        14.9s to 4.0s, the candle 14.8s to 3.6s, scattering 22.9s to 6.0s, a-stony-bank 33.1s to
        7.4s, first-light-at-the-field 45.0s to 12.0s.  Nothing here is conditional on DEBUG, so an
        optimized Debug build runs exactly as fast as a Release one.

        The price is in the debugger, which may show a local as unavailable or step out of order.
        For a session that needs to step through code, rebuild in full with Optimize set false,
        and rebuild in full again afterwards; the commands are in CLAUDE.md.  Both must be full
        rebuilds: a plain build sees no file changed and keeps whichever the last compile made, so
        renders would quietly stay unoptimized after a debugging session, or the debugger quietly
        stay optimized.
        -->
        <Optimize>true</Optimize>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommandLineParser" Version="2.9.1" />
      <PackageReference Include="Lex" Version="1.4.0" />
      <PackageReference Include="Magick.NET-Q16-HDRI-AnyCPU" Version="14.16.0" />
      <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="Typography.OpenFont.NetCore" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Tests\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Tests\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Tests\**" />
    </ItemGroup>

    <!-- The curated libraries ship inside the assembly rather than beside it, so that installing
         them works the same however the tool itself was installed, and whatever the working
         directory happens to be. -->
    <ItemGroup>
      <EmbeddedResource Include="Libraries\**\*.igl" />
    </ItemGroup>












</Project>
