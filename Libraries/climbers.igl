// The color of a creeper's leaf by the season: green in summer; in autumn crimson, scarlet, wine or, now and
// then, still orange on its way; in spring bronzed.
function ClimberCreeperColor(season, id, variant) -> color {
    shade = 0.80 + random(id, 11, variant) * 0.40
    turn = random(id, 12, variant)

    switch (season) {
        case 'summer' { return color [0.055, 0.115, 0.035] * shade }
        case 'autumn', 'fall' {
            return (turn < 0.40 ? color [0.33, 0.025, 0.025] : turn < 0.70 ? color [0.46, 0.065, 0.020] :
                    turn < 0.88 ? color [0.19, 0.020, 0.055] : color [0.42, 0.17, 0.025]) * shade
        }
        default { return color [0.11, 0.105, 0.035] * shade }
    }
}

// One creeper leaf: a long stalk up +Y from the stem, and at its end five leaflets spread like a hand, laid back
// toward the wall, tips down it along +Z.  Bare in winter, as the plant is.
primitive ClimberCreeperLeaf(season, id, variant) -> group {
    size = 0.065 * (0.80 + random(id, 13, variant) * 0.40) *
           (season == 'summer' || season == 'autumn' || season == 'fall' ? 1 : 0.7)
    stalk = 0.05 + random(id, 14, variant) * 0.04
    tint = ClimberCreeperColor(season, id, variant)

    if (season == 'winter') { return group { } }
    else {
        return group {
            cylinder {
                min Y 0  max Y 1
                material { pigment tint * 0.8  specular 0.05 }
                scale [0.0013, stalk, 0.0013]
            }
            group {
                for leaflet in [0, 4] {
                    object ClimberLeaflet() {
                        scale size * (leaflet == 2 ? 1 : leaflet == 1 || leaflet == 3 ? 0.88 : 0.66)
                        rotate Z (leaflet - 2) * 38
                    }
                }
                material { pigment tint  specular 0.18  shininess 24 }
                rotate X 90 + 10 + random(id, 15, variant) * 25
                rotate Y (random(id, 16, variant) - 0.5) * 40
                translate Y stalk
            }
        }
    }
}

// Virginia creeper, climbing the surface of that name from where it stands, as ivy does but more loosely, its
// leaves larger and further apart on longer stalks.
primitive Creeper(wall, spread = 3, season = 'summer', variant = 1) -> grown {
    return grown {
        all over wall
        spacing 0.06
        reach 0.2
        kill 0.04
        step 0.045
        tropism [0, 1, 0]
        susceptibility 0.30
        twig 0.0018
        spread spread
        patches spherical { turbulence { amplitude 0.35  octaves 2  with seed variant + 7 }  scale spread } from 0 to 0.6
        leaf ClimberCreeperLeaf(season, 1, variant), ClimberCreeperLeaf(season, 2, variant),
             ClimberCreeperLeaf(season, 3, variant), ClimberCreeperLeaf(season, 4, variant),
             ClimberCreeperLeaf(season, 5, variant), ClimberCreeperLeaf(season, 6, variant)
        with seed variant
        material ClimberCreeperStem
    }
}
