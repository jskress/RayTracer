// The green of an ivy leaf: dark and glossy, a little different leaf to leaf; in winter a third of the ways of
// making a leaf bronzed by the cold, in spring a third fresh and pale.  A third by the leaf's number rather than by
// chance: a climber has only six of them, and by chance one in six winters had none bronzed at all.
function ClimberIvyGreen(season, id, variant) -> color {
    shade = 0.80 + random(id, 1, variant) * 0.45
    bronzed = season == 'winter' && mod(id, 3) == 0
    fresh = season != 'summer' && season != 'autumn' && season != 'fall' && season != 'winter' && mod(id, 3) == 1

    return (bronzed ? color [0.075, 0.045, 0.030] : fresh ? color [0.070, 0.115, 0.030] : color [0.030, 0.062, 0.022]) *
           shade
}

// One ivy leaf, standing out of the surface as a climber's leaves stand: its stalk up +Y from the stem and out to
// one side -- odd leaves to one side, even to the other, as they alternate along a shoot -- and the blade at the
// stalk's end laid back toward the wall, tip down it along +Z and a little out, so its face looks out and a little
// up: the shingled way ivy leaves overlap on a wall.
primitive ClimberIvyLeaf(season, id, variant) -> group {
    size = 0.055 * (0.80 + random(id, 4, variant) * 0.45)
    stalk = 0.03 + random(id, 5, variant) * 0.03
    side = mod(id, 2) == 0 ? -1 : 1
    lean = side * (35 + random(id, 9, variant) * 25)

    return group {
        cylinder {
            min Y 0  max Y 1
            material { pigment [0.10, 0.12, 0.05]  specular 0.05 }
            scale [0.0012, stalk, 0.0012]
            rotate Z lean
        }
        object ClimberIvyBlade(1 + floor(random(id, 6, variant) * 3)) {
            material { pigment ClimberIvyGreen(season, id, variant)  specular 0.45  shininess 45 }
            scale size
            rotate X 90 + 12 + random(id, 7, variant) * 22
            rotate Y -side * (15 + random(id, 8, variant) * 30)
            translate [-stalk * sin(lean°), stalk * cos(lean°), 0]
        }
    }
}

// English ivy, climbing the surface of that name from where it stands: its stems spread from its root as far as
// `spread` along them, branching and filling the surface, its leaves all along them.
//
// **Its edge is ragged, as a real one's is.**  Cut off at a distance, a climber's edge is a neat arc; here its
// points thin away with distance from its root, raggedly, from two fifths of the spread on, so it stands as a
// dense mat that breaks up toward its edge into a few long shoots running on ahead.
primitive Ivy(wall, spread = 3, season = 'summer', variant = 1) -> grown {
    return grown {
        all over wall
        spacing 0.045
        reach 0.15
        kill 0.03
        step 0.03
        tropism [0, 1, 0]
        susceptibility 0.35
        twig 0.0016
        spread spread
        patches spherical { turbulence { amplitude 0.35  octaves 2  with seed variant }  scale spread } from 0 to 0.6
        leaf ClimberIvyLeaf(season, 1, variant), ClimberIvyLeaf(season, 2, variant),
             ClimberIvyLeaf(season, 3, variant), ClimberIvyLeaf(season, 4, variant),
             ClimberIvyLeaf(season, 5, variant), ClimberIvyLeaf(season, 6, variant)
        with seed variant
        material ClimberIvyStem
    }
}

// -- Virginia creeper ------------------------------------------------------------------------------

