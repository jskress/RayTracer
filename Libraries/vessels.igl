// A band of her island with a row of windows round it: down both sides and across the front.  The band's own
// middle is at the origin, its length along X, its front at x = half.
primitive CvnWindowBand(long, wide, high, sill) -> group {
    return group {
        cube { scale [long / 2, high / 2, wide / 2] }
        material CvnHaze {
            decal { path CvnWindowsLong  color [0.03, 0.035, 0.04]  planar  min Y -0.5  max Y 0.5
                    rotate X -90  translate [-long / 2 + 0.3, sill - high / 2, -wide / 2] }
            decal { path CvnWindowsLong  color [0.03, 0.035, 0.04]  planar  min Y -0.5  max Y 0.5
                    rotate X -90  rotate Y 180  translate [long / 2 - 0.3, sill - high / 2, wide / 2] }
            decal { path CvnWindowsWide  color [0.03, 0.035, 0.04]  planar  min Y -0.5  max Y 0.5
                    rotate X -90  rotate Y -90  translate [long / 2, sill - high / 2, -wide / 2 + 0.4] }
        }
    }
}

// Her island, on her starboard side between her second and third elevators: a narrower base on the deck, the
// main block with her number on its sides and the Battle E to port, two decks of windows -- the navigation and
// flag bridges -- under eaves, the roof with its domes, and her mast with the SPS-48E's square face before it.
primitive CvnIsland() -> group {
    return group {
        cube { scale [12, 2.5, 6.75]  translate [-21, 21.5, -27.75] }
        cube { scale [0.12, 1.2, 2.3]  translate [-8.9, 22.4, -27.75]  material CvnShade }
        group { cube { scale [14.75, 3.85, 8.25]  translate [-20.75, 27.85, -27.75] }  material CvnIslandSides }
        object CvnWindowBand(29.9, 17.1, 2.3, 0.6) { translate [-20.75, 32.85, -27.75] }
        object CvnWindowBand(29.9, 17.1, 2.4, 0.6) { translate [-20.75, 35.2, -27.75] }
        cube { scale [15.2, 0.12, 8.8]  translate [-20.75, 34.05, -27.75] }
        cube { scale [15.2, 0.12, 8.8]  translate [-20.75, 36.45, -27.75] }
        cube { scale [11.5, 1.0, 6.75]  translate [-21.5, 37.5, -27.75] }
        cube { scale [7, 0.65, 4.25]  translate [-22, 39.15, -27.75] }
        // Her mast: a tapering tower, a pole and a topmast, with two yardarms bristling with whips.
        cube { scale [1.4, 2.9, 1.4]  translate [-22, 42.4, -27.75] }
        cube { scale [1.0, 2.5, 1.0]  translate [-22, 47.8, -27.75] }
        cylinder { min Y 50.3  max Y 54  scale [0.35, 1, 0.35]  translate [-22, 0, -27.75] }
        cylinder { min Y 54  max Y 57  scale [0.14, 1, 0.14]  translate [-22, 0, -27.75] }
        cylinder { min Y -6.4  max Y 6.4  scale 0.2  rotate X 90  translate [-22, 45.2, -27.75] }
        cylinder { min Y -5.75  max Y 5.75  scale 0.18  rotate X 90  translate [-22, 49.2, -27.75] }
        cube { scale [1.6, 0.08, 1.6]  translate [-22, 45.2, -27.75] }
        cylinder { min Y 45.2  max Y 47.6  scale 0.05  translate [-22, 0, -33.8] }
        cylinder { min Y 45.2  max Y 47.6  scale 0.05  translate [-22, 0, -21.7] }
        cylinder { min Y 49.2  max Y 51.2  scale 0.05  translate [-22, 0, -33.2] }
        cylinder { min Y 49.2  max Y 51.2  scale 0.05  translate [-22, 0, -22.3] }
        cube { scale [0.22, 2.3, 2.3]  rotate Z -12  translate [-18.3, 42.3, -27.75] }
        cube { scale [0.6, 0.8, 0.4]  translate [-19.3, 40.2, -27.75] }
        // Her domes: on the corners of her roof, on a bracket on her island's front, and on a sponson to starboard.
        sphere { scale 1.05  translate [-31.2, 39.2, -33.0]  material CvnWhite }
        sphere { scale 0.9  translate [-12.2, 39.0, -33.0]  material CvnWhite }
        sphere { scale 0.85  translate [-31.2, 39.0, -22.6]  material CvnWhite }
        sphere { scale 0.7  translate [-14, 39.6, -23.5]  material CvnWhite }
        cube { scale [1.2, 0.1, 1.3]  translate [-4.9, 30.2, -24.5] }
        sphere { scale [0.75, 1.05, 0.75]  translate [-4.9, 31.3, -24.5]  material CvnWhite }
        cube { scale [4.5, 0.12, 1.5]  translate [-10.5, 25.3, -37.4] }
        sphere { scale 0.8  translate [-13.5, 26.2, -37.4]  material CvnWhite }
        sphere { scale 0.8  translate [-10.5, 26.2, -37.4]  material CvnWhite }
        sphere { scale 0.8  translate [-7.5, 26.2, -37.4]  material CvnWhite }
        material CvnHaze
    }
}

// A white dome on its pedestal, on a sponson reaching back in to her side.  Without the sponson, the dome on her
// bow hung in the air and threw the shadow of a doorway onto her flare.
primitive CvnDome(x, y, z, r) -> group {
    return group {
        cylinder { min Y 0  max Y r * 1.2  scale [r * 0.9, 1, r * 0.9]  translate [x, y, z]  material CvnHaze }
        sphere { scale r  translate [x, y + r * 1.2, z]  material CvnWhite }
        cube { scale [r * 1.6, 0.45, (abs(z) - 12) / 2 + r]  translate [x, y - 0.45, z / abs(z) * (abs(z) + 12) / 2]
               material CvnHaze }
    }
}


// -- Her air wing, parked --------------------------------------------------------------------------------
// Carrier Air Wing One as she carried it in 2004, struck down to a deck park as she steams with no flying: two
// rows angled across her bow with their tails over her sides, a row along her starboard edge forward of her island
// and another aft of it, noses inboard, the Hawkeyes and a Tomcat in a second rank, helicopters on her fantail, a
// Hornet on her port elevator, and her landing area clear.

CvnTractorYellow = material { pigment [0.62, 0.48, 0.06]  specular 0.2  shininess 30 }

primitive CvnTractor() -> group {
    return group {
        cube { scale [1.6, 0.5, 0.95]  translate Y 0.75 }
        cube { scale [0.5, 0.45, 0.9]  translate [-0.9, 1.6, 0] }
        material CvnTractorYellow
    }
}

primitive CvnDeckPark() -> group {
    return group {
        // Across her bow: a Prowler at the very tip facing aft, then two rows of Hornets and Tomcats.
        object Prowler(1) { rotate Y 180  translate [161, 19, 0] }
        object Hornet(1) { rotate Y -48  translate [150, 19, -8.5] }
        object Hornet(1) { rotate Y -48  translate [139, 19, -8.8] }
        object Hornet(1) { rotate Y -48  translate [128, 19, -9.0] }
        object Tomcat(75) { rotate Y -48  translate [115, 19, -8.0] }
        object Hornet(1) { rotate Y -48  translate [102, 19, -10.5] }
        object Hornet(1) { rotate Y 48  translate [146, 19, 7.8] }
        object Hornet(1) { rotate Y 48  translate [135, 19, 8.2] }
        object Hornet(1) { rotate Y 48  translate [124, 19, 8.6] }
        object Hornet(1) { rotate Y 48  translate [113, 19, 9.0] }
        object Tomcat(75) { rotate Y 48  translate [100, 19, 9.8] }
        object Hornet(1) { rotate Y 48  translate [87, 19, 10.5] }
        // Along her starboard edge forward of her island, and a second rank inboard of them.
        object Hornet(1) { rotate Y -90  translate [72, 19, -24.5] }
        object Hornet(1) { rotate Y -90  translate [61.5, 19, -24.5] }
        object Hornet(1) { rotate Y -90  translate [51, 19, -24.5] }
        object Viking(1) { rotate Y -90  translate [40, 19, -24.0] }
        object Hornet(1) { rotate Y -90  translate [29, 19, -24.5] }
        object Hornet(1) { rotate Y -90  translate [18.5, 19, -24.5] }
        object Viking(1) { rotate Y -90  translate [7.5, 19, -24.0] }
        object Hawkeye(1) { rotate Y -90  translate [62, 19, -7.0] }
        object Tomcat(75) { rotate Y -90  translate [48, 19, -6.0] }
        object Hawkeye(1) { rotate Y -90  translate [33, 19, -7.0] }
        object Prowler(1) { rotate Y -90  translate [19, 19, -6.5] }
        // Aft of her island, the same.
        object Prowler(1) { rotate Y -90  translate [-45, 19, -24.5] }
        object Prowler(1) { rotate Y -90  translate [-55.5, 19, -24.5] }
        object Viking(1) { rotate Y -90  translate [-66, 19, -24.0] }
        object Hornet(1) { rotate Y -90  translate [-77, 19, -24.5] }
        object Tomcat(75) { rotate Y -90  translate [-88, 19, -24.0] }
        object Tomcat(75) { rotate Y -90  translate [-99.5, 19, -24.0] }
        object Hawkeye(1) { rotate Y -90  translate [-47, 19, -8.0] }
        object Tomcat(75) { rotate Y -90  translate [-60, 19, -8.5] }
        // Her helicopters on her fantail, and a Hornet on her port elevator.
        object Seahawk(1) { rotate Y 170  translate [-138, 19, -14] }
        object Seahawk(1) { rotate Y 175  translate [-152, 19, -12] }
        object Hornet(1) { rotate Y 90  translate [-101, 19, 33] }
        // Her tractors, by her island and among the rows.
        object CvnTractor() { rotate Y 20  translate [2, 19, -15] }
        object CvnTractor() { rotate Y -70  translate [-6, 19, -18] }
        object CvnTractor() { rotate Y 90  translate [-38, 19, -14] }
        object CvnTractor() { rotate Y 10  translate [80, 19, -14] }
        object CvnTractor() { rotate Y -30  translate [-108, 19, -16] }
    }
}

// The ship, and if asked her air wing parked on her deck.
primitive CarrierEnterprise(planes = 1) -> group {
    return group {
        object CvnHull()
        object CvnFlightDeck()
        object CvnIsland()
        // Her close-in weapons and her radomes, white on their sponsons round her.
        object CvnDome(110, 15.5, -21.5, 1.4)
        object CvnDome(118, 15.5, 18.5, 1.6)
        object CvnDome(18.6, 15.0, 43.2, 1.4)
        object CvnDome(-136, 15.0, 35.8, 1.6)
        object CvnDome(-118, 15.5, -27.6, 1.4)
        if (planes > 0.5) {
            object CvnDeckPark()
        }
    }
}


// -- Her wake ------------------------------------------------------------------------------------------------
//
// A carrier at speed leaves white water down her sides from a bow wave she throws up, a broad churned band astern
// as wide as her transom that fades over several of her lengths, and the diverging crests of a Kelvin wake breaking
// white near her.  They are a pattern on the sea rather than anything on it: a function of the place in her own
// frame, read by a gradient through a warp, blends a sea water with aerated water and with foam.  Foam laid as
// decals on a second sheet of water over the first, for the schooner, read as stickers and doubled the render.
//
// Her side foam spreads some fifteen meters out amidships, and from a low angle that is a few pixels; the white
// that shows is her bow wave and her wake, as it does in photographs of her.


// Her half-breadth at the waterline, fine at her bow and broad at her transom.
function CvnBeamAt(x) -> number {
    return 20.25 * clamp(1 - pow(max(x - 40, 0) / 110, 1.7), 0, 1) - 6 * smoothstep(-112, -162, x)
}

// White water down her sides: thrown up at her bow, and spreading as it runs aft.
function CvnSideFoam(x, z) -> number {
    return (0.6 + 0.9 * smoothstep(100, 146, x)) * (1 - smoothstep(0, 6 + 0.09 * (150 - x), abs(z) - CvnBeamAt(x)))
           * smoothstep(154, 144, x) * smoothstep(-168, -158, x)
}

// The churned water astern of her: as broad as her transom, spreading slowly and fading over a few of her lengths.
function CvnSternWake(x, z) -> number {
    return smoothstep(-156, -166, x) * exp(-max(-162 - x, 0) / 520)
           * (1 - smoothstep(0.55 * (16 + 0.07 * max(-162 - x, 0)), 16 + 0.07 * max(-162 - x, 0), abs(z)))
}

// The diverging crests from her bow, at the Kelvin angle of 19.5 degrees, broken white near her and fading.
function CvnKelvin(x, z) -> number {
    return 0.5 * smoothstep(152, 125, x) * exp(-max(150 - x, 0) / 260)
           * (1 - smoothstep(0, 3 + 0.03 * max(150 - x, 0), abs(abs(z) - 19 - 0.354 * max(150 - x, 0))))
}

function CvnWake(x, z) -> number {
    return clamp((CvnSideFoam(x, z) + CvnSternWake(x, z) + CvnKelvin(x, z)) * (0.3 + 1.4 * noise(x * 0.045, 1.7, z * 0.21)), 0, 0.999)
}

// The open Atlantic: the [water](#water) library's sea water, bluer, with a fine chop on it.
CvnAtlantic = material {
    pigment [0.010, 0.070, 0.300]
    ambient 0.22  diffuse 0.10  specular 1  shininess 900  reflective 1  transparency 0.88
    interior { index of refraction Water  clarity 24  filter 1 }
    normal wrinkles { depth 0.55  scale [5, 3, 3.5] }
}
CvnAerated = material {
    pigment [0.24, 0.50, 0.56]
    ambient 0.10  diffuse 0.55  specular 0.6  shininess 200  reflective 0.35  fresnel
}
CvnFoam = material { pigment [0.82, 0.85, 0.87]  ambient 0.12  diffuse 0.9  specular 0.1  shininess 10 }

// A sea with her wake in it, for a surface of water: she at `along`, `across` on it, turned `turn` degrees as a
// `rotate Y` turns her, steaming toward her bow.
primitive CarrierEnterpriseWake(along = 0, across = 0, turn = 0) -> material {
    return material blend linear X gradient {
        warp { X { CvnWake(x, z) } }
        [0, CvnAtlantic, 0.18, CvnAtlantic, 0.45, CvnAerated, 0.75, CvnFoam, 1, CvnFoam]
        rotate Y turn
        translate [along, 0, across]
    }
}
