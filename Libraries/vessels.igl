// Her flight deck's paint: dark nonskid, the landing area's dashed edges and its yellow centerline, the four
// catapults' slots, and her elevators outlined.
CvnFlightDeckPaint = material CvnDeckGray {
    decal { path CvnCatapultSlots  color [0.015, 0.015, 0.016]  planar  min Y 18.5  max Y 19.5 }
    decal { path CvnDeckWhite  color [0.70, 0.70, 0.68]  planar  min Y 18.5  max Y 19.5 }
    decal { path CvnDeckYellow  color [0.78, 0.55, 0.08]  planar  min Y 18.5  max Y 19.5 }
}

// Her island's sides: her hull number aft on her starboard side, forward on her port side, and the Battle E beside
// it there.
CvnIslandSides = material CvnHaze {
    decal { path CvnSixtyFive  color [0.86, 0.86, 0.84]  planar  min Y -1  max Y 1  scale 6
            rotate X -90  translate [-33, 24.8, -36] }
    decal { path CvnSixtyFive  color [0.86, 0.86, 0.84]  planar  min Y -1  max Y 1  scale 6
            rotate X -90  rotate Y 180  translate [-8.5, 24.8, -19.5] }
    decal { path CvnBattleE  color [0.86, 0.86, 0.84]  planar  min Y -1  max Y 1  scale 5.4
            rotate X -90  rotate Y 180  translate [-19.5, 25.1, -19.5] }
}

