// The catwalks round her deck's edge: grating, a rail along their outer edge, and the white canisters of her life
// rafts lying along them in banks.
CvnCatwalk = material { pigment [0.17, 0.175, 0.18]  specular 0.05  shininess 10 }

primitive CvnLifeRaft() -> cylinder {
    return cylinder { min Y -0.75  max Y 0.75  scale [0.3, 1, 0.3]  rotate Z 90  translate Y 0.32  material CvnWhite }
}

// Her hull, from her keel to the underside of her flight deck, with her hangar bays open to the sea under her
// four elevators and her fantail open astern.
primitive CvnHull() -> group {
    return group {
        loft {
            section { path CvnStation0  translate Z -162 }
            section { path CvnStation1  translate Z -150 }
            section { path CvnStation2  translate Z -132 }
            section { path CvnStation3  translate Z -110 }
            section { path CvnStation4  translate Z -40 }
            section { path CvnStation5  translate Z 35 }
            section { path CvnStation6  translate Z 62 }
            section { path CvnStation7  translate Z 88 }
            section { path CvnStation8  translate Z 110 }
            section { path CvnStation9  translate Z 130 }
            section { path CvnStation10  translate Z 139 }
            section { path CvnStation11  translate Z 146 }
            section { path CvnStation12  translate Z 150.5 }
            section { path CvnStation13  translate Z 160 }
            section { path CvnStation14  translate Z 170.2 }
            rotate Y 90
            material CvnHullPaint
        }
        // The hangar's openings under her elevators and at her fantail: dark, a hair off her side.
        cube { scale [11.5, 3.5, 0.05]  translate [58.5, 14.0, -20.32]  material CvnShade }
        cube { scale [11.5, 3.5, 0.05]  translate [12.5, 14.0, -20.32]  material CvnShade }
        cube { scale [12, 3.5, 0.05]  translate [-52, 14.0, -20.32]  material CvnShade }
        cube { scale [12, 3.5, 0.05]  translate [-101, 14.0, 20.32]  material CvnShade }
        cube { scale [0.05, 4.2, 10.5]  translate [-162.05, 11.0, 0]  material CvnShade }
    }
}

// Her flight deck, and the overhangs under it: a slab three meters deep wherever the deck stands out past her
// sides, and below it the sloping skirt that carries it down to her hull.  Nothing under her elevators.
primitive CvnFlightDeck() -> group {
    return group {
        extrusion { path CvnDeckPlan  min Y 17.6  max Y 19  material CvnFlightDeckPaint }
        difference {
            extrusion { path CvnCatwalkPlan  min Y 16.9  max Y 17.15 }
            extrusion { path CvnDeckPlan  min Y 16.5  max Y 17.6 }
            material CvnCatwalk
        }
        difference {
            extrusion { path CvnCatwalkPlan  min Y 17.15  max Y 17.95 }
            extrusion { path CvnCatwalkRail  min Y 17.0  max Y 18.1 }
            material CvnCatwalk
        }
        field {
            of CvnLifeRaft()
            along CvnDeckPlan  spacing 2.1  offset -0.95  jitter 0.15
            patches bozo { scale 9 } from 0.42 to 0.5
            translate Y 17.15
        }
        difference {
            union {
                extrusion { path CvnDeckPlan  min Y 14.6  max Y 17.6 }
                intersection {
                    extrusion { path CvnDeckPlan  min Y 6  max Y 14.6 }
                    cube { scale [132, 20, 60]  translate [-28, 20, 0] }
                    // Up from her side at y = 8, outward to the deck's edge at a slope of 3 in 10.
                    cube { scale [400, 100, 100]  translate [0, 100, 0]  rotate X 16.7  translate [0, 8, -20.25] }
                    cube { scale [400, 100, 100]  translate [0, 100, 0]  rotate X -16.7  translate [0, 8, 20.25] }
                }
            }
            cube { scale [11.5, 6, 10]  translate [58.5, 11.5, -30.5] }
            cube { scale [11.5, 6, 10]  translate [12.5, 11.5, -30.5] }
            cube { scale [12, 6, 10]  translate [-52, 11.5, -30.5] }
            cube { scale [12, 6, 12]  translate [-101, 11.5, 32.5] }
            material CvnHaze
        }
    }
}

