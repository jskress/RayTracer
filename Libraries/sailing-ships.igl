            move to 0.2100, 1.3330  line to 0.1909, 1.2743  line to 0.1292, 1.2743  line to 0.1791, 1.2380  line to 0.1600, 1.1792  line to 0.2100, 1.2155  line to 0.2600, 1.1792  line to 0.2409, 1.2380  line to 0.2908, 1.2743  line to 0.2291, 1.2743  close
            move to 0.6300, 1.3330  line to 0.6109, 1.2743  line to 0.5492, 1.2743  line to 0.5991, 1.2380  line to 0.5800, 1.1792  line to 0.6300, 1.2155  line to 0.6800, 1.1792  line to 0.6609, 1.2380  line to 0.7108, 1.2743  line to 0.6491, 1.2743  close
