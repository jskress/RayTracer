// Ships of the age of sail, each one a particular ship.
//
//     import 'sailing-ships' { SchoonerEnterprise, PolaccaTripoli, GunSmoke }
//
//     object SchoonerEnterprise(-28) { rotate X -7 }
//     object PolaccaTripoli(-25)     { rotate X -4  translate [24, 0, -30] }
//     object GunSmoke(28, 34, 17)    { rotate Y 180  translate Z -3.4 }
//
// | `SchoonerEnterprise` | The United States schooner Enterprise as she was in 1801: twelve guns, a topsail schooner. |
// | `PolaccaTripoli` | The Tripolitan corsair Tripoli as Enterprise left her on 1 August 1801: fourteen guns, her mizzen shot away. |
// | `GunSmoke` | The bank of powder smoke a broadside leaves, drifting downwind off a ship's side. |
//
// **These are in meters, face `+X`, and float with their waterline at `y = 0`**, as the [vessels](#vessels)
// do: a ship dropped at the origin floats on a [`Water`](#water) surface laid at the origin.  `+Z` is the
// ship's port side.
//
// **The first number is her trim**: how far her booms and yards are swung off her centerline, to port when
// it is positive (the wind on her starboard side) and to starboard when negative; her sails, headsails and
// colors all go with it.  The second, `belly`, is how full her sails are drawn.  She stands upright: how far
// she heels is the scene's `rotate X` to say.
//
// Everything beginning with `Ent`, `Pol` or `Ship` is the machinery.

import 'cloth' { Flag }

// -- The schooner Enterprise ------------------------------------------------------------------------
//
// Built by Henry Spencer at Baltimore in 1799: 84 ft 7 in on deck, 60 ft on the keel, 22 ft 6 in in the
// beam, 10 ft depth of hold, drawing 9 ft 6 in aft.  No draught of her survives; her lines here are those
// of the Baltimore schooners of her day, sharp, low and dragged deep aft, and her rig, paint and ports are
// Antoine Roux's portrait of her, drawn from life in 1806.

// The height of her rail at a place along her, from aft to forward: her sheer, lowest a little abaft the
// middle and rising 0.34 m to the taffrail and 0.64 m to the stem.  Her deck at the side lies 1.05 m under it.
function EntRail(x) -> number { return 2.34 + 0.0029 * (x + 2) * (x + 2) }
function EntDeck(x) -> number { return 1.29 + 0.0029 * (x + 2) * (x + 2) }

// Her stations, each normalized: the rail at the top (y = 1), the rabbet at the keel at the bottom
// (y = 0), and her greatest half-breadth at x = 1.  Drawn from the port rail across the top, down the
// starboard side and up the port side, in eight segments apiece so that the same places run the
// length of her.
EntMid = path {
    move to -0.962, 1
    line to 0.962, 1
    curve 0.985, 0.92, 1.0, 0.82 to 1.0, 0.72
    curve 1.0, 0.55, 0.975, 0.38 to 0.88, 0.27
    curve 0.72, 0.14, 0.30, 0.035 to 0.045, 0
    line to -0.045, 0
    curve -0.30, 0.035, -0.72, 0.14 to -0.88, 0.27
    curve -0.975, 0.38, -1.0, 0.55 to -1.0, 0.72
    curve -1.0, 0.82, -0.985, 0.92 to -0.962, 1
}

EntEntrance = path {
    move to -0.97, 1
    line to 0.97, 1
    curve 0.99, 0.93, 1.0, 0.86 to 1.0, 0.78
    curve 1.0, 0.62, 0.93, 0.49 to 0.78, 0.40
    curve 0.50, 0.22, 0.20, 0.05 to 0.045, 0
    line to -0.045, 0
    curve -0.20, 0.05, -0.50, 0.22 to -0.78, 0.40
    curve -0.93, 0.49, -1.0, 0.62 to -1.0, 0.78
    curve -1.0, 0.86, -0.99, 0.93 to -0.97, 1
}

EntBow = path {
    move to -1.0, 1
    line to 1.0, 1
    curve 0.995, 0.95, 0.98, 0.88 to 0.96, 0.80
    curve 0.93, 0.68, 0.80, 0.55 to 0.62, 0.45
    curve 0.40, 0.28, 0.15, 0.08 to 0.045, 0
    line to -0.045, 0
    curve -0.15, 0.08, -0.40, 0.28 to -0.62, 0.45
    curve -0.80, 0.55, -0.93, 0.68 to -0.96, 0.80
    curve -0.98, 0.88, -0.995, 0.95 to -1.0, 1
}

// The run: the hollow, wineglass sections the Baltimore builders drew aft, deep and narrow at the keel.
EntRun = path {
    move to -0.95, 1
    line to 0.95, 1
    curve 0.98, 0.90, 1.0, 0.80 to 1.0, 0.70
    curve 1.0, 0.58, 0.93, 0.50 to 0.80, 0.45
    curve 0.45, 0.30, 0.12, 0.10 to 0.045, 0
    line to -0.045, 0
    curve -0.12, 0.10, -0.45, 0.30 to -0.80, 0.45
    curve -0.93, 0.50, -1.0, 0.58 to -1.0, 0.70
    curve -1.0, 0.80, -0.98, 0.90 to -0.95, 1
}

// The counter, over the sternpost, where she is wide and shallow.
EntCounter = path {
    move to -0.97, 1
    line to 0.97, 1
    curve 0.99, 0.90, 1.0, 0.78 to 1.0, 0.65
    curve 1.0, 0.45, 0.97, 0.28 to 0.85, 0.20
    curve 0.60, 0.05, 0.20, 0.0 to 0.045, 0
    line to -0.045, 0
    curve -0.20, 0.0, -0.60, 0.05 to -0.85, 0.20
    curve -0.97, 0.28, -1.0, 0.45 to -1.0, 0.65
    curve -1.0, 0.78, -0.99, 0.90 to -0.97, 1
}

// What lies inside her bulwarks: her deck, cambered 0.12 m in a beam two units high, and straight sides
// standing well clear of her rail.
EntWell = path {
    move to -1, 0
    curve -0.33, 0.08, 0.33, 0.08 to 1, 0
    line to 1, 1
    line to -1, 1
    close
}

// Her keel, stem and sternpost in profile, 0.3 m thick.
EntBackbone = path {
    move to -10.15, -2.9
    line to 8.4, -1.9
    curve 10.9, -1.88, 12.85, 0.0 to 13.05, 2.99
    line to 12.70, 2.99
    curve 12.30, 0.9, 10.6, -1.55 to 8.4, -1.6
    line to -9.75, -2.6
    line to -11.6, 0.6
    line to -11.98, 0.55
    close
}

// -- What she is made of ----------------------------------------------------------------------------

// Black topsides, with the broad ochre band her ports are cut in, following her sheer, and a thin ochre
// line at her wale.  Coppered below the waterline.
EntBlack = material {
    pigment [0.030, 0.030, 0.032]
    specular 0.25  shininess 30
    decal {
        path {
            move to -13.5, 2.5735  quad 0, 1.673 to 13.5, 2.8867
            line to 13.5, 2.1667  quad 0, 0.953 to -13.5, 1.8535
            close
        }
        color [0.70, 0.53, 0.24]  planar  min Y -5  max Y 5  fade from 70 to 85  rotate X -90
    }
    decal {
        path {
            move to -13.5, 1.4335  quad 0, 0.533 to 13.5, 1.7467
            line to 13.5, 1.6867  quad 0, 0.473 to -13.5, 1.3735
            close
        }
        color [0.70, 0.53, 0.24]  planar  min Y -5  max Y 5  fade from 70 to 85  rotate X -90
    }
}

// Her copper has been at sea two years: browned, and not the new metal's pink.
EntCopper = material { metal [0.46, 0.27, 0.18] edge [0.78, 0.52, 0.38]  roughness 0.55 }

// Her planking, which shows through her paint: strakes two tenths of a meter wide and seven long, butts
// staggered, running with her sheer and closing in by a quarter toward her ends, as planks taper into a
// stem and a counter.  It is a roughening, so it is the blend's first material's, and a copy of her copper
// carries it so that her keel and stem, painted the same way, are not planked too.  Her hull is lofted
// along its own Z and turned onto her length, so the planks are turned back to lie along her X.
EntHullCopper = material EntCopper {
    normal planks {
        plank size [7, 0.2, 1000]  seam size 0.04
        warp { Y { (y - EntRail(x)) / (1 - 0.25 * (x / 13) * (x / 13)) + 0.1 } }
        depth 0.05  rotate Y -90
    }
}

EntHullPaint = material blend linear Y gradient {
    [0, EntHullCopper, 0.4995, EntHullCopper, 0.5005, EntBlack]
    scale [1, 20, 1]
    translate Y -9.75
}

// The same for her keel, stem, rudder and head, which are profiles extruded across her and turned on their
// sides: their own Z is her height.  They carry no band.
EntTimberBlack = material { pigment [0.030, 0.030, 0.032]  specular 0.25  shininess 30 }

EntProfilePaint = material blend linear Z gradient {
    [0, EntCopper, 0.4995, EntCopper, 0.5005, EntTimberBlack]
    scale [1, 1, 20]
    translate Z -9.75
}

// Her deck, scrubbed pine laid fore and aft in boards fourteen centimeters wide, each its own shade, the seams
// payed with pitch; a king plank down her middle.  Read in her own frame, as her planking is.
EntDeckPlanking = material {
    pigment planks {
        plank size [7, 1000, 0.14]  seam size 0.016
        [0, [0.10, 0.08, 0.06], 0.5, [0.63, 0.55, 0.42], 1, [0.54, 0.46, 0.34]]
        rotate Y -90
    }
    specular 0.08  shininess 12
}

// The insides of her bulwarks, painted red over strakes that run with her deck.  The deck and the bulwarks are
// one surface, so this roughening is the deck's too, where it finds nothing but the odd seam fore and aft.
EntRed = material { pigment [0.40, 0.10, 0.07]  specular 0.10  shininess 16 }

EntBulwarkRed = material EntRed {
    normal planks {
        plank size [7, 0.2, 1000]  seam size 0.03
        warp { Y { y - EntDeck(x) } }
        depth 0.06  rotate Y -90
    }
}

EntDeckAndBulwarks = material blend facing { [0.74, EntBulwarkRed, 0.80, EntDeckPlanking] }

// -- Her hull ---------------------------------------------------------------------------------------

// Lofted from sixteen stations, aft to forward, each standing on her rabbet and reaching to her rail;
// cut square at her raked transom; her deck cut in under her bulwarks; six ports a side.
primitive EntHull() -> group {
    return group {
        difference {
            intersection {
                loft {
                    section { path EntCounter   scale [2.25, EntRail(-13.2) - 1.40, 1]   translate [0, 1.40, -13.2] }
                    section { path EntCounter   scale [2.50, EntRail(-12.4) - 0.85, 1]   translate [0, 0.85, -12.4] }
                    section { path EntRun       scale [2.70, EntRail(-11.6) - 0.05, 1]   translate [0, 0.05, -11.6] }
                    section { path EntRun       scale [2.86, EntRail(-10.6) + 1.68, 1]   translate [0, -1.68, -10.6] }
                    section { path EntRun       scale [3.00, EntRail(-9.4) + 2.573, 1]   translate [0, -2.573, -9.4] }
                    section { path EntRun       scale [3.22, EntRail(-7.0) + 2.44, 1]    translate [0, -2.44, -7.0] }
                    section { path EntMid       scale [3.38, EntRail(-4.0) + 2.28, 1]    translate [0, -2.28, -4.0] }
                    section { path EntMid       scale [3.43, EntRail(-0.5) + 2.09, 1]    translate [0, -2.09, -0.5] }
                    section { path EntMid       scale [3.41, EntRail(2.5) + 1.92, 1]     translate [0, -1.92, 2.5] }
                    section { path EntEntrance  scale [3.22, EntRail(5.2) + 1.775, 1]    translate [0, -1.775, 5.2] }
                    section { path EntEntrance  scale [2.88, EntRail(7.6) + 1.644, 1]    translate [0, -1.644, 7.6] }
                    section { path EntBow       scale [2.30, EntRail(9.6) + 1.45, 1]     translate [0, -1.45, 9.6] }
                    section { path EntBow       scale [1.68, EntRail(10.9) + 0.70, 1]    translate [0, -0.70, 10.9] }
                    section { path EntBow       scale [1.05, EntRail(11.9) - 0.58, 1]    translate [0, 0.58, 11.9] }
                    section { path EntBow       scale [0.50, EntRail(12.55) - 1.97, 1]   translate [0, 1.97, 12.55] }
                    section { path EntBow       scale [0.12, EntRail(12.89) - 2.80, 1]   translate [0, 2.80, 12.89] }
                    rotate Y 90
                }
                // The transom: a plane raking aft from the tuck to the taffrail.
                cube { scale 50  translate X 50  rotate Z 25.55  translate [-11.8, 0.4, 0]  material EntTimberBlack }
            }
            loft {
                section { path EntWell  scale [2.30, 2, 1]  translate [0, EntDeck(-12.25), -12.25] }
                section { path EntWell  scale [2.62, 2, 1]  translate [0, EntDeck(-11.0), -11.0] }
                section { path EntWell  scale [2.93, 2, 1]  translate [0, EntDeck(-8.0), -8.0] }
                section { path EntWell  scale [3.13, 2, 1]  translate [0, EntDeck(-4.0), -4.0] }
                section { path EntWell  scale [3.18, 2, 1]  translate [0, EntDeck(-0.5), -0.5] }
                section { path EntWell  scale [3.16, 2, 1]  translate [0, EntDeck(2.5), 2.5] }
                section { path EntWell  scale [2.98, 2, 1]  translate [0, EntDeck(5.2), 5.2] }
                section { path EntWell  scale [2.62, 2, 1]  translate [0, EntDeck(7.6), 7.6] }
                section { path EntWell  scale [2.03, 2, 1]  translate [0, EntDeck(9.6), 9.6] }
                section { path EntWell  scale [1.30, 2, 1]  translate [0, EntDeck(10.9), 10.9] }
                section { path EntWell  scale [0.55, 2, 1]  translate [0, EntDeck(11.9), 11.9] }
                rotate Y 90
                material EntDeckAndBulwarks
            }
            cube { scale [0.31, 0.25, 4]  translate [9.0, EntDeck(9.0) + 0.57, 0]    material EntRed }
            cube { scale [0.31, 0.25, 4]  translate [6.0, EntDeck(6.0) + 0.57, 0]    material EntRed }
            cube { scale [0.31, 0.25, 4]  translate [1.6, EntDeck(1.6) + 0.57, 0]    material EntRed }
            cube { scale [0.31, 0.25, 4]  translate [-4.6, EntDeck(-4.6) + 0.57, 0]  material EntRed }
            cube { scale [0.31, 0.25, 4]  translate [-8.2, EntDeck(-8.2) + 0.57, 0]  material EntRed }
            cube { scale [0.31, 0.25, 4]  translate [-10.6, EntDeck(-10.6) + 0.57, 0] material EntRed }
        }
        extrusion { path EntBackbone  min Y -0.15  max Y 0.15  rotate X -90  material EntProfilePaint }
        extrusion { path EntRudder  min Y -0.11  max Y 0.11  rotate X -90  material EntProfilePaint }
        extrusion { path EntKnee  min Y -0.13  max Y 0.13  rotate X -90  material EntProfilePaint }
        material EntHullPaint
    }
}


// -- Her fittings --------------------------------------------------------------------------------

ShipIron = material { pigment [0.055, 0.055, 0.06]  specular 0.35  shininess 40 }
// Oak for her fittings, faintly figured.
ShipTimber = material {
    pigment bozo { turbulence 0.5  [0, [0.32, 0.22, 0.13], 1, [0.39, 0.27, 0.16]]  scale 0.15 }
    specular 0.10  shininess 16
}
EntBoatPaint = material { pigment [0.80, 0.78, 0.72]  specular 0.20  shininess 30 }

// A six-pounder on its truck carriage, run out: its muzzle at the origin, its bore along +Z, the deck
// 0.55 m under its axis.
ShipGunBarrel = path {
    move to 0, -0.14
    line to 0.05, -0.14  line to 0.06, -0.06  line to 0.16, 0
    line to 0.16, 0.62  line to 0.145, 0.64  line to 0.138, 1.02  line to 0.125, 1.04
    line to 0.112, 1.80  line to 0.13, 1.86  line to 0.13, 2.0  line to 0.046, 2.0  line to 0.046, 1.7  line to 0, 1.7
}

primitive ShipGun() -> group {
    return group {
        lathe { path ShipGunBarrel  rotate X 90  translate Z -2.0  material ShipIron }
        cylinder { min Y -0.26  max Y 0.26  scale [0.05, 1, 0.05]  rotate Z 90  translate Z -1.38  material ShipIron }
        cube { scale [0.05, 0.22, 0.62]  translate [0.21, -0.30, -1.15]  material EntRed }
        cube { scale [0.05, 0.22, 0.62]  translate [-0.21, -0.30, -1.15]  material EntRed }
        cylinder { min Y -0.32  max Y 0.32  scale [0.15, 1, 0.15]  rotate Z 90  translate [0, -0.40, -0.68]  material EntRed }
        cylinder { min Y -0.32  max Y 0.32  scale [0.15, 1, 0.15]  rotate Z 90  translate [0, -0.40, -1.58]  material EntRed }
    }
}

// A gun at each port, both sides, its muzzle a quarter meter outside her side there.
primitive EntGuns() -> group {
    return group {
        object ShipGun() { translate [9.0, EntDeck(9.0) + 0.55, 2.70] }
        object ShipGun() { translate [6.0, EntDeck(6.0) + 0.55, 3.25] }
        object ShipGun() { translate [1.6, EntDeck(1.6) + 0.55, 3.53] }
        object ShipGun() { translate [-4.6, EntDeck(-4.6) + 0.55, 3.46] }
        object ShipGun() { translate [-8.2, EntDeck(-8.2) + 0.55, 3.21] }
        object ShipGun() { translate [-10.6, EntDeck(-10.6) + 0.55, 2.97] }
        object ShipGun() { rotate Y 180  translate [9.0, EntDeck(9.0) + 0.55, -2.70] }
        object ShipGun() { rotate Y 180  translate [6.0, EntDeck(6.0) + 0.55, -3.25] }
        object ShipGun() { rotate Y 180  translate [1.6, EntDeck(1.6) + 0.55, -3.53] }
        object ShipGun() { rotate Y 180  translate [-4.6, EntDeck(-4.6) + 0.55, -3.46] }
        object ShipGun() { rotate Y 180  translate [-8.2, EntDeck(-8.2) + 0.55, -3.21] }
        object ShipGun() { rotate Y 180  translate [-10.6, EntDeck(-10.6) + 0.55, -2.97] }
    }
}

// Her rudder, hung on the sternpost's after edge, its head coming up through her counter to the tiller.
EntRudder = path {
    move to -10.15, -2.85  line to -11.98, 0.55  line to -12.40, 0.62  line to -11.0, -2.85  close
}

// The knee of her head, carried forward of the stem under the bowsprit to a scrolled billet head.
EntKnee = path {
    move to 12.35, 0.1
    curve 13.0, 0.5, 13.75, 1.4 to 14.15, 2.45
    curve 14.35, 2.95, 14.45, 3.15 to 14.2, 3.2
    line to 13.3, 3.2
    line to 12.8, 2.95
    curve 12.75, 1.9, 12.6, 0.9 to 12.35, 0.1
}

// An anchor, its ring at the origin and its shank hanging down -Y: the stock across the top, the arms
// at the crown.
primitive ShipAnchor() -> group {
    return group {
        cylinder { min Y -2.1  max Y 0  scale [0.06, 1, 0.06]  material ShipIron }
        cylinder { min Y -1.0  max Y 1.0  scale [0.08, 1, 0.08]  rotate X 90  translate Y -0.25  material ShipTimber }
        cylinder { min Y 0  max Y 0.9  scale [0.055, 1, 0.055]  rotate Z 50  translate Y -2.1  material ShipIron }
        cylinder { min Y 0  max Y 0.9  scale [0.055, 1, 0.055]  rotate Z -50  translate Y -2.1  material ShipIron }
        cube { scale [0.18, 0.03, 0.14]  rotate Z 50  translate [-0.62, -1.55, 0]  material ShipIron }
        cube { scale [0.18, 0.03, 0.14]  rotate Z -50  translate [0.62, -1.55, 0]  material ShipIron }
    }
}

// A boat for a schooner of war: a cutter of six and a half meters, stowed on chocks over the main hatch.
primitive EntBoat() -> group {
    return group {
        loft {
            section { path EntCounter  scale [0.62, 0.66, 1]  translate [0, 0.12, -3.2] }
            section { path EntRun      scale [0.86, 0.76, 1]  translate [0, 0.02, -2.0] }
            section { path EntMid      scale [0.95, 0.80, 1]  translate [0, 0, 0] }
            section { path EntEntrance scale [0.86, 0.82, 1]  translate [0, 0.01, 1.8] }
            section { path EntBow      scale [0.40, 0.84, 1]  translate [0, 0.06, 2.9] }
            section { path EntBow      scale [0.06, 0.86, 1]  translate [0, 0.10, 3.3] }
            rotate Y 90
            material EntBoatPaint
        }
    }
}

// Her deck: hatches, the windlass at the bow with its bitts, the companion and skylight aft, the tiller,
// and the boat.
primitive EntDeckFittings() -> group {
    return group {
        cube { scale [0.55, 0.18, 0.55]  translate [8.4, EntDeck(8.4) + 0.12, 0]   material ShipTimber }
        cube { scale [0.8, 0.18, 0.7]    translate [0.0, EntDeck(0.0) + 0.12, 0]   material ShipTimber }
        cube { scale [0.5, 0.35, 0.45]   translate [-8.9, EntDeck(-8.9) + 0.25, 0] material ShipTimber }
        cube { scale [0.45, 0.22, 0.6]   translate [-6.9, EntDeck(-6.9) + 0.15, 0] material ShipTimber }
        cylinder { min Y -1.2  max Y 1.2  scale [0.24, 1, 0.24]  rotate X 90  translate [10.6, EntDeck(10.6) + 0.42, 0]  material ShipTimber }
        cube { scale [0.14, 0.45, 0.14]  translate [10.6, EntDeck(10.6) + 0.4, 1.3]   material ShipTimber }
        cube { scale [0.14, 0.45, 0.14]  translate [10.6, EntDeck(10.6) + 0.4, -1.3]  material ShipTimber }
        cylinder { min Y 0  max Y 1.0  scale [0.13, 1, 0.13]  translate [-12.15, EntDeck(-12.15) - 0.3, 0]  material ShipTimber }
        cylinder { min Y 0  max Y 2.8  scale [0.06, 1, 0.06]  rotate Z -86  translate [-12.15, EntDeck(-12.15) + 0.62, 0]  material ShipTimber }
        cylinder { min Y 0  max Y 1.1  scale [0.11, 1, 0.11]  translate [8.0, EntDeck(8.0), 0.9]  material ShipIron }
        object EntBoat() { translate [0.2, EntDeck(0.2) + 0.38, 0] }
        cube { scale [0.12, 0.2, 0.8]  translate [-1.6, EntDeck(-1.6) + 0.15, 0]  material ShipTimber }
        cube { scale [0.12, 0.2, 0.8]  translate [2.0, EntDeck(2.0) + 0.15, 0]  material ShipTimber }
    }
}

// -- Her people ----------------------------------------------------------------------------------

ShipSkin = material { pigment [0.70, 0.50, 0.38]  specular 0.08  shininess 12 }
ShipSlops = material { pigment [0.82, 0.80, 0.74]  specular 0.04  shininess 8 }
ShipHat = material { pigment [0.07, 0.065, 0.06]  specular 0.10  shininess 16 }

// A man's coat: a blue jacket (1) or a red shirt (2).
primitive ShipCoat(dress) -> material {
    if (dress == 2) {
        return material { pigment [0.62, 0.20, 0.16]  specular 0.04  shininess 8 }
    }
    else {
        return material { pigment [0.10, 0.12, 0.20]  specular 0.06  shininess 10 }
    }
}

// A man standing on y = 0 facing +X, 1.72 m tall: white trousers, his coat by `dress`, a round hat, and bent
// `lean` degrees at the hips toward his work.
primitive ShipHand(dress = 1, lean = 0) -> group {
    return group {
        cylinder { min Y 0  max Y 0.86  scale [0.075, 1, 0.075]  translate Z 0.1   material ShipSlops }
        cylinder { min Y 0  max Y 0.86  scale [0.075, 1, 0.075]  translate Z -0.1  material ShipSlops }
        group {
            superellipsoid { east 0.6  north 0.8  scale [0.13, 0.32, 0.21]  translate Y 0.3 }
            cylinder { min Y -0.55  max Y 0  scale [0.055, 1, 0.055]  rotate X -12  translate [0, 0.56, 0.25] }
            cylinder { min Y -0.55  max Y 0  scale [0.055, 1, 0.055]  rotate X 12  translate [0, 0.56, -0.25] }
            sphere { scale [0.10, 0.12, 0.10]  translate Y 0.75  material ShipSkin }
            cylinder { min Y 0  max Y 0.09  scale [0.16, 1, 0.16]  translate Y 0.82  material ShipHat }
            cylinder { min Y 0  max Y 0.12  scale [0.09, 1, 0.09]  translate Y 0.84  material ShipHat }
            material ShipCoat(dress)
            rotate Z 0 - lean
            translate Y 0.86
        }
    }
}

// A marine: a blue coat crossed with white belts, his musket at his shoulder, aimed along +X.
primitive ShipMarine() -> group {
    return group {
        object ShipHand(1, 8)
        group {
            cube { scale [0.135, 0.025, 0.215]  rotate X 38  translate Y 0.33  material ShipSlops }
            cube { scale [0.135, 0.025, 0.215]  rotate X -38  translate Y 0.33  material ShipSlops }
            cylinder { min Y 0  max Y 1.45  scale [0.014, 1, 0.014]  rotate Z -86  translate [-0.35, 0.55, -0.12]  material ShipTimber }
            rotate Z -8
            translate Y 0.86
        }
    }
}

// Her crew at quarters, fighting her starboard guns -- four at each -- with the officers and the helmsman
// aft, and marines in the starboard shrouds and at her rail, all facing the enemy to starboard.
primitive EntGunCrew(x, hb) -> group {
    return group {
        object ShipHand(1, 22) { rotate Y 90  translate [x + 0.75, EntDeck(x), 0.6 - hb] }
        object ShipHand(2, 22) { rotate Y 90  translate [x - 0.75, EntDeck(x), 0.6 - hb] }
        object ShipHand(1, 8)  { rotate Y 90  translate [x + 0.45, EntDeck(x), 2.6 - hb] }
        object ShipHand(2, 32) { rotate Y 75  translate [x - 0.6, EntDeck(x), 2.3 - hb] }
    }
}

primitive EntCrew() -> group {
    return group {
        object EntGunCrew(9.0, 2.45)
        object EntGunCrew(6.0, 3.0)
        object EntGunCrew(1.6, 3.28)
        object EntGunCrew(-4.6, 3.21)
        object EntGunCrew(-8.2, 2.96)
        object EntGunCrew(-10.6, 2.72)
        object ShipHand(1, 0)  { rotate Y 120  translate [-11.2, EntDeck(-11.2), 0.7] }
        object ShipHand(1, 0)  { rotate Y 95   translate [-10.6, EntDeck(-10.6), -0.5] }
        object ShipHand(2, 10) { rotate Y 180  translate [-9.6, EntDeck(-9.6), 0.25] }
        object ShipMarine() { rotate Y 90  translate [-6.06, 5.0, -2.5] }
        object ShipMarine() { rotate Y 90  translate [-5.93, 6.5, -2.05] }
        object ShipMarine() { rotate Y 90  translate [3.72, 5.5, -2.45] }
        object ShipMarine() { rotate Y 90  translate [-1.0, EntDeck(-1.0), -2.75] }
        object ShipMarine() { rotate Y 90  translate [-2.1, EntDeck(-2.1), -2.75] }
        object ShipMarine() { rotate Y 90  translate [3.1, EntDeck(3.1), -2.8] }
        object ShipMarine() { rotate Y 90  translate [4.3, EntDeck(4.3), -2.75] }
    }
}

// -- Her colors ----------------------------------------------------------------------------------

// The flag of 1795 to 1818: fifteen stripes and fifteen stars, flown at the main peak, four meters on the
// fly.  The stripes are the cloth; the canton and its stars are painted over it.
EntEnsign = material {
    pigment linear Y gradient {
        banded [0, [0.62, 0.07, 0.09], 0.0667, [0.92, 0.90, 0.86], 0.1333, [0.62, 0.07, 0.09], 0.2, [0.92, 0.90, 0.86],
                0.2667, [0.62, 0.07, 0.09], 0.3333, [0.92, 0.90, 0.86], 0.4, [0.62, 0.07, 0.09], 0.4667, [0.92, 0.90, 0.86],
                0.5333, [0.62, 0.07, 0.09], 0.6, [0.92, 0.90, 0.86], 0.6667, [0.62, 0.07, 0.09], 0.7333, [0.92, 0.90, 0.86],
                0.8, [0.62, 0.07, 0.09], 0.8667, [0.92, 0.90, 0.86], 0.9333, [0.62, 0.07, 0.09]]
        scale [1, 2.4, 1]
    }
    specular 0.04  shininess 8  ambient 0.12
    decal {
        path { move to 0, 1.12  line to 1.68, 1.12  line to 1.68, 2.4  line to 0, 2.4  close }
        color [0.10, 0.12, 0.33]  planar  min Y -3  max Y 3  no fade  rotate X -90
    }
    decal {
        path {
            move to 0.2100, 2.3570  line to 0.1909, 2.2983  line to 0.1292, 2.2983  line to 0.1791, 2.2620  line to 0.1600, 2.2032  line to 0.2100, 2.2395  line to 0.2600, 2.2032  line to 0.2409, 2.2620  line to 0.2908, 2.2983  line to 0.2291, 2.2983  close
            move to 0.6300, 2.3570  line to 0.6109, 2.2983  line to 0.5492, 2.2983  line to 0.5991, 2.2620  line to 0.5800, 2.2032  line to 0.6300, 2.2395  line to 0.6800, 2.2032  line to 0.6609, 2.2620  line to 0.7108, 2.2983  line to 0.6491, 2.2983  close
            move to 1.0500, 2.3570  line to 1.0309, 2.2983  line to 0.9692, 2.2983  line to 1.0191, 2.2620  line to 1.0000, 2.2032  line to 1.0500, 2.2395  line to 1.1000, 2.2032  line to 1.0809, 2.2620  line to 1.1308, 2.2983  line to 1.0691, 2.2983  close
            move to 0.6300, 2.1010  line to 0.6109, 2.0423  line to 0.5492, 2.0423  line to 0.5991, 2.0060  line to 0.5800, 1.9472  line to 0.6300, 1.9835  line to 0.6800, 1.9472  line to 0.6609, 2.0060  line to 0.7108, 2.0423  line to 0.6491, 2.0423  close
            move to 1.0500, 2.1010  line to 1.0309, 2.0423  line to 0.9692, 2.0423  line to 1.0191, 2.0060  line to 1.0000, 1.9472  line to 1.0500, 1.9835  line to 1.1000, 1.9472  line to 1.0809, 2.0060  line to 1.1308, 2.0423  line to 1.0691, 2.0423  close
            move to 1.4700, 2.1010  line to 1.4509, 2.0423  line to 1.3892, 2.0423  line to 1.4391, 2.0060  line to 1.4200, 1.9472  line to 1.4700, 1.9835  line to 1.5200, 1.9472  line to 1.5009, 2.0060  line to 1.5508, 2.0423  line to 1.4891, 2.0423  close
            move to 0.2100, 1.8450  line to 0.1909, 1.7863  line to 0.1292, 1.7863  line to 0.1791, 1.7500  line to 0.1600, 1.6912  line to 0.2100, 1.7275  line to 0.2600, 1.6912  line to 0.2409, 1.7500  line to 0.2908, 1.7863  line to 0.2291, 1.7863  close
            move to 0.6300, 1.8450  line to 0.6109, 1.7863  line to 0.5492, 1.7863  line to 0.5991, 1.7500  line to 0.5800, 1.6912  line to 0.6300, 1.7275  line to 0.6800, 1.6912  line to 0.6609, 1.7500  line to 0.7108, 1.7863  line to 0.6491, 1.7863  close
            move to 1.0500, 1.8450  line to 1.0309, 1.7863  line to 0.9692, 1.7863  line to 1.0191, 1.7500  line to 1.0000, 1.6912  line to 1.0500, 1.7275  line to 1.1000, 1.6912  line to 1.0809, 1.7500  line to 1.1308, 1.7863  line to 1.0691, 1.7863  close
            move to 0.6300, 1.5890  line to 0.6109, 1.5303  line to 0.5492, 1.5303  line to 0.5991, 1.4940  line to 0.5800, 1.4352  line to 0.6300, 1.4715  line to 0.6800, 1.4352  line to 0.6609, 1.4940  line to 0.7108, 1.5303  line to 0.6491, 1.5303  close
            move to 1.0500, 1.5890  line to 1.0309, 1.5303  line to 0.9692, 1.5303  line to 1.0191, 1.4940  line to 1.0000, 1.4352  line to 1.0500, 1.4715  line to 1.1000, 1.4352  line to 1.0809, 1.4940  line to 1.1308, 1.5303  line to 1.0691, 1.5303  close
