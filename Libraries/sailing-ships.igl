// The commission pennant at the main topmast head: a blue hoist, and a long fly red over white.
EntPennant = material {
    pigment linear Y gradient { banded [0, [0.92, 0.90, 0.86], 0.5, [0.62, 0.07, 0.09]]  scale [1, 0.36, 1] }
    specular 0.04  shininess 8  ambient 0.12
    decal {
        path { move to 0, 0  line to 0.9, 0  line to 0.9, 0.36  line to 0, 0.36  close }
        color [0.10, 0.12, 0.33]  planar  min Y -3  max Y 3  no fade  rotate X -90
    }
}

// -- Spars and sails ------------------------------------------------------------------------------

// Her spars, oiled pine with their mastheads and yardarms blacked.
// Oiled pine, its grain streaking along the spar: read in a spar's own space, where its length is Y and its
// round is one across.
ShipSpar = material {
    pigment bozo {
        turbulence 0.4
        [0, [0.44, 0.33, 0.20], 0.5, [0.52, 0.40, 0.25], 1, [0.47, 0.35, 0.22]]
        scale [0.18, 2.5, 0.18]
    }
    specular 0.20  shininess 30
}
ShipBlackedSpar = material { pigment [0.05, 0.045, 0.04]  specular 0.20  shininess 30 }

// Sailcloth: flax canvas, weathered to a warm off-white.  A sail encloses nothing, so the sun behind
// one lights the face toward the eye, as it does the real thing.
ShipCanvas = material { pigment [0.86, 0.82, 0.71]  specular 0.04  shininess 8  ambient 0.12 }

// The same cloth made up of bolts 60 cm wide, their seams showing as fine darker lines: running up and
// down a sail whose panels stand along Y and lie across X, or across one whose panels lie across Z.
ShipCanvasAlongX = material {
    pigment linear X gradient { [0, [0.70, 0.66, 0.56], 0.035, [0.86, 0.82, 0.71], 0.965, [0.86, 0.82, 0.71], 1, [0.70, 0.66, 0.56]]  scale 0.6 }
    specular 0.04  shininess 8  ambient 0.12
}

ShipCanvasAlongZ = material {
    pigment linear Z gradient { [0, [0.70, 0.66, 0.56], 0.035, [0.86, 0.82, 0.71], 0.965, [0.86, 0.82, 0.71], 1, [0.70, 0.66, 0.56]]  scale 0.6 }
    specular 0.04  shininess 8  ambient 0.12
}

// A sail between four corners -- the head's two (a at the luff, b at the leech) and the foot's two (c at
// the leech, d at the luff) -- bellied by the vector n at its middle, falling away to nothing at its edges.
// A triangular sail gives its head twice.  `cloth` is what it is made of.
primitive ShipSail(ax, ay, az, bx, by, bz, cx, cy, cz, dx, dy, dz, nx, ny, nz, cloth) -> parametric {
    return parametric {
        u [0, 1]
        v [0, 1]

        X { (1 - v) * ((1 - u) * dx + u * cx) + v * ((1 - u) * ax + u * bx) + nx * sin(3.14159265 * u) * sin(3.14159265 * v) }
        Y { (1 - v) * ((1 - u) * dy + u * cy) + v * ((1 - u) * ay + u * by) + ny * sin(3.14159265 * u) * sin(3.14159265 * v) }
        Z { (1 - v) * ((1 - u) * dz + u * cz) + v * ((1 - u) * az + u * bz) + nz * sin(3.14159265 * u) * sin(3.14159265 * v) }

        material cloth
    }
}

// A spar along +Y from its heel at the origin, `long` and `r` in radius.
primitive ShipPole(long, r) -> cylinder {
    return cylinder { min Y 0  max Y long  scale [r, 1, r] }
}

// A spar lying along Z, centered on the origin.
primitive ShipYard(long, r) -> cylinder {
    return cylinder { min Y -0.5 * long  max Y 0.5 * long  scale [r, 1, r]  rotate X 90 }
}

// -- The Enterprise's rig ---------------------------------------------------------------------------
//
// From Roux: both masts raked about twelve degrees, the foremast stepped 6.5 m abaft the stem head and the
// mainmast a little abaft her middle; a fore yard and a topsail yard on the foremast, and gaffs on both,
// the main boom reaching four meters past her taffrail.  Each mast is built in its own frame, its heel on
// the deck at the origin and its length up +Y, then raked and stepped.
//
// `trim` is how far her booms and yards are swung off her centerline, to port when it is positive (the
// wind on her starboard side) and to starboard when negative; `belly` how deep her sails are drawn.

primitive EntForemast(trim, belly) -> group {
    side = trim >= 0 ? 1 : -1
    return group {
        // The lower mast, its head, the crosstrees and the topmast in its doublings, forward of the head.
        object ShipPole(14.8, 0.19)  { translate Y -0.5  material ShipSpar }
        object ShipPole(1.8, 0.17)   { translate Y 13.2  material ShipBlackedSpar }
        cube { scale [0.45, 0.06, 1.25]  translate [0.12, 13.2, 0]  material ShipBlackedSpar }
        object ShipPole(10.0, 0.12)  { translate [0.36, 11.6, 0]  material ShipSpar }
        cube { scale [0.42, 0.1, 0.2]  translate [0.18, 15.0, 0]  material ShipBlackedSpar }

        // The fore yard, its course furled along it, and the topsail yard hoisted: both braced by the trim.
        group {
            object ShipYard(12.0, 0.12)  { translate [0.42, 13.0, 0]  material ShipSpar }
            object ShipYard(10.8, 0.22)  { scale [1, 1.4, 1]  translate [0.42, 12.78, 0]  material ShipCanvas }
            object ShipYard(9.0, 0.09)   { translate [0.48, 19.6, 0]  material ShipSpar }
            // The fore topsail, from its yard down to the fore yard's arms, bellied forward.
            object ShipSail(0.48, 19.45, 4.3,  0.48, 19.45, -4.3,  0.42, 13.15, -5.6,  0.42, 13.15, 5.6,  1.6 * belly, 0, 0,  ShipCanvasAlongZ)
            rotate Y 0 - trim * 0.8
        }

        // The fore gaff and the foresail, loose-footed, its clew forward of the mainmast.
        group {
            cylinder { min Y 0  max Y 6.0  scale [0.09, 1, 0.09]  rotate Z 50  translate [-0.25, 12.4, 0]  material ShipSpar }
            object ShipSail(-0.3, 12.3, 0,  -4.8, 16.1, 0,  -7.4, 2.6, 0,  -0.3, 1.2, 0,  0, 0, 2.2 * belly * side,  ShipCanvasAlongX)
            rotate Y trim * 0.7
        }
    }
}

primitive EntMainmast(trim, belly) -> group {
    side = trim >= 0 ? 1 : -1
    return group {
        object ShipPole(15.0, 0.20)  { translate Y -0.5  material ShipSpar }
        object ShipPole(1.8, 0.18)   { translate Y 12.8  material ShipBlackedSpar }
        cube { scale [0.45, 0.06, 1.3]  translate [0.12, 12.8, 0]  material ShipBlackedSpar }
        object ShipPole(9.8, 0.12)   { translate [0.36, 11.2, 0]  material ShipSpar }
        cube { scale [0.42, 0.1, 0.2]  translate [0.18, 14.6, 0]  material ShipBlackedSpar }

        group {
            // The main boom and the main gaff.
            cylinder { min Y 0  max Y 13.5  scale [0.13, 1, 0.13]  rotate Z 76  translate [-0.25, 1.4, 0]  material ShipSpar }
            cylinder { min Y 0  max Y 7.0  scale [0.10, 1, 0.10]  rotate Z 52  translate [-0.25, 12.0, 0]  material ShipSpar }
            // The mainsail, and the gaff topsail above it, from the topmast's head to the gaff's peak.
            object ShipSail(-0.3, 11.9, 0,  -5.7, 16.2, 0,  -12.9, 4.6, 0,  -0.3, 1.6, 0,  0, 0, 2.8 * belly * side,  ShipCanvasAlongX)
            object ShipSail(0.25, 20.4, 0,  0.25, 20.4, 0,  -5.5, 16.5, 0,  -0.2, 12.4, 0,  0, 0, 1.0 * belly * side,  ShipCanvasAlongX)
            rotate Y trim
        }
    }
}

// -- Rope ---------------------------------------------------------------------------------------------

// Standing rigging is tarred hemp, near black; running rigging is hemp left as it is.
ShipTar = material { pigment [0.07, 0.055, 0.045] }
ShipHemp = material { pigment [0.46, 0.38, 0.27] }

// A rope from one place to another, as fine as it is: a strand, so that a line a pixel wide or less is a
// whole faint line and not a row of dots.
primitive ShipRope(x0, y0, z0, x1, y1, z1, wide) -> strand {
    return strand {
        width wide at [x0, y0, z0]
        width wide at [x1, y1, z1]
        material ShipTar
    }
}

primitive ShipLine(x0, y0, z0, x1, y1, z1, wide) -> strand {
    return strand {
        width wide at [x0, y0, z0]
        width wide at [x1, y1, z1]
        material ShipHemp
    }
}

// One ratline at height `h` across three shrouds, which run from their deadeyes at (ax, ay), (bx, by) and
// (cx, cy), `zb` out from the centerline, up to the masthead at (tx, ty, tz).
primitive ShipRatline(tx, ty, tz, ax, ay, bx, by, cx, cy, zb, h) -> strand {
    ta = (h - ay) / (ty - ay)
    tb = (h - by) / (ty - by)
    tc = (h - cy) / (ty - cy)
    return strand {
        width 0.02 at [ax + ta * (tx - ax), h, zb + ta * (tz - zb)]
        width 0.02 at [bx + tb * (tx - bx), h, zb + tb * (tz - zb)]
        width 0.02 at [cx + tc * (tx - cx), h, zb + tc * (tz - zb)]
        material ShipTar
    }
}

// Three shrouds on one side of a mast, and the ratlines across them every 38 cm, from just over the rail
// to a meter and a half under the masthead.
primitive ShipShrouds(tx, ty, ax, ay, bx, by, cx, cy, zb) -> group {
    tz = zb > 0 ? 0.2 : -0.2
    count = floor((ty - 1.6 - ay - 0.55) / 0.38)
    return group {
        object ShipRope(tx, ty, tz, ax, ay, zb, 0.045)
        object ShipRope(tx, ty, tz, bx, by, zb, 0.045)
        object ShipRope(tx, ty, tz, cx, cy, zb, 0.045)
        for k in [0, count] {
            object ShipRatline(tx, ty, tz, ax, ay, bx, by, cx, cy, zb, ay + 0.55 + k * 0.38)
        }
    }
}

// -- The Enterprise, rigged -------------------------------------------------------------------------

// Where a place on either mast, written in that mast's own frame, stands in hers.
function EntForeX(lx, ly) -> number { return 6.5 + lx * 0.98163 - ly * 0.19081 }
function EntForeY(lx, ly) -> number { return 1.4995 + lx * 0.19081 + ly * 0.98163 }
function EntMainX(lx, ly) -> number { return -2.7 + lx * 0.97815 - ly * 0.20791 }
function EntMainY(lx, ly) -> number { return 1.2914 + lx * 0.20791 + ly * 0.97815 }

// Her standing rigging.  The bowsprit runs from her stem head at (13.0, 3.15) at 17 degrees: a place `s`
// along it is (13.0 + 0.9563 s, 3.15 + 0.2924 s).
primitive EntStandingRigging() -> group {
    return group {
        // The fore shrouds and the main shrouds, both sides, to their channels.
        object ShipShrouds(4.02, 14.26,  4.3, 2.205,  3.6, 2.181,  2.9, 2.16,  3.70)
        object ShipShrouds(4.02, 14.26,  4.3, 2.205,  3.6, 2.181,  2.9, 2.16,  -3.70)
        object ShipShrouds(-5.32, 13.62,  -5.6, 2.128,  -6.3, 2.144,  -7.0, 2.163,  3.62)
        object ShipShrouds(-5.32, 13.62,  -5.6, 2.128,  -6.3, 2.144,  -7.0, 2.163,  -3.62)

        // The fore topmast's and main topmast's shrouds to the crosstrees' ends, and their backstays to the rail.
        object ShipRope(EntForeX(0.36, 19.4), EntForeY(0.36, 19.4), 0.1,  EntForeX(0.12, 13.2), EntForeY(0.12, 13.2), 1.25,  0.03)
        object ShipRope(EntForeX(0.36, 19.4), EntForeY(0.36, 19.4), -0.1,  EntForeX(0.12, 13.2), EntForeY(0.12, 13.2), -1.25,  0.03)
        object ShipRope(EntMainX(0.36, 19.4), EntMainY(0.36, 19.4), 0.1,  EntMainX(0.12, 12.8), EntMainY(0.12, 12.8), 1.3,  0.03)
        object ShipRope(EntMainX(0.36, 19.4), EntMainY(0.36, 19.4), -0.1,  EntMainX(0.12, 12.8), EntMainY(0.12, 12.8), -1.3,  0.03)
        object ShipRope(EntForeX(0.36, 19.6), EntForeY(0.36, 19.6), 0.1,  1.9, 2.15, 3.55,  0.035)
        object ShipRope(EntForeX(0.36, 19.6), EntForeY(0.36, 19.6), -0.1,  1.9, 2.15, -3.55,  0.035)
        object ShipRope(EntMainX(0.36, 20.2), EntMainY(0.36, 20.2), 0.1,  -8.1, 2.19, 3.45,  0.035)
        object ShipRope(EntMainX(0.36, 20.2), EntMainY(0.36, 20.2), -0.1,  -8.1, 2.19, -3.45,  0.035)

        // The stays: the forestay to the bowsprit's heel outboard, the fore topmast stay to its cap, the flying
        // jib stay to the jib boom's end, and the main's two stays forward to the foremast.
        object ShipRope(EntForeX(0.15, 13.05), EntForeY(0.15, 13.05), 0,  13.55, 3.52, 0,  0.055)
        object ShipRope(EntForeX(0.46, 19.2), EntForeY(0.46, 19.2), 0,  18.90, 5.10, 0,  0.04)
        object ShipRope(EntForeX(0.46, 21.1), EntForeY(0.46, 21.1), 0,  23.45, 6.59, 0,  0.03)
        object ShipRope(EntMainX(0.15, 12.7), EntMainY(0.15, 12.7), 0,  EntForeX(-0.15, 13.1), EntForeY(-0.15, 13.1), 0,  0.045)
        object ShipRope(EntMainX(0.46, 19.8), EntMainY(0.46, 19.8), 0,  EntForeX(0.36, 15.0), EntForeY(0.36, 15.0), 0,  0.03)

        // The bobstay from the bowsprit's cap down to her stem, and the bowsprit's shrouds to her bows.
        object ShipRope(19.0, 4.85, 0,  12.15, 0.45, 0,  0.05)
        object ShipRope(18.0, 4.65, 0,  11.6, 1.9, 1.15,  0.04)
        object ShipRope(18.0, 4.65, 0,  11.6, 1.9, -1.15,  0.04)
    }
}

// The headsails, on their stays: the fore staysail, the jib and the flying jib, each hoisted about three
// quarters of the way up its stay, sheeted aft toward the foremast on the lee side and bellied out to it.
primitive EntHeadsails(trim, belly) -> group {
    side = trim >= 0 ? 1 : -1
    lee = min(1, abs(trim) / 25)
    return group {
        object ShipSail(6.79, 11.31, 0,  6.79, 11.31, 0,  8.0, 3.5, side * 1.0 * lee,  13.4, 3.62, 0,
                        0, 0, side * 0.8 * belly,  ShipCanvasAlongX)
        object ShipSail(7.97, 15.83, 0,  7.97, 15.83, 0,  9.8, 4.6, side * 1.8 * lee,  18.6, 5.18, 0,
                        0, 0, side * 1.0 * belly,  ShipCanvasAlongX)
        object ShipSail(9.49, 17.27, 0,  9.49, 17.27, 0,  13.2, 6.2, side * 2.0 * lee,  23.2, 6.66, 0,
                        0, 0, side * 0.8 * belly,  ShipCanvasAlongX)
    }
}


// Where a place on either mast's swung spars, written in that mast's own frame before it is swung `t`
// degrees about the mast, stands in hers.
function EntForeTX(lx, ly, lz, t) -> number { return 6.5 + (lx * cos(t * 0.0174533) + lz * sin(t * 0.0174533)) * 0.98163 - ly * 0.19081 }
function EntForeTY(lx, ly, lz, t) -> number { return 1.4995 + (lx * cos(t * 0.0174533) + lz * sin(t * 0.0174533)) * 0.19081 + ly * 0.98163 }
function EntMainTX(lx, ly, lz, t) -> number { return -2.7 + (lx * cos(t * 0.0174533) + lz * sin(t * 0.0174533)) * 0.97815 - ly * 0.20791 }
function EntMainTY(lx, ly, lz, t) -> number { return 1.2914 + (lx * cos(t * 0.0174533) + lz * sin(t * 0.0174533)) * 0.20791 + ly * 0.97815 }
function EntTZ(lx, lz, t) -> number { return lz * cos(t * 0.0174533) - lx * sin(t * 0.0174533) }

// Her running rigging, as much of it as reads from off the ship: the sheets, the main boom's topping lift,
// and the braces of both yards led aft to the mainmast.
primitive EntRunningRigging(trim) -> group {
    side = trim >= 0 ? 1 : -1
    lee = min(1, abs(trim) / 25)
    f = trim * 0.7
    y = 0 - trim * 0.8
    return group {
        object ShipLine(EntMainTX(-12.7, 4.45, 0, trim), EntMainTY(-12.7, 4.45, 0, trim), EntTZ(-12.7, 0, trim),  -12.3, 2.72, side * 0.9,  0.035)
        object ShipLine(EntMainX(0.1, 14.4), EntMainY(0.1, 14.4), 0,  EntMainTX(-13.1, 4.62, 0, trim), EntMainTY(-13.1, 4.62, 0, trim), EntTZ(-13.1, 0, trim),  0.025)
        object ShipLine(EntForeTX(-7.4, 2.6, 0, f), EntForeTY(-7.4, 2.6, 0, f), EntTZ(-7.4, 0, f),  -0.6, 2.38, side * 2.9,  0.03)
        object ShipLine(8.0, 3.5, side * 1.0 * lee,  7.2, 2.45, side * 2.85,  0.025)
        object ShipLine(9.8, 4.6, side * 1.8 * lee,  5.6, 2.42, side * 3.1,  0.025)
        object ShipLine(13.2, 6.2, side * 2.0 * lee,  8.2, 2.5, side * 2.6,  0.025)
        object ShipLine(EntForeTX(0.42, 13.0, 6.0, y), EntForeTY(0.42, 13.0, 6.0, y), EntTZ(0.42, 6.0, y),  EntMainX(0, 10.8), EntMainY(0, 10.8), 0.3,  0.025)
        object ShipLine(EntForeTX(0.42, 13.0, -6.0, y), EntForeTY(0.42, 13.0, -6.0, y), EntTZ(0.42, -6.0, y),  EntMainX(0, 10.8), EntMainY(0, 10.8), -0.3,  0.025)
        object ShipLine(EntForeTX(0.48, 19.6, 4.5, y), EntForeTY(0.48, 19.6, 4.5, y), EntTZ(0.48, 4.5, y),  EntMainX(0.36, 17.0), EntMainY(0.36, 17.0), 0.15,  0.02)
        object ShipLine(EntForeTX(0.48, 19.6, -4.5, y), EntForeTY(0.48, 19.6, -4.5, y), EntTZ(0.48, -4.5, y),  EntMainX(0.36, 17.0), EntMainY(0.36, 17.0), -0.15,  0.02)
    }
}

// Her colors: the ensign at the main peak and the pennant at the main topmast head, both streaming to
// leeward, a little aft.
primitive EntColors(trim) -> group {
    side = trim >= 0 ? 1 : -1
    return group {
        object Flag(4.0, 2.4, 'wind', 1) {
            material EntEnsign
            rotate Y -113 * side
            translate [EntMainTX(-5.85, 16.4, 0, trim), EntMainTY(-5.85, 16.4, 0, trim) - 2.4, EntTZ(-5.85, 0, trim)]
        }
        object Flag(6.5, 0.36, 'wind', 2) {
            material EntPennant
            rotate Y -105 * side
            translate [EntMainX(0.36, 21.0), EntMainY(0.36, 21.0) - 0.36, 0]
        }
    }
}

primitive SchoonerEnterprise(trim = 25, belly = 1) -> group {
    return group {
        object EntHull()
        object EntForemast(trim, belly)  { rotate Z 11  translate [6.5, EntDeck(6.5), 0] }
        object EntMainmast(trim, belly)  { rotate Z 12  translate [-2.7, EntDeck(-2.7), 0] }

        // The bowsprit, steeved 17 degrees over the stem head, and the jib boom along its top.
        group {
            cylinder { min Y -3.0  max Y 6.5  scale [0.20, 1, 0.20]  material ShipSpar }
            cylinder { min Y 3.5  max Y 11.0  scale [0.10, 1, 0.10]  translate X -0.24  material ShipSpar }
            rotate Z -73
            translate [13.0, 3.15, 0]
        }

        // The channels the shrouds are set up to, outside her rail.
        cube { scale [1.1, 0.05, 0.25]  translate [3.6, 2.13, 3.45]   material EntBlack }
        cube { scale [1.1, 0.05, 0.25]  translate [3.6, 2.13, -3.45]  material EntBlack }
        cube { scale [1.1, 0.05, 0.25]  translate [-6.3, 2.09, 3.37]  material EntBlack }
        cube { scale [1.1, 0.05, 0.25]  translate [-6.3, 2.09, -3.37] material EntBlack }

        object EntStandingRigging()
        object EntHeadsails(trim, belly)
        object EntRunningRigging(trim)
        object EntGuns()
        object EntDeckFittings()
        object EntColors(trim)
        object EntCrew()

        // Her anchors, catted at the bow.
        cube { scale [0.12, 0.12, 0.55]  rotate Y 25  translate [11.15, 2.85, 1.85]  material ShipTimber }
        cube { scale [0.12, 0.12, 0.55]  rotate Y -25  translate [11.15, 2.85, -1.85]  material ShipTimber }
        object ShipAnchor() { rotate Z 12  translate [11.35, 2.75, 2.25] }
        object ShipAnchor() { rotate Z 12  translate [11.35, 2.75, -2.25] }
    }
}

// -- The polacca Tripoli ------------------------------------------------------------------------------
//
// A corsair of fourteen guns and eighty men, met by Enterprise west of Malta on 1 August 1801 and shot to
// pieces in three hours.  No drawing of her survives either: she is built as the Barbary polaccas were drawn,
// about Enterprise's size, with a long beak, a sheer rising to a high stern, and single-pole fore and main
// masts square-rigged to their trucks.  Her mizzen is gone, as the reports have it -- shot through, its mast,
// lateen yard and sail over her starboard side -- and her side is holed along her waterline.

function PolRail(x) -> number { return 2.25 + 0.0055 * (x + 1) * (x + 1) }
function PolDeck(x) -> number { return 1.25 + 0.0055 * (x + 1) * (x + 1) }

// Black topsides with a red band along her ports and a yellow line under it; her bottom paid with white stuff.
PolBlack = material {
    pigment [0.06, 0.045, 0.035]
    specular 0.2  shininess 24
    decal {
        path {
            move to -14.5, 3.1024  quad 0, 0.9492 to 14.5, 3.4214
            line to 14.5, 2.7214  quad 0, 0.2492 to -14.5, 2.4024
            close
        }
        color [0.50, 0.09, 0.06]  planar  min Y -6  max Y 6  fade from 70 to 85  rotate X -90
    }
    decal {
        path {
            move to -14.5, 2.0324  quad 0, -0.1208 to 14.5, 2.3514
            line to 14.5, 2.2714  quad 0, -0.2008 to -14.5, 1.9524
            close
        }
        color [0.74, 0.58, 0.16]  planar  min Y -6  max Y 6  fade from 70 to 85  rotate X -90
    }
    // Enterprise's shot, between wind and water on her larboard side.
    decal {
        path {
            move to -7.773, 0.317  line to -7.774, 0.364  line to -7.803, 0.379  line to -7.840, 0.383  line to -7.889, 0.382  line to -7.918, 0.362  line to -7.925, 0.317  line to -7.922, 0.272  line to -7.874, 0.251  line to -7.840, 0.227  line to -7.800, 0.259  line to -7.783, 0.270  close
            move to 9.076, 0.085  line to 9.060, 0.132  line to 9.032, 0.171  line to 8.993, 0.161  line to 8.955, 0.155  line to 8.922, 0.134  line to 8.911, 0.085  line to 8.924, 0.046  line to 8.938, 0.012  line to 8.993, -0.003  line to 9.035, 0.001  line to 9.082, 0.031  close
            move to 4.134, 0.085  line to 4.094, 0.138  line to 4.083, 0.187  line to 4.023, 0.203  line to 3.978, 0.188  line to 3.945, 0.137  line to 3.915, 0.085  line to 3.924, 0.041  line to 3.964, -0.009  line to 4.023, -0.008  line to 4.073, -0.004  line to 4.115, 0.024  close
            move to -7.131, 0.226  line to -7.137, 0.278  line to -7.182, 0.294  line to -7.224, 0.307  line to -7.266, 0.313  line to -7.304, 0.263  line to -7.301, 0.226  line to -7.295, 0.176  line to -7.276, 0.148  line to -7.224, 0.123  line to -7.175, 0.161  line to -7.155, 0.183  close
            move to -1.717, 0.331  line to -1.736, 0.368  line to -1.751, 0.404  line to -1.787, 0.407  line to -1.827, 0.381  line to -1.842, 0.365  line to -1.867, 0.331  line to -1.850, 0.298  line to -1.828, 0.279  line to -1.787, 0.251  line to -1.753, 0.261  line to -1.724, 0.302  close
            move to -5.212, 0.530  line to -5.217, 0.572  line to -5.248, 0.603  line to -5.289, 0.612  line to -5.326, 0.598  line to -5.355, 0.573  line to -5.355, 0.530  line to -5.344, 0.493  line to -5.328, 0.463  line to -5.289, 0.449  line to -5.257, 0.470  line to -5.218, 0.499  close
            move to 6.942, 0.159  line to 6.917, 0.197  line to 6.900, 0.223  line to 6.862, 0.242  line to 6.821, 0.221  line to 6.802, 0.196  line to 6.803, 0.159  line to 6.788, 0.120  line to 6.820, 0.101  line to 6.862, 0.083  line to 6.902, 0.084  line to 6.928, 0.124  close
            move to 7.860, 0.261  line to 7.852, 0.302  line to 7.816, 0.360  line to 7.773, 0.373  line to 7.724, 0.345  line to 7.699, 0.305  line to 7.671, 0.261  line to 7.690, 0.206  line to 7.716, 0.157  line to 7.773, 0.178  line to 7.831, 0.190  line to 7.849, 0.205  close
            move to -6.906, 0.749  line to -6.928, 0.788  line to -6.941, 0.806  line to -6.983, 0.820  line to -7.021, 0.818  line to -7.048, 0.790  line to -7.054, 0.749  line to -7.047, 0.719  line to -7.015, 0.694  line to -6.983, 0.686  line to -6.953, 0.679  line to -6.923, 0.715  close
            move to 5.431, 0.471  line to 5.421, 0.514  line to 5.399, 0.536  line to 5.360, 0.558  line to 5.321, 0.532  line to 5.292, 0.507  line to 5.268, 0.471  line to 5.287, 0.437  line to 5.313, 0.394  line to 5.360, 0.402  line to 5.397, 0.389  line to 5.427, 0.429  close
            move to 9.937, 1.950  line to 9.912, 1.997  line to 9.886, 2.014  line to 9.849, 2.052  line to 9.811, 2.011  line to 9.788, 1.997  line to 9.765, 1.950  line to 9.780, 1.907  line to 9.797, 1.864  line to 9.849, 1.874  line to 9.888, 1.884  line to 9.914, 1.907  close
            move to -5.968, 2.359  line to -5.974, 2.405  line to -6.019, 2.449  line to -6.065, 2.466  line to -6.105, 2.433  line to -6.146, 2.407  line to -6.157, 2.359  line to -6.134, 2.320  line to -6.115, 2.294  line to -6.065, 2.271  line to -6.018, 2.278  line to -5.976, 2.320  close
            move to 4.578, 2.165  line to 4.577, 2.223  line to 4.541, 2.269  line to 4.483, 2.265  line to 4.438, 2.250  line to 4.406, 2.220  line to 4.366, 2.165  line to 4.398, 2.117  line to 4.424, 2.085  line to 4.483, 2.038  line to 4.548, 2.058  line to 4.588, 2.108  close
            move to 4.515, 2.202  line to 4.514, 2.237  line to 4.483, 2.263  line to 4.446, 2.283  line to 4.404, 2.263  line to 4.384, 2.247  line to 4.371, 2.202  line to 4.376, 2.158  line to 4.407, 2.141  line to 4.446, 2.110  line to 4.484, 2.137  line to 4.520, 2.160  close
        }
        color [0.015, 0.012, 0.01]  planar  min Y -6  max Y 0  fade from 70 to 85  rotate X -90
    }
}

PolStuff = material { pigment [0.46, 0.44, 0.38]  specular 0.08  shininess 10 }

// Her planking, as Enterprise's: strakes running with her steeper sheer and closing in toward her ends,
// carried by a copy of her stuff, the blend's first material.
PolHullStuff = material PolStuff {
    normal planks {
        plank size [6.5, 0.21, 1000]  seam size 0.04
        warp { Y { (y - PolRail(x)) / (1 - 0.25 * (x / 13.5) * (x / 13.5)) + 0.105 } }
        depth 0.05  rotate Y -90
    }
}

PolHullPaint = material blend linear Y gradient {
    [0, PolHullStuff, 0.4995, PolHullStuff, 0.5005, PolBlack]
    scale [1, 20, 1]
    translate Y -9.8
}

PolTimberBlack = material { pigment [0.06, 0.045, 0.035]  specular 0.2  shininess 24 }

PolProfilePaint = material blend linear Z gradient {
    [0, PolStuff, 0.4995, PolStuff, 0.5005, PolTimberBlack]
    scale [1, 1, 20]
    translate Z -9.8
}

// Her deck as Enterprise's, her bulwarks' strakes running with her own deck.
PolBulwarkRed = material EntRed {
    normal planks {
        plank size [6.5, 0.2, 1000]  seam size 0.03
        warp { Y { y - PolDeck(x) } }
        depth 0.06  rotate Y -90
    }
}

PolDeckAndBulwarks = material blend facing { [0.74, PolBulwarkRed, 0.80, EntDeckPlanking] }

// The sides and front of her poop, planked as her own sides are, read in its own unit cube.
PolPoopSides = material PolBlack {
    normal planks { plank size [5, 0.2, 1000]  seam size 0.03  depth 0.06  scale [0.41667, 1.17647, 0.36364] }
}

// The top of her poop, a slab 4.8 m by 5.6 m read in its own unit cube: the boards made back into meters.
PolPoopDeck = material {
    pigment planks {
        plank size [5, 1000, 0.14]  seam size 0.016
        [0, [0.10, 0.08, 0.06], 0.5, [0.63, 0.55, 0.42], 1, [0.54, 0.46, 0.34]]
        scale [0.41667, 25, 0.35714]
    }
    specular 0.08  shininess 12
}

PolBackbone = path {
    move to -10.65, -3.0
    line to 10.5, -2.4
    curve 12.3, -2.38, 13.6, -0.6 to 13.95, 3.45
    line to 13.6, 3.45
    curve 13.3, 0.4, 12.0, -2.05 to 10.5, -2.1
    line to -10.3, -2.7
    line to -12.0, 1.1
    line to -12.4, 1.05
    close
}

// Her beak, a long pointed knee carried far forward of her stem.
PolBeak = path {
    move to 13.3, 0.4
    curve 14.4, 1.0, 15.9, 2.1 to 16.9, 2.75
    line to 16.5, 2.98
    curve 15.4, 3.2, 14.6, 3.35 to 13.9, 3.4
    curve 13.75, 2.4, 13.6, 1.4 to 13.3, 0.4
}

PolRudder = path {
    move to -10.65, -2.95  line to -12.4, 1.05  line to -12.85, 1.1  line to -11.5, -2.95  close
}

primitive PolHull() -> group {
    return group {
        difference {
            intersection {
                loft {
                    section { path EntCounter   scale [2.60, PolRail(-13.8) - 1.6, 1]   translate [0, 1.6, -13.8] }
                    section { path EntCounter   scale [2.90, PolRail(-12.9) - 1.0, 1]   translate [0, 1.0, -12.9] }
                    section { path EntRun       scale [3.10, PolRail(-12.0) - 0.55, 1]  translate [0, 0.55, -12.0] }
                    section { path EntRun       scale [3.30, PolRail(-11.0) + 1.82, 1]  translate [0, -1.82, -11.0] }
                    section { path EntRun       scale [3.50, PolRail(-9.5) + 2.67, 1]   translate [0, -2.67, -9.5] }
                    section { path EntMid       scale [3.72, PolRail(-6.0) + 2.57, 1]   translate [0, -2.57, -6.0] }
                    section { path EntMid       scale [3.80, PolRail(-2.0) + 2.456, 1]  translate [0, -2.456, -2.0] }
                    section { path EntMid       scale [3.80, PolRail(2.0) + 2.34, 1]    translate [0, -2.34, 2.0] }
                    section { path EntEntrance  scale [3.60, PolRail(5.5) + 2.24, 1]    translate [0, -2.24, 5.5] }
                    section { path EntEntrance  scale [3.10, PolRail(8.5) + 2.157, 1]   translate [0, -2.157, 8.5] }
                    section { path EntBow       scale [2.40, PolRail(10.6) + 2.05, 1]   translate [0, -2.05, 10.6] }
                    section { path EntBow       scale [1.70, PolRail(11.9) + 1.45, 1]   translate [0, -1.45, 11.9] }
                    section { path EntBow       scale [1.00, PolRail(12.9) + 0.2, 1]    translate [0, -0.2, 12.9] }
                    section { path EntBow       scale [0.50, PolRail(13.5) - 1.3, 1]    translate [0, 1.3, 13.5] }
                    section { path EntBow       scale [0.12, PolRail(13.75) - 2.9, 1]   translate [0, 2.9, 13.75] }
                    rotate Y 90
                }
                cube { scale 50  translate X 50  rotate Z 27  translate [-12.2, 1.0, 0]  material PolTimberBlack }
            }
            loft {
                section { path EntWell  scale [2.55, 2.5, 1]  translate [0, PolDeck(-12.6), -12.6] }
                section { path EntWell  scale [2.95, 2.5, 1]  translate [0, PolDeck(-11.0), -11.0] }
                section { path EntWell  scale [3.30, 2.5, 1]  translate [0, PolDeck(-8.0), -8.0] }
                section { path EntWell  scale [3.50, 2.5, 1]  translate [0, PolDeck(-4.0), -4.0] }
                section { path EntWell  scale [3.53, 2.5, 1]  translate [0, PolDeck(0.0), 0.0] }
                section { path EntWell  scale [3.42, 2.5, 1]  translate [0, PolDeck(4.0), 4.0] }
                section { path EntWell  scale [3.10, 2.5, 1]  translate [0, PolDeck(6.5), 6.5] }
                section { path EntWell  scale [2.75, 2.5, 1]  translate [0, PolDeck(8.5), 8.5] }
                section { path EntWell  scale [2.15, 2.5, 1]  translate [0, PolDeck(10.6), 10.6] }
                section { path EntWell  scale [1.45, 2.5, 1]  translate [0, PolDeck(11.9), 11.9] }
                section { path EntWell  scale [0.6, 2.5, 1]   translate [0, PolDeck(12.9), 12.9] }
                rotate Y 90
                material PolDeckAndBulwarks
            }
            cube { scale [0.3, 0.24, 5]  translate [10.4, PolDeck(10.4) + 0.56, 0]  material EntRed }
            cube { scale [0.3, 0.24, 5]  translate [4.8, PolDeck(4.8) + 0.56, 0]   material EntRed }
            cube { scale [0.3, 0.24, 5]  translate [2.0, PolDeck(2.0) + 0.56, 0]   material EntRed }
            cube { scale [0.3, 0.24, 5]  translate [-2.2, PolDeck(-2.2) + 0.56, 0] material EntRed }
            cube { scale [0.3, 0.24, 5]  translate [-4.5, PolDeck(-4.5) + 0.56, 0] material EntRed }
            cube { scale [0.3, 0.24, 5]  translate [-7.5, PolDeck(-7.5) + 0.56, 0] material EntRed }
            cube { scale [0.3, 0.24, 5]  translate [-11.0, PolDeck(-11.0) + 0.56, 0] material EntRed }
        }
        extrusion { path PolBackbone  min Y -0.16  max Y 0.16  rotate X -90  material PolProfilePaint }
        extrusion { path PolRudder  min Y -0.12  max Y 0.12  rotate X -90  material PolProfilePaint }
        extrusion { path PolBeak  min Y -0.16  max Y 0.16  rotate X -90  material PolProfilePaint }
        material PolHullPaint
    }
}

// Her guns, run out on both sides; her larboard battery is the one fighting.
primitive PolGuns() -> group {
    return group {
        object ShipGun() { translate [10.4, PolDeck(10.4) + 0.55, 2.70] }
        object ShipGun() { translate [4.8, PolDeck(4.8) + 0.55, 3.77] }
        object ShipGun() { translate [2.0, PolDeck(2.0) + 0.55, 3.91] }
        object ShipGun() { translate [-2.2, PolDeck(-2.2) + 0.55, 3.91] }
        object ShipGun() { translate [-4.5, PolDeck(-4.5) + 0.55, 3.87] }
        object ShipGun() { translate [-7.5, PolDeck(-7.5) + 0.55, 3.70] }
        object ShipGun() { translate [-11.0, PolDeck(-11.0) + 0.55, 3.38] }
        object ShipGun() { rotate Y 180  translate [10.4, PolDeck(10.4) + 0.55, -2.70] }
        object ShipGun() { rotate Y 180  translate [4.8, PolDeck(4.8) + 0.55, -3.77] }
        object ShipGun() { rotate Y 180  translate [2.0, PolDeck(2.0) + 0.55, -3.91] }
        object ShipGun() { rotate Y 180  translate [-2.2, PolDeck(-2.2) + 0.55, -3.91] }
        object ShipGun() { rotate Y 180  translate [-4.5, PolDeck(-4.5) + 0.55, -3.87] }
        object ShipGun() { rotate Y 180  translate [-7.5, PolDeck(-7.5) + 0.55, -3.70] }
        object ShipGun() { rotate Y 180  translate [-11.0, PolDeck(-11.0) + 0.55, -3.38] }
    }
}

// The flag of Tripoli under the Karamanli: green, with three white crescents.
PolFlag = material {
    pigment [0.08, 0.36, 0.14]
    specular 0.04  shininess 8  ambient 0.12
    decal {
        path {
            move to 1.1659, 1.6427  line to 1.1129, 1.6784  line to 1.0542, 1.7036  line to 0.9918, 1.7174  line to 0.9279, 1.7193  line to 0.8648, 1.7092  line to 0.8048, 1.6874  line to 0.7498, 1.6548  line to 0.7019, 1.6125  line to 0.6628, 1.5620  line to 0.6338, 1.5050  line to 0.6160, 1.4436  line to 0.6100, 1.3800  line to 0.6160, 1.3164  line to 0.6338, 1.2550  line to 0.6628, 1.1980  line to 0.7019, 1.1475  line to 0.7498, 1.1052  line to 0.8048, 1.0726  line to 0.8648, 1.0508  line to 0.9279, 1.0407  line to 0.9918, 1.0426  line to 1.0542, 1.0564  line to 1.1129, 1.0816  line to 1.1659, 1.1173  line to 1.1230, 1.1058  line to 1.0789, 1.1013  line to 1.0345, 1.1038  line to 0.9912, 1.1133  line to 0.9499, 1.1296  line to 0.9117, 1.1522  line to 0.8776, 1.1806  line to 0.8484, 1.2140  line to 0.8249, 1.2517  line to 0.8076, 1.2926  line to 0.7971, 1.3357  line to 0.7936, 1.3800  line to 0.7971, 1.4243  line to 0.8076, 1.4674  line to 0.8249, 1.5083  line to 0.8484, 1.5460  line to 0.8776, 1.5794  line to 0.9117, 1.6078  line to 0.9499, 1.6304  line to 0.9912, 1.6467  line to 1.0345, 1.6562  line to 1.0789, 1.6587  line to 1.1230, 1.6542  close
            move to 1.8341, 1.1173  line to 1.8871, 1.0816  line to 1.9458, 1.0564  line to 2.0082, 1.0426  line to 2.0721, 1.0407  line to 2.1352, 1.0508  line to 2.1952, 1.0726  line to 2.2502, 1.1052  line to 2.2981, 1.1475  line to 2.3372, 1.1980  line to 2.3662, 1.2550  line to 2.3840, 1.3164  line to 2.3900, 1.3800  line to 2.3840, 1.4436  line to 2.3662, 1.5050  line to 2.3372, 1.5620  line to 2.2981, 1.6125  line to 2.2502, 1.6548  line to 2.1952, 1.6874  line to 2.1352, 1.7092  line to 2.0721, 1.7193  line to 2.0082, 1.7174  line to 1.9458, 1.7036  line to 1.8871, 1.6784  line to 1.8341, 1.6427  line to 1.8770, 1.6542  line to 1.9211, 1.6587  line to 1.9655, 1.6562  line to 2.0088, 1.6467  line to 2.0501, 1.6304  line to 2.0883, 1.6078  line to 2.1224, 1.5794  line to 2.1516, 1.5460  line to 2.1751, 1.5083  line to 2.1924, 1.4674  line to 2.2029, 1.4243  line to 2.2064, 1.3800  line to 2.2029, 1.3357  line to 2.1924, 1.2926  line to 2.1751, 1.2517  line to 2.1516, 1.2140  line to 2.1224, 1.1806  line to 2.0883, 1.1522  line to 2.0501, 1.1296  line to 2.0088, 1.1133  line to 1.9655, 1.1038  line to 1.9211, 1.1013  line to 1.8770, 1.1058  close
            move to 1.2373, 0.8359  line to 1.2016, 0.7829  line to 1.1764, 0.7242  line to 1.1626, 0.6618  line to 1.1607, 0.5979  line to 1.1708, 0.5348  line to 1.1926, 0.4748  line to 1.2252, 0.4198  line to 1.2675, 0.3719  line to 1.3180, 0.3328  line to 1.3750, 0.3038  line to 1.4364, 0.2860  line to 1.5000, 0.2800  line to 1.5636, 0.2860  line to 1.6250, 0.3038  line to 1.6820, 0.3328  line to 1.7325, 0.3719  line to 1.7748, 0.4198  line to 1.8074, 0.4748  line to 1.8292, 0.5348  line to 1.8393, 0.5979  line to 1.8374, 0.6618  line to 1.8236, 0.7242  line to 1.7984, 0.7829  line to 1.7627, 0.8359  line to 1.7742, 0.7930  line to 1.7787, 0.7489  line to 1.7762, 0.7045  line to 1.7667, 0.6612  line to 1.7504, 0.6199  line to 1.7278, 0.5817  line to 1.6994, 0.5476  line to 1.6660, 0.5184  line to 1.6283, 0.4949  line to 1.5874, 0.4776  line to 1.5443, 0.4671  line to 1.5000, 0.4636  line to 1.4557, 0.4671  line to 1.4126, 0.4776  line to 1.3717, 0.4949  line to 1.3340, 0.5184  line to 1.3006, 0.5476  line to 1.2722, 0.5817  line to 1.2496, 0.6199  line to 1.2333, 0.6612  line to 1.2238, 0.7045  line to 1.2213, 0.7489  line to 1.2258, 0.7930  close
        }
