// A corsair of her crew: loose white clothes and a red cap, standing on y = 0 facing +X, bent `lean`
// degrees toward his work; a musket at his shoulder or a sword raised by `arms` (1 or 2).
PolShirt = material { pigment [0.80, 0.77, 0.70]  specular 0.04  shininess 8 }
PolSash = material { pigment [0.55, 0.12, 0.10]  specular 0.04  shininess 8 }
PolCap = material { pigment [0.62, 0.10, 0.08]  specular 0.08  shininess 12 }

primitive ShipCorsair(lean = 0, arms = 1) -> group {
    return group {
        cylinder { min Y 0  max Y 0.86  scale [0.09, 1, 0.09]  translate Z 0.1   material PolShirt }
        cylinder { min Y 0  max Y 0.86  scale [0.09, 1, 0.09]  translate Z -0.1  material PolShirt }
        group {
            superellipsoid { east 0.6  north 0.8  scale [0.14, 0.33, 0.22]  translate Y 0.3  material PolShirt }
            cylinder { min Y -0.06  max Y 0.06  scale [0.16, 1, 0.23]  translate Y 0.05  material PolSash }
            cylinder { min Y -0.55  max Y 0  scale [0.055, 1, 0.055]  rotate X -12  translate [0, 0.56, 0.25]  material PolShirt }
            cylinder { min Y -0.55  max Y 0  scale [0.055, 1, 0.055]  rotate X (arms == 2 ? 150 : 12)  translate [0, 0.56, -0.25]  material PolShirt }
            sphere { scale [0.10, 0.12, 0.10]  translate Y 0.75  material ShipSkin }
            cylinder { min Y 0  max Y 0.16  scale [0.095, 1, 0.095]  translate Y 0.8  material PolCap }
            cylinder { min Y 0  max Y 1.4  scale [0.014, 1, 0.014]  rotate Z -84  translate [-0.35, 0.55, -0.12]  material ShipTimber }
            rotate Z 0 - lean
            translate Y 0.86
        }
    }
}

// Where a place on either of her masts, written in that mast's own frame, stands in hers: the foremast
// stepped at 8 m and raked four degrees forward, the mainmast at -0.5 m and raked two aft.
function PolForeX(lx, ly) -> number { return 8.0 + lx * 0.99756 + ly * 0.06976 }
function PolForeY(lx, ly) -> number { return 1.6955 - lx * 0.06976 + ly * 0.99756 }
function PolMainX(lx, ly) -> number { return -0.5 + lx * 0.99939 - ly * 0.03490 }
function PolMainY(lx, ly) -> number { return 1.2514 + lx * 0.03490 + ly * 0.99939 }

// A pole mast, one spar from the deck to its truck, square-rigged: a course, a topsail and a topgallant,
// their yards braced by the trim.  `course` 0 has the course furled on its yard.
primitive PolPoleMast(high, cy, cl, ty, tl, gy, gl, course, trim, belly) -> group {
    return group {
        cylinder { min Y -0.5  max Y high  scale [0.21, 1, 0.21]  material ShipSpar }
        cylinder { min Y high - 3  max Y high + 0.4  scale [0.13, 1, 0.13]  material ShipBlackedSpar }
        group {
            object ShipYard(cl, 0.13)  { translate [0.32, cy, 0]  material ShipSpar }
            object ShipYard(tl, 0.10)  { translate [0.30, ty, 0]  material ShipSpar }
            object ShipYard(gl, 0.07)  { translate [0.28, gy, 0]  material ShipSpar }
            object ShipSail(0.30, ty - 0.12, 0.47 * tl,  0.30, ty - 0.12, -0.47 * tl,  0.32, cy + 0.15, -0.47 * cl,  0.32, cy + 0.15, 0.47 * cl,
                            1.5 * belly, 0, 0,  ShipCanvasAlongZ)
            object ShipSail(0.28, gy - 0.1, 0.47 * gl,  0.28, gy - 0.1, -0.47 * gl,  0.30, ty + 0.12, -0.47 * tl,  0.30, ty + 0.12, 0.47 * tl,
                            0.9 * belly, 0, 0,  ShipCanvasAlongZ)
            object ShipSail(0.32, cy - 0.15, 0.47 * cl,  0.32, cy - 0.15, -0.47 * cl,  0.6 + 0.8 * belly, 3.6 + (1 - course) * (cy - 4.2), -0.5 * cl,  0.6 + 0.8 * belly, 3.6 + (1 - course) * (cy - 4.2), 0.5 * cl,
                            (1.7 * course + 0.05) * belly, 0, 0,  ShipCanvasAlongZ)
            rotate Y 0 - trim * 0.8
        }
    }
}

primitive PolaccaTripoli(trim = -25, belly = 1) -> group {
    side = trim >= 0 ? 1 : -1
    return group {
        object PolHull()
        object PolGuns()

        // Her poop, raised over the after third of her deck, with a rail along it.
        cube { scale [2.4, 0.85, 2.75]  translate [-10.9, PolDeck(-10.9) + 0.85, 0]  material PolPoopSides }
        cube { scale [2.4, 0.04, 2.8]   translate [-10.9, PolDeck(-10.9) + 1.72, 0]  material PolPoopDeck }

        // Her fore and main, poles to their trucks.
        object PolPoleMast(21.0, 10.5, 13.0, 15.5, 9.6, 19.4, 6.4, 1, trim, belly)  { rotate Z -4  translate [8.0, PolDeck(8.0), 0] }
        object PolPoleMast(24.5, 11.5, 14.5, 17.5, 10.8, 21.8, 7.2, 0, trim, belly)  { rotate Z 2  translate [-0.5, PolDeck(-0.5), 0] }

        // Her bowsprit, steeved 22 degrees off the beak's root, and a jib to the foremast.
        cylinder { min Y -2.0  max Y 8.5  scale [0.2, 1, 0.2]  rotate Z -68  translate [13.8, 3.5, 0]  material ShipSpar }
        object ShipSail(PolForeX(0.2, 17.0), PolForeY(0.2, 17.0), 0,  PolForeX(0.2, 17.0), PolForeY(0.2, 17.0), 0,
                        11.2, 4.2, side * 1.6,  20.8, 6.4, 0,  0, 0, side * 0.9 * belly,  ShipCanvasAlongX)

        // The stump of her mizzen, splintered three meters up, and the mast over her starboard side with its
        // lateen yard and the sail, half in the sea.
        cylinder { min Y 0  max Y 2.5  scale [0.19, 1, 0.19]  translate [-9.0, PolDeck(-9.0), 0]  material ShipSpar }
        conic { min Y -0.6  max Y 0  scale [0.19, 0.9, 0.19]  rotate X 180  rotate Z 14  translate [-9.0, PolDeck(-9.0) + 2.5, 0.02]  material ShipSpar }
        group {
            cylinder { min Y 0  max Y 15  scale [0.17, 1, 0.17]  rotate X -104  rotate Y 8  translate [-9.4, PolDeck(-9.4) + 2.4, -0.3]  material ShipSpar }
            cylinder { min Y -8  max Y 9  scale [0.11, 1, 0.11]  rotate Z 70  rotate X 12  translate [-9.6, 0.15, -7.5]  material ShipSpar }
            object ShipSail(-1.2, 0.5, -6.0,  -1.2, 0.5, -6.0,  -14.0, 0.05, -10.0,  -4.0, 0.3, -12.5,  0, 0.4, 0,  ShipCanvasAlongX)
        }

        // Her standing rigging, fore and main.
        object ShipShrouds(8.70, 11.67,  8.9, 2.52,  8.2, 2.52,  7.5, 2.50,  3.45)
        object ShipShrouds(8.70, 11.67,  8.9, 2.52,  8.2, 2.52,  7.5, 2.50,  -3.45)
        object ShipShrouds(-0.884, 12.24,  -0.9, 2.05,  -1.6, 2.05,  -2.3, 2.06,  4.0)
        object ShipShrouds(-0.884, 12.24,  -0.9, 2.05,  -1.6, 2.05,  -2.3, 2.06,  -4.0)
        object ShipRope(PolForeX(0.2, 20.5), PolForeY(0.2, 20.5), 0,  21.5, 6.65, 0,  0.04)
        object ShipRope(PolForeX(0.2, 16.0), PolForeY(0.2, 16.0), 0,  16.4, 3.05, 0,  0.05)
        object ShipRope(PolMainX(0.2, 23.5), PolMainY(0.2, 23.5), 0,  PolForeX(0, 16.0), PolForeY(0, 16.0), 0,  0.04)
        object ShipRope(PolMainX(0.2, 13.0), PolMainY(0.2, 13.0), 0,  PolForeX(0, 4.0), PolForeY(0, 4.0), 0,  0.05)
        object ShipRope(PolMainX(0, 23.0), PolMainY(0, 23.0), 0.1,  -4.5, 2.25, 3.9,  0.035)
        object ShipRope(PolMainX(0, 23.0), PolMainY(0, 23.0), -0.1,  -4.5, 2.25, -3.9,  0.035)
        object ShipRope(PolForeX(0, 20.0), PolForeY(0, 20.0), 0.1,  5.2, 2.5, 3.8,  0.035)
        object ShipRope(PolForeX(0, 20.0), PolForeY(0, 20.0), -0.1,  5.2, 2.5, -3.8,  0.035)

        // Her colors at the main truck, streaming to leeward.
        object Flag(3.0, 2.0, 'wind', 3) {
            material PolFlag
            rotate Y -110 * side
            translate [PolMainX(0, 24.6), PolMainY(0, 24.6) - 2.0, 0]
        }

        // Her people, crowding her larboard side to board, muskets and swords up, and at her guns.
        object ShipCorsair(10, 1) { rotate Y -90  translate [3.4, PolDeck(3.4), 2.6] }
        object ShipCorsair(5, 2)  { rotate Y -95  translate [2.6, PolDeck(2.6), 2.9] }
        object ShipCorsair(12, 1) { rotate Y -85  translate [1.4, PolDeck(1.4), 2.7] }
        object ShipCorsair(0, 2)  { rotate Y -90  translate [0.6, PolDeck(0.6), 3.0] }
        object ShipCorsair(8, 1)  { rotate Y -100  translate [-0.9, PolDeck(-0.9), 2.5] }
        object ShipCorsair(4, 2)  { rotate Y -80  translate [-1.6, PolDeck(-1.6), 2.9] }
        object ShipCorsair(10, 1) { rotate Y -90  translate [-3.2, PolDeck(-3.2), 2.8] }
        object ShipCorsair(6, 2)  { rotate Y -90  translate [-5.8, PolDeck(-5.8), 2.9] }
        object ShipCorsair(14, 1) { rotate Y -95  translate [-6.6, PolDeck(-6.6), 2.6] }
        object ShipCorsair(2, 2)  { rotate Y -88  translate [-8.6, PolDeck(-8.6), 2.4] }
        object ShipCorsair(25, 1) { rotate Y -90  translate [5.6, PolDeck(5.6), 1.8] }
        object ShipCorsair(25, 1) { rotate Y -90  translate [-10.0, PolDeck(-10.0), 1.6] }
        object ShipCorsair(0, 1)  { rotate Y 180  translate [-11.6, PolDeck(-11.6), 0.2] }
        object ShipCorsair(9, 2)  { rotate Y -90  translate [1.9, PolDeck(1.9), 1.5] }
        object ShipCorsair(9, 1)  { rotate Y -90  translate [-2.6, PolDeck(-2.6), 1.6] }
    }
}

// -- Powder smoke -------------------------------------------------------------------------------------

// Smoke at a place in a bank `long` along a ship's side, `reach` downwind of her guns and `high`: thick at the
// muzzles, rising and spreading as it drifts, thinning toward its far end and its two ends, and broken into
// billows by two scales of noise.  Negative where there is none.  One expression, as a density must be.
function ShipSmoke(px, py, pz, long, reach, high, ox, oz) -> number {
    return 1.2 * (1 - abs(py - 1.4 - 0.42 * high * pz / reach) / (1.6 + 0.42 * high * pz / reach))
           - 1.1 * (pz / reach) * (pz / reach) - 4 * max(0, abs(px) / (0.5 * long) - 0.8)
           + 1.1 * (noise(px / 5.0 + ox, py / 4.2 - 2 * pz / reach, pz / 5.0 + oz)
                    + 0.5 * noise(px / 2.2 + 3.1 + ox, py / 2.0, pz / 2.2 + 1.3 + oz)
                    + 0.25 * noise(px / 0.9 + 7.3 + ox, py / 0.9 + 2.2, pz / 0.9 + 5.1 + oz) - 0.875)
}

// The smoke of a broadside: black powder burns to a white smoke, dense and billowing, that scatters nearly all
// the light it stops.  Built from the muzzles at its near edge, running along X, rising up +Y and drifting down +Z;
// turn it so +Z is downwind.
primitive GunSmoke(long, reach, high, variant = 1, thick = 0.25) -> group {
    ox = random(variant, 61) * 40
    oz = random(variant, 62) * 40
    return group {
        cube {
            material {
                pigment White  ambient 0  diffuse 0  specular 0  transparency 1
                interior {
                    ior 1.0
                    medium {
                        absorption [0.06, 0.06, 0.065]
                        scattering [1.6, 1.6, 1.62]
                        density function {
                            max(0, ShipSmoke(x * 0.5 * long, (y + 1) * 0.5 * high, (z + 1) * 0.5 * reach,
                                             long, reach, high, ox, oz))
                        }
                        density thick
                    }
                }
            }
            no shadow
            scale [0.5 * long, 0.5 * high, 0.5 * reach]
            translate [0, 0.5 * high, 0.5 * reach]
        }
    }
}
