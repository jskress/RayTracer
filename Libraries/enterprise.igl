    // The rib that runs aft from the egg to the impulse housing, built from the blueprints the way a
    // shape is recovered from its views: the plan, the profile and the rear view each pushed out into a
    // prism, and the rib is what all three have in common.  Heights are the blueprints' own, above the
    // housing's top, less the 0.02 the housing sits below the saucer's.  The rear view's pill stands
    // taller than the profile's crest (0.232 against 0.176); its heights are scaled by 0.784 to meet the
    // profile, and its widths kept.
    intersection {
        extrusion {
            // the plan: a rounded front, a straight taper, and a flare into two rounded ears at the
            // housing's aft face (just inside it, so the two never share a surface)
            path {
                move to 3.357, 0
                curve 3.357, 0.0913, 3.3966, 0.332 to 3.72, 0.3163
                line to 6.18, 0.1971
                curve 6.3121, 0.1907, 6.5003, 0.172 to 6.7225, 0.3288
                curve 6.7394, 0.3408, 6.7616, 0.3423 to 6.78, 0.3328
                curve 6.7984, 0.3232, 6.81, 0.3042 to 6.81, 0.2835
                line to 6.81, -0.2835
                curve 6.81, -0.3042, 6.7984, -0.3232 to 6.78, -0.3328
                curve 6.7616, -0.3423, 6.7394, -0.3408 to 6.7225, -0.3288
                curve 6.5003, -0.172, 6.3121, -0.1907 to 6.18, -0.1971
                line to 3.72, -0.3163
                curve 3.3966, -0.332, 3.357, -0.0913 to 3.357, 0
                close
            }
            min Y -0.05
            max Y 0.5
        }
        extrusion {
            // the profile: nearly level, then chamfered down to the aft face's top edge
            path {
                move to 3.2, -0.05
                line to 3.2, 0.1653
                line to 6.613, 0.1501
                line to 6.81, -0.02
                line to 6.81, -0.05
                close
            }
            min Y -1
            max Y 1
            rotate X -90
        }
        extrusion {
            // the rear view: the pill of the crest, the lobes either side, resting on the housing
            path {
                move to 0, 0.1619
                curve 0.032, 0.1619, 0.058, 0.1415 to 0.058, 0.1164
                line to 0.058, 0.1043
                curve 0.1835, 0.1046, 0.2558, 0.0941 to 0.2623, 0.0568
                line to 0.2623, 0.0455
                line to 0.297, 0.0455
                curve 0.3202, 0.0455, 0.339, 0.0309 to 0.339, 0.0128
                curve 0.339, -0.0053, 0.3202, -0.02 to 0.297, -0.02
                line to 0.297, -0.05
                line to -0.297, -0.05
                line to -0.297, -0.02
                curve -0.3202, -0.02, -0.339, -0.0053 to -0.339, 0.0128
                curve -0.339, 0.0309, -0.3202, 0.0455 to -0.297, 0.0455
                line to -0.2623, 0.0455
                line to -0.2623, 0.0568
                curve -0.2558, 0.0941, -0.1835, 0.1046 to -0.058, 0.1043
                line to -0.058, 0.1164
                curve -0.058, 0.1415, -0.032, 0.1619 to 0, 0.1619
                close
            }
            min Y -6.95
            max Y -3.2
            rotate X -90
            rotate Y 90
        }
        // a darker gray than the plating, as the studio model's is: a third of the way, as it shows,
        // from the plating unpainted (0.66 with gamma on) to the nacelles' matte gray (0.40)
        material {
            pigment [0.2938, 0.2938, 0.2938]   // 0.57 as it shows with gamma on
        }
    }
    object EnterpriseImpulseEngines {
        translate [6.3125, -0.02, 0] 
    }
}

// A warp nacelle, from FJ's nacelle profile, top and bottom (each sheet scanned in two halves and joined),
// in its own frame: the axis along X, the pylon's chord centered on the origin, up along Y and the inboard
// side toward -Z.  The drawings are at the hull's scale (the pylon root measures 1.000-1.010 against the
// pylon's 1.0045).  The two nacelles are this one placed, and this one mirrored.
EnterpriseNacelle = union {
    sphere {
        // the Bussard dome: half an ellipsoid, 0.81 along and 0.84 across (the drawings' ellipse exactly), in
        // an orange-red bronze.  Its aft half lies wholly inside the collar and the body.
        scale [0.8119, 0.8382, 0.8382]
        translate [-3.3330, 0, 0]
        material {
            pigment [0.6121, 0.0815, 0.0094]   // an orange-red bronze, (0.8, 0.32, 0.12) as it shows with gamma on
            diffuse 0.7
            specular 0.7
            shininess 35
            metallic 1
            brilliance 3
            reflective 0.15
        }
    }
    difference {
        lathe {
            // the body, from just inside the Bussard dome's rim back to the hood: a short chamfer out to the
            // collar, a recess under the vane ring, and a straight taper to the hood.  It starts a little
            // inside the dome, so the two never share a surface.
            path {
                move to 0, -3.3511
                line to 0.8339, -3.3511
                line to 0.8391, -3.3132
                line to 0.9063, -3.1943
                line to 0.9063, -2.8015
                line to 0.8615, -2.8015
                line to 0.8615, -2.5465
                line to 0.9034, -2.5465
                line to 0.6818, 10.6823
                line to 0, 10.6823
                close
            }
            rotate Z -90
        }
        intersection {
            // the recess the control reactor sits in, along the inboard side at mid-height, as the studio
            // model has it: 0.5341 tall, from the pylon's fore-and-aft centerline back to just ahead of the inboard vent.
            // Its walls slope in from the surface for 0.0793 at top and bottom, and between them the floor is
            // flat and vertical, 0.0948 below the surface; the floor leans in 0.960 degrees with the body's
            // taper, so the depth holds all the way aft.  It takes the vane rings' matte gray.
            extrusion {
                // its side outline: a long rectangle with rounded corners
                path {
                    move to 0.1034, -0.2671
                    line to 8.8560, -0.2671
                    curve 8.9131, -0.2671, 8.9593, -0.2208 to 8.9593, -0.1637
                    line to 8.9593, 0.1637
                    curve 8.9593, 0.2208, 8.9131, 0.2671 to 8.8560, 0.2671
                    line to 0.1034, 0.2671
                    curve 0.0463, 0.2671, 0.0000, 0.2208 to 0.0000, 0.1637
                    line to 0.0000, -0.1637
                    curve 0.0000, -0.2208, 0.0463, -0.2671 to 0.1034, -0.2671
                    close
                }
                min Y 0
                max Y 1.2
                rotate X -90
            }
            extrusion {
                // its section: the flat floor and the two sloped walls, carried along the nacelle's axis
                path {
                    move to -0.1878, -0.7659
                    line to 0.1878, -0.7659
                    line to 0.8550, -1.2061
                    line to -0.8550, -1.2061
                    close
                }
                min Y -1.5
                max Y 11
                rotate Z -90
                rotate Y -0.9596
            }
            material {
                pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                specular 0
            }
        }
        // the two grooves round the end band, just aft of the vents, where FJ's profile draws its two lines:
        // each a torus centered on the body's surface, so the groove is 0.0241 wide and 0.0121 deep, and
        // cut in the vane rings' gray
        torus {
            // the fore groove
            radii 0.6853, 0.0121
            rotate Z 90
            translate [10.4686, 0, 0]
            material {
                pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                specular 0
            }
        }
        torus {
            // the aft groove, clear of the hood's front
            radii 0.6820, 0.0121
            rotate Z 90
            translate [10.6685, 0, 0]
            material {
                pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                specular 0
            }
        }
    }
    lathe {
        // the vane ring just aft of the Bussard dome: five ribs with shallow grooves between them, in a matte
        // gray.  Its front sits a little inside the collar and its back a little inside the body, over a
        // recess in the body, so it never shares a surface with either.
        path {
            move to 0, -2.8084
            line to 0.8890, -2.8084
            line to 0.8890, -2.7826
            line to 0.8787, -2.7826
            line to 0.8787, -2.7429
            line to 0.8890, -2.7429
            line to 0.8890, -2.7292
            line to 0.8787, -2.7292
            line to 0.8787, -2.6826
            line to 0.8890, -2.6826
            line to 0.8890, -2.6620
            line to 0.8787, -2.6620
            line to 0.8787, -2.6189
            line to 0.8890, -2.6189
            line to 0.8890, -2.5999
            line to 0.8787, -2.5999
            line to 0.8787, -2.5586
            line to 0.8890, -2.5586
            line to 0.8890, -2.5396
            line to 0, -2.5396
            close
        }
        rotate Z -90
        material {
            pigment [0.1332, 0.1332, 0.1332]   // a matte gray, 0.40 as it shows with gamma on
            specular 0
        }
    }
    difference {
        // the hood: the body's taper carried on aft, ribbed fore and aft and in the vane rings' gray, rounded
