        }
        extrusion {
            // the web that closes the handle's opening: hull gray, 0.0760 thick so it sits 0.0361 in from the
            // handle's faces on both sides, its edges buried in the legs and the bar so it never reaches past them
            path {
                move to 7.4656, 0.6588
                line to 7.4656, 0.8029
                curve 7.4656, 0.8410, 7.5504, 0.8713 to 7.6551, 0.8708
                line to 9.7915, 0.8208
                curve 9.8486, 0.8204, 9.8949, 0.7919 to 9.8949, 0.7571
                line to 9.8949, 0.6452
                close
            }
            min Y -0.0380
            max Y 0.0380
            rotate X -90
        }
        cylinder {
            min Y 6.8711
            max Y 7.1158
            scale [0.0710, 1, 0.0710]
            rotate Z -90
            translate [0, 0.7436, 0]
        }
        sphere { scale 0.0710 translate [6.8711, 0.7436, 0] }
        rotate X -45
    }

    union {
        // the control reactor, standing in its recess along the inboard side at mid-height, as the studio
        // model has it.  At its fore end, a box from 0.4307 ahead of the recess's start to 0.2872 behind it: seen
        // from inboard, 0.3446 tall at its fore end and closing to 0.2274 at its aft end; seen from above,
        // its fore face raked back 20 degrees.  Its inward-facing face stands 1.1458 from the nacelle's axis.
        intersection {
            extrusion {
                // seen from inboard: narrowing toward the aft end
                path {
                    move to -0.5255, -0.1800
                    line to 0.2872, -0.1137
                    line to 0.2872, 0.1137
                    line to -0.5255, 0.1800
                    close
                }
                min Y 0.6547
                max Y 1.1458
                rotate X -90
            }
            extrusion {
                // seen from above: the fore face raked back
                path {
                    move to -0.4738, -0.6547
                    line to -0.2951, -1.1458
                    line to 0.3561, -1.1458
                    line to 0.3561, -0.6547
                    close
                }
                min Y -0.2068
                max Y 0.2068
            }
        }

        // the two bolt heads near the fore corners of the box's inward-facing face
        sphere {
            scale 0.0379
            translate [-0.2090, 0.0767, -1.1458]
        }
        sphere {
            scale 0.0379
            translate [-0.2090, -0.0767, -1.1458]
        }

        tube {
            // the cylinder: from inside the box, straight aft along the line FJ draws for it, then bending
            // down through the recess floor into the nacelle.  It stands clear of the floor until the bend.
            radius 0.0913 at [0.1723, 0, -1.0351]
            radius 0.0913 at [2.8946, 0, -0.9145]
            quad radius 0.0913 at [3.1013, 0, -0.9053]  radius 0.0913 at [3.3339, 0, -0.5858]
        }

        extrusion {
            // the ribbed section of the cylinder: 16 ribs running along it, in the vane rings' gray, a sleeve
            // a hair fuller than the cylinder so none of the cylinder shows between the ribs
            path {
                move to 0.0946, 0.0056
                quad 0.1090, 0.0217 to 0.0895, 0.0310
                line to 0.0853, 0.0414
                quad 0.0924, 0.0618 to 0.0708, 0.0629
                line to 0.0629, 0.0708
                quad 0.0618, 0.0924 to 0.0414, 0.0853
                line to 0.0310, 0.0895
                quad 0.0217, 0.1090 to 0.0056, 0.0946
                line to -0.0056, 0.0946
                quad -0.0217, 0.1090 to -0.0310, 0.0895
                line to -0.0414, 0.0853
                quad -0.0618, 0.0924 to -0.0629, 0.0708
                line to -0.0708, 0.0629
                quad -0.0924, 0.0618 to -0.0853, 0.0414
                line to -0.0895, 0.0310
                quad -0.1090, 0.0217 to -0.0946, 0.0056
                line to -0.0946, -0.0056
                quad -0.1090, -0.0217 to -0.0895, -0.0310
                line to -0.0853, -0.0414
                quad -0.0924, -0.0618 to -0.0708, -0.0629
                line to -0.0629, -0.0708
                quad -0.0618, -0.0924 to -0.0414, -0.0853
                line to -0.0310, -0.0895
                quad -0.0217, -0.1090 to -0.0056, -0.0946
                line to 0.0056, -0.0946
                quad 0.0217, -0.1090 to 0.0310, -0.0895
                line to 0.0414, -0.0853
                quad 0.0618, -0.0924 to 0.0629, -0.0708
                line to 0.0708, -0.0629
                quad 0.0924, -0.0618 to 0.0853, -0.0414
                line to 0.0895, -0.0310
                quad 0.1090, -0.0217 to 0.0946, -0.0056
                close
            }
            min Y 0.9773
            max Y 2.7249
            rotate Z -90
            rotate Y -2.5365
            translate [0, 0, -1.0427]
            material {
                pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                specular 0
            }
        }
    }

    union {
        // the recess floor's ribs: four half-round ribs along its flat, in the recess's gray
        cylinder {
            min Y -0.0172
            max Y 8.9766
            scale [0.0138, 1, 0.0138]
            rotate Z -90
            translate [0, -0.1413, -0.7659]
            rotate Y -0.9596
        }
        cylinder {
            min Y -0.0172
            max Y 8.9766
            scale [0.0138, 1, 0.0138]
            rotate Z -90
            translate [0, -0.0465, -0.7659]
            rotate Y -0.9596
        }
        cylinder {
            min Y -0.0172
            max Y 8.9766
            scale [0.0138, 1, 0.0138]
            rotate Z -90
            translate [0, 0.0465, -0.7659]
            rotate Y -0.9596
        }
        cylinder {
            min Y -0.0172
            max Y 8.9766
            scale [0.0138, 1, 0.0138]
            rotate Z -90
            translate [0, 0.1413, -0.7659]
            rotate Y -0.9596
        }
        material {
            pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
            specular 0
        }
    }

    union {
        // the vents, one on each side at mid-height (FJ's profile draws the outboard one, the bottom view
        // both): boxes 1.1337 long and 0.5238 tall, their aft ends in line with the intercoolers', their
        // flat vertical faces standing 0.0948 proud of the body at mid-height and leaning in with its taper,
        // so the leading and trailing edges show all round.  In the vane rings' matte gray.
        extrusion {
            // the inboard vent
            path {
                move to 9.1092, -0.2619
                line to 10.2429, -0.2619
                line to 10.2429, 0.2619
                line to 9.1092, 0.2619
                close
            }
            min Y 0.6970
            max Y 0.9555
            rotate X -90
            rotate Y -0.9596
        }
        extrusion {
            // the outboard vent
            path {
                move to 9.1092, -0.2619
                line to 10.2429, -0.2619
                line to 10.2429, 0.2619
                line to 9.1092, 0.2619
                close
            }
            min Y 0.6970
            max Y 0.9555
            rotate X 90
            rotate Y 0.9596
        }
        material {
            pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
            specular 0
        }
    }
}

// The secondary hull, from FJ's profile, bottom view and rear view of it, in the saucer's own frame (+X
// aft): the sheets are 580.4 px to the unit (the saucer's rim, which the bottom view shows as an arc,
// measures 6.3125 at that scale), placed fore and aft by the center of that arc and up and down by the
// three dorsal edges the hull's profile shares with the saucer's.  Its sections are circles (the plan is as wide as the profile is deep to within
// 0.5% from the shoulder to the pylons), but their centers ride on a gentle arch, lowest a third of the
// way back, so the body is a tube rather than a lathe.  At the stern the hangar deck and doors follow the
// rear, bottom and top views, and the hull's top runs aft over the doors as the top view and the profile
// draw it.
EnterpriseSecondaryHull = union {
    // The pennant along either side, as FJ's profile draws it: a red band whose forward block carries a
    // yellow chevron pointing at the bow, and aft of it three prongs, the middle one running on alone.
    // The outlines are his ink lines (his coloring inside them is rough), in the profile's own X and Y,
    // carried straight across the hull, so one decal paints both sides, each the other's mirror image.
    // The red is the studio model's darker one, measured on the pennant along its nacelle (the one on
    // the hull lies in the saucer's shadow) against the plating beside it.
    // The block and chevron lie over the side tabs as much as the hull.  His chevron is not symmetric --
    // its upper arm is the slimmer -- and it is kept as drawn.
    material inherited {
        decal {
            // the forward block
            path { move to 5.4534, -3.8163  line to 6.3115, -3.8163  line to 6.4856, -4.1192
                   line to 5.6245, -4.1192  close }
            color [0.29, 0.04, 0.06]           // a maroon, (0.57, 0.23, 0.28) as it shows with gamma on
            planar  min Y -2  max Y 2
            rotate X -90
        }
        decal {
            // the prongs: three bands and the two slots between them, all five as deep as one another, as
            // the studio model has them (FJ draws the prongs slimmer than the slots); the slots' rounded
            // forward ends reach where his do
            path {
                move to 6.3594, -3.8163
                line to 7.8989, -3.8163
                line to 7.8989, -3.8769
                line to 6.6145, -3.8769
                curve 6.5978, -3.8769, 6.5843, -3.8905 to 6.5843, -3.9072
                curve 6.5843, -3.9239, 6.5978, -3.9375 to 6.6145, -3.9375
                line to 9.3005, -3.9375
                line to 9.3005, -3.9981
                line to 6.6886, -3.9981
                curve 6.6719, -3.9981, 6.6583, -4.0116 to 6.6583, -4.0284
                curve 6.6583, -4.0451, 6.6719, -4.0586 to 6.6886, -4.0586
                line to 7.8989, -4.0586
                line to 7.8989, -4.1192
                line to 6.5305, -4.1192
                close
            }
            color [0.29, 0.04, 0.06]
            planar  min Y -2  max Y 2
            rotate X -90
        }
        decal {
            // the chevron, over the block and standing out above and below it
            path { move to 5.8352, -3.7024  line to 5.8913, -3.7024  line to 5.8045, -3.9498
                   line to 5.8621, -4.1795  line to 5.7500, -4.1795  line to 5.6336, -3.9646  close }
            color [0.85, 0.55, 0.04]           // a golden yellow, (0.93, 0.76, 0.23) as it shows with gamma on
            planar  min Y -2  max Y 2
            rotate X -90
        }
        // Her name along the keel, as FJ's bottom view draws it: on the centerline, centered fore and aft
        // where his line is (X = 8.875), reading from bow to stern seen from below with the letters'
        // tops to port.  His capitals are 0.0887 tall, so 0.1479 to the em, and the baseline runs half
        // that to starboard of the centerline so the letters straddle it.  His "CONSTITUTION" runs 1.364
        // from its first letter to its last, which this face matches with 252 more to each pair -- his
        // letters are wider than this face's, so these stand further apart.  Seen from below a decal comes
        // out mirrored, so it is turned over, which points its reach down onto the belly (-4.5 to -6.0).
        decal {
            path {
                text {
                    text 'U.S.S. ENTERPRISE'
                    font 'Federation Starfleet Hull 23rd', 'Orbitron'
                    layout {
                        along path { move to 50.0061, -0.3  line to 70.0061, -0.3 }
                        horizontal position center
                    }
                    kerning {
                        kern 'U', '.', 252  kern '.', 'S', 252  kern 'S', '.', 252  kern '.', ' ', 252
                        kern ' ', 'E', 252  kern 'E', 'N', 252  kern 'N', 'T', 252  kern 'T', 'E', 252
                        kern 'E', 'R', 252  kern 'R', 'P', 252  kern 'P', 'R', 252  kern 'R', 'I', 252
                        kern 'I', 'S', 252  kern 'S', 'E', 252
                    }
                }
            }
            color [0.06, 0.06, 0.07]
            planar  min Y 4.5  max Y 6.0
            scale 0.1479
            rotate X 180
        }
        // A hatch outlined on the floor of the fantail's scoop, on the centerline: a dark line 0.02 wide round a
        // rectangle 0.68 across and 0.89 long, from 12.66 to 13.55, its fore edge just behind the scoop's front.  FJ does not draw it; it is placed from the photograph of the studio model from below astern,
        // through a camera fitted to it, on this floor.  Seen from below, it is turned over.
        decal {
            path { move to 12.6600, -0.3400  line to 13.5500, -0.3400  line to 13.5500, 0.3400  line to 12.6600, 0.3400  close
                   move to 12.6800, -0.3200  line to 13.5300, -0.3200  line to 13.5300, 0.3200  line to 12.6800, 0.3200  close }
            color [0.06, 0.06, 0.07]
            planar  min Y 4.2  max Y 4.9
            rotate X 180
        }
        // The nacelles' markings, on their outboard sides only, as the studio model has them: the pennant -- a
        // red block with the yellow chevron at its front, and a long red stripe tapering aft -- then the
        // registration, then a thin stripe running on toward the hood.  The shapes are FJ's, from his profile
        // of the nacelle, where the block, the stripe and the thin stripe all lie between the same two lines,
        // narrowing from 0.29 deep at the block to 0.09 at the end; but the studio model carries the whole of
        // it 0.70 further aft and 0.13 higher than he draws it (above the nacelle's axis, not on it), with the
        // first stripe running on to just ahead of the registration, and its registration the size of the
        // saucer's underside one, which FJ draws larger and wider.  They are written here, in the secondary
        // hull's frame, rather than on the nacelle, because the port nacelle is the starboard one mirrored, and
        // a marking carried over with it would read backwards: each side has its own, turned to read from
        // outboard, reaching only the nacelle's outboard half.
        // the port nacelle's
        decal {
            path { move to 11.0643, 1.2628  line to 11.9469, 1.2488  line to 12.1156, 0.9520  line to 11.2518, 0.9434  close
                   move to 11.9930, 1.2459  line to 15.5024, 1.2016  line to 15.5024, 0.9935  line to 12.1618, 0.9526  close
                   move to 18.1144, 1.1724  line to 20.1594, 1.1476  line to 20.1594, 1.0580  line to 18.1144, 1.0316  close }
            color [0.29, 0.04, 0.06]
            planar  min Y 4.728  max Y 6.0
            rotate X -90
        }
        decal {
            path { move to 11.4719, 1.3702  line to 11.2579, 1.1038  line to 11.3699, 0.8935  line to 11.4783, 0.8944  line to 11.4306, 1.0957  line to 11.5230, 1.3680  close }
            color [0.85, 0.55, 0.04]
            planar  min Y 4.728  max Y 6.0
            rotate X -90
        }
        decal {
            path {
                text {
                    text 'NCC-1701'
                    font 'Federation Starfleet Hull 23rd', 'Orbitron'
                    layout {
                        along path { move to 18.7834, 1.5841  line to 38.7834, 1.5841 }
                        horizontal position center
                    }
                    kerning {
                        kern 'N', 'C', 36  kern 'C', 'C', 36  kern 'C', '-', 36  kern '-', '1', 36
                        kern '1', '7', 36  kern '7', '0', 36  kern '0', '1', 36
                    }
                }
            }
            color [0.06, 0.06, 0.07]
            planar  min Y 4.728  max Y 6.0
            scale 0.5833
            rotate X -90
        }
        // the starboard nacelle's
        decal {
            path { move to -11.0643, 1.2628  line to -11.9469, 1.2488  line to -12.1156, 0.9520  line to -11.2518, 0.9434  close
                   move to -11.9930, 1.2459  line to -15.5024, 1.2016  line to -15.5024, 0.9935  line to -12.1618, 0.9526  close
                   move to -18.1144, 1.1724  line to -20.1594, 1.1476  line to -20.1594, 1.0580  line to -18.1144, 1.0316  close }
            color [0.29, 0.04, 0.06]
            planar  min Y 4.728  max Y 6.0
            rotate Y 180  rotate X 90
        }
        decal {
            path { move to -11.4719, 1.3702  line to -11.2579, 1.1038  line to -11.3699, 0.8935  line to -11.4783, 0.8944  line to -11.4306, 1.0957  line to -11.5230, 1.3680  close }
            color [0.85, 0.55, 0.04]
            planar  min Y 4.728  max Y 6.0
            rotate Y 180  rotate X 90
        }
        decal {
            path {
                text {
                    text 'NCC-1701'
                    font 'Federation Starfleet Hull 23rd', 'Orbitron'
                    layout {
                        along path { move to -38.7834, 1.5841  line to -18.7834, 1.5841 }
                        horizontal position center
                    }
                    kerning {
                        kern 'N', 'C', 36  kern 'C', 'C', 36  kern 'C', '-', 36  kern '-', '1', 36
                        kern '1', '7', 36  kern '7', '0', 36  kern '0', '1', 36
                    }
                }
            }
            color [0.06, 0.06, 0.07]
            planar  min Y 4.728  max Y 6.0
            scale 0.5833
            rotate Y 180  rotate X 90
        }
        // A panel outlined on the underside of each nacelle, as the studio model has it: from 0.167 aft of the
        // nacelle's middle -- a third of the pylon's width forward of its trailing edge -- to 3.51, and across
        // the bottom from 43 degrees below the outboard side round to the pylon, which bounds it inboard: its
        // fore edge runs round the bottom until it meets the pylon's side, and its inboard edge, 43 degrees
        // below the inboard side, runs aft from the pylon's rounded trailing end.  From the side, its outboard
        // edge shows as a line low on the flank.  Dark lines 0.015 wide, seen from below and so turned over,
        // reaching only the nacelles' lower halves.
        decal {
            path { move to 11.7446, -5.3554  line to 15.0874, -5.3145  line to 15.0874, -5.2995  line to 11.7446, -5.3404  close
                   move to 15.0724, -5.2995  line to 15.0874, -5.2995  line to 15.0874, -4.1415  line to 15.0724, -4.1415  close
                   move to 12.0674, -4.1195  line to 15.0724, -4.1565  line to 15.0724, -4.1415  line to 12.0674, -4.1045  close
                   move to 11.7446, -5.3404  line to 11.7596, -5.3404  line to 11.7596, -4.2337  line to 11.7446, -4.2337  close
                   move to 11.7446, 5.3554  line to 15.0874, 5.3145  line to 15.0874, 5.2995  line to 11.7446, 5.3404  close
                   move to 15.0724, 5.2995  line to 15.0874, 5.2995  line to 15.0874, 4.1415  line to 15.0724, 4.1415  close
                   move to 12.0674, 4.1195  line to 15.0724, 4.1565  line to 15.0724, 4.1415  line to 12.0674, 4.1045  close
                   move to 11.7446, 5.3404  line to 11.7596, 5.3404  line to 11.7596, 4.2337  line to 11.7446, 4.2337  close }
            color [0.06, 0.06, 0.07]
            planar  min Y -0.979  max Y -0.05
            rotate X 180
        }
    }

    // The nacelle pylons: each a straight bar whose section is a capsule 1.0045 long fore and aft and
    // 0.2419 thick (straight sides and round ends), as the hull's profile and the rear views draw it.  They rise
    // 43.7 degrees from upright, as the rear views draw them, on a line that passes through the hull's
    // axis, from inside the hull out to the nacelles' centers (the rear view puts those 4.6726 out and
    // 0.9673 up), where the nacelles will bury their ends.  Along the upper face of each -- the one turned up
    // and in, toward the dorsal -- run four grilles, as FJ's top view of the pylons draws them and the
    // studio model has them: recesses 0.012 deep in the matte gray, 0.415 across the middle of the face,
    // the first starting 1.66 out along the pylon's line, each about 0.88 long with 0.09 between them, the
    // last a little shorter, at 0.81.
    // On the other, outer face -- turned down and out -- are three dark windows, as FJ's profile draws them
    // and the studio model has them: 0.114 fore and aft by 0.062 along the pylon, 0.266 forward of its middle,
    // their centers 2.133, 4.886 and 5.283 up its line, each set 0.01 into the face.
    difference {
        // the starboard pylon
        extrusion {
            path {
                move to -0.3813, -0.1210
                line to 0.3813, -0.1210
                curve 0.4481, -0.1210, 0.5022, -0.0668 to 0.5022, 0
                curve 0.5022, 0.0668, 0.4481, 0.1210 to 0.3813, 0.1210
                line to -0.3813, 0.1210
                curve -0.4481, 0.1210, -0.5022, 0.0668 to -0.5022, 0
                curve -0.5022, -0.0668, -0.4481, -0.1210 to -0.3813, -0.1210
                close
            }
            min Y 0.8500
            max Y 6.8246
        }
        union {
            // its grilles
            cube {
                scale [0.2075, 0.4449, 0.0205]
                translate [0, 2.1059, -0.1295]
            }
            cube {
                scale [0.2075, 0.4418, 0.0205]
                translate [0, 3.0776, -0.1295]
            }
            cube {
                scale [0.2075, 0.4399, 0.0205]
                translate [0, 4.0505, -0.1295]
            }
            cube {
                scale [0.2075, 0.4026, 0.0205]
                translate [0, 4.9804, -0.1295]
            }
            material {
                pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                specular 0
            }
        }
        union {
            // its windows, on the outer face: three, dark
            cube {
                scale [0.0570, 0.0310, 0.0150]
                translate [-0.2660, 2.1330, 0.1260]
            }
            cube {
                scale [0.0570, 0.0310, 0.0150]
                translate [-0.2660, 4.8860, 0.1260]
            }
            cube {
                scale [0.0570, 0.0310, 0.0150]
                translate [-0.2660, 5.2830, 0.1260]
            }
            material {
                pigment [0.03, 0.03, 0.035]
                specular 0.5
                shininess 120
            }
        }
        rotate X 43.663
        translate [11.5774, -3.9697, 0]
    }
    difference {
        // the port pylon
        extrusion {
            path {
                move to -0.3813, -0.1210
                line to 0.3813, -0.1210
                curve 0.4481, -0.1210, 0.5022, -0.0668 to 0.5022, 0
                curve 0.5022, 0.0668, 0.4481, 0.1210 to 0.3813, 0.1210
                line to -0.3813, 0.1210
                curve -0.4481, 0.1210, -0.5022, 0.0668 to -0.5022, 0
                curve -0.5022, -0.0668, -0.4481, -0.1210 to -0.3813, -0.1210
                close
            }
            min Y 0.8500
            max Y 6.8246
        }
        union {
            // its grilles
            cube {
                scale [0.2075, 0.4449, 0.0205]
                translate [0, 2.1059, 0.1295]
            }
            cube {
                scale [0.2075, 0.4418, 0.0205]
