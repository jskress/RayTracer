    // The deflector dish, from the cutaway: a shell open toward the front, its rim 0.8132 in radius,
    // 0.033 thick and thinning to a lip at the rim (the cutaway's section drawn as a lathe profile).
    // At its middle a small hemisphere, as round as the mounting pole, carries the antenna; the pole runs
    // aft from the back of the dish to the floor of the innermost cup.
    lathe {
        path {
            move to 0, 3.8921
            curve 0.3148, 3.8921, 0.5969, 3.8147 to 0.7994, 3.6613
            line to 0.8132, 3.6699
            line to 0.7994, 3.6940
            curve 0.5969, 3.8474, 0.3148, 3.9249 to 0.0000, 3.9249
            close
        }
        rotate Z -90
        translate [0, -3.9531, 0]
        material {
            pigment [0.17261, 0.05163, 0.00084]   // a dark orange, (0.45, 0.26, 0.04) as it shows with gamma on
        }
    }
    sphere {
        // the hemisphere at the antenna's foot: the pole's own end, standing through the dish, and the
        // antenna's color
        scale 0.1103
        translate [3.9025, -3.9531, 0]
        material {
            pigment [0.06566, 0.01323, 0.00386]   // a dark brownish red, (0.29, 0.14, 0.08) as it shows with gamma on
        }
    }
    cylinder {
        // the mounting pole, 0.1103 in radius, from the dish back to the innermost cup's floor
        min Y 3.9025
        max Y 4.4471
        scale [0.1103, 1, 0.1103]
        rotate Z -90
        translate [0, -3.9531, 0]
    }
    lathe {
        // the antenna: a rod tapering from 0.0366 at the hemisphere to 0.0215, with a short
        // cylinder 0.0388 in radius at its tip
        path {
            move to 0, 3.1358
            line to 0.0388, 3.1358
            line to 0.0388, 3.2219
            line to 0.0215, 3.2219
            line to 0.0366, 3.8249
            line to 0, 3.8249
            close
        }
        rotate Z -90
        translate [0, -3.9531, 0]
        material {
            pigment [0.06566, 0.01323, 0.00386]   // a dark brownish red, (0.29, 0.14, 0.08) as it shows with gamma on
        }
    }

    // The deflector housings: three cylinders nested on the deflector's axis, each standing proud of
    // the next and running back into it, as the cutaway draws them; their sizes are the hull profile's and the
    // bottom view's.  The first and third are plain cylinders; the second swells a little toward the
    // third (the bottom view draws it 0.04-0.06 fuller than the profile; this splits the difference).
    // The first two are cups, open toward the dish, each a deck (0.261) deep as the cutaway draws them,
    // and a smaller cup stands inside the first, on the first's floor.  The second cup's floor is the
    // plane of the tabs' faces, which the cutaway draws as the hull's nose wall (the forward wall of
    // the room marked ST).  The walls are as thick as the cutaway draws them.
    difference {
        // the first: 0.9486 in radius, its wall 0.0500 thick, standing on the second cup's floor
        cylinder {
            min Y 4.1661
            max Y 4.6148
            scale [0.9486, 1, 0.9486]
            rotate Z -90
            translate [0, -3.9531, 0]
        }
        cylinder {
            min Y 4.1561
            max Y 4.4271
            scale [0.8986, 1, 0.8986]
            rotate Z -90
            translate [0, -3.9531, 0]
        }
        material {
            pigment [0.06566, 0.01323, 0.00386]   // a dark brownish red, (0.29, 0.14, 0.08) as it shows with gamma on
        }
    }
    difference {
        // the second, swelling from 1.1354 at its face to 1.2173, its wall 0.0500 thick at the rim
        lathe {
            path {
                move to 0, 4.3298
                line to 1.1354, 4.3298
                curve 1.1829, 4.5519, 1.2109, 4.7874 to 1.2173, 5.0017
                line to 0, 5.0017
                close
            }
            rotate Z -90
            translate [0, -3.9531, 0]
        }
        cylinder {
            // its floor a hair ahead of the tabs' faces, so the two never share a face
            min Y 4.3198
            max Y 4.5948
            scale [1.0854, 1, 1.0854]
            rotate Z -90
            translate [0, -3.9531, 0]
        }
    }
    difference {
        // the cup inside the first: 0.5398 in radius (0.569 of the first's, as the cutaway draws it), its
        // rim 0.1223 back from the first's, its wall 0.0420 thick.  It is a tube standing on the first cup's
        // floor, which is the floor seen inside it.
        cylinder {
            min Y 4.2884
            max Y 4.4471
            scale [0.5398, 1, 0.5398]
            rotate Z -90
            translate [0, -3.9531, 0]
        }
        cylinder {
            min Y 4.2784
            max Y 4.4571
            scale [0.4978, 1, 0.4978]
            rotate Z -90
            translate [0, -3.9531, 0]
        }
        material {
            pigment [0.06566, 0.01323, 0.00386]   // a dark brownish red, (0.29, 0.14, 0.08) as it shows with gamma on
        }
    }
    cylinder {
        // the third: 1.3243 in radius, its face standing in front of the hull's nose and its back
        // buried in it
        min Y 4.9845
        max Y 5.2257
        scale [1.3243, 1, 1.3243]
        rotate Z -90
        translate [0, -3.9531, 0]
    }

    difference {
        intersection {
            // the tabs on the nose: three of them, at 3, 6 and 9 o'clock round the deflector's axis, each
            // 0.5808 wide and centered on its own line through the axis (both views draw them that wide, to
            // within 0.006).  Their faces stand 1.4283 out at the front of the second housing; their outer
            // edges flare as the hull's profile (the bottom tab) and the bottom view (the side tabs) draw them, stand
            // proud of the hull's shoulder, and dive back under the hull's belly and sides
            lathe {
                path {
                    move to 0, 4.5968
                    line to 1.4283, 4.5968
                    curve 1.4666, 4.8829, 1.5098, 5.2201 to 1.5400, 5.4859
                    curve 1.5516, 5.5886, 1.5438, 5.7943 to 1.4955, 6.0183
                    line to 0, 6.0183
                    close
                }
                rotate Z -90
                translate [0, -3.9531, 0]
            }
            union {
                cube {
                    // the bottom tab
                    scale [2, 1, 0.2904]
                    translate [5.3, -4.9531, 0]
                }
                cube {
                    // the side tabs
                    scale [2, 0.2904, 2]
                    translate [5.3, -3.9531, 0]
                }
            }
        }

        difference {
            // The vents on the side tabs, as the studio model has them: the face of each tab from just behind
            // its front to just ahead of the pennant, X 4.64 to 5.40, cut with eleven slots 0.018 high and
            // 0.015 deep across 0.47 of its height, leaving slats between them.  The slots run through both
            // side tabs at once; taking the tabs' own shape 0.015 smaller out of them leaves only the outer
            // layer to cut, and gives each slot its floor.
            union {
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -4.1667, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -4.1240, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -4.0813, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -4.0386, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.9958, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.9531, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.9104, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.8676, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.8249, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.7822, 0]
                }
                cube {
                    scale [0.38, 0.009, 2]
                    translate [5.02, -3.7395, 0]
                }
            }
            lathe {
                path {
                    move to 0, 4.5968
                    line to 1.4133, 4.5968
                    curve 1.4516, 4.8829, 1.4948, 5.2201 to 1.5250, 5.4859
                    line to 0, 5.4859
                    close
                }
                rotate Z -90
                translate [0, -3.9531, 0]
            }
            material {
                pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                specular 0
            }
        }
    }

    // The hull's body, hollowed under the hood: aft of x = 14.25 and above the hangar deck, the hull is a shell
    // 0.06 thick -- the same tube, every radius 0.06 less, taken out of it -- so the hull ends round the doors
    // in a hood whose edge is the same thickness all the way round, as the studio model's is.
    difference {
        intersection {
            tube {
                // the spine and radius are fitted so the tube's outline lands on the profile's top and bottom
                // (within 5 px) and on the plan (within 7.5 px).  Aft of the pylon roots (x = 11.08) the plan
                // narrows more slowly than ahead of them; that kink is the drawing's, hence "discontinuous".
                // There the plan is also a little wider than the profile is deep, which no circle can be, so
                // between the pylon roots and x = 13.6 the radius dips and the spine rises by the same amount,
                // smoothly, by 0.049 at the fantail's scoop (x = 12.32): the top stays on the profile's line,
                // the bottom comes up 0.098 to meet the profile's belly where the scoop starts, and the sides
                // come in from the plan by no more than that 0.049.  Aft of 13.6 the tube is as it was.
                discontinuous

                radius 1.5271 at [5.6564, -4.0113, 0]
                curve radius 1.5647 at [6.2020, -4.0718, 0]  radius 1.5706 at [6.7476, -4.0381, 0]  radius 1.5426 at [7.2932, -4.0417, 0]
                curve radius 1.5102 at [7.9250, -4.0459, 0]  radius 1.4210 at [8.5567, -4.0140, 0]  radius 1.3465 at [9.1885, -3.9834, 0]
                curve radius 1.2720 at [9.8202, -3.9529, 0]  radius 1.1901 at [10.4520, -3.9224, 0]  radius 1.1543 at [11.0837, -3.9303, 0]
                curve radius 1.1394 at [11.4943, -3.9461, 0]  radius 1.0755 at [11.9050, -3.9129, 0]  radius 1.0607 at [12.3156, -3.9287, 0]
                curve radius 1.0451 at [12.7437, -3.9452, 0]  radius 1.0786 at [13.1719, -4.0107, 0]  radius 1.0631 at [13.6000, -4.0272, 0]
                radius 1.0263 at [14.6158, -4.0663, 0]
            }

            lathe {
                // the nose: the shoulder rolling up from the third housing's corner onto the hull.  Its vertical
                // sections are circles whose centers fall 0.1 per unit aft (the shear), which is what makes the
                // drawing's top and bottom shoulders agree to within 2 px.  Aft of the shoulder it flares out
                // into a sleeve wider than the body, so from there on it cuts nothing.
                path {
                    move to 0, 5.1999
                    line to 1.3448, 5.1999
                    curve 1.4130, 5.2469, 1.4311, 5.2671 to 1.4559, 5.3291
                    curve 1.5012, 5.4424, 1.5052, 5.4477 to 1.5300, 5.5875
                    curve 1.5422, 5.6564, 2.5844, 5.7254 to 2.5844, 5.8632
                    line to 2.5844, 14.8742
                    line to 0, 14.8742
                    close
                }
                rotate Z -90
                shear [0, 0, -0.1, 0, 0, 0]
                translate [0, -3.4581, 0]
            }

            extrusion {
                // the profile aft: the stern face, the edge where the hangar doors meet the hull, the fantail
                // sweeping up to the hangar deck, and the underside ahead of it.  With the plan below, this lets
                // the hull's top run aft over the doors while it still meets the deck where the profile draws it.
                // The fantail's rounded step comes down to meet the belly where the tube's own bottom meets the
                // profile's, and ends level with it, so the two join in a curve and the scoop's fore end rounds
                // off into the hull; ahead of it this falls away below the hull and cuts nothing.
                path {
                    move to 5.0534, -2.1768
                    line to 14.5124, -2.1768
                    line to 14.5124, -3.2105
                    line to 14.4228, -3.3139
                    curve 14.3209, -3.5696, 14.3290, -3.6974 to 14.3194, -3.9686
                    line to 14.3143, -4.1556
                    curve 14.1004, -4.1556, 13.4217, -4.2627 to 13.1513, -4.3687
                    curve 12.9148, -4.4613, 12.7420, -4.5417 to 12.5482, -4.7103
                    curve 12.4154, -4.8259, 12.3700, -4.9945 to 12.3000, -4.9945
                    curve 12.1200, -4.9945, 11.9000, -5.2000 to 11.5500, -5.4500
                    line to 9.8777, -6.1396
                    line to 5.0534, -6.1396
                    close
                }
                min Y -2
                max Y 2
                rotate X -90
            }

            extrusion {
                // the plan aft, as top2 draws it: the stern face straight across the middle, and either side of it
                // the hull's edge scalloped forward to the hull's corner, so the hull wraps round the doors
                path {
                    move to 5.0534, -1.8952
                    line to 14.2884, -1.8952
                    line to 14.2884, -1.0407
                    curve 14.3225, -0.8832, 14.3368, -0.6902 to 14.5055, -0.5720
                    line to 14.5055, 0.5720
                    curve 14.3368, 0.6902, 14.3225, 0.8832 to 14.2884, 1.0407
                    line to 14.2884, 1.8952
                    line to 5.0534, 1.8952
                    close
                }
                min Y -7
                max Y -1
            }
        }

        intersection {
            tube {
                // the hollow under the hood: the hull's tube, every radius 0.06 less
                radius 1.0943 at [11.0837, -3.9303, 0]
                radius 0.9663 at [14.6158, -4.0663, 0]
            }
            cube {
                // keeps x >= 14.25 and y >= -3.9691, a hair under the deck's top so the two never share a face.
                // Its forward face is the wall the doors stand against, which is the nacelles' dark gray.
                scale [1, 1, 2]
                translate [15.25, -2.9691, 0]
                material {
                    pigment [0.1332, 0.1332, 0.1332]   // the vane rings' matte gray, 0.40 as it shows with gamma on
                    specular 0
                }
            }
        }
    }

    // The hull's windows, on both its sides: FJ's profile draws thirty-two and nine round ports, from a flat
    // pair low on the nose to a pair high up by the beacon, and the studio model's photograph of the
    // starboard side has the same rows, near enough to say which are lit -- four of the five in the long row
    // forward, the two just above the pennant and one below it, a window and a square low down, the pair aft
    // and one port.  The rest are dark, but for the square the near pylon hides, which is taken to be lit.
    // The sizes are FJ's, to the middle of his outline, and the windows in a row share one.  Each is a plate
    // standing 0.004 proud of the hull: a short straight tube fitted to the hull's surface over the window
    // and made that much fuller, cut to the window by a prism run straight through the hull, so one prism
    // makes a window on each side.  (A copy of the hull's own tube, grown, would serve as well, but every ray
    // that reached the hull would then be tested against its curved sections twice more, and they are slow.)
    // The two on the nose's shoulder are cut from the shoulder, grown the same way.
    group {
        group {
            intersection { tube { radius 1.5671 at [6.4350, -4.0493, 0]  radius 1.5586 at [7.1350, -4.0411, 0] }  cube { scale [0.0672, 0.0362, 2]  translate [6.7850, -3.0469, 0] } }
            intersection { tube { radius 1.5673 at [6.6848, -4.0454, 0]  radius 1.5475 at [7.3848, -4.0392, 0] }  cube { scale [0.0293, 0.0254, 2]  translate [7.0348, -3.3329, 0] } }
            intersection { tube { radius 1.5656 at [6.8123, -4.0429, 0]  radius 1.5400 at [7.5123, -4.0401, 0] }  cube { scale [0.0293, 0.0254, 2]  translate [7.1623, -3.3277, 0] } }
            intersection { tube { radius 1.5590 at [7.0621, -4.0402, 0]  radius 1.5213 at [7.7621, -4.0446, 0] }  cube { scale [0.0672, 0.0388, 2]  translate [7.4121, -3.6120, 0] } }
            intersection { tube { radius 1.5590 at [7.0639, -4.0414, 0]  radius 1.5210 at [7.7639, -4.0426, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [7.4139, -4.4683, 0] } }
            intersection { tube { radius 1.5436 at [7.3826, -4.0429, 0]  radius 1.4889 at [8.0826, -4.0366, 0] }  cube { scale [0.0672, 0.0388, 2]  translate [7.7326, -3.6120, 0] } }
            intersection { tube { radius 1.5232 at [7.6600, -4.0409, 0]  radius 1.4565 at [8.3600, -4.0263, 0] }  cube { scale [0.0672, 0.0388, 2]  translate [8.0100, -3.6120, 0] } }
            intersection { tube { radius 1.5160 at [7.7427, -4.0398, 0]  radius 1.4462 at [8.4427, -4.0222, 0] }  cube { scale [0.0663, 0.0362, 2]  translate [8.0927, -3.8558, 0] } }
            intersection { tube { radius 1.4999 at [7.9121, -4.0363, 0]  radius 1.4249 at [8.6121, -4.0139, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [8.2621, -4.1797, 0] } }
            intersection { tube { radius 1.4990 at [7.9219, -4.0357, 0]  radius 1.4235 at [8.6219, -4.0143, 0] }  cube { scale [0.0672, 0.0388, 2]  translate [8.2719, -3.6120, 0] } }
            intersection { tube { radius 1.4952 at [7.9598, -4.0347, 0]  radius 1.4186 at [8.6598, -4.0125, 0] }  cube { scale [0.0327, 0.0310, 2]  translate [8.3098, -3.8558, 0] } }
            intersection { tube { radius 1.3825 at [8.9212, -3.9964, 0]  radius 1.2985 at [9.6212, -3.9623, 0] }  cube { scale [0.0302, 0.0284, 2]  translate [9.2712, -4.4752, 0] } }
            intersection { tube { radius 1.1690 at [10.8406, -3.9227, 0]  radius 1.1385 at [11.5406, -3.9447, 0] }  cube { scale [0.0336, 0.0319, 2]  translate [11.1906, -3.3449, 0] } }
            intersection { tube { radius 1.0603 at [12.6858, -3.9521, 0]  radius 1.0746 at [13.3858, -4.0187, 0] }  cube { scale [0.0612, 0.0388, 2]  translate [13.0358, -3.4113, 0] } }
            intersection { tube { radius 1.0653 at [12.8564, -3.9698, 0]  radius 1.0754 at [13.5564, -4.0322, 0] }  cube { scale [0.0612, 0.0388, 2]  translate [13.2064, -3.4113, 0] } }
            intersection { tube { radius 1.0681 at [12.9047, -3.9781, 0]  radius 1.0736 at [13.6047, -4.0324, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [13.2547, -4.0789, 0] } }
            material {
                pigment [1, 0.76, 0.31]         // a yellow warm white, (1.0, 0.88, 0.59) as it shows under one white light
                ambient 1
                diffuse 0
                specular 0
            }
        }
        group {
            intersection { tube { radius 1.5587 at [5.4615, -3.9678, 0]  radius 1.5442 at [6.1615, -4.0640, 0] }  cube { scale [0.0637, 0.0211, 2]  translate [5.8115, -5.3272, 0] } }
            intersection { tube { radius 1.5578 at [5.6343, -4.0001, 0]  radius 1.5522 at [6.3343, -4.0644, 0] }  cube { scale [0.0637, 0.0211, 2]  translate [5.9843, -5.3272, 0] } }
            intersection { tube { radius 1.5257 at [7.6285, -4.0416, 0]  radius 1.4608 at [8.3285, -4.0270, 0] }  cube { scale [0.0258, 0.0276, 2]  translate [7.9785, -4.7681, 0] } }
            intersection { tube { radius 1.4806 at [8.0976, -4.0309, 0]  radius 1.4009 at [8.7976, -4.0048, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [8.4476, -4.1797, 0] } }
            intersection { tube { radius 1.4799 at [8.1050, -4.0305, 0]  radius 1.3997 at [8.8050, -4.0051, 0] }  cube { scale [0.0586, 0.0388, 2]  translate [8.4550, -3.6120, 0] } }
            intersection { tube { radius 1.3687 at [9.0349, -3.9907, 0]  radius 1.2858 at [9.7349, -3.9573, 0] }  cube { scale [0.0319, 0.0319, 2]  translate [9.3849, -3.6206, 0] } }
            intersection { tube { radius 1.3199 at [9.4450, -3.9708, 0]  radius 1.2367 at [10.1450, -3.9396, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [9.7950, -4.1797, 0] } }
            intersection { tube { radius 1.3000 at [9.6104, -3.9630, 0]  radius 1.2183 at [10.3104, -3.9341, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [9.9604, -4.1797, 0] } }
            intersection { tube { radius 1.2569 at [9.9756, -3.9475, 0]  radius 1.1825 at [10.6756, -3.9256, 0] }  cube { scale [0.0603, 0.0370, 2]  translate [10.3256, -3.8704, 0] } }
            intersection { tube { radius 1.2395 at [10.1307, -3.9418, 0]  radius 1.1695 at [10.8307, -3.9241, 0] }  cube { scale [0.0603, 0.0370, 2]  translate [10.4807, -3.8704, 0] } }
            intersection { tube { radius 1.2376 at [10.1514, -3.9409, 0]  radius 1.1669 at [10.8514, -3.9242, 0] }  cube { scale [0.0293, 0.0284, 2]  translate [10.5014, -4.7715, 0] } }
            intersection { tube { radius 1.2343 at [10.1789, -3.9398, 0]  radius 1.1655 at [10.8789, -3.9245, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [10.5289, -4.1797, 0] } }
            intersection { tube { radius 1.2023 at [10.4874, -3.9314, 0]  radius 1.1461 at [11.1874, -3.9263, 0] }  cube { scale [0.0414, 0.0405, 2]  translate [10.8374, -4.1797, 0] } }
            intersection { tube { radius 1.1729 at [10.7992, -3.9243, 0]  radius 1.1379 at [11.4992, -3.9402, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [11.1492, -4.1797, 0] } }
            intersection { tube { radius 1.1645 at [11.0473, -3.9347, 0]  radius 1.1141 at [11.7473, -3.9344, 0] }  cube { scale [0.0629, 0.0388, 2]  translate [11.3973, -4.1797, 0] } }
            intersection { tube { radius 1.0675 at [12.8874, -3.9770, 0]  radius 1.0739 at [13.5874, -4.0308, 0] }  cube { scale [0.0284, 0.0345, 2]  translate [13.2374, -4.1943, 0] } }
            intersection { tube { radius 1.5640 at [6.8950, -4.0421, 0]  radius 1.5343 at [7.5950, -4.0405, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [7.2450, -4.5820, 0] } }
            intersection { tube { radius 1.5467 at [7.3344, -4.0433, 0]  radius 1.4942 at [8.0344, -4.0374, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [7.6844, -4.2994, 0] } }
            intersection { tube { radius 1.5245 at [7.6428, -4.0415, 0]  radius 1.4591 at [8.3428, -4.0264, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [7.9928, -4.6785, 0] } }
            intersection { tube { radius 1.2352 at [10.1721, -3.9403, 0]  radius 1.1656 at [10.8721, -3.9239, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [10.5221, -4.6837, 0] } }
            intersection { tube { radius 1.0614 at [12.2051, -3.9159, 0]  radius 1.0595 at [12.9051, -3.9691, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [12.5551, -3.7464, 0] } }
            intersection { tube { radius 1.0619 at [12.2361, -3.9199, 0]  radius 1.0587 at [12.9361, -3.9693, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [12.5861, -3.1020, 0] } }
            intersection { tube { radius 1.0664 at [12.9012, -3.9743, 0]  radius 1.0754 at [13.6012, -4.0356, 0] }  cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [13.2512, -3.1416, 0] } }
            intersection {
                lathe {
                    // the nose's shoulder, every radius 0.004 more
                    path {
                        move to 0, 5.1999
                        line to 1.3488, 5.1999
                        curve 1.4170, 5.2469, 1.4351, 5.2671 to 1.4599, 5.3291
                        curve 1.5052, 5.4424, 1.5092, 5.4477 to 1.5340, 5.5875
                        curve 1.5462, 5.6564, 2.5884, 5.7254 to 2.5884, 5.8632
                        line to 2.5884, 14.8742
                        line to 0, 14.8742
                        close
                    }
                    rotate Z -90
                    shear [0, 0, -0.1, 0, 0, 0]
                    translate [0, -3.4581, 0]
                }
                union {
                    cube { scale [0.0207, 0.0258, 2]  translate [5.4571, -4.7422, 0] }
                    cylinder { min Y -2  max Y 2  scale [0.0155, 1, 0.0155]  rotate X 90  translate [5.4686, -4.5837, 0] }
                }
            }
            material {
                pigment [0.03, 0.03, 0.035]
                specular 0.5
                shininess 120
            }
        }
    }

    union {
        intersection {
            // the hangar deck: a disc, as the bottom and top views draw it (a circle of radius 1.0455 about a
            // center 0.495 ahead of the stern face), its lower edge rounded; kept only from just inside the
            // stern face aft.  Its underside sits a hair above the fantail's end, so the two never coincide.
            lathe {
                path {
                    move to 0, -3.9686
                    line to 1.0455, -3.9686
                    line to 1.0455, -4.1099
                    curve 1.0455, -4.1337, 1.0262, -4.1530 to 1.0024, -4.1530
                    line to 0, -4.1530
                    close
                }
                translate [13.8193, 0, 0]
            }
            cube {
                // keeps x >= 14.2712
                scale [1, 1, 2]
                translate [15.2712, -4.4686, 0]
            }
        }

        extrusion {
            // the corners where the hull's sides meet the deck: both plan views draw the side turning in
            // at the hull's corner and curving round into the deck's circle.  A slab as thick as the deck
            // (a hair inside its top and bottom, so the two never share a face), from inside the hull to
            // inside the deck
            path {
                move to 14.2712, -1.0286
                line to 14.2884, -1.0286
                curve 14.3107, -1.0263, 14.3108, -0.9246 to 14.3608, -0.8943
                line to 14.3608, 0.8943
                curve 14.3108, 0.9246, 14.3107, 1.0263 to 14.2884, 1.0286
                line to 14.2712, 1.0286
                close
            }
            min Y -4.1513
            max Y -3.9704
        }
    }

    difference {
        // The hangar doors: a dome standing on the deck under the hood, as the studio model's are -- half an
        // ellipsoid 0.89 across either side, 0.76 high and reaching 0.51 aft of the hollow's back wall, which
        // its center sits on, so it stops 0.1 short of the deck's edge on the centerline and stands clear of
        // the hood by 0.086 at the sides and 0.137 at the top, where the hangar's light hangs.  It is made of
        // seven leaves, the grooves between them meridians through its crown, evenly spaced as the rear view
        // draws them: so they are cut in a unit sphere, 0.03 wide and 0.03 deep, before it is stretched to size.
        intersection {
            sphere { }
            cube {
                // keeps x >= -0.02 (inside the hull) and y >= -0.0113 (inside the deck)
                scale [2, 2, 2]
                translate [1.98, 1.9887, 0]
            }
        }
        difference {
            cube {
                scale [1.2, 1.2, 0.015]
                rotate Y 25.714
            }
            sphere { scale 0.97 }
        }
        difference {
            cube {
                scale [1.2, 1.2, 0.015]
                rotate Y -25.714
            }
            sphere { scale 0.97 }
        }
        difference {
            cube {
                scale [1.2, 1.2, 0.015]
                rotate Y 51.429
            }
            sphere { scale 0.97 }
        }
        difference {
            cube {
                scale [1.2, 1.2, 0.015]
                rotate Y -51.429
            }
            sphere { scale 0.97 }
        }
        difference {
            cube {
                scale [1.2, 1.2, 0.015]
                rotate Y 77.143
            }
            sphere { scale 0.97 }
        }
        difference {
            cube {
                scale [1.2, 1.2, 0.015]
                rotate Y -77.143
            }
            sphere { scale 0.97 }
        }
        scale [0.51, 0.76, 0.89]
        translate [14.25, -3.9686, 0]
    }

    // The hangar's light: a small box hanging under the hood above the doors' crown, its aft face lit along its
    // upper part.  Its top is buried in the hood's shell, and its foot clears the doors.
    cube {
        scale [0.035, 0.08, 0.105]
        translate [14.435, -3.15, 0]
    }
    cube {
        scale [0.004, 0.0525, 0.095]
        translate [14.4702, -3.1475, 0]
        material {
            pigment [0.96, 0.8, 0.65]       // a warm white, (0.98, 0.90, 0.82) as it shows under one white light
            ambient 1
            diffuse 0
            specular 0
        }
    }

    // The lights on the deck's aft edge, as the studio model has them: a green bar 0.20 long in the middle,
    // and either side of it a red bar standing upright (0.165 out) and a red one lying along the edge (0.22
    // to 0.35 out).  The bars lying along it sit in the edge's upper part and the upright ones run most of
    // its depth.  Each is a plate 0.004 proud of the edge, following its curve: the deck's own shape a
    // little larger, trimmed to the light's outline.
    intersection {
        cylinder {
            min Y -4.2
            max Y -3.9
            scale [1.0495, 1, 1.0495]
            translate [13.8193, 0, 0]
        }
        cube {
            scale [0.2, 0.017, 0.10]
            translate [14.8, -4.027, 0]
        }
        material {
            pigment [0.08, 1, 0.3]         // as it shows under one white light
            ambient 1
            diffuse 0
            specular 0
        }
    }
    intersection {
        cylinder {
            min Y -4.2
            max Y -3.9
            scale [1.0495, 1, 1.0495]
            translate [13.8193, 0, 0]
        }
        union {
            cube {
                // upright, to port
                scale [0.2, 0.0475, 0.0175]
                translate [14.8, -4.0555, -0.165]
            }
            cube {
                // upright, to starboard
                scale [0.2, 0.0475, 0.0175]
                translate [14.8, -4.0555, 0.165]
            }
            cube {
                // lying along the edge, to port
                scale [0.2, 0.015, 0.0635]
                translate [14.8, -4.0273, -0.2845]
            }
            cube {
                // lying along the edge, to starboard
                scale [0.2, 0.015, 0.0635]
                translate [14.8, -4.0273, 0.2845]
            }
        }
        material {
            pigment [1, 0.08, 0.08]        // as it shows under one white light
            ambient 1
            diffuse 0
            specular 0
        }
    }

    lathe {
        // the homing beacon's collar, 0.59 across as the studio model's is: its foot sunk into the hull, whose
        // top slopes under it, but not through the hood's shell, which runs under its aft edge, and its top
        // level with the strip's, which runs into it
        path {
            move to 0, -3.0620
            line to 0.2950, -3.0620
            line to 0.2950, -2.9935
            curve 0.2950, -2.9687, 0.2749, -2.9487 to 0.2502, -2.9487
            line to 0, -2.9487
            close
        }
        translate [14.1368, 0, 0]
    }
    lathe {
        // and its lamp: a spherical cap 0.49 across and 0.152 high, standing on the collar, and green, both as
        // the studio model's is, in the starboard running light's green
        path {
            move to 0, -2.9555
            line to 0.2450, -2.9555
            line to 0.2450, -2.9487
            curve 0.1989, -2.8556, 0.1039, -2.7967 to 0.0000, -2.7967
            close
        }
        translate [14.1368, 0, 0]
        material {
            pigment [0.08, 1, 0.3]         // as it shows under one white light
            ambient 1
            diffuse 0
            specular 0
        }
    }

    // The strip along the top, from the homing beacon forward until it runs under the dorsal: FJ's top view
    // draws its two edges either side of the centerline, 0.19 apart, and the studio model has it as a flat
    // strip standing proud of the hull, 0.035 -- enough to read in a flat light -- with a groove down its
    // middle, on the hull's centerline, 0.02 wide and 0.02 deep.  It follows the hull's top line -- the
    // tube's, then the stern's -- and across its width it is flat, which on a hull this round leaves its
    // edges 0.004 further proud than its middle.  Its foot is buried in the hull, its forward end in the
    // dorsal and its aft end in the beacon's collar, which stands on it, level with its top.
    difference {
        extrusion {
            path {
                move to 8.3000, -2.5348
                line to 8.6000, -2.5582
                line to 8.9000, -2.5810
                line to 9.1885, -2.6019
                line to 9.5000, -2.6241
                line to 9.8000, -2.6463
                line to 10.1000, -2.6688
                line to 10.4000, -2.6914
                line to 10.7000, -2.7136
                line to 11.0837, -2.7410
                line to 13.9000, -2.9486
                line to 13.9000, -3.1336
                line to 11.0837, -2.9260
                line to 10.7000, -2.8986
                line to 10.4000, -2.8764
                line to 10.1000, -2.8538
                line to 9.8000, -2.8313
                line to 9.5000, -2.8091
                line to 9.1885, -2.7869
                line to 8.9000, -2.7660
                line to 8.6000, -2.7432
                line to 8.3000, -2.7198
                close
            }
            min Y -0.095
            max Y 0.095
            rotate X -90
        }
        extrusion {
            // the groove
            path {
                move to 8.2500, -2.3659
                line to 8.6000, -2.3932
                line to 8.9000, -2.4160
                line to 9.1885, -2.4369
                line to 9.5000, -2.4591
                line to 9.8000, -2.4813
                line to 10.1000, -2.5038
                line to 10.4000, -2.5264
                line to 10.7000, -2.5486
                line to 11.0837, -2.5760
                line to 13.9500, -2.7873
                line to 13.9500, -2.9723
                line to 11.0837, -2.7610
                line to 10.7000, -2.7336
                line to 10.4000, -2.7114
                line to 10.1000, -2.6888
                line to 9.8000, -2.6663
                line to 9.5000, -2.6441
                line to 9.1885, -2.6219
                line to 8.9000, -2.6010
                line to 8.6000, -2.5782
                line to 8.2500, -2.5509
                close
            }
            min Y -0.01
            max Y 0.01
            rotate X -90
        }
    }

    // And on it, a unit forward of the beacon, the small red lamp the studio model carries there: a dome
    // 0.07 across and 0.044 high.
    sphere {
        scale 0.036
        translate [13.15, -2.8844, 0]
        material {
            pigment [1, 0.08, 0.08]        // as it shows under one white light
            ambient 1
            diffuse 0
            specular 0
        }
    }
}


// -- Enterprise ---------------------------------------------------------------------------------------

// The whole ship, turned to face +X, her middle moved to the origin and scaled to `long` meters
// overall.  Her middle is the middle of her box: 29.6117 long from the saucer's rim (x = -6.3125) to
// the nacelles' end caps (x = 23.2992), and from the bottom of the secondary hull (y = -5.6066) to the
// top of the nacelles' collars (y = 1.8853).
primitive Enterprise(long = 289, variant = 1) -> group {
    size = long / 29.6117

    return group {
        object EnterpriseSaucer
        object EnterpriseSecondaryHull
        translate [-8.4934, 1.8607, 0]
        rotate Y 180
        scale [size, size, size]
    }
}
