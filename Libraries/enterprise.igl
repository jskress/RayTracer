        tube {
            // the cylinder: from inside the box, straight aft along the line FJ draws for it, then bending
            // down through the recess floor into the nacelle.  It stands clear of the floor until the bend.
            radius 0.0913 at [0.1723, 0, -1.0351]
            radius 0.0913 at [2.8946, 0, -0.9145]
            quad radius 0.0913 at [3.1013, 0, -0.9053]  radius 0.0913 at [3.3339, 0, -0.5858]
        }

        extrusion {
