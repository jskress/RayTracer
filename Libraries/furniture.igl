// What a room is furnished with: the things people sit at, eat off and put things on.
//
//     import 'furniture' { DiningTable, Armchair, KitchenRun, Bed, FurnitureOak }
//
//     object DiningTable(60)                   // five feet, and thirty inches to the top
//     object DiningTable(36, 36, FurnitureOak) // a square one
//     object Armchair()                        // the default is a chair's own size
//     object KitchenRun(96, 2)                 // eight feet, with a sink in the third unit
//     object Bed(60)                           // a queen; 38 is a twin and 76 a king
//
// | `DiningTable` | A table to eat at: top, apron and four legs. |
// | `DiningChair` | One to sit at it on. |
// | `LowTable` | The low one in front of a sofa. |
// | `Sideboard` | A carcase on short legs, to stand against a wall. |
// | `Armchair` | A seat, a back, two arms and four feet. |
// | `Sofa` | The armchair, gone long, with cushions. |
// | `Bookcase` | Sides, shelves, and as many books as fit. |
// | `Desk` | A table to work at, with a pedestal of drawers under one end. |
// | `KitchenRun` | A length of base cabinets under one continuous counter. |
// | `WallCabinets` | The ones that hang over it. |
// | `Range` | A cooker, flush with the counter. |
// | `Refrigerator` | The tallest thing in a kitchen. |
// | `Bed` | Frame, headboard, mattress, cover and two pillows. |
// | `Wardrobe` | A tall carcase with two doors and a cornice. |
// | `Dresser` | A chest of drawers. |
// | `Nightstand` | The little one beside the bed. |
//
// -- Three things that hold for everything here ---------------------------------------------------
//
// **It is written in inches, and a scene unit IS an inch.**  The [trains](#trains) are in meters and
// the [brick](#buildings) is in inches, and the reason is the same for both: a thing with real
// dimensions should be written in the units it is actually sold in, so the numbers can be checked
// against a tape measure rather than against each other.  Furniture is sold in inches -- a sixty-inch
// table, a seventy-two-inch sofa -- so that is what these take.  A room is a hundred and forty-four
// units across, which is twelve feet, and reads as such.
//
// **A piece stands on `y = 0` and grows upward**, so it drops onto a floor at the origin without a
// height to work out, the same as the [street furniture](#street-furniture) does.
//
// **The height does not follow the first number.**  Everywhere else in these libraries the first
// argument scales the whole thing; here it is the size of the *top*, and the height is whatever that
// kind of furniture is.  A table twice as long is not twice as tall -- it is a table for more people,
// at the same thirty inches as every other table, because the people are the same size.  Getting this
// wrong is what makes a rendered room feel like a doll's house without anyone being able to say why.
//
// The heights are the real ones, and they are worth knowing because they are not guesses: a dining
// table and a desk are both **thirty inches**, a low table is **eighteen**, a sideboard is **thirty-
// two**, and a chair seat is **seventeen**, which is the height of the back of a knee.
//
// -- What it is made of ---------------------------------------------------------------------------

// Oak: the pale, open-grained wood most furniture in a room is.
//
// **The rings run along X, and that is which way round the grain lies.**  A `wood` pattern is rings
// about an axis, so any face square to that axis shows them as circles -- end grain.  Left the way
// it comes, a sideboard's front and a desk's pedestal came out as swirled blotches, which is what
// the end of a plank looks like and not its face.  Along X the grain runs the length of a piece,
// which is how furniture is cut, and only the ends show rings.
//
// **The axis is Z and the radius is taken in X-Y**, so turning the grain along X takes a `rotate Y
// 90` and nothing else will do it.  Stretching X instead -- `scale [120, 0.5, 0.5]`, which looks
// like it ought to lie the rings down along X -- only makes them enormously elongated ellipses that
// are still about Z, and the grain that comes out is both the wrong way round and almost too faint
// to see.  It is worth saying because the wrong version renders: it is wood-colored, it has a hint
// of figure in it, and there is nothing in the picture that says it is not wood.
//
// **And the axis is lifted to `y = 26`, which is the one number here that is not a dimension.**  Left
// on the origin the axis runs along the *floor*, and a tabletop is then twenty-nine inches off it --
// so the surface crosses the rings almost tangentially, and the grain arrives stretched into bands
// inches apart that read as a stain rather than as wood.  Lifted to twenty-six the axis runs through
// the pieces themselves: near the middle of a sideboard, just under a table's top.  That is where a
// flat-sawn board's cathedral figure comes from -- the arch a plank shows when the saw passed close
// to the heart of the log -- and it is the difference between a table that is brown and a table that
// is wooden.

FurnitureOak = material {
    pigment wood {
        turbulence { amplitude 0.26  octaves 3 }
        [0, [0.52, 0.38, 0.23], 0.5, [0.44, 0.31, 0.18],
         0.82, [0.34, 0.23, 0.13], 1, [0.52, 0.38, 0.23]]
        scale [0.5, 0.5, 90]
        rotate Y 90
        translate [0, 26, 0]
    }
    specular 0.30  shininess 50  ambient 0.12  reflective 0.03
}

// Walnut: darker, for a piece meant to sit apart from the rest of the room.
FurnitureWalnut = material {
    pigment wood {
        turbulence { amplitude 0.30  octaves 3 }
        [0, [0.27, 0.16, 0.10], 0.5, [0.20, 0.12, 0.07],
         0.82, [0.14, 0.08, 0.05], 1, [0.27, 0.16, 0.10]]
        scale [0.45, 0.45, 80]
        rotate Y 90
        translate [0, 26, 0]
    }
    specular 0.36  shininess 65  ambient 0.10  reflective 0.05
}

// Linen, for what a chair is covered in.
FurnitureLinen = material {
    pigment [0.55, 0.50, 0.44]
    specular 0.06  shininess 12  ambient 0.16
}

// Stone, for a kitchen counter.  Speckled rather than plain, because a plain counter reads as
// plastic: what says stone is that the grain is finer than anything else in the room.
FurnitureStone = material {
    pigment granite {
        [0, [0.13, 0.12, 0.12], 0.42, [0.21, 0.20, 0.19],
         0.74, [0.34, 0.32, 0.30], 1, [0.13, 0.12, 0.12]]
        scale [2.2, 2.2, 2.2]
    }
    specular 0.55  shininess 140  ambient 0.11  reflective 0.06
}

// Steel, for the things in a kitchen that are not made of wood.
//
// **Its reflectivity is what makes it metal, not its color, and its color has to be DARK.**  The
// first try was a light gray -- roughly what stainless looks like to the eye -- and under a working
// light it went to white and took every edge on the appliance with it: the door lines, the handles
// and the oven front all disappeared into one blank panel.  A metal is dark and gets its brightness
// back from what it reflects, which is also the only reason an appliance is recognizable across a
// room: it carries a dim, distorted picture of that room on its door.
FurnitureSteel = material {
    pigment [0.30, 0.31, 0.33]
    specular 0.70  shininess 190  ambient 0.10  reflective 0.24
}

// -- Dining table ---------------------------------------------------------------------------------

// A table to eat at.  `long` is how far it runs and `wide` how far across -- leave `wide` out for a
// square one.  Thirty inches to the top.
//
// The apron is the rail under the top that the legs are joined to, set in from the edge.  **It is
// worth the two cubes it costs.**  A top on four legs with nothing between them reads as a trestle,
// and the gap under the edge is the first thing the eye uses to tell a table from a board laid across
// supports.
primitive DiningTable(long, wide = 0, coat = FurnitureOak) -> group {
    across = wide > 0 ? wide : long

    return group {
        union {
            // the top: an inch and a half thick, its surface at thirty
            cube { scale [long / 2, 0.75, across / 2]  translate [0, 29.25, 0] }

            // the apron: three and a half deep, set in two inches from the edge
            difference {
                cube { scale [long / 2 - 2, 1.75, across / 2 - 2]  translate [0, 26.75, 0] }
                cube { scale [long / 2 - 2.9, 2.2, across / 2 - 2.9]  translate [0, 26.75, 0] }
            }

            // Four legs, two and three-quarters square, their outer faces under the apron.
            //
            // **Turning one leg about Y through four quarters only works for a square top.**  A
            // quarter turn swaps the two extents, so on a table longer than it is wide it puts two
            // legs out past the ends and two in under the middle.  The corner is picked apart
            // instead, which does not care what shape the top is.
            group {
                for corner in [0, 3] {
                    cube {
                        scale [1.375, 12.5, 1.375]
                        translate [(corner % 2 * 2 - 1) * (long / 2 - 3.375), 12.5,
                                   (floor(corner / 2) * 2 - 1) * (across / 2 - 3.375)]
                    }
                }
            }
        }
        material coat
    }
}

// -- Low table ------------------------------------------------------------------------------------

// The one in front of a sofa: eighteen inches to the top, which is a seat's height and not a table's,
// because what it is for is reaching down to rather than sitting at.  No apron -- a low table is
// meant to be seen under, and a rail there would close it up.
primitive LowTable(long, wide = 0, coat = FurnitureOak) -> group {
    across = wide > 0 ? wide : long * 0.55

    return group {
        union {
            cube { scale [long / 2, 0.5, across / 2]  translate [0, 17.5, 0] }

            group {
                for corner in [0, 3] {
                    cube {
                        scale [0.875, 8.5, 0.875]
                        translate [(corner % 2 * 2 - 1) * (long / 2 - 2.375), 8.5,
                                   (floor(corner / 2) * 2 - 1) * (across / 2 - 2.375)]
                    }
                }
            }
        }
        material coat
    }
}

// -- Sideboard ------------------------------------------------------------------------------------

// A carcase on short legs, against a wall: thirty-two inches to the top and eighteen deep, which is
// what one is.  **The depth does not follow the length**, for the same reason the height does not: a
// sideboard is as deep as a person's reach across it, however long the wall it stands along.
//
// It faces `+Z`, so its back goes to a wall behind it.
primitive Sideboard(long, coat = FurnitureOak) -> group {
    return group {
        union {
            // the carcase, from six inches up to thirty-two
            cube { scale [long / 2, 13, 9]  translate [0, 19, 0] }

            // a plinth rail under it, so it does not read as a box floating on sticks
            cube { scale [long / 2 - 0.75, 0.9, 8.2]  translate [0, 5.1, 0] }

            group {
                for corner in [0, 3] {
                    cube {
                        scale [1.1, 3, 1.1]
                        translate [(corner % 2 * 2 - 1) * (long / 2 - 2.2), 3,
                                   (floor(corner / 2) * 2 - 1) * 7]
                    }
                }
            }

            // two doors, given away by the line between them
            group {
                for door in [0, 1] {
                    difference {
                        cube { scale [long / 4 - 0.7, 12.2, 0.3]  translate [0, 0, 9.1] }
                        cube { scale [long / 4, 12.6, 0.16]  translate [0, 0, 9.4] }
                        translate [(door * 2 - 1) * (long / 4), 19, 0]
                    }
                }
            }
        }
        material coat
    }
}

// -- Armchair -------------------------------------------------------------------------------------

// A seat, a back, two arms and four feet.  `wide` is across the arms; the seat sits at seventeen
// inches whatever the chair's width, because that is the height of the back of a knee.
primitive Armchair(wide = 32, cloth = FurnitureLinen, coat = FurnitureOak) -> group {
    deep = wide * 0.98
    inner = wide / 2 - 4

    return group {
        group {
            // **The base is a block, not a slab on legs.**  Drawn as a thin seat floating between
            // two arms, an armchair reads as three separate boards with daylight under them -- the
            // eye looks straight through where the upholstery should be.  A chair is a solid thing
            // with a seat on top of it, and the feet only lift it off the floor.
            //
            // **And the upholstery is superellipsoids rather than cubes.**  Everything else here is
            // boxes, because a table really is made of boards with square arrises -- but stuffing
            // has no sharp edge anywhere on it, and a chair drawn in cubes reads as a crate with a
            // cushion on it however well proportioned it is.  The exponents are small, which is a
            // box with its edges taken off: 0.25 on the base and back, and 0.38 on the arms because
            // an arm is the roundest part of a chair and the part a hand actually goes on.
            superellipsoid {
                east 0.25  north 0.25
                scale [inner + 2, 5.25, deep / 2]  translate [0, 11.75, 0]
            }

            // The back and the arms **sink into the base** rather than sitting on top of it.  Where
            // two cubes meeting face to face are joined, two superellipsoids are not: each one
            // curves away from the corner it shares, so an arm that rested exactly on the seat
            // floats, with daylight under it.  Both reach three inches below the seat's top face,
            // where the base has them; only their tops are where the chair's outline needs them.
            // The back runs the chair's full width for the same reason: ended at the arms' center
            // line it left a slot of daylight at each shoulder.
            superellipsoid {
                east 0.25  north 0.25
                scale [inner + 4, 8, 2.6]  translate [0, 23, deep / 2 - 2.6]
            }

            // an arm each side, their tops at twenty-four
            superellipsoid {
                east 0.38  north 0.38
                scale [2, 5, deep / 2]  translate [-(inner + 2), 19, 0]
            }
            superellipsoid {
                east 0.38  north 0.38
                scale [2, 5, deep / 2]  translate [inner + 2, 19, 0]
            }

            material cloth
        }

        group {
            for corner in [0, 3] {
                cube {
                    scale [1, 3.25, 1]
                    translate [(corner % 2 * 2 - 1) * (wide / 2 - 2.4), 3.25,
                               (floor(corner / 2) * 2 - 1) * (deep / 2 - 2.4)]
                }
            }
            material coat
        }
    }
}

// -- Desk -----------------------------------------------------------------------------------------

// A table to work at, which is a table with a pedestal of drawers under one end.  Thirty inches, like
// the dining table, since a desk and a dining table are the same height and always have been.
//
// The pedestal is on `-X`; turn the desk if you want it the other way about.
primitive Desk(long, wide = 28, coat = FurnitureOak) -> group {
    return group {
        union {
            cube { scale [long / 2, 0.625, wide / 2]  translate [0, 29.375, 0] }

            // the pedestal, with three drawer lines cut across its face
            difference {
                cube { scale [7.25, 14.375, wide / 2 - 1.2]  translate [-(long / 2 - 8), 14.375, 0] }

                group {
                    for drawer in [0, 2] {
                        cube {
                            scale [7.6, 0.2, 0.16]
                            translate [-(long / 2 - 8), 8 + drawer * 8, wide / 2 - 1.3]
                        }
                    }
                }
            }

            // and a leg at the far end, with a rail tying it back to the pedestal
            cube { scale [1.25, 14.375, 1.25]  translate [long / 2 - 3, 14.375, wide / 2 - 3] }
            cube { scale [1.25, 14.375, 1.25]  translate [long / 2 - 3, 14.375, -(wide / 2 - 3)] }
            cube { scale [1, 1.2, wide / 2 - 3]  translate [long / 2 - 3, 27.55, 0] }
        }
        material coat
    }
}

// -- Dining chair ---------------------------------------------------------------------------------

// Something to sit at the dining table on.  `wide` is across the seat; the seat is at **eighteen**
// inches and not the seventeen an armchair is, because a chair you eat at is drawn up to a thirty-inch
// table and a chair you sit back in is not.  An inch is the whole difference and it is the right inch.
//
// **The back posts are the back legs**, in one piece from the floor to the top rail.  That is how a
// chair is actually made, and it is also the only way it holds together: back legs that stop under the
// seat, with a separate back stood on top of them, read as a stool with a board behind it -- the eye
// picks up the join even when it cannot see it, because nothing else in a room has that break in it.
primitive DiningChair(wide = 18, cloth = FurnitureLinen, coat = FurnitureOak) -> group {
    deep = wide * 0.92
    post = 0.7                          // half a leg
    pad = 16.5                          // where the upholstery starts
    top = 34                            // the top of the back

    return group {
        group {
            // the two front legs, which stop under the seat
            for side in [0, 1] {
                cube {
                    scale [post, pad / 2, post]
                    translate [(side * 2 - 1) * (wide / 2 - post), pad / 2, -(deep / 2 - post)]
                }
            }

            // and the two back ones, which do not
            for side in [0, 1] {
                cube {
                    scale [post, top / 2, post]
                    translate [(side * 2 - 1) * (wide / 2 - post), top / 2, deep / 2 - post]
                }
            }

            // the frame the seat sits in
            cube { scale [wide / 2 - 0.15, 0.55, deep / 2 - 0.15]  translate [0, 15.95, 0] }

            // the top rail, and one slat below it
            cube { scale [wide / 2 - post, 1.5, 0.45]  translate [0, top - 1.5, deep / 2 - post] }
            cube { scale [wide / 2 - post, 1.1, 0.40]  translate [0, 26.5, deep / 2 - post] }

            material coat
        }

        // The seat, which is a pad and so is rounded, like the armchair and for the same reason.
        superellipsoid {
            east 0.3  north 0.3
            scale [wide / 2, 0.9, deep / 2]
            translate [0, pad + 0.75, 0]
            material cloth
        }
    }
}

// -- Sofa -----------------------------------------------------------------------------------------

// The armchair, gone long.  `long` is across the arms; the seat is at seventeen and the back at
// thirty-one, the same as the chair's, because a sofa is not a taller chair -- it is a wider one.
//
// **What a sofa needs that a chair does not is cushions**, and the reason is length.  An armchair's
// seat is one cushion's worth wide, so a single upholstered block reads as one.  Stretch that block to
// six feet and it reads as a bench with padding on it: there is nothing to say how many people it is
// for.  The cushions are what say so, and the gaps between them do the saying -- which is why they are
// separate shapes with real gaps rather than lines cut into one.
primitive Sofa(long = 78, cloth = FurnitureLinen, coat = FurnitureOak) -> group {
    deep = 36
    arm = 3.2                                       // half an arm
    seats = long < 60 ? 2 : floor(long / 30)
    span = long - arm * 4                           // the width the cushions have between the arms
    wide = span / seats                             // and so one cushion's pitch

    return group {
        group {
            // the base, whose top is below the seat because the cushions make up the rest
            superellipsoid {
                east 0.25  north 0.25
                scale [long / 2 - 1.5, 3.9, deep / 2]  translate [0, 10.3, 0]
            }

            // the back, and an arm each side, both sinking into the base as the armchair's do
            superellipsoid {
                east 0.25  north 0.25
                scale [long / 2, 8.4, 2.8]  translate [0, 22.6, deep / 2 - 2.8]
            }
            for side in [0, 1] {
                superellipsoid {
                    east 0.38  north 0.38
                    scale [arm, 5.2, deep / 2]
                    translate [(side * 2 - 1) * (long / 2 - arm), 18.8, 0]
                }
            }

            // The seat cushions, each sinking an inch into the base for the reason every other joint
            // here does: two superellipsoids that merely touch do not meet.
            for seat in [0, seats - 1] {
                superellipsoid {
                    east 0.30  north 0.30
                    scale [wide / 2 - 0.5, 2.0, deep / 2 - 3.6]
                    translate [-span / 2 + wide * (seat + 0.5), 15.2, -1.2]
                }
            }

            // and one cushion standing against the back behind each of them
            for seat in [0, seats - 1] {
                superellipsoid {
                    east 0.34  north 0.34
                    scale [wide / 2 - 0.5, 5.4, 1.7]
                    translate [-span / 2 + wide * (seat + 0.5), 22.4, deep / 2 - 7.0]
                }
            }

            material cloth
        }

        group {
            for corner in [0, 3] {
                cube {
                    scale [1, 3.2, 1]
                    translate [(corner % 2 * 2 - 1) * (long / 2 - 3), 3.2,
                               (floor(corner / 2) * 2 - 1) * (deep / 2 - 3)]
                }
            }
            material coat
        }
    }
}

// -- Bookcase -------------------------------------------------------------------------------------

// Sides, a top, a plinth, a back and as many shelves as will fit.  `long` is across and `high` is up,
// and this is the one piece here whose height *is* an argument -- a bookcase is the only thing in a
// room that is built to the wall it stands against rather than to the person using it.
//
// It faces `+Z`, like the sideboard.
//
// **The shelves are counted, not measured.**  A shelf wants about a foot over it, so the count is what
// divides into the height and the spacing is whatever that leaves -- which is how a bookcase is really
// built.  Asking for a fixed twelve inches instead leaves a short remainder at the top on almost every
// height, and a bookcase with one stunted shelf under its lid looks like a mistake, because it is one.
primitive Bookcase(long = 36, high = 60, books = 1, coat = FurnitureOak) -> group {
    deep = 11
    board = 0.375                                   // half a board's thickness
    plinth = 3
    shelves = floor((high - plinth) / 12)
    gap = (high - plinth - board * 2) / shelves     // from one shelf's top to the next

    return group {
        group {
            // the two sides, the top, and the plinth the whole thing stands on
            for side in [0, 1] {
                cube {
                    scale [board, (high - plinth) / 2, deep / 2]
                    translate [(side * 2 - 1) * (long / 2 - board), plinth + (high - plinth) / 2, 0]
                }
            }
            cube { scale [long / 2, board, deep / 2]  translate [0, high - board, 0] }
            cube { scale [long / 2 - 0.4, plinth / 2, deep / 2 - 0.4]  translate [0, plinth / 2, 0] }

            // the back, which is thin because a bookcase's back is
            cube {
                scale [long / 2 - board, (high - plinth) / 2, 0.2]
                translate [0, plinth + (high - plinth) / 2, -(deep / 2 - 0.2)]
            }

            // and the shelves, the topmost of which is the underside of the lid and so is not drawn
            for shelf in [0, shelves - 1] {
                cube {
                    scale [long / 2 - board, 0.28, deep / 2 - 0.3]
                    translate [0, plinth + shelf * gap, 0.3]
                }
            }

            material coat
        }

        // **The books are what make it a bookcase**, and they are cheap: one cube each, stood at an
        // even pitch with uneven widths, so the gaps come out irregular without anything having to
        // work out where one book ends and the next begins.  Their heights and colors are `random`
        // rather than arithmetic on the index, because arithmetic on an index repeats, and a repeat
        // down a shelf is the one thing that says at a glance these are not books.
        if (books > 0) {
            group {
                for shelf in [0, shelves - 1] {
                    for book in [0, floor((long - 2.4) / 1.05) - 1] {
                        cube {
                            material {
                                pigment [0.12 + random(shelf, book, 11) * 0.34,
                                         0.09 + random(shelf, book, 12) * 0.22,
                                         0.08 + random(shelf, book, 13) * 0.26]
                                specular 0.10  shininess 25  ambient 0.11
                            }
                            scale [0.32 + random(shelf, book, 14) * 0.18,
                                   4.1 + random(shelf, book, 15) * 1.4, deep / 2 - 1.6]
                            translate [-(long - 2.4) / 2 + 1.05 * (book + 0.5),
                                       plinth + shelf * gap + 4.38 + random(shelf, book, 15) * 1.4,
                                       0.1]
                        }
                    }
                }
            }
        }
    }
}

// -- The kitchen ----------------------------------------------------------------------------------
//
// **A kitchen is a run, not a set of pieces.**  Everywhere else in this library a call gives you one
// thing you could carry.  Here a call gives you a length of wall, because that is what a kitchen is
// sold and fitted as, and because a counter is the one surface in a house that is deliberately
// continuous -- units butt up under a single slab and the joins are meant not to show.  Asking for
// cabinets one at a time and laying a counter over them is how a kitchen is *built*, but it puts the
// scene author in the business of making the seams line up, and the first seam that does not is the
// one thing in the render that says this is not a kitchen.
//
// The standard heights, which are standard everywhere and worth not guessing at: a counter is
// **thirty-six inches** and **twenty-four deep**, wall cabinets hang with their bottoms **eighteen
// inches above it** -- fifty-four off the floor -- and are **twelve deep**, so you can stand at the
// counter without meeting them.  A range sits flush at thirty-six.

// A run of base cabinets under one continuous counter.  `long` is how far it runs; `sink` is which
// unit holds the sink, counting from the left from zero, or -1 for a run without one.
primitive KitchenRun(long = 96, sink = -1, coat = FurnitureOak, top = FurnitureStone) -> group {
    deep = 24
    counter = 36                                    // the top surface
    kick = 4                                        // the height of the recess it stands on
    units = floor(long / 24 + 0.5) < 1 ? 1 : floor(long / 24 + 0.5)
    wide = long / units
    at = -long / 2 + wide * (sink + 0.5)            // the middle of the sink's unit
    bowl = wide / 2 - 3 > 13 ? 13 : wide / 2 - 3    // and half the bowl it will take

    return group {
        group {
            // the carcase, standing on a recessed kick so the run does not look like a wall
            cube { scale [long / 2, (counter - 1.5 - kick) / 2, deep / 2]
                   translate [0, kick + (counter - 1.5 - kick) / 2, 0] }
            cube { scale [long / 2, kick / 2, deep / 2 - 3]  translate [0, kick / 2, -1.5] }

            // a drawer over a door in each unit, standing proud of the carcase as fronts do
            group {
                for unit in [0, units - 1] {
                    difference {
                        cube { scale [wide / 2 - 0.75, 2.6, 0.55]
                               translate [-long / 2 + wide * (unit + 0.5), 30.9, deep / 2 + 0.55] }
                        cube { scale [wide / 2 - 2.2, 0.35, 0.3]
                               translate [-long / 2 + wide * (unit + 0.5), 30.9, deep / 2 + 1.2] }
                    }
                    cube { scale [wide / 2 - 0.75, 10.8, 0.55]
                           translate [-long / 2 + wide * (unit + 0.5), 16.2, deep / 2 + 0.55] }
                }
            }

            material coat
        }

        // **The counter is a difference whether or not there is a sink in it.**  A `group` holding an
        // `if` is a legal thing to subtract and an empty one subtracts nothing, so the run does not
        // need two spellings of its counter for the two cases.
        difference {
            cube { scale [long / 2, 0.75, deep / 2]  translate [0, counter - 0.75, 0] }
            group {
                if (sink >= 0) {
                    cube { scale [bowl, 2, 8]  translate [at, counter - 0.75, 1] }
                }
            }
            material top
        }

        group {
            if (sink >= 0) {
                // the bowl, hung under the hole, and a faucet standing behind it
                difference {
                    cube { scale [bowl, 4.75, 8]  translate [at, counter - 5.5, 1] }
                    cube { scale [bowl - 0.5, 4.5, 7.5]  translate [at, counter - 5, 1] }
                }
                cylinder {
                    min Y 0  max Y 10
                    scale [0.5, 1, 0.5]  translate [at, counter, -9]
                }
                cylinder {
                    min Y 0  max Y 5.5
                    scale [0.35, 1, 0.35]  rotate X 90  translate [at, counter + 9.5, -9]
                }
            }

            // **The material belongs to the group and not inside the `if`.**  Only surfaces may stand
            // in one; a material, a transform or a name is the surrounding group's business.
            material FurnitureSteel
        }
    }
}

// The cabinets over it: `long` is the run they hang along, and they hang themselves -- their bottoms
// at fifty-four, which is eighteen inches of backsplash over a thirty-six-inch counter.
primitive WallCabinets(long = 96, coat = FurnitureOak) -> group {
    deep = 12
    foot = 54                                       // where the bottoms hang
    high = 30
    units = floor(long / 24 + 0.5) < 1 ? 1 : floor(long / 24 + 0.5)
    wide = long / units

    return group {
        union {
            cube { scale [long / 2, high / 2, deep / 2]  translate [0, foot + high / 2, 0] }

            group {
                for unit in [0, units - 1] {
                    difference {
                        cube { scale [wide / 2 - 0.75, high / 2 - 0.8, 0.55]
                               translate [-long / 2 + wide * (unit + 0.5), foot + high / 2, deep / 2 + 0.55] }
                        cube { scale [wide / 2 - 2.4, high / 2 - 2.6, 0.3]
                               translate [-long / 2 + wide * (unit + 0.5), foot + high / 2, deep / 2 + 1.2] }
                    }
                }
            }
        }
        material coat
    }
}

// A range: thirty inches across and flush with the counter at thirty-six, with four burners on it and
// an oven under it.  The back panel is what tells it apart from a cabinet at any distance.
primitive Range(coat = FurnitureSteel) -> group {
    wide = 30
    deep = 26

    return group {
        union {
            cube { scale [wide / 2, 16, deep / 2]  translate [0, 20, 0] }

            // the oven door, and its handle across the front
            difference {
                cube { scale [wide / 2 - 0.6, 9, 0.5]  translate [0, 17, deep / 2 + 0.5] }
                cube { scale [wide / 2 - 4, 6, 0.4]  translate [0, 17, deep / 2 + 1.1] }
            }
            cylinder {
                min Y 0  max Y (wide - 5)
                scale [0.55, 1, 0.55]  rotate Z 90
                // **`rotate Z 90` sends the cylinder's length down -X**, so it is centered by
                // translating the POSITIVE half-length, not the negative one.  Getting the sign
                // wrong here put the handle a whole range's width off to one side, lying across the
                // counter beside it, which reads as a rail rather than as a mistake.
                translate [(wide - 5) / 2, 27.5, deep / 2 + 1.8]
            }

            // the back panel, which is the shape that says range rather than cupboard
            cube { scale [wide / 2, 4, 0.75]  translate [0, 40, -(deep / 2 - 0.75)] }

            // four burners
            group {
                for burner in [0, 3] {
                    cylinder {
                        min Y 0  max Y 0.4
                        scale [3.6, 1, 3.6]
                        translate [(burner % 2 * 2 - 1) * 7, 36, (floor(burner / 2) * 2 - 1) * 6]
                    }
                }
            }
        }
        material coat
    }
}

// A refrigerator: thirty-four across, sixty-eight up, thirty deep, with the freezer on top.  It is the
// tallest thing in a kitchen and the only one that is not part of a run, so it reads as furniture.
primitive Refrigerator(coat = FurnitureSteel) -> group {
    wide = 34
    high = 68
    deep = 30
    split = 46                                      // where the freezer door ends and the other starts

    return group {
        union {
            cube { scale [wide / 2, high / 2, deep / 2]  translate [0, high / 2, 0] }

            // the two doors, given away by the line between them
            cube { scale [wide / 2 - 0.3, (high - split - 1.5) / 2, 0.5]
                   translate [0, split + 1 + (high - split - 1.5) / 2, deep / 2 + 0.5] }
            cube { scale [wide / 2 - 0.3, (split - 3) / 2, 0.5]
                   translate [0, 2 + (split - 3) / 2, deep / 2 + 0.5] }

            // and a handle beside each, the length of the door it opens
            group {
                for door in [0, 1] {
                    cylinder {
                        min Y 0  max Y (door > 0 ? high - split - 6 : split - 8)
                        scale [0.55, 1, 0.55]
                        translate [wide / 2 - 3.5,
                                   door > 0 ? split + 4 : 5,
                                   deep / 2 + 1.9]
                    }
                }
            }
        }
        material coat
    }
}

// -- The bedroom ----------------------------------------------------------------------------------

// A bed.  `wide` is across the mattress -- 38 is a twin, 54 a full, 60 a queen, 76 a king -- and the
// length is eighty whichever you ask for, because a bed is made longer only for taller people and not
// for wider ones.  The mattress top is at **twenty-five**, which is a seat's height plus the bedding.
//
// **The headboard is at `-Z`, so the wall goes behind it**, the same way round as the sideboard and
// the bookcase.  You get out of it toward `+Z`.
primitive Bed(wide = 60, cloth = FurnitureLinen, coat = FurnitureOak) -> group {
    long = 80
    deck = 15                                       // the platform the mattress lies on

    return group {
        group {
            // the headboard, and the frame around the deck
            cube { scale [wide / 2 + 1.5, 12, 1]  translate [0, 36, -(long / 2 + 1)] }
            difference {
                cube { scale [wide / 2 + 1, (deck - 6) / 2 + 1, long / 2 + 1]
                       translate [0, 6 + (deck - 6) / 2, 0] }
                cube { scale [wide / 2, deck, long / 2]  translate [0, 6 + (deck - 6) / 2 + 2, 0] }
            }

            group {
                for corner in [0, 3] {
                    cube {
                        scale [1.2, 3, 1.2]
                        translate [(corner % 2 * 2 - 1) * (wide / 2 - 0.5), 3,
                                   (floor(corner / 2) * 2 - 1) * (long / 2 - 0.5)]
                    }
                }
            }

            material coat
        }

        // **The mattress and the pillows are white and only the cover takes the `cloth`.**  Drawn all
        // one material -- which is what `cloth` for the whole bed gives you -- a made bed comes back
        // as a single rounded slab: the cover is there, it is just the same color as what it lies on,
        // so nothing in the picture says the bed is made rather than bare.  Bedding is white anyway,
        // and it is the one place in this library where a fixed material is more right than an
        // argument.
        group {
            // **The mattress sinks into the deck rather than resting on it**, for the reason every
            // rounded thing in this library does: a superellipsoid curves away from the corner it
            // shares, so one laid exactly on the frame floats at its edges.
            //
            // Its exponents are small.  At 0.28 it came out rounded like something inflatable; a
            // mattress is a box whose edges have been softened, and 0.16 is that.
            superellipsoid {
                east 0.16  north 0.16
                scale [wide / 2, 5.5, long / 2]  translate [0, 19.5, 0]
            }

            for side in [0, 1] {
                superellipsoid {
                    east 0.45  north 0.45
                    scale [wide / 4 - 1.5, 2.4, 6.5]
                    translate [(side * 2 - 1) * (wide / 4), 27, -(long / 2 - 8)]
                }
            }

            material {
                pigment [0.84, 0.83, 0.79]
                specular 0.05  shininess 10  ambient 0.17
            }
        }

        // the cover, turned down short of the pillows, and wider than the mattress so it hangs over
        superellipsoid {
            east 0.30  north 0.30
            scale [wide / 2 + 1.8, 4.0, long / 2 - 12]  translate [0, 23.8, 9]
            material cloth
        }
    }
}

// A wardrobe: seventy-two up, twenty-four deep, two doors and a cornice.  It faces `+Z`.
//
// **The cornice is the whole of why it reads as a wardrobe** and not as a very tall cupboard.  A
// carcase that stops dead at its top edge looks unfinished at this height in a way it does not at a
// sideboard's, because the top is above the eye and what you see is the underside of nothing.
primitive Wardrobe(long = 48, high = 72, coat = FurnitureOak) -> group {
    deep = 24
    plinth = 3

    return group {
        union {
            cube { scale [long / 2, (high - plinth - 1.4) / 2, deep / 2]
                   translate [0, plinth + (high - plinth - 1.4) / 2, 0] }
            cube { scale [long / 2 - 0.6, plinth / 2, deep / 2 - 0.5]  translate [0, plinth / 2, 0] }
            cube { scale [long / 2 + 0.8, 0.7, deep / 2 + 0.8]  translate [0, high - 0.7, 0] }

            group {
                for door in [0, 1] {
                    difference {
                        cube { scale [long / 4 - 0.6, (high - plinth - 3.4) / 2, 0.4]
                               translate [(door * 2 - 1) * (long / 4),
                                          plinth + 0.5 + (high - plinth - 3.4) / 2, deep / 2 + 0.4] }
                        cube { scale [long / 4 - 2.2, (high - plinth - 8) / 2, 0.3]
                               translate [(door * 2 - 1) * (long / 4),
                                          plinth + 0.5 + (high - plinth - 3.4) / 2, deep / 2 + 0.9] }
                    }
                    cylinder {
                        min Y 0  max Y 3
                        scale [0.3, 1, 0.3]
                        translate [(door * 2 - 1) * 1.8, high / 2 - 1.5, deep / 2 + 1.2]
                    }
                }
            }
        }
        material coat
    }
}

// A chest of drawers: thirty-two up and eighteen deep, in three courses.  `rows` says how many.
primitive Dresser(long = 54, rows = 3, coat = FurnitureOak) -> group {
    high = 32
    deep = 18
    plinth = 2.5
    course = (high - plinth - 1.2) / rows

    return group {
        union {
            cube { scale [long / 2, (high - plinth) / 2, deep / 2]
                   translate [0, plinth + (high - plinth) / 2, 0] }
            cube { scale [long / 2 - 0.5, plinth / 2, deep / 2 - 0.4]  translate [0, plinth / 2, 0] }

            // **Each front gets a recessed panel, and that is what makes the drawers visible.**  The
            // first version stood plain fronts eight tenths of an inch proud with a thin gap between
            // courses, which is about right for a real chest and renders as a plain box: across a
            // room that step is a pixel or two and the carcase behind it is lit the same as the front
            // in front of it.  A cut panel gives every drawer an edge that faces a different way, and
            // an edge facing a different way is the only thing that survives the distance.
            group {
                for row in [0, rows - 1] {
                    difference {
                        cube { scale [long / 2 - 0.8, course / 2 - 0.7, 0.6]
                               translate [0, plinth + course * (row + 0.5), deep / 2 + 0.6] }
                        cube { scale [long / 2 - 2.8, course / 2 - 2.3, 0.4]
                               translate [0, plinth + course * (row + 0.5), deep / 2 + 1.3] }
                    }

                    // two pulls to a drawer, which is what says drawer rather than door
                    for pull in [0, 1] {
                        cylinder {
                            min Y 0  max Y 4.5
                            scale [0.35, 1, 0.35]  rotate Z 90
                            translate [(pull * 2 - 1) * (long / 4) + 2.25,
                                       plinth + course * (row + 0.5), deep / 2 + 1.7]
                        }
                    }
                }
            }
        }
        material coat
    }
}

// A nightstand: eighteen across and twenty-five up, which is the height of the mattress beside it, so
// what is on it can be reached from the bed without sitting up.  That is the only dimension here
// derived from another piece rather than from a person.
primitive Nightstand(coat = FurnitureOak) -> group {
    wide = 18
    high = 25
    deep = 16

    return group {
        union {
            cube { scale [wide / 2, 0.5, deep / 2]  translate [0, high - 0.5, 0] }
            cube { scale [wide / 2 - 0.8, 4, deep / 2 - 0.5]  translate [0, high - 5.2, 0] }

            difference {
                cube { scale [wide / 2 - 1, 3.2, 0.55]  translate [0, high - 5.2, deep / 2 + 0.55] }
                cube { scale [wide / 2 - 2.6, 1.7, 0.4]  translate [0, high - 5.2, deep / 2 + 1.1] }
            }

            cube { scale [wide / 2 - 1.4, 0.35, deep / 2 - 1]  translate [0, 8, 0] }

            group {
                for corner in [0, 3] {
                    cube {
                        scale [0.85, (high - 1) / 2, 0.85]
                        translate [(corner % 2 * 2 - 1) * (wide / 2 - 0.85), (high - 1) / 2,
                                   (floor(corner / 2) * 2 - 1) * (deep / 2 - 0.85)]
                    }
                }
            }
        }
        material coat
    }
}
