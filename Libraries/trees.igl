}

primitive Poplar(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 12.75 above the ground for a 13.
    tall = height * 1.020

    // A Lombardy poplar: a column from near the ground to the top, its limbs held up close to the leader
    // by a strong lift toward the sky.
    return group {
        grown {
            crown {
                sphere { scale [tall * 0.12, tall * 0.44, tall * 0.12]  translate [0, tall * 0.54, 0] }
                for lobe in [0, 3] {
                    wide = tall * (0.06 + random(341, lobe, variant) * 0.03)
                    sphere {
                        scale wide
                        translate [tall * 0.07, tall * 0.10 + wide + tall * random(342, lobe, variant) * 0.70, 0]
                        rotate Y lobe * 90 + random(343, lobe, variant) * 50
                    }
                }
            }
            points 2400
            reach tall * 0.05
            kill tall * 0.010
            step tall * 0.007
            twig tall * 0.0010
            joining 3
            tropism [0, 1, 0]
            susceptibility 0.3
        leaf TreeCluster('poplar', season, 1, variant, tall * 0.02), TreeCluster('poplar', season, 2, variant, tall * 0.02),
             TreeCluster('poplar', season, 3, variant, tall * 0.02), TreeCluster('poplar', season, 4, variant, tall * 0.02)
            with seed variant
            material TreeBark('poplar')
        }
    }
}

primitive Aspen(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 11.58 above the ground for a 12.
    tall = height * 1.037

    // A narrow oval high on a slender pale trunk.  A narrow crown wants a near reach: points drawing from
    // far off pull a few leaders the whole height of it, a broom rather than a tree.  And a steeper
    // joining keeps less of the twigs' thickness as the wood gathers them, for the slender trunk.
    return group {
        grown {
            crown {
                sphere { scale [tall * 0.12, tall * 0.32, tall * 0.12]  translate [0, tall * 0.64, 0] }
                for lobe in [0, 4] {
                    wide = tall * (0.07 + random(211, lobe, variant) * 0.04)
                    sphere {
                        scale wide
                        translate [tall * 0.08, tall * 0.32 + wide + tall * random(212, lobe, variant) * 0.50, 0]
                        rotate Y lobe * 72 + random(213, lobe, variant) * 50
                    }
                }
            }
            points 2400
            reach tall * 0.06
            kill tall * 0.012
            step tall * 0.008
            twig tall * 0.0010
            joining 3
        leaf TreeCluster('aspen', season, 1, variant, tall * 0.02), TreeCluster('aspen', season, 2, variant, tall * 0.02),
             TreeCluster('aspen', season, 3, variant, tall * 0.02), TreeCluster('aspen', season, 4, variant, tall * 0.02)
            with seed variant
            material TreeBark('aspen')
        }
    }
}

// -- A willow, which hangs ------------------------------------------------------------------------
//
// **A weeping shape is foliage, not branching**, and this was established the hard way when the trees
// were built: leaning the limbs over changed the silhouette hardly at all, because what the eye reads at
// tree distance is where the *leaves* are.  So a willow's twigs end in strands -- a thin twig hanging
// straight down from where it is hung, leaves down its length, swinging out a little as it goes.  The
// tree hangs them (`hanging`), so they fall plumb from the twig whichever way the twig points, which is
// what defeated the built willow twice: a strand hung along its twig flew sideways from any limb bent
// past level.

// What a willow's hanging leaves are, by season.  Winter never reaches here -- a willow grows no
// curtains at all then -- but the other three must each look like themselves: a test held autumn
// against summer and found them identical, because the curtains had been taking one green all year.
function TreeWillowLeaf(season) -> color {
    switch (season) {
        case 'summer' { return color [0.40, 0.50, 0.25] }
        case 'autumn', 'fall' { return color [0.62, 0.51, 0.19] }
        default { return color [0.56, 0.66, 0.33] }
    }
}

// One strand of a curtain, hanging down -Y from where it is hung.  In winter it is the bare twig, which is
// still a willow: the curtain without its leaves.
primitive TreeWillowStrand(season, id, variant, drop) -> group {
    green = TreeWillowLeaf(season)
    swing = drop * 0.10

    if (season == 'winter') {
        return group {
            tube {
                material TreeWillowBark
                radius drop * 0.0030 at [0, 0, 0]
                quad radius drop * 0.0020 at [swing * 0.25, -drop * 0.52, 0]
                     radius drop * 0.0010 at [swing, -drop, 0]
            }
        }
    }
    else {
        return group {
            tube {
                material TreeWillowBark
                radius drop * 0.0030 at [0, 0, 0]
                quad radius drop * 0.0020 at [swing * 0.25, -drop * 0.52, 0]
                     radius drop * 0.0010 at [swing, -drop, 0]
            }

            for leaf in [0, 11] {
                along = (leaf + 1) / 13
                object TreeBlade('willow') {
                    material {
                        pigment green * (0.74 + random(id, leaf, variant + 3) * 0.48)
                        specular 0.10  shininess 22  ambient 0.26
                    }
                    // Narrow, because a willow leaf is: the blade is scaled harder across than along
                    // rather than being a smaller leaf of the same shape.  And barely tipped: a hanging
                    // leaf hangs face outward, and laid over it is edge-on to anyone looking from the side.
                    scale [TreeLeaf('willow') * 0.62, TreeLeaf('willow') * 2.1, TreeLeaf('willow')]
                    rotate X 6 + random(id, leaf, variant + 4) * 22
                    rotate Y random(id, leaf, variant + 5) * 360
                    translate [swing * along * along, -drop * along, 0]
                }
            }
        }
    }
}

primitive Willow(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 10.32 above the ground for a 10.
    tall = height * 0.969
    drop = tall * 0.30

    // A broad crown of arching limbs, lifted a little so the strands hang clear of the wood.
    return group {
        grown {
            crown {
                sphere { scale [tall * 0.26, tall * 0.22, tall * 0.26]  translate [0, tall * 0.62, 0] }
                for lobe in [0, 6] {
                    wide = tall * (0.16 + random(351, lobe, variant) * 0.08)
                    sphere {
                        scale wide
                        translate [tall * (0.22 + random(354, lobe, variant) * 0.18),
                                   tall * 0.40 + wide + tall * random(352, lobe, variant) * 0.24, 0]
                        rotate Y lobe * 51 + random(353, lobe, variant) * 30
                    }
                }
            }
            points 1600
            reach tall * 0.14
            kill tall * 0.03
            step tall * 0.015
            twig tall * 0.0022
            tropism [0, 1, 0]
            susceptibility 0.12
            leaf TreeWillowStrand(season, 1, variant, drop), TreeWillowStrand(season, 2, variant, drop * 0.8),
                 TreeWillowStrand(season, 3, variant, drop * 1.15), TreeWillowStrand(season, 4, variant, drop * 0.65)
                 hanging
            with seed variant
            material TreeWillowBark
        }
    }
}

// -- The conifers --------------------------------------------------------------------------------
//
// A fir keeps its needles all year, so a conifer is the one tree here that looks the same in spring,
// summer and autumn.  Winter is the exception, and not a small one: snow lies on top of the shoots,
// which is how anybody would draw a fir from memory.  It lies on top because a grown tree turns each
// shoot's face to the sky; which shoots catch it is decided shoot by shoot, so a tree comes out with
// snow on some and none on others -- a fir under an even coating looks molded rather than snowed on.

// What lies on a shoot, which in three seasons out of four is nothing.
primitive TreeSnowOn(season, long, id, variant) -> group {
    if (season == 'winter' && random(id, 60, variant) > 0.25) {
        return group {
            sphere {
                material TreeSnow
                scale [long * 0.42, long * 0.55, long * 0.16]
                translate [0, long * 0.35, long * 0.20]
            }
        }
    }
    else {
        return group { }
    }
}

// The needles at the end of a conifer's twig: needled shoots fanned round it, each standing for many
// needles (see the fir's blade, above), with snow on top in winter.
primitive TreeShoots(season, id, variant, long) -> group {
    return group {
        for shoot in [0, 4] {
            object TreeBlade('fir') {
                material TreeNeedles
                scale long * (0.75 + random(id, shoot, variant) * 0.5)
                rotate X 40 + random(id, shoot, variant + 1) * 30
                rotate Y shoot * 72 + random(id, shoot, variant + 2) * 30
            }
        }

        object TreeSnowOn(season, long, id, variant)
    }
}

primitive Fir(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 10.67 above the ground for a 11.
    tall = height * 1.031
    long = tall * 0.05

    // A cone to the ground.  The trunk runs up the middle of it to the top and the boughs leave it all
    // the way up, which is what a cone of points grows without being told; a little weight droops them.
    return group {
        grown {
            crown {
                conic {
                    min Y 0  max Y 1
                    scale [tall * 0.34, tall * 0.92, tall * 0.34]
                    rotate X 180
                    translate [0, tall, 0]
                }
            }
            points 2400
            reach tall * 0.09
            kill tall * 0.018
            step tall * 0.010
            twig tall * 0.0016
            joining 2.6
            tropism [0, -1, 0]
            susceptibility 0.10
            leaf TreeShoots(season, 1, variant, long), TreeShoots(season, 2, variant, long),
                 TreeShoots(season, 3, variant, long), TreeShoots(season, 4, variant, long)
            with seed variant
            material TreeBark('fir')
        }
    }
}

primitive Pine(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 12.68 above the ground for a 12.
    tall = height * 0.946
    long = tall * 0.06

    // The other way round from a fir: a pine sheds its lower boughs as it grows, so what is left is a long
    // clear trunk and a crown of a few clumps on the ends of long bare limbs, high up.
    return group {
        grown {
            crown {
                sphere { scale [tall * 0.15, tall * 0.12, tall * 0.15]  translate [0, tall * 0.80, 0] }
                for lobe in [0, 6] {
                    wide = tall * (0.08 + random(361, lobe, variant) * 0.06)
                    sphere {
                        scale [wide, wide * 0.7, wide]
                        translate [tall * (0.13 + random(364, lobe, variant) * 0.16),
                                   tall * 0.68 + wide * 0.7 + tall * random(362, lobe, variant) * 0.20, 0]
                        rotate Y lobe * 51 + random(363, lobe, variant) * 40
                    }
                }
            }
            points 1500
            reach tall * 0.14
            kill tall * 0.034
            step tall * 0.013
            twig tall * 0.0034
            joining 2.3
            tropism [0, 1, 0]
            susceptibility 0.10
            leaf TreeShoots(season, 11, variant, long), TreeShoots(season, 12, variant, long),
                 TreeShoots(season, 13, variant, long), TreeShoots(season, 14, variant, long)
            with seed variant
            material TreeBark('fir')
        }
    }
}

// -- A dead one ----------------------------------------------------------------------------------

// What is left of a tree: no leaves, few twigs and those broken off thick, in a crown that was never
// filled.  Few points, drawn from far, make the sparse, crooked limbs.
// It takes the season, as every tree here does, so that a scene setting its season in one place can hand it to
// everything -- and, being dead, does nothing with it.
primitive Snag(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 7.89 above the ground for a 9.
    tall = height * 1.141

    return group {
        grown {
            crown {
                sphere { scale tall * 0.14  translate [0, tall * 0.56, 0] }
                for lobe in [0, 3] {
                    wide = tall * (0.12 + random(371, lobe, variant) * 0.08)
                    sphere {
                        scale wide
                        translate [tall * (0.10 + random(374, lobe, variant) * 0.18),
                                   tall * 0.42 + wide + tall * random(372, lobe, variant) * 0.26, 0]
                        rotate Y lobe * 90 + random(373, lobe, variant) * 60
                    }
                }
            }
            points 900
            reach tall * 0.18
            kill tall * 0.045
            step tall * 0.015
            twig tall * 0.0035
            with seed variant
            material TreeSnagBark
        }
    }
}

// -- Palm ------------------------------------------------------------------------------------------
//
// The one tree here that is still built, and the only one that should be: a palm never branches.  It is
// one trunk and a fountain of fronds, and there is nothing in that for a crown of points to grow.

// One leaflet of a palm frond: a narrow strap growing out along +Z and drooping as it goes, so it
// needs no turning to hang -- which is the lesson the willow taught.  Grown along Z rather than the
// usual Y because a palm frond is a flat feather and its leaflets leave the rachis *sideways*.
primitive TreePalmLeaflet(long, wide) -> ribbon {
    return ribbon {
        material TreePalmLeaf

        width wide        at [0, 0, 0]
        width wide * 0.96 at [0, -long * 0.03, long * 0.30]
        width wide * 0.82 at [0, -long * 0.13, long * 0.60]
        width wide * 0.52 at [0, -long * 0.30, long * 0.85]
        width wide * 0.08 at [0, -long * 0.52, long * 0.98]

        twist 0.15
    }
}

// One frond: a rachis arcing up and then well down, with leaflets in pairs along it, longest in the
// middle as a feather is.
//
// **Each pair is turned to the rachis's own tangent**, worked out from the same quadratic the tube was
// made from -- `2(1-t)(P1-P0) + 2t(P2-P1)`, whose angle is `atan2`.  Leaflets left at a fixed angle
// stand square to the frond near the base and cut across it at the tip, which reads as a mistake even
// when you cannot say what is wrong.
primitive TreePalmFrond(long, id, variant) -> group {
    pairs = 15
    midX = long * 0.42
    midY = long * 0.30
    tipX = long * 0.92
    tipY = -long * 0.20

    return group {
        tube {
            material TreePalmBark
            radius long * 0.017 at [0, 0, 0]
            quad radius long * 0.010 at [midX, midY, 0]
                 radius long * 0.004 at [tipX, tipY, 0]
        }

        for pair in [0, pairs - 1] {
            along = (pair + 1) / (pairs + 1)
            middle = 2 * (1 - along) * along
            last = along * along

            // Longest about a third of the way out and shortest at both ends.
            fat = 4 * along * (1 - along)
            leaf = long * 0.32 * (0.34 + 0.66 * fat)
            slope = toDegrees(atan2(2 * (1 - along) * midY + 2 * along * (tipY - midY),
                                    2 * (1 - along) * midX + 2 * along * (tipX - midX)))

            for side in [0, 1] {
                object TreePalmLeaflet(leaf, leaf * 0.085) {
                    // Swept back toward the base, the way a feather's barbs lie.
                    rotate Y side * 180 - (1 - 2 * side) *
                                          (22 + random(id, pair, variant) * 16)
                    rotate Z slope
                    translate [middle * midX + last * tipX,
                               middle * midY + last * tipY,
                               0]
                }
            }
        }
    }
}

// A palm: a bare leaning trunk with the whole of its foliage in one crown at the top.  **No other tree
// here is shaped anything like it** -- the broadleaves divide all the way out, the conifers are boughs
// off a leader, and the willow hangs.  A palm is a pole with a fountain on it.
//
// The season says nothing: a palm sheds and grows fronds the year round rather than by the calendar,
// and it is taken so a scene may pass it along with everything else.
primitive Palm(height, season = 'summer', variant = 1) -> group {
    fronds = 11

    // Measured, as every tree here is: an upright frond reaches above the top of the trunk, so the
    // whole plant is built against a shade less than the height asked for.
    high = height * 0.890
    tall = high * 0.72
    lean = high * 0.06

    return group {
        tube {
            material TreePalmBark
            radius high * 0.027 at [0, 0, 0]
            quad radius high * 0.022 at [lean * 0.45, tall * 0.55, 0]
                 radius high * 0.019 at [lean, tall, 0]
        }

        for frond in [0, fronds - 1] {
            object TreePalmFrond(high * 0.60 * (0.80 + random(frond, 51, variant) * 0.40),
                                 frond, variant) {
                rotate Z -4 + random(frond, 52, variant) * 62
                rotate Y frond * 360 / fronds + random(frond, 53, variant) * 26
                // Onto the top of the trunk, which leans -- turned first and moved second, so no
                // frond starts beside the wood it is supposed to leave.
                translate [lean, tall, 0]
            }
        }
    }
}
