}

primitive Beech(height, season = 'summer', variant = 1) -> group {
    // Grown at the height asked, over five variants it stood 8.91 above the ground for a 9.
    tall = height * 1.010

    // A broad dome, wider than it is tall, its underside high enough above the ground to leave a short
    // trunk showing.
    return group {
        grown {
            crown {
                sphere { scale [tall * 0.30, tall * 0.24, tall * 0.30]  translate [0, tall * 0.56, 0] }
                for lobe in [0, 5] {
                    wide = tall * (0.17 + random(201, lobe, variant) * 0.08)
                    sphere {
                        scale wide
                        translate [tall * 0.30, tall * 0.34 + wide + tall * random(202, lobe, variant) * 0.26, 0]
                        rotate Y lobe * 60 + random(203, lobe, variant) * 40
                    }
                }
            }
            points 2200
            reach tall * 0.14
            kill tall * 0.028
            step tall * 0.015
            twig tall * 0.0022
        leaf TreeCluster('beech', season, 1, variant, tall * 0.03), TreeCluster('beech', season, 2, variant, tall * 0.03),
             TreeCluster('beech', season, 3, variant, tall * 0.03), TreeCluster('beech', season, 4, variant, tall * 0.03)
            with seed variant
            material TreeBark('beech')
        }
