// Trees you can name.
//
//     import 'trees' { Elm }
//
//     object Elm(9)
//     object Elm(7, 'autumn') { translate X 12 }
//     object Elm(8, 'winter', 4) { translate X -12 }
//
// A tree takes how tall it should stand, what time of year it is, and which of itself you want.  Only
// the first is required, so the common case is one number.
//
// | Elm    | Reaching, the limbs sweeping up and out. |
// | Oak    | Heavy and broad, throwing its weight sideways. |
// | Birch  | Slender, pale-barked, dividing into finer twigs than the others. |
// | Fir    | A conifer: one trunk the whole height, rings of branches coming off it. |
// | Pine   | The other conifer: a long clear trunk with the whole crown at the top. |
// | Willow | Arching limbs with curtains of foliage hanging from along them. |
// | Poplar | The narrow one, for a windbreak or an avenue. |
// | Maple  | Broad like an oak but lighter, with the biggest leaves here. |
// | Palm   | A bare leaning trunk with the whole crown in one fountain at the top. |
// | Snag   | A dead tree, standing.  Bare in every season, because that is what dead means. |
//
// **Height is what you would measure**, near enough -- `Elm(9)` stands about nine units high, which is
// worth saying because the obvious alternative is for the number to mean the trunk, and then nobody can
// picture it.
//
// **The season is a word**: 'summer', 'autumn' (or 'fall'), 'winter', or anything else for spring.
// Winter has no leaves at all and shows the shape they were hanging on.  A fir keeps its needles, so
// three of its four seasons look alike -- but it still answers to winter, by taking snow along its
// boughs, which is the state anybody picturing a fir pictures.
//
// **The variant is which tree of that kind you want.**  The same numbers always grow the same tree,
// down to the last twig, so a scene renders the same way today and next year and in every frame of an
// animation.  Change it and you get a different tree of the same species -- which is what you want for
// a row of them, since three identical elms read as a diagram rather than a hedge:
//
//     for tree in [0, 5] {
//         object Elm(8 + random(tree) * 3, 'summer', tree) { translate X tree * 7 - 17 }
//     }
//
// -- What is here for the library and not for you ------------------------------------------------
//
// Everything below beginning with `Tree` is the machinery, and a scene that imports `Elm` does not get
// any of it: a library keeps its own workings, so `TreeLimb` and `TreeWilt` stay here where they
// belong.  You may still ask for one by name if you want to build something of your own out of it.
//
// The barks are the exception, and the reason is worth knowing rather than guessing.  A material is
// looked up wherever it is *used* rather than remembering where it was written, so a library's
// materials have to travel with what they belong to -- which means `TreeElmBark` and its two siblings
// do arrive in your scene whether you asked or not.  They are named with the prefix so they will not
// collide with anything of yours.

// -- What a species is, said as numbers ---------------------------------------------------------

// How much shorter each generation of limb is than the one it grew from.
function TreeShrink(species) -> number {
    switch (species) {
        case 'elm' { return 0.76 }
        case 'oak' { return 0.70 }
        case 'birch' { return 0.78 }
        case 'willow' { return 0.80 }
        case 'poplar' { return 0.83 }
        case 'maple' { return 0.73 }
        default { return 0.74 }
    }
}

// And how much thinner.
function TreeTaper(species) -> number {
    switch (species) {
        case 'fir' { return 0.14 }
        case 'oak' { return 0.66 }
        case 'birch' { return 0.55 }
        case 'willow' { return 0.58 }
        case 'poplar' { return 0.74 }
        case 'maple' { return 0.64 }
        default { return 0.62 }
    }
}

// How far a limb turns away from the one it grew from.  This is most of what tells one tree from
// another at a glance: an elm reaches up and out, an oak throws its weight sideways.
function TreeLean(species) -> number {
    switch (species) {
        case 'elm' { return 26 }
        case 'oak' { return 44 }
        case 'birch' { return 20 }
        case 'willow' { return 30 }
        case 'poplar' { return 13 }
        case 'maple' { return 38 }
        default { return 32 }
    }
}

// And how far round from one sibling to the next.
function TreeTurn(species) -> number {
    switch (species) {
        case 'oak' { return 132 }
        case 'willow' { return 126 }
        case 'poplar' { return 104 }
        case 'maple' { return 124 }
        default { return 118 }
    }
}

// How far any one limb may depart from all of that.  An oak is knottier than a birch.
function TreeVary(species) -> number {
    switch (species) {
        case 'oak' { return 0.38 }
        case 'birch' { return 0.18 }
        case 'willow' { return 0.30 }
        case 'poplar' { return 0.13 }
        case 'maple' { return 0.32 }
        default { return 0.28 }
    }
}

// How many generations of limb: a birch divides into finer and finer twigs, an oak stops sooner and
// leaves each limb heavy.
function TreeDepth(species) -> number {
    switch (species) {
        // Measured on an elm at 380 by 300: depth four renders in 3.2 seconds and gives a spindly
        // canopy you can see straight through; five takes 7.1 and fills; six takes 19.4 for a
        // further gain that is real but much smaller.  Five is the knee of that curve.
        case 'birch' { return 6 }
        case 'oak' { return 5 }
        case 'willow' { return 6 }
        case 'poplar' { return 6 }
        case 'maple' { return 5 }
        default { return 5 }
    }
}

// How big a leaf cluster is, which does as much for the look of a tree as its branching does.
function TreeLeaf(species) -> number {
    switch (species) {
        case 'oak' { return 0.26 }
        case 'birch' { return 0.10 }
        case 'willow' { return 0.19 }
        case 'poplar' { return 0.16 }
        case 'maple' { return 0.29 }
        default { return 0.19 }
    }
}

// -- The wobble that keeps a rule from looking like a rule --------------------------------------

function TreeWilt(species, id, which, variant) -> number {
    return 1 - TreeVary(species) + random(id, which, variant) * TreeVary(species) * 2
}

function TreeSway(species, id, which, variant) -> number {
    return (random(id, which, variant) - 0.5) * TreeLean(species)
}

// -- Bark and leaf --------------------------------------------------------------------------------

// The green of a summer leaf, which differs more between species than people expect.
function TreeGreen(species) -> color {
    switch (species) {
        case 'oak' { return color [0.20, 0.36, 0.14] }
        case 'birch' { return color [0.38, 0.55, 0.24] }
        case 'willow' { return color [0.42, 0.52, 0.26] }
        case 'poplar' { return color [0.30, 0.46, 0.20] }
        case 'maple' { return color [0.22, 0.42, 0.16] }
        default { return color [0.24, 0.44, 0.17] }
    }
}

TreeElmBark = material { pigment [0.44, 0.34, 0.26]  specular 0.10  shininess 18 }
TreeOakBark = material { pigment [0.35, 0.29, 0.23]  specular 0.08  shininess 14 }
TreeBirchBark = material { pigment [0.82, 0.80, 0.74]  specular 0.16  shininess 30 }
TreeFirBark = material { pigment [0.30, 0.22, 0.17]  specular 0.06  shininess 12 }
TreeWillowBark = material { pigment [0.38, 0.33, 0.27]  specular 0.09  shininess 16 }
TreePoplarBark = material { pigment [0.52, 0.50, 0.44]  specular 0.12  shininess 22 }
TreeMapleBark = material { pigment [0.33, 0.30, 0.28]  specular 0.08  shininess 15 }
TreeSnagBark = material { pigment [0.55, 0.52, 0.47]  specular 0.14  shininess 26 }
TreePalmBark = material { pigment [0.47, 0.41, 0.32]  specular 0.10  shininess 16 }
TreePalmLeaf = material { pigment [0.24, 0.42, 0.19]  specular 0.20  shininess 34  ambient 0.20 }
TreeNeedles = material { pigment [0.14, 0.30, 0.18]  specular 0.22  shininess 40  ambient 0.24 }
TreeSnow = material { pigment [0.93, 0.94, 0.97]  specular 0.30  shininess 60 }

primitive TreeBark(species) -> material {
    switch (species) {
        case 'oak' { return material TreeOakBark }
        case 'birch' { return material TreeBirchBark }
        case 'fir' { return material TreeFirBark }
        case 'willow' { return material TreeWillowBark }
        case 'poplar' { return material TreePoplarBark }
        case 'maple' { return material TreeMapleBark }
        case 'snag' { return material TreeSnagBark }
        default { return material TreeElmBark }
    }
}

// -- What a leaf is ---------------------------------------------------------------------------------

// The blade of one leaf, authored growing along +Y from nothing at its base to a point at its tip,
// its width across X and a shallow cup lifting toward +Z.  It is drawn at a length of one and scaled
// where it is used.
//
// **These were spheres.**  Four green balls per twig, which is what the library shipped with, and at
// any distance where a leaf is more than a few pixels across it reads as a bunch of grapes.  Measured
// at eight hundred pixels and a forty-six degree field, a leaf on an elm gets thirty pixels at six
// units off and nine at twenty -- easily enough to tell an oval from a triangle from a lobed edge, so
// the shape is worth getting right rather than approximating with a ball.
//
// Three of the four are `patch` surfaces: a bicubic sheet pulled into shape by sixteen control
// points, which gives a smooth outline and, more importantly, a **cup**.  A leaf that is dead flat
// takes the light evenly across its whole face and reads as a plastic cut-out; a cupped one catches
// the light along one edge and turns away from it along the other, which is most of what makes
// foliage look soft.
//
// The oak is the exception, and the reason is worth stating: **a bicubic patch cannot be lobed.**  Its
// silhouette comes from cubic boundary curves, and a cubic can carry one inflection -- enough for a
// waisted oval, nowhere near the five rounded lobes down each edge that make an oak leaf an oak leaf.
// So the oak is a `generic shape` instead: an arbitrary closed outline left flat.  It gives up the
// cup and keeps the lobes, which is the right way round -- the lobes are what identify it.  A generic
// shape is also cheaper to intersect than an extrusion of the same outline, being a flat thing in
// space rather than a solid, and a leaf has no thickness worth paying for either way.
// It gives back a `group` rather than a surface because the four are not all the same kind of
// surface -- three patches and one generic shape -- and a primitive must name one kind.  A group
// of one costs a bounding box, which a leaf is glad of anyway.
primitive TreeBlade(species) -> group {
    switch (species) {
        // Oak: lobed, and flat for the reason above.  The outline is a great many short lines rather
        // than a few curves because the lobes are easier to state as a width that rises and falls up
        // the leaf than as a hand-fitted set of Beziers.
        case 'oak' {
            return group { generic shape {
                path {
                move to 0.0000, 0.0000
                line to 0.1260, 0.0250
                line to 0.1758, 0.0500
                line to 0.2360, 0.0750
                line to 0.2835, 0.1000
                line to 0.2985, 0.1250
                line to 0.2759, 0.1500
                line to 0.2301, 0.1750
                line to 0.1883, 0.2000
                line to 0.1776, 0.2250
                line to 0.2100, 0.2500
                line to 0.2755, 0.2750
                line to 0.3464, 0.3000
                line to 0.3901, 0.3250
                line to 0.3864, 0.3500
                line to 0.3376, 0.3750
                line to 0.2684, 0.4000
                line to 0.2129, 0.4250
                line to 0.1984, 0.4500
                line to 0.2309, 0.4750
                line to 0.2929, 0.5000
                line to 0.3521, 0.5250
                line to 0.3777, 0.5500
                line to 0.3560, 0.5750
                line to 0.2963, 0.6000
                line to 0.2255, 0.6250
                line to 0.1738, 0.6500
                line to 0.1596, 0.6750
                line to 0.1812, 0.7000
                line to 0.2192, 0.7250
                line to 0.2476, 0.7500
                line to 0.2474, 0.7750
                line to 0.2155, 0.8000
                line to 0.1619, 0.8250
                line to 0.1035, 0.8500
                line to 0.0663, 0.8750
                line to 0.0494, 0.9000
                line to 0.0425, 0.9250
                line to 0.0343, 0.9500
                line to 0.0199, 0.9750
                line to 0.0000, 1.0000
                line to -0.0199, 0.9750
                line to -0.0343, 0.9500
                line to -0.0425, 0.9250
                line to -0.0494, 0.9000
                line to -0.0663, 0.8750
                line to -0.1035, 0.8500
                line to -0.1619, 0.8250
                line to -0.2155, 0.8000
                line to -0.2474, 0.7750
                line to -0.2476, 0.7500
                line to -0.2192, 0.7250
                line to -0.1812, 0.7000
                line to -0.1596, 0.6750
                line to -0.1738, 0.6500
                line to -0.2255, 0.6250
                line to -0.2963, 0.6000
                line to -0.3560, 0.5750
                line to -0.3777, 0.5500
                line to -0.3521, 0.5250
                line to -0.2929, 0.5000
                line to -0.2309, 0.4750
                line to -0.1984, 0.4500
                line to -0.2129, 0.4250
                line to -0.2684, 0.4000
                line to -0.3376, 0.3750
                line to -0.3864, 0.3500
                line to -0.3901, 0.3250
                line to -0.3464, 0.3000
                line to -0.2755, 0.2750
                line to -0.2100, 0.2500
                line to -0.1776, 0.2250
                line to -0.1883, 0.2000
                line to -0.2301, 0.1750
                line to -0.2759, 0.1500
                line to -0.2985, 0.1250
                line to -0.2835, 0.1000
                line to -0.2360, 0.0750
                line to -0.1758, 0.0500
                line to -0.1260, 0.0250
                line to -0.1012, 0.0000
                close
                }
            }
        } }

        // Birch: a small deltoid.  Broad and nearly straight across the base, drawn to a sharp point,
        // and barely longer than it is wide.
        case 'birch' {
            return group { patch {
                points
            [-0.0700, 0.0000, 0.0000], [-0.0233, 0.0000, 0.0000], [0.0233, 0.0000, 0.0000], [0.0700, 0.0000, 0.0000],
            [-0.4000, 0.2200, 0.0000], [-0.1333, 0.2200, 0.0489], [0.1333, 0.2200, 0.0489], [0.4000, 0.2200, 0.0000],
            [-0.2300, 0.6000, 0.0000], [-0.0767, 0.6000, 0.0356], [0.0767, 0.6000, 0.0356], [0.2300, 0.6000, 0.0000],
            [-0.0150, 1.0000, 0.0000], [-0.0050, 1.0000, 0.0000], [0.0050, 1.0000, 0.0000], [0.0150, 1.0000, 0.0000]
                uSteps 3
                vSteps 3
            }
        } }

        // Fir: a needled shoot, not a needle -- and flat, like the oak, though for the opposite
        // reason.  The oak is a `generic shape` because a patch cannot hold its outline; this is one
        // because a patch holds curvature a shoot has not got.  Measured, a fir carrying patches took
        // eighty-eight seconds against fifty-six for flat shapes, and a bicubic patch has no
        // closed-form intersection -- it is subdivided per ray -- so the curvature is worth paying
        // for where it shows and worth avoiding where it does not.
        //
        // **It is a shoot rather than a single needle because a needle is thinner than its pixel.**
        // A real fir needle is some twenty times as long as it is wide; drawn at that ratio on a tree
        // that fits the frame it comes out twenty-two pixels long and *one and a half wide*, and a
        // mass of hairs renders as wire wool rather than as foliage.  This is the same trap the grass
        // in `undergrowth` fell into.  So the outline is about six to one, with its edge notched to
        // suggest the needles along it, and each one drawn stands for several.
        case 'fir' {
            return group { generic shape {
                path {
                    move to 0.0000, 0.0000
                    line to 0.0628, 0.0333
                    line to 0.0474, 0.0667
                    line to 0.0580, 0.1000
                    line to 0.0896, 0.1333
                    line to 0.0986, 0.1667
                    line to 0.0738, 0.2000
                    line to 0.0589, 0.2333
                    line to 0.0834, 0.2667
                    line to 0.1130, 0.3000
                    line to 0.1028, 0.3333
                    line to 0.0704, 0.3667
                    line to 0.0692, 0.4000
                    line to 0.1030, 0.4333
                    line to 0.1190, 0.4667
                    line to 0.0919, 0.5000
                    line to 0.0646, 0.5333
                    line to 0.0796, 0.5667
                    line to 0.1113, 0.6000
                    line to 0.1077, 0.6333
                    line to 0.0734, 0.6667
                    line to 0.0601, 0.7000
                    line to 0.0841, 0.7333
                    line to 0.1019, 0.7667
                    line to 0.0819, 0.8000
                    line to 0.0524, 0.8333
                    line to 0.0526, 0.8667
                    line to 0.0703, 0.9000
                    line to 0.0662, 0.9333
                    line to 0.0383, 0.9667
                    line to 0.0000, 1.0000
                    line to -0.0383, 0.9667
                    line to -0.0662, 0.9333
                    line to -0.0703, 0.9000
                    line to -0.0526, 0.8667
                    line to -0.0524, 0.8333
                    line to -0.0819, 0.8000
                    line to -0.1019, 0.7667
                    line to -0.0841, 0.7333
                    line to -0.0601, 0.7000
                    line to -0.0734, 0.6667
                    line to -0.1077, 0.6333
                    line to -0.1113, 0.6000
                    line to -0.0796, 0.5667
                    line to -0.0646, 0.5333
                    line to -0.0919, 0.5000
                    line to -0.1190, 0.4667
                    line to -0.1030, 0.4333
                    line to -0.0692, 0.4000
                    line to -0.0704, 0.3667
                    line to -0.1028, 0.3333
                    line to -0.1130, 0.3000
                    line to -0.0834, 0.2667
                    line to -0.0589, 0.2333
                    line to -0.0738, 0.2000
                    line to -0.0986, 0.1667
                    line to -0.0896, 0.1333
                    line to -0.0580, 0.1000
                    line to -0.0474, 0.0667
                    line to -0.0628, 0.0333
                    line to -0.0666, 0.0000
                    close
                }
            } }
        }

        // Elm: an ovate blade, widest below the middle and pointed at both ends, about twice as long
        // as it is wide.
        default {
            return group { patch {
                points
            [-0.0200, 0.0000, 0.0000], [-0.0067, 0.0000, 0.0000], [0.0067, 0.0000, 0.0000], [0.0200, 0.0000, 0.0000],
            [-0.2600, 0.3000, 0.0000], [-0.0867, 0.3000, 0.0489], [0.0867, 0.3000, 0.0489], [0.2600, 0.3000, 0.0000],
            [-0.2000, 0.6500, 0.0000], [-0.0667, 0.6500, 0.0400], [0.0667, 0.6500, 0.0400], [0.2000, 0.6500, 0.0000],
            [-0.0200, 1.0000, 0.0000], [-0.0067, 1.0000, 0.0000], [0.0067, 1.0000, 0.0000], [0.0200, 1.0000, 0.0000]
                uSteps 3
                vSteps 3
            }
        } }
    }
}

// How many leaves hang at the end of one twig.  The library shipped with four, which is part of why
// a tree read as sparse: a real twig carries a spray, not a handful.
function TreeLeaves(species) -> number {
    switch (species) {
        case 'birch' { return 10 }
        case 'oak' { return 12 }
        case 'willow' { return 17 }
        case 'poplar' { return 15 }
        case 'maple' { return 12 }
        default { return 14 }
    }
}

// What hangs on the end of a limb, which is the whole of what a season is.
//
// A blade is authored growing along +Y, and this is called from inside the limb's own group, so +Y
// already runs along the twig.  That means a leaf needs no frame arithmetic to point the right way:
// pitching it away from the axis and spinning it about that axis is enough, and the whole spray then
// travels with the limb wherever the limb was turned to.
// What hangs off a willow, and the reason the willow needed anything new at all.
//
// **A weeping shape is foliage, not branching**, and this was established the hard way.  Leaning the
// limbs over changes the silhouette hardly at all, because what the eye reads at this distance is
// where the *leaves* are, and they were a compact cluster at each limb tip -- a rounded tree whichever
// way the wood points.  So a willow's limb ends in strands instead: a thin twig hanging below where it
// started, leaves down its length, swinging further out the further down it goes.
//
// **And the limbs must sweep UP for it to work**, which is the part worth writing down.  A strand
// hangs along its own -Y, and its own Y is whatever direction the limb it grew from points.  Limbs
// bent over past level therefore fling their strands sideways and upward -- the first attempt made a
// spiked ball rather than a tree.  Upswept limbs keep the frame near-vertical, so hanging means down.
// This is the same fact `undergrowth`'s blades rely on and the reason a lean of 30 is right here.
primitive TreeWeep(season, id, variant, drop) -> group {
    strands = 9
    swing = drop * 0.20

    // **Each strand starts somewhere of its own.**  Seven of them from one point renders a teepee --
    // a ring of poles converging on an apex, which is exactly what the first version of this looked
    // like and nothing at all like foliage.
    start = drop * 0.16
    green = TreeWillowLeaf(season)

    return group {
        for strand in [0, strands - 1] {
            group {
                tube {
                    material TreeWillowBark
                    radius drop * 0.0022 at [0, 0, 0]
                    quad radius drop * 0.0014 at [swing * 0.25, -drop * 0.52, 0]
                         radius drop * 0.0008 at [swing, -drop, 0]
                }

                for leaf in [0, 11] {
                    along = (leaf + 1) / 16
                    object TreeBlade('willow') {
                        material {
                            pigment green * (0.74 + random(id, strand * 11 + leaf, variant + 3) * 0.48)
                            specular 0.10  shininess 22  ambient 0.26
                        }
                        // Narrow, because a willow leaf is: the blade is scaled harder across than
                        // along rather than being a smaller leaf of the same shape.
                        scale [TreeLeaf('willow') * 0.62, TreeLeaf('willow') * 2.1, TreeLeaf('willow')]
                        // Barely tipped, and this was the difference between foliage and a cloud of
                        // dashes.  A blade is drawn flat with its length up the Y axis, so laying it
                        // over -- which is right for a leaf held out from a twig -- turns it edge-on
                        // to anyone looking from the side, and a curtain of edges is a curtain of
                        // thin lines.  A hanging leaf hangs face outward.
                        rotate X 6 + random(id, strand * 11 + leaf, variant + 4) * 22
                        rotate Y random(id, strand * 11 + leaf, variant + 5) * 360
                        translate [swing * along * along, -drop * along, 0]
                    }
                }

                rotate Y strand * 360 / strands +
                         random(id, strand, variant + 6) * 40
                translate [(random(id, strand, variant + 7) - 0.5) * start,
                           (random(id, strand, variant + 8) - 0.5) * start * 0.7,
                           (random(id, strand, variant + 9) - 0.5) * start]
            }
        }
    }
}

primitive TreeCluster(species, season, id, variant, twig) -> group {
    count = TreeLeaves(species)

    switch (season) {
        case 'summer' {
            green = TreeGreen(species)
            return group {
                for leaf in [0, count - 1] {
                    object TreeBlade(species) {
                        // No two leaves on a tree are the same green.  A canopy of one flat color
                        // reads as a single painted object however good the shapes are, and varying
                        // it per leaf costs nothing at all.
                        material {
                            pigment green * (0.78 + random(id, leaf, variant + 11) * 0.44)
                            specular 0.10
                            shininess 22
                            ambient 0.26
                        }
                        scale TreeLeaf(species) * 1.5 *
                              (0.80 + random(id, leaf, variant) * 0.45)
                        // Pitched away from the twig, then drooping a little further: a leaf held
                        // out flat reads as a signpost.
                        rotate X 52 + random(id, leaf, variant + 1) * 34
                        rotate Y leaf * 360 / count +
                                 random(id, leaf, variant + 2) * 40
                        translate Y -twig * random(id, leaf, variant + 3) * 0.85
                    }
                }
            }
        }
        case 'autumn', 'fall' {
            turned = random(id, 30, variant)
            return group {
                for leaf in [0, count - 3] {
                    object TreeBlade(species) {
                        material {
                            pigment [0.34 + turned * 0.40, 0.30 - turned * 0.08, 0.10]
                            specular 0.08
                            shininess 18
                            ambient 0.26
                        }
                        scale TreeLeaf(species) * 1.45 *
                              (0.75 + random(id, leaf, variant + 4) * 0.4)
                        // Further over than in summer: an autumn leaf has given up holding itself
                        // out and hangs from its stalk.
                        rotate X 66 + random(id, leaf, variant + 5) * 30
                        rotate Y leaf * 360 / count +
                                 random(id, leaf, variant + 6) * 50
                        translate Y -twig * random(id, leaf, variant + 7) * 0.85
                    }
                }
            }
        }
        case 'winter' {
            left = random(id, 40, variant)
            if (left > 0.55) {
                return group { sphere { material { pigment [0.36, 0.27, 0.21] }  scale 0.05 } }
            }
            else { return group { } }
        }
        default {
            return group {
                for bud in [0, 2] {
                    object TreeBlade(species) {
                        material { pigment [0.58, 0.70, 0.36]  specular 0.16  shininess 30  ambient 0.26 }
                        // A spring leaf is a small one, not a different one.
                        scale TreeLeaf(species) * 1.5 *
                              (0.7 + random(id, bud, variant + 7) * 0.5)
                        rotate X 40 + random(id, bud, variant + 8) * 30
                        rotate Y bud * 120 + random(id, bud, variant + 9) * 60
                    }
                }
            }
        }
    }
}

// What a limb ends in.  Most trees end in a cluster; a willow hangs, in every season it has leaves
// at all.  Winter is nobody's exception -- a bare tree is bare whatever kind it is.
primitive TreeFoliage(species, season, id, variant, twig) -> group {
    return group { object TreeCluster(species, season, id, variant, twig) }
}

// How far a limb wanders off the straight line between its ends, as a fraction of its own length.
// A fir is nearly nothing -- a conifer's leader and boughs run true -- where a broadleaf sweeps.
function TreeSweep(species) -> number {
    switch (species) {
        case 'fir' { return 0.05 }
        case 'birch' { return 0.22 }
        case 'oak' { return 0.34 }
        case 'willow' { return 0.30 }
        case 'poplar' { return 0.09 }
        case 'maple' { return 0.31 }
        default { return 0.30 }
    }
}

// Where the control point of a limb's curve sits, along and across.
//
// **These two numbers are why an earlier attempt at this looked straight**, and the arithmetic is
// worth writing down.  A quadratic's greatest departure from the straight line between its ends is
// `bend * (2k - 1) / 4`, where `k` is how far across that line the control point sits.  Put the
// control near the middle of the chord -- k of a half -- and the term vanishes: the tip is displaced
// but the path between the ends is dead straight, which is a stick pointing slightly off rather than
// a branch.  The first version used k = 0.25 and bent by an eighth of the sweep, under two percent of
// the limb's length, and read as no bend at all.
//
// At k = 0 the control stands directly above the base, so the limb leaves going straight up and
// leans over to reach its tip, which is what a branch does.  The departure is then a quarter of the
// sweep, and the sweep itself is larger.
function TreeBendAcross() -> number { return 0 }

// How far up the limb that control point sits.
function TreeBendAlong() -> number { return 0.55 }

// Which way, and how far, this particular limb sweeps.  Signed, so limbs curve both ways and a tree
// does not come out combed.
//
// **The size and the direction are drawn separately, and that is not fussiness.**  Written the
// obvious way -- `(random - 0.5) * 2` -- a limb whose random landed near a half would get a bend of
// nearly nothing, and a curve with no bend in it is a straight line: its control point lies on the
// line between its ends.  A tube segment in that state renders *nothing at all* except the sphere at
// each end of it, with no error and no complaint.  So a tree would have been missing whichever limbs
// happened to draw badly, differently for every variant, and nothing would have said why.  Drawing
// the magnitude from a range that never reaches nought keeps every limb genuinely curved.
function TreeBend(species, length, id, variant) -> number {
    return length * TreeSweep(species) *
           (0.30 + random(id, 78, variant) * 0.70) *
           (1 - 2 * floor(random(id, 77, variant) * 2))
}

// The angle a limb is heading at by the time it reaches its tip, which is what anything growing from
// that tip must be turned by if it is to carry on rather than kink.  A quadratic ends heading along
// the line from its control point to its endpoint, which is what this measures -- and both of those
// come from the same two numbers as the curve itself, so this cannot drift out of step with it.
function TreeBendAngle(species, length, id, variant) -> number {
    return toDegrees(atan2(
        TreeBend(species, length, id, variant) * (1 - TreeBendAcross()),
        length * (1 - TreeBendAlong())))
}

// The wood of one limb: a tube, which is a length of tapering rod with a *sphere* at each end of it.
//
// **It curves.**  A tube is threaded through points and will bend between them, and this used two
// bare points -- a straight segment, which is the least a tube can do.  A branch running dead
// straight from base to tip is the loudest thing left in a tree once its leaves are right: real wood
// sweeps as it reaches, and a fork of two straight sticks reads as scaffolding.  One `quad` costs one
// surface, exactly as the straight one did, and the taper follows the bend without being asked.
//
// `quad` rather than `curve`: a quadratic takes a single control point, so the whole limb is one
// segment with no join in it, and a tube with no join cannot fail the tangent-continuity check that
// a join has to satisfy.
primitive TreeWood(species, length, thickness, id, variant) -> tube {
    bend = TreeBend(species, length, id, variant)

    return tube {
        material TreeBark(species)
        radius thickness at [0, 0, 0]
        quad radius thickness * 0.45 + thickness * TreeTaper(species) * 0.55
                 at [bend * TreeBendAcross(), length * TreeBendAlong(), 0]
             radius thickness * TreeTaper(species) at [bend, length, 0]
    }
}

// One limb: a length of wood, and then either foliage or three more limbs.
primitive TreeLimb(species, season, depth, length, thickness, twist, id, variant) -> group {
    if (depth < 1) {
        return group { object TreeFoliage(species, season, id, variant, length) }
    }
    else {
        return group {
            object TreeWood(species, length, thickness, id, variant)
            object TreeLimb(species, season, depth - 1,
                            length * TreeShrink(species) * TreeWilt(species, id, 1, variant),
                            thickness * TreeTaper(species), twist + TreeTurn(species),
                            id * 3 + 1, variant) {
                rotate Z TreeLean(species) * TreeWilt(species, id, 2, variant)
                rotate Y twist + TreeSway(species, id, 3, variant)
                rotate Z -TreeBendAngle(species, length, id, variant)
                translate [TreeBend(species, length, id, variant), length, 0]
            }
            object TreeLimb(species, season, depth - 1,
                            length * TreeShrink(species) * TreeWilt(species, id, 4, variant),
                            thickness * TreeTaper(species), twist + TreeTurn(species),
                            id * 3 + 2, variant) {
                rotate Z TreeLean(species) * TreeWilt(species, id, 5, variant)
                rotate Y twist + TreeTurn(species) + TreeSway(species, id, 6, variant)
                rotate Z -TreeBendAngle(species, length, id, variant)
                translate [TreeBend(species, length, id, variant), length, 0]
            }
            object TreeLimb(species, season, depth - 1,
                            length * TreeShrink(species) * TreeWilt(species, id, 7, variant) * 0.9,
                            thickness * TreeTaper(species), twist + TreeTurn(species),
                            id * 3 + 3, variant) {
                rotate Z TreeLean(species) * 0.45 * TreeWilt(species, id, 8, variant)
                rotate Y twist + TreeTurn(species) * 2 + TreeSway(species, id, 9, variant)
                rotate Z -TreeBendAngle(species, length, id, variant)
                // At the tip, like its two siblings, and not part way down.  A limb leaving the side
                // of another has to start as wide as its parent is *there*, and this one started as
                // wide as its parent ends -- so it emerged from the wood with a step around it.  The
                // cones this was written for hid that in their own banding; a tube shows it plainly.
                translate [TreeBend(species, length, id, variant), length, 0]
            }
        }
    }
}

// -- The trees themselves --------------------------------------------------------------------------

// How tall a tree comes out for a first limb of one: every generation adds its own length, each a
// fraction of the one below.  A limb leans as well as rises, so the true height is less than this sum,
// and the fudge that follows is measured rather than derived.
function TreeReach(species) -> number {
    return (1 - pow(TreeShrink(species), TreeDepth(species))) / (1 - TreeShrink(species))
}

// How much taller than its arithmetic each species stands, measured rather than derived: one of each
// was stood beside a post of exactly nine units and read off against it.
//
// **It used to be one number for all of them, and the sweep is why it cannot be.**  The sum above
// counts every generation at its full length; what that turns into in height depends on how much of
// each limb goes sideways, and the species now sweep by quite different amounts -- an oak by a third
// of its length, a birch by a fifth.  Measured against the post, an elm came out at 9.75 for a nine
// asked, a birch at 9.51 and an oak at exactly 9.  One constant served while every species bent about
// the same; it stopped serving the moment they stopped.
function TreeStand(species) -> number {
    switch (species) {
        case 'oak' { return 1.060 }
        case 'birch' { return 1.120 }
        case 'poplar' { return 1.100 }
        case 'maple' { return 1.139 }
        case 'snag' { return 1.099 }
        default { return 1.148 }
    }
}

// The length of the first limb for a tree meant to stand about this tall.
function TreeTrunk(species, height) -> number {
    return height / TreeReach(species) / TreeStand(species)
}

primitive Elm(height, season = 'summer', variant = 1) -> group {
    return group {
        object TreeLimb('elm', season, TreeDepth('elm'), TreeTrunk('elm', height), height * 0.030, 0, 1, variant)
    }
}

primitive Oak(height, season = 'summer', variant = 1) -> group {
    return group {
        object TreeLimb('oak', season, TreeDepth('oak'), TreeTrunk('oak', height), height * 0.042, 0, 1, variant)
    }
}

primitive Birch(height, season = 'summer', variant = 1) -> group {
    return group {
        object TreeLimb('birch', season, TreeDepth('birch'), TreeTrunk('birch', height), height * 0.020, 0, 1, variant)
    }
}

// -- A conifer, which is built the other way round ------------------------------------------------
//
// The three above are made by forking: a limb divides into limbs, which divide again, and the shape
// of the tree falls out of how they lean.  A fir does not grow that way and cannot be made that way.
// It has one trunk running the whole height of it, and branches come off that trunk in rings -- a
// whorl a year, each ring a little shorter than the one below, which is what makes the cone.
//
// So this is a loop rather than a recursion, and the two sit side by side in the same library because
// the shapes are honestly different rather than the same shape differently tuned.

// What lies on top of a bough, which in three seasons out of four is nothing.
//
// A fir keeps its needles all year, so a conifer is the one tree here that looks the same in spring,
// summer and autumn.  Winter is the exception, and not a small one: snow gathers along the upper side
// of the boughs, which is how anybody would draw a fir from memory.  It rides a little above the
// needles and a little narrower, so what shows is a white edge along the top of a tier rather than a
// second set of foliage.
//
// Which boughs catch it is decided per bough rather than per handful of needles, so a tree comes out
// with snow on some limbs and none on others.  A fir under an even coating looks moulded rather than
// snowed on.
primitive TreeSnowOn(season, length, id, variant) -> group {
    switch (season) {
        case 'winter' {
            if (random(id, 60, variant) > 0.3) {
                return group {
                    for along in [0, 4] {
                        sphere {
                            material TreeSnow
                            scale [length * 0.24, length * 0.085, length * 0.24]
                            translate Y length * (0.16 + along * 0.19)
                            // A bough is built along Y and laid over by a quarter turn about Z, and
                            // that turn carries X up -- so this is what puts the snow on top of the
                            // branch rather than along the side of it.
                            translate X length * 0.085 +
                                      (random(id, along, variant) - 0.5) * length * 0.10
                        }
                    }
                }
            }
            else { return group { } }
        }
        default { return group { } }
    }
}

// One branch: a shaft angled down and out from the trunk, with needles gathered along it.  Real
// conifer branches sweep -- the wood angles up and the needles hang -- which is more than this does,
// but the length and the droop are what read at any distance.
primitive TreeBough(season, length, id, variant) -> group {
    return group {
        object TreeWood('fir', length, length * 0.045, id, variant)

        // Needles, in sprays along the bough.  These were flattened spheres, for the same reason the
        // broadleaves were round ones, and at any distance where a fir is more than a smudge the
        // difference between a squashed ball and a spray of needles is the difference between a
        // conifer and a topiary.
        for along in [0, 4] {
            for needle in [0, 5] {
                object TreeBlade('fir') {
                    material TreeNeedles
                    scale length * 0.34 * (0.75 + random(id, along * 6 + needle, variant) * 0.5)
                    // Needles stand well out from the shoot and sweep back toward its tip, which is
                    // what gives a fir bough its brush.
                    rotate X 62 + random(id, along * 6 + needle, variant + 1) * 26
                    rotate Y needle * 60 + along * 23 +
                             random(id, along * 6 + needle, variant + 2) * 24
                    translate Y length * (0.12 + along * 0.185)
                }
            }
        }
        object TreeSnowOn(season, length, id, variant)
        rotate Z 90
    }
}

// How wide a fir is at the bottom, as a fraction of its height.  Narrower than instinct says: a fir
// that is half as wide as it is tall reads as a bush.  It asks for no species because it is about
// firs and nothing else; the other three shape helpers take one because they genuinely differ.
function TreeFirSpread() -> number { return 0.30 }

// A willow, built its own way -- as a fir is, and for the same kind of reason: the recursive limb
// machinery cannot make one.
//
// **Three attempts failed before this, each for its own reason, and they are worth knowing.**  Leaning
// the limbs over changed nothing, because a limb still ended in a compact leaf cluster and what the
// eye reads at tree distance is where the leaves are.  Hanging the curtains on a ring around the crown
// put them in the air with no wood above them -- they hung from nothing and looked it.  And laying each
// hanging leaf over, which is right for a leaf held out from a twig, turned every one of them edge-on
// to a viewer at the side, so a curtain of leaves rendered as a curtain of thin lines.
//
// So the wood here is drawn out by hand, which means its curve is *known*: a curtain hangs from a point
// on the very arc the tube was made from.  That is the whole difference.

// One arch of willow wood, rising from its own origin and reaching out, with curtains along it.
primitive WillowSpray(season, reach, rise, thick, hangs, id, variant) -> group {
    return group {
        tube {
            material TreeWillowBark
            radius thick at [0, 0, 0]
            quad radius thick * 0.50 at [reach * 0.30, rise * 0.96, 0]
                 radius thick * 0.17 at [reach, rise * 0.84, 0]
        }

        if (season != 'winter') {
            for hang in [0, hangs - 1] {
                along = 0.28 + hang * 0.68 / (hangs - 1)
                middle = 2 * (1 - along) * along
                last = along * along

                object TreeWeep(season, id * 17 + hang, variant,
                                rise * (0.30 + along * 0.46) *
                                    (0.82 + random(id, hang, variant + 21) * 0.36)) {
                    translate [middle * reach * 0.30 + last * reach,
                               middle * rise * 0.96 + last * rise * 0.84,
                               0]
                }
            }
        }
    }
}

// A limb: one arch, with two smaller ones leaving it partway along.  A single unbroken curve reads as
// an umbrella rib; wood that divides reads as a tree.
primitive WillowLimb(season, reach, rise, thick, id, variant) -> group {
    return group {
        object WillowSpray(season, reach, rise, thick, 9, id, variant)

        for child in [0, 1] {
            // Where on the parent's arc this one leaves it -- the same quadratic, so the join is a
            // join and not a near miss.
            at = 0.40 + child * 0.28
            middle = 2 * (1 - at) * at
            last = at * at

            object WillowSpray(season, reach * 0.44, rise * 0.38, thick * 0.40, 5,
                               id * 7 + child + 1, variant) {
                rotate Y (child * 2 - 1) * (28 + random(id, child, variant + 41) * 22)
                translate [middle * reach * 0.30 + last * reach,
                           middle * rise * 0.96 + last * rise * 0.84,
                           0]
            }
        }
    }
}

primitive Willow(height, season = 'summer', variant = 1) -> group {
    limbs = 6
    fork = height * 0.30
    lean = height * 0.026
    stand = 1.301

    return group {
        // Thick at the ground and tapering hard.  It also leans, and not only because a willow's
        // does: three points dead in line give a tube no plane to frame itself in and the solver
        // does not converge.
        tube {
            material TreeWillowBark
            radius height * 0.030 at [0, 0, 0]
            quad radius height * 0.021 at [lean * 0.35, fork * 0.55, 0]
                 radius height * 0.016 at [lean, fork, 0]
        }

        for limb in [0, limbs - 1] {
            object WillowLimb(season,
                              height * 0.38 * (0.78 + random(limb, 31, variant) * 0.44),
                              (height - fork) / stand * (0.80 + random(limb, 32, variant) * 0.34),
                              height * 0.011, limb, variant) {
                rotate Y limb * 360 / limbs + random(limb, 33, variant) * 34
                // **Onto the top of the trunk, which leans.**  Turned first and moved second, so
                // every limb starts exactly where the wood ends however far round it is turned --
                // the other order rings them about the axis and leaves a visible step at the fork.
                translate [lean, fork, 0]
            }
        }
    }
}

// A poplar: the narrow one.  Limbs held close to the leader and hardly sweeping at all, which is the
// whole of a columnar silhouette -- the shape a windbreak or an avenue is made of.
primitive Poplar(height, season = 'summer', variant = 1) -> group {
    return group {
        object TreeLimb('poplar', season, TreeDepth('poplar'), TreeTrunk('poplar', height), height * 0.019, 0, 1, variant)
    }
}

// A maple: broad like an oak but not so heavy, and the biggest leaves in the library -- which is what
// makes its autumn read from further off than the others.
primitive Maple(height, season = 'summer', variant = 1) -> group {
    return group {
        object TreeLimb('maple', season, TreeDepth('maple'), TreeTrunk('maple', height), height * 0.036, 0, 1, variant)
    }
}

// A dead tree, standing.  Bare in every season, because that is what dead means -- the leaf clusters
// are asked for in winter whatever the scene said, and winter is the season that grows none.  Pale,
// too: bark falls off a snag and what is left is weathered wood rather than bark.
//
// **A snag is worth having for the same reason a bare birch is.**  A stand of trees where every one
// is alive and in leaf reads as planted; one dead trunk among them reads as woodland.
primitive Snag(height, variant = 1) -> group {
    return group {
        object TreeLimb('snag', 'winter', TreeDepth('snag'), TreeTrunk('snag', height), height * 0.034, 0, 1, variant)
    }
}

// A pine: the same conifer parts as a fir, put together the other way round.
//
// A fir is a cone to the ground.  A pine sheds its lower branches as it grows, so what stands is a
// long clear trunk with the whole crown at the top -- which is why the two read as different trees at
// any distance even though a needle is a needle and the wood is the same wood.  Its boughs come off
// much closer to level, too; a fir's sweep up.
// -- Palm ------------------------------------------------------------------------------------------

// What a willow's hanging leaves are, by season.  Winter never reaches here -- a willow grows no
// curtains at all then -- but the other three must each look like themselves: a test held autumn
// against summer and found them identical, because the curtains had been taking one green all year.
function TreeWillowLeaf(season) -> color {
    switch (season) {
        case 'summer' { return color [0.40, 0.50, 0.25] }
        case 'autumn', 'fall' { return color [0.62, 0.51, 0.19] }
        default { return color [0.56, 0.66, 0.33] }
    }
}

// One leaflet of a palm frond: a narrow strap growing out along +Z and drooping as it goes, so it
// needs no turning to hang -- which is the lesson the willow taught.  Grown along Z rather than the
// usual Y because a palm frond is a flat feather and its leaflets leave the rachis *sideways*.
primitive TreePalmLeaflet(long, wide) -> ribbon {
    return ribbon {
        material TreePalmLeaf

        width wide        at [0, 0, 0]
        width wide * 0.96 at [0, -long * 0.03, long * 0.30]
        width wide * 0.82 at [0, -long * 0.13, long * 0.60]
        width wide * 0.52 at [0, -long * 0.30, long * 0.85]
        width wide * 0.08 at [0, -long * 0.52, long * 0.98]

        twist 0.15
    }
}

// One frond: a rachis arcing up and then well down, with leaflets in pairs along it, longest in the
// middle as a feather is.
//
// **Each pair is turned to the rachis's own tangent**, worked out from the same quadratic the tube was
// made from -- `2(1-t)(P1-P0) + 2t(P2-P1)`, whose angle is `atan2`.  Leaflets left at a fixed angle
// stand square to the frond near the base and cut across it at the tip, which reads as a mistake even
// when you cannot say what is wrong.
primitive TreePalmFrond(long, id, variant) -> group {
    pairs = 15
    midX = long * 0.42
    midY = long * 0.30
    tipX = long * 0.92
    tipY = -long * 0.20

    return group {
        tube {
            material TreePalmBark
            radius long * 0.017 at [0, 0, 0]
            quad radius long * 0.010 at [midX, midY, 0]
                 radius long * 0.004 at [tipX, tipY, 0]
        }

        for pair in [0, pairs - 1] {
            along = (pair + 1) / (pairs + 1)
            middle = 2 * (1 - along) * along
            last = along * along

            // Longest about a third of the way out and shortest at both ends.
            fat = 4 * along * (1 - along)
            leaf = long * 0.32 * (0.34 + 0.66 * fat)
            slope = toDegrees(atan2(2 * (1 - along) * midY + 2 * along * (tipY - midY),
                                    2 * (1 - along) * midX + 2 * along * (tipX - midX)))

            for side in [0, 1] {
                object TreePalmLeaflet(leaf, leaf * 0.085) {
                    // Swept back toward the base, the way a feather's barbs lie.
                    rotate Y side * 180 - (1 - 2 * side) *
                                          (22 + random(id, pair, variant) * 16)
                    rotate Z slope
                    translate [middle * midX + last * tipX,
                               middle * midY + last * tipY,
                               0]
                }
            }
        }
    }
}

// A palm: a bare leaning trunk with the whole of its foliage in one crown at the top.  **No other tree
// here is shaped anything like it** -- the broadleaves divide all the way out, the conifers are whorls
// on a leader, and the willow hangs.  A palm is a pole with a fountain on it.
//
// The season says nothing: a palm sheds and grows fronds the year round rather than by the calendar,
// and it is taken so a scene may pass it along with everything else.
primitive Palm(height, season = 'summer', variant = 1) -> group {
    fronds = 11

    // Measured against Elm's own mean, as every tree here is: an upright frond reaches above the top
    // of the trunk, so the whole plant is built against a shade less than the height asked for.
    high = height * 0.890
    tall = high * 0.72
    lean = high * 0.06

    return group {
        tube {
            material TreePalmBark
            radius high * 0.027 at [0, 0, 0]
            quad radius high * 0.022 at [lean * 0.45, tall * 0.55, 0]
                 radius high * 0.019 at [lean, tall, 0]
        }

        for frond in [0, fronds - 1] {
            object TreePalmFrond(high * 0.60 * (0.80 + random(frond, 51, variant) * 0.40),
                                 frond, variant) {
                rotate Z -4 + random(frond, 52, variant) * 62
                rotate Y frond * 360 / fronds + random(frond, 53, variant) * 26
                // Onto the top of the trunk, which leans -- turned first and moved second, so no
                // frond starts beside the wood it is supposed to leave.
                translate [lean, tall, 0]
            }
        }
    }
}

primitive Pine(height, season = 'summer', variant = 1) -> group {
    whorls = 6

    // Everything below is built against `tall` rather than the height asked for, and the ratio is
    // measured rather than reasoned: the highest thing on a pine is not the top of its trunk but the
    // needles on the topmost bough, which overshoot it by an amount no arithmetic here predicts.
    tall = height / 1.180
    bare = tall * 0.56

    // **The crown is hung below the top of the trunk, not scaled to it.**  A fir multiplies its whorl
    // heights by a factor, which works there because the factor is nearly one; doing the same here
    // simply lifted the whole crown off the top of the tree and made every variant exactly as tall as
    // every other, since nothing random reaches higher than the topmost whorl.
    crown = tall * 0.93

    return group {
        object TreeWood('fir', tall * 0.97, tall * 0.026, 0, variant)

        for whorl in [0, whorls - 1] {
            for branch in [0, 4] {
                object TreeBough(season,
                    tall * 0.34 * (1 - whorl * 0.5 / whorls) *
                        (0.85 + random(whorl, branch, variant) * 0.3),
                    whorl * 7 + branch + 400, variant) {
                    rotate Z -72 - random(whorl, branch, variant + 1) * 18
                    rotate Y branch * 72 + whorl * 41 +
                             random(whorl, branch, variant + 2) * 22
                    translate Y bare + (crown - bare) * whorl / (whorls - 1)
                }
            }
        }
    }
}

primitive Fir(height, season = 'summer', variant = 1) -> group {
    // A fir keeps its needles the year round, so three of the four seasons look alike here.  Winter
    // does not: snow gathers along the boughs, which is the state anybody picturing a fir pictures.
    whorls = 11
    bare = height * 0.16

    // A fir's height is set here rather than by TreeStand, since it never goes through TreeTrunk:
    // it is one leader with whorls off it rather than a limb that divides.  Measured against a post
    // at 9.19 for a nine asked before this factor was applied.
    stand = 0.979

    return group {
        object TreeWood('fir', height * 0.911, height * 0.028, 0, variant)
        for whorl in [0, whorls - 1] {
            for branch in [0, 5] {
                object TreeBough(season,
                    height * TreeFirSpread() * (1 - whorl / whorls) *
                        (0.85 + random(whorl, branch, variant) * 0.3),
                    whorl * 7 + branch, variant) {
                    rotate Z -22 - random(whorl, branch, variant + 1) * 14
                    rotate Y branch * 60 + whorl * 27 +
                             random(whorl, branch, variant + 2) * 18
                    translate Y (bare + (height - bare) * whorl / (whorls - 1)) * stand
                }
            }
        }
    }
}
