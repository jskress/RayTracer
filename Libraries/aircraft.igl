HawkeyeDome = material {
    pigment [0.62, 0.62, 0.60]  specular 0.25  shininess 40
    decal { path HawkeyeSpiral  color [0.05, 0.05, 0.05]  planar  min Y 0  max Y 0.6  scale 3.5 }
}

// A four-bladed propeller, its disc square to X.
primitive HawkeyeProp() -> group {
    return group {
        cube { scale [0.08, 2.05, 0.16] }
        cube { scale [0.08, 0.16, 2.05] }
        sphere { scale [0.5, 0.32, 0.32]  translate X 0.2 }
        material AircraftNavyDark
    }
}

primitive Hawkeye(folded = 1) -> group {
    return group {
        superellipsoid { east 1  north 0.8  scale [7.6, 1.05, 1.0]  translate [0.4, 2.2, 0] }
        sphere { scale [1.1, 0.5, 0.75]  translate [5.9, 2.75, 0]  material AircraftCanopy }
        superellipsoid { east 1  north 0.9  scale [1.6, 0.7, 0.65]  translate [-6.5, 2.75, 0] }
        object AircraftPlate(HawkeyeWingIn, 3.25, 0.32)
        object AircraftPlate(HawkeyeWingIn, 3.25, 0.32) { scale [1, 1, -1] }
        group {
            object AircraftPlate(HawkeyeWingOut, 0, 0.26) {
                rotate X (-90 * folded)  rotate Z (90 * folded)  translate [1.75, 0, 4.6]
            }
            translate Y 3.25
        }
        group {
            object AircraftPlate(HawkeyeWingOut, 0, 0.26) {
                rotate X (-90 * folded)  rotate Z (90 * folded)  translate [1.75, 0, 4.6]
            }
            translate Y 3.25
            scale [1, 1, -1]
        }
        superellipsoid { east 0.8  north 0.8  scale [3.3, 0.72, 0.62]  translate [0.9, 2.7, 3.9] }
        superellipsoid { east 0.8  north 0.8  scale [3.3, 0.72, 0.62]  translate [0.9, 2.7, -3.9] }
        object HawkeyeProp() { translate [4.3, 2.8, 3.9] }
        object HawkeyeProp() { translate [4.3, 2.8, -3.9] }
        // Her tailplane, with eleven degrees of dihedral, and its four fins.
        object AircraftPlate(HawkeyeStab, 0, 0.18) { rotate X -11  translate Y 3.35 }
        object AircraftPlate(HawkeyeStab, 0, 0.18) { rotate X -11  translate Y 3.35  scale [1, 1, -1] }
        object AircraftPlate(HawkeyeFin, 0, 0.14) { rotate X -90  translate [0, 3.6, 1.35] }
        object AircraftPlate(HawkeyeFin, 0, 0.14) { rotate X -90  translate [0, 3.6, -1.35] }
        object AircraftPlate(HawkeyeFin, 0, 0.14) { rotate X -90  translate [0, 4.1, 3.9] }
        object AircraftPlate(HawkeyeFin, 0, 0.14) { rotate X -90  translate [0, 4.1, -3.9] }
        // Her rotodome on its two struts.
        cube { scale [0.25, 0.75, 0.18]  translate [-1.2, 4.0, 0.5] }
        cube { scale [0.25, 0.75, 0.18]  translate [-1.2, 4.0, -0.5] }
        group {
            sphere { scale [3.66, 0.38, 3.66] }
            translate [-1.6, 5.15, 0]
            material HawkeyeDome
        }
        object AircraftLeg(6.2, 0, 0.3, 1.3)
        object AircraftLeg(0.6, 2.2, 0.42, 1.9)
        object AircraftLeg(0.6, -2.2, 0.42, 1.9)
        material AircraftNavyGray
    }
}

// The EA-6B Prowler: 18.24 m long with her refueling probe, 16.15 m across, 7.87 m folded, 4.95 m high to the
// receiver pod on top of her fin.  Four men sit two and two under one broad canopy, and a jamming pod hangs under
// each wing.
ProwlerWingIn = path { move to 2.6, 0  line to 1.3, 2.9  line to -1.05, 2.9  line to -1.6, 0  close }
ProwlerWingOut = path { move to 0, 0  line to -2.3, 5.0  line to -3.3, 5.0  line to -2.35, 0  close }
ProwlerStab = path { move to -6.6, 0  line to -8.0, 3.0  line to -8.9, 3.0  line to -8.7, 0  close }
ProwlerFin = path { move to -4.2, 0  line to -6.3, 2.75  line to -8.2, 2.75  line to -8.0, 0  close }

primitive Prowler(folded = 1) -> group {
    return group {
        superellipsoid { east 0.7  north 0.7  scale [4.0, 0.95, 1.05]  translate [4.4, 2.2, 0] }
        superellipsoid { east 0.9  north 0.8  scale [5.6, 0.75, 0.8]  translate [-3.0, 2.25, 0] }
        sphere { scale [1.0, 0.35, 0.35]  translate [8.2, 2.0, 0]  material AircraftRadome }
        superellipsoid { east 0.5  north 0.5  scale [1.9, 0.45, 0.85]  translate [5.0, 2.95, 0]  material AircraftCanopy }
        cylinder { min Y 0  max Y 1.4  scale 0.05  rotate Z -90  translate [7.4, 2.9, 0] }
        superellipsoid { east 0.7  north 0.7  scale [2.7, 0.55, 0.55]  translate [1.2, 1.55, 1.25] }
        superellipsoid { east 0.7  north 0.7  scale [2.7, 0.55, 0.55]  translate [1.2, 1.55, -1.25] }
        group {
            object AircraftPlate(ProwlerWingIn, 0, 0.2)
            object AircraftPlate(ProwlerWingOut, 0, 0.16) { rotate X (-100 * folded)  translate [1.3, 0, 2.9] }
            translate [0, 2.2, 0.9]
        }
        group {
            object AircraftPlate(ProwlerWingIn, 0, 0.2)
            object AircraftPlate(ProwlerWingOut, 0, 0.16) { rotate X (-100 * folded)  translate [1.3, 0, 2.9] }
            translate [0, 2.2, 0.9]
            scale [1, 1, -1]
        }
        superellipsoid { east 1  north 0.7  scale [2.2, 0.38, 0.38]  translate [0.6, 1.25, 2.9] }
        superellipsoid { east 1  north 0.7  scale [2.2, 0.38, 0.38]  translate [0.6, 1.25, -2.9] }
        object AircraftPlate(ProwlerStab, 2.45, 0.14) { translate Z 0.4 }
        object AircraftPlate(ProwlerStab, 2.45, 0.14) { translate Z 0.4  scale [1, 1, -1] }
        object AircraftPlate(ProwlerFin, 0, 0.18) { rotate X -90  translate Y 2.8 }
        superellipsoid { east 1  north 0.8  scale [1.7, 0.42, 0.42]  translate [-6.6, 5.55, 0] }
        object AircraftLeg(5.6, 0, 0.3, 1.4)
        object AircraftLeg(-0.9, 1.7, 0.4, 1.4)
        object AircraftLeg(-0.9, -1.7, 0.4, 1.4)
        material AircraftNavyGray
    }
}

// The S-3B Viking: 16.26 m long, 20.93 m across, 8.99 m folded, 6.93 m high, 4.65 m with her fin folded.  Her
// wings fold up and on over her back until they cross, the port one over the starboard, and her tall fin folds
// down to port to clear the hangar's deckhead.
VikingWingIn = path { move to 1.7, 0  line to 1.15, 3.4  line to -1.75, 3.4  line to -2.1, 0  close }
VikingWingOut = path { move to 0, 0  line to -1.7, 6.6  line to -3.0, 6.6  line to -2.9, 0  close }
VikingStab = path { move to -5.4, 0  line to -6.6, 4.1  line to -7.6, 4.1  line to -7.9, 0  close }
VikingFin = path { move to -4.2, 0  line to -6.5, 3.8  line to -7.8, 3.8  line to -7.9, 0  close }

primitive Viking(folded = 1) -> group {
    return group {
        superellipsoid { east 0.6  north 0.6  scale [7.0, 1.3, 1.15]  translate [0.3, 2.0, 0] }
        sphere { scale [1.4, 1.05, 1.1]  translate [6.6, 2.0, 0] }
        superellipsoid { east 0.5  north 0.5  scale [1.2, 0.4, 0.95]  translate [5.9, 3.1, 0]  material AircraftCanopy }
        group {
            object AircraftPlate(VikingWingIn, 0, 0.24)
            object AircraftPlate(VikingWingOut, 0, 0.18) { rotate X (-152 * folded)  translate [1.15, 0, 3.4] }
            translate [0, 3.35, 0.9]
        }
        group {
            object AircraftPlate(VikingWingIn, 0, 0.24)
            object AircraftPlate(VikingWingOut, 0, 0.18) { rotate X (-146 * folded)  translate [1.15, 0, 3.4] }
            translate [0, 3.35, 0.9]
            scale [1, 1, -1]
        }
        superellipsoid { east 0.8  north 0.8  scale [1.9, 0.62, 0.62]  translate [0.9, 2.25, 2.85] }
        superellipsoid { east 0.8  north 0.8  scale [1.9, 0.62, 0.62]  translate [0.9, 2.25, -2.85] }
        object AircraftPlate(VikingStab, 2.6, 0.14)
        object AircraftPlate(VikingStab, 2.6, 0.14) { scale [1, 1, -1] }
        object AircraftPlate(VikingFin, 0, 0.2) { rotate X (-90 + 90 * folded)  translate Y 3.2 }
        object AircraftLeg(5.4, 0, 0.3, 1.0)
        object AircraftLeg(0.0, 1.6, 0.4, 1.0)
        object AircraftLeg(0.0, -1.6, 0.4, 1.0)
        material AircraftNavyGray
    }
}

// The SH-60F Seahawk: 15.26 m long, 3.79 m to the top of her rotor head, her rotor 16.36 m across.  Folded, her
// four blades lie aft along her tail boom and her tail pylon folds forward beside it, and she is 12.47 m long.
primitive Seahawk(folded = 1) -> group {
    return group {
        superellipsoid { east 0.45  north 0.45  scale [3.0, 0.95, 1.18]  translate [2.6, 1.55, 0] }
        sphere { scale [1.1, 0.75, 1.0]  translate [5.0, 1.55, 0]  material AircraftCanopy }
        superellipsoid { east 0.6  north 0.6  scale [2.0, 0.42, 0.95]  translate [1.8, 2.75, 0] }
        superellipsoid { east 1  north 1  scale [3.8, 0.45, 0.42]  translate [-3.2, 2.05, 0] }
        cylinder { min Y 2.9  max Y 3.6  scale 0.25  translate [1.6, 0, 0] }
        if (folded > 0.5) {
            cube { scale [1.0, 0.12, 0.85]  translate [-6.3, 2.2, 0.85] }
            cube { scale [3.9, 0.06, 0.27]  rotate Y 4  translate [-2.3, 3.5, 0.5] }
            cube { scale [3.9, 0.06, 0.27]  rotate Y -4  translate [-2.3, 3.5, -0.5] }
            cube { scale [3.9, 0.06, 0.27]  rotate Y 1.5  translate [-2.3, 3.3, 0.18] }
            cube { scale [3.9, 0.06, 0.27]  rotate Y -1.5  translate [-2.3, 3.3, -0.18] }
        }
        if (folded < 0.5) {
            cube { scale [1.0, 0.85, 0.12]  translate [-7.2, 2.85, 0] }
            cylinder { min Y -1.65  max Y 1.65  scale [0.05, 1, 0.12]  rotate X 90  translate [-7.6, 3.4, 0.25] }
            for blade in [0, 3] {
                cube { scale [4.1, 0.06, 0.27]  translate X 4.1  rotate Y (blade * 90 + 20)  translate [1.6, 3.6, 0] }
            }
        }
        object AircraftLeg(1.0, 1.4, 0.3, 0.9)
        object AircraftLeg(1.0, -1.4, 0.3, 0.9)
        object AircraftLeg(-4.6, 0, 0.2, 1.4)
        material AircraftNavyGray
    }
}
