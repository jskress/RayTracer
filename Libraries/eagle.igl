// Six small dark ports on the top, painted on: two beside the hatch and four along the band to starboard, one by each
// panel's forward corner (the last is the one Mandel draws near the nose in his profile).  The decal is cylindrical
// about the hull lathe's axis, laid out on the hull in the world's lengths.
EagleCommandPorts = path {
    move to 3.7630, 1.5475
    line to 3.7539, 1.6125  line to 3.7946, 1.6125  line to 3.8037, 1.5475
    close
    move to 3.9509, 1.5475
    line to 3.9414, 1.6125  line to 3.9821, 1.6125  line to 3.9916, 1.5475
    close
    move to -3.8037, 1.5475
    line to -3.7946, 1.6125  line to -3.7539, 1.6125  line to -3.7630, 1.5475
    close
    move to 3.9566, 2.0075
    line to 3.8733, 2.0725  line to 3.9147, 2.0725  line to 3.9979, 2.0075
    close
    move to -3.4240, 2.0075
    line to -3.3528, 2.0725  line to -3.3114, 2.0725  line to -3.3826, 2.0075
    close
    move to 2.9869, 2.7875
    line to 2.8705, 2.8525  line to 2.9121, 2.8525  line to 3.0285, 2.7875
    close
    move to -2.5379, 2.7875
    line to -2.4405, 2.8525  line to -2.3989, 2.8525  line to -2.4963, 2.7875
    close
    move to 2.1426, 3.2775
    line to 2.0140, 3.3425  line to 2.0563, 3.3425  line to 2.1849, 3.2775
    close
    move to -1.7372, 3.2775
    line to -1.6352, 3.3425  line to -1.5929, 3.3425  line to -1.6949, 3.2775
    close
    move to 1.5768, 3.5775
    line to 1.4318, 3.6425  line to 1.4751, 3.6425  line to 1.6201, 3.5775
    close
    move to -1.2135, 3.5775
    line to -1.1053, 3.6425  line to -1.0621, 3.6425  line to -1.1702, 3.5775
    close
}

// The hull, its ports painted on.
EagleCommandHull = lathe {
    path EagleCommandOutline
    material inherited {
        decal { path EagleCommandPorts  color EagleHole  cylindrical  min radius 0.05  max radius 1.5 }
    }
    rotate Z -90
    scale [1, 1, EagleCommandWidening]
    translate [EagleCommandBack, EagleCommandMiddle, 0]
}

// The recess of one forward viewport, `up` 1 above the center line and -1 below it, `side` 1 to port and -1 to
// starboard: the block cut out of the hull, its faces the dark glass.
//
// **A window is a recess, not the hull's skin.**  Its floor is all but level and its inner wall all but upright, and
// a wall at its back faces forward; the bands down the middle of the module's faces stand proud between the four.
// Its edges run straight in the side view and in the plan (Briedis's drawings, scaled to this length): the floor's
// edge 0.42 above the center line at 9.17, falling 0.094 for every meter forward, and the inner wall's 0.69 out from
// the middle there (as a photograph of the 44-inch model from dead ahead has it), falling 0.106 -- each a plane, the
// one tipped forward 5.37 degrees from level and the other turned in 6.05 from upright.  Seen from the side the
// window is its inner wall, from above its floor, and from ahead its back wall.  The back wall is at 9.12, and the
// recess ends at 11.08, a few centimeters wide, as Mandel draws it, where the two planes are still within the hull.
primitive EagleCommandWindow(up, side) -> group {
    return group {
        intersection {
            cube { scale 50  translate Y up * 50  rotate Z -up * 5.37  translate [9.17, EagleCommandMiddle + up * 0.42, 0] }
            cube { scale 50  translate Z side * 50  rotate Y side * 6.05  translate [9.17, 0, side * 0.69] }
            cube { scale [0.98, 2, 3]  translate [10.1, EagleCommandMiddle, 0] }
        }
        material EagleGlass
    }
}

// A round hatch: a gray ring standing out of the hull, a dark well within it, facing along +Y before it is placed.
EagleCommandHatch = group {
    difference {
        cylinder { min Y -0.1  max Y 0.035  scale [0.22, 1, 0.22] }
        cylinder { min Y -0.2  max Y 0.2  scale [0.15, 1, 0.15] }
        material EagleGray
    }
    cylinder { min Y -0.1  max Y 0.01  scale [0.155, 1, 0.155]  material EagleDark }
}

// The command module: its hull with the four forward viewports and its grooves cut into it, a hatch on either side and one on top,
// and the collar it stands on at its back.  The side hatches are where Mandel draws his ringed circle, on the center
// line at 8.94; Briedis puts a hatch on the top as well, above the same place.
EagleCommandModule = group {
    difference {
        object EagleCommandHull
        object EagleCommandWindow(1, 1)
        object EagleCommandWindow(1, -1)
        object EagleCommandWindow(-1, 1)
        object EagleCommandWindow(-1, -1)
        object EagleCommandGrooves
        // the emblems on its flanks, between the windows near the nose
        material inherited {
            decal { path EagleEmblemPlaque  color EagleEmblemWhite  planar  min Y 0.3  max Y 2.0
                    scale [-0.4, 1, 0.4]  translate [10.85, 0, -2.607]  rotate X 90 }
            decal { path EagleEmblemMark  color EagleEmblemBlue  planar  min Y 0.3  max Y 2.0
                    scale [-0.4, 1, 0.4]  translate [10.85, 0, -2.607]  rotate X 90 }
            decal { path EagleEmblemPlaque  color EagleEmblemWhite  planar  min Y 0.3  max Y 2.0
                    scale [0.4, 1, -0.4]  translate [10.85, 0, 2.607]  rotate X -90 }
            decal { path EagleEmblemMark  color EagleEmblemBlue  planar  min Y 0.3  max Y 2.0
                    scale [0.4, 1, -0.4]  translate [10.85, 0, 2.607]  rotate X -90 }
        }
    }
    object EagleCommandHatch { rotate X -90  translate [8.94, EagleCommandMiddle, 1.987] }
    object EagleCommandHatch { rotate X 90  translate [8.94, EagleCommandMiddle, -1.987] }
    object EagleCommandHatch { translate [8.9, EagleCommandMiddle + 1.24, 0] }
    cylinder { min Y 7.2  max Y EagleCommandBack + 0.05  scale [0.3, 1, 0.3]  rotate Z -90  translate Y EagleCommandMiddle
               material EagleGray }
}

// -- Pods ---------------------------------------------------------------------------------------------

// What hangs in the bay under the spine, between the sections: from 4.195 aft of the middle to 3.91 forward of it
// (Mandel's profile: 8.1 long, where his particulars say 8.15), 4.55 across, its roof at 3.60 under the spine's
// bottom chords and its floor 2.68 below that.

// The passenger module, after Mandel's profile and the studio's 44-inch model's (Tim Ketzer's photographs of the
// module alone, cited, not reproduced): upright sides from 1.27 up to eaves at 3.05, and above them a slope on
// either side, 27.6 degrees, up to a flat top 2.45 across at 3.60 under the spine's bottom chords; so seen from an
// end it is a house.
//   - Each slope is a panel standing 3 cm proud of it, its lower edge a bullnose 3.5 cm in radius (finer than the
//     spine's bottom chords, 4.5) overhanging the upright wall.  Set into the panel, two groups of three windows --
//     which is why the windows show in a side view and a plan alike -- with two vents between the groups and a
//     grille at either end.
//   - Along each side, a ribbed panel either side of the sliding door (the "Sliding Doors (2)" of Mandel's profile,
//     one a side), a recess 3 cm deep with eight grooves along its floor; the door set 7.5 cm into the side, its two
//     leaves meeting in the middle, and on them an hourglass-shaped panel standing out flush with the side; and a
//     rail along the bottom.
//   - In each end, a door: a trapezoid narrowing upward, its eight triangles recessed between the bars of an
//     upright, a level and its two diagonals, all crossing where the diagonals do; and either side of it a panel
//     carrying a hexagonal plate, the two mirror images of one another.
//   - Under it, a shallow well ribbed along and across, and four round feet with a ribbed block beside each, down
//     to 0.92 (his feet; the photos' cups).
// The windows' places are Mandel's profile's, made alike fore and aft about the middle.

// A foot of a pod: a round cup, flaring to its sole, a shallow dish in that, from the pod's underside to 0.92.
EaglePodFoot = lathe {
    path { move to 0, 0.96  line to 0.36, 0.92  line to 0.42, 0.92  line to 0.32, 1.32  line to 0, 1.32  close }
    material EagleBell
}

// The ribbed block beside each foot.
EaglePodBlock = group {
    cube { scale [0.165, 0.075, 0.15]  translate Y 1.245 }
    cube { scale [0.02, 0.08, 0.16]  translate [-0.1, 1.245, 0] }
    cube { scale [0.02, 0.08, 0.16]  translate [0, 1.245, 0] }
    cube { scale [0.02, 0.08, 0.16]  translate [0.1, 1.245, 0] }
    material EagleGray
}

