                curve -3.0325, 2.3392, -3.0537, 2.3326 to -3.0627, 2.3155
                line to -3.6266, 1.2389
                line to -3.6000, 1.2250
                line to -3.6000, -1.2250
                line to -3.6266, -1.2389
                line to -3.0627, -2.3155
                curve -3.0537, -2.3326, -3.0325, -2.3392 to -3.0154, -2.3303
                curve -2.9983, -2.3213, -2.9917, -2.3001 to -3.0006, -2.2830
                line to -3.0052, -2.2750
                line to -1.2700, -2.2750
                close
            }
            min Y -4.0525  max Y 4.0525
            rotate Z -90
        }
        union {
            union {
                cube { scale [0.2750, 0.0375, 0.0356]  translate Y 0.0425  rotate X 27.646  translate [3.7250, 3.1600, 2.0650] }
                cube { scale [0.2750, 0.0375, 0.0356]  translate Y 0.0425  rotate X 27.646  translate [3.7250, 3.2425, 1.9075] }
