    line to 0.6790, 0.5240  line to 0.6710, 0.5240  line to 0.6680, 0.5360  line to 0.6760, 0.5360
    line to 0.6665, 0.5740  line to 0.6585, 0.5740  line to 0.6555, 0.5860  line to 0.6635, 0.5860
    line to 0.6540, 0.6240  line to 0.6460, 0.6240  line to 0.6430, 0.6360  line to 0.6510, 0.6360
    line to 0.6415, 0.6740  line to 0.6335, 0.6740  line to 0.6308, 0.6860  line to 0.6388, 0.6860
    line to 0.6312, 0.7240  line to 0.6232, 0.7240  line to 0.6208, 0.7360  line to 0.6288, 0.7360
    line to 0.6000, 0.8800  line to 0.5350, 1.0800  line to 0.4700, 1.2300  line to 0.4200, 1.3300
    line to 0.4200, 1.5300  line to 0.2700, 1.5300  line to 0.2700, 2.2000  line to 0.0000, 2.2000
    close
}

// A tank: a pill along +Y from its aft end, 1.75 long and 0.55 round, its ends rounded 0.5 deep, a seam round it
// where each end meets its middle.
EagleTank = group {
    lathe {
        path {
            move to 0, 0
            curve 0.3038, 0, 0.55, 0.2239 to 0.55, 0.5
            line to 0.55, 1.25
            curve 0.55, 1.5261, 0.3038, 1.75 to 0, 1.75
            close
        }
    }
    cylinder { min Y 0.49  max Y 0.52  scale [0.562, 1, 0.562] }
    cylinder { min Y 1.23  max Y 1.26  scale [0.562, 1, 0.562] }
    material inherited {
        decal { path EagleTankBars  color EagleOrange  cylindrical  min radius 0.4  max radius 0.7  rotate Y 180 }
    }
}

// One of a bell's five small nozzles, on the plate in its throat, opening toward the mouth (-Y).
EagleBellNozzle = lathe {
    path { move to 0.025, 0  line to 0.07, -0.17  line to 0.076, -0.17  line to 0.033, 0  close }
}

// One engine, its axis `high` up and `side` across, its bell's mouth at the stern.
primitive EagleEngine(high, side) -> group {
    return group {
        group {
            lathe { path EagleBellOutline }
            cylinder { min Y 1.78  max Y 1.93  scale [0.33, 1, 0.33] }
            cylinder { min Y 1.248  max Y 1.252  scale [0.44, 1, 0.44]  material EagleDark }
            object EagleBellNozzle { translate Y 1.25 }
            object EagleBellNozzle { translate [0.2, 1.25, 0] }
            object EagleBellNozzle { translate [-0.2, 1.25, 0] }
            object EagleBellNozzle { translate [0, 1.25, 0.2] }
            object EagleBellNozzle { translate [0, 1.25, -0.2] }
            material EagleBell
            rotate Z -90
            translate [EagleBellMouth, high, side]
        }
        object EagleTank { rotate Z -90  translate [-9.5, high, side] }
    }
}

// What holds the engines together: a pair of struts upright between the top and bottom engines and a pair level
// between the side ones, crossing behind the bells, each pair straddling the necks it runs between, 0.46 apart at
// the flange rings round them (0.66 across) and ending inside them; four spheres between the tanks, two above the
// side engines and two below, as the stern elevation and the photographs have them; and a small pipe from each
// sphere round to the neck of each engine beside it.
EagleEngineFrame = group {
    for z in list(-0.23, 0.23) {
        tube { radius 0.04 at [-9.72, 1.74, z]  radius 0.04 at [-9.72, 3.40, z] }
    }
    for y in list(2.30, 2.76) {
        tube { radius 0.04 at [-9.72, y, -1.63]  radius 0.04 at [-9.72, y, 1.63] }
    }
    for z in list(-1, 1) {
        sphere { scale 0.38  translate [-8.7, 3.62, 0.92 * z] }
        sphere { scale 0.38  translate [-8.7, 1.62, 0.92 * z] }
        cylinder { min Y -0.012  max Y 0.012  scale [0.386, 1, 0.386]  rotate Z 90  translate [-8.7, 3.62, 0.92 * z]
                   material EagleChecks }
        cylinder { min Y -0.012  max Y 0.012  scale [0.386, 1, 0.386]  rotate Z 90  translate [-8.7, 1.62, 0.92 * z]
                   material EagleChecks }
    }
    tube { radius 0.035 at [-8.820, 3.536, 0.569]  quad radius 0.035 at [-9.560, 3.508, 0.453]  radius 0.035 at [-9.580, 3.457, 0.236] }
    tube { radius 0.035 at [-8.820, 3.318, 1.117]  quad radius 0.035 at [-9.560, 3.113, 1.250]  radius 0.035 at [-9.580, 2.734, 1.497] }
    tube { radius 0.035 at [-8.820, 3.536, -0.569]  quad radius 0.035 at [-9.560, 3.508, -0.453]  radius 0.035 at [-9.580, 3.457, -0.236] }
    tube { radius 0.035 at [-8.820, 3.318, -1.117]  quad radius 0.035 at [-9.560, 3.113, -1.250]  radius 0.035 at [-9.580, 2.734, -1.497] }
    tube { radius 0.035 at [-8.820, 1.667, 0.562]  quad radius 0.035 at [-9.560, 1.681, 0.450]  radius 0.035 at [-9.580, 1.709, 0.241] }
    tube { radius 0.035 at [-8.820, 1.905, 1.142]  quad radius 0.035 at [-9.560, 2.056, 1.261]  radius 0.035 at [-9.580, 2.338, 1.481] }
    tube { radius 0.035 at [-8.820, 1.667, -0.562]  quad radius 0.035 at [-9.560, 1.681, -0.450]  radius 0.035 at [-9.580, 1.709, -0.241] }
    tube { radius 0.035 at [-8.820, 1.905, -1.142]  quad radius 0.035 at [-9.560, 2.056, -1.261]  radius 0.035 at [-9.580, 2.338, -1.481] }
}


// -- The leg pods ------------------------------------------------------------------------------------

// A leg pod has a square top and a square bottom, each sloping out at 45 degrees to a band round its middle that
// is an octagon in plan: four sides, the one toward the ship among them, and a corner cut between each two, so it
// is the same all the way round, and from any side the slopes and the band make an octagon too.  The band is
// lower than it is long, so its outer face, where the thrusters stand, is a rectangle.  The shape is Munro's plan
// and Briedis's side view on the eagle-with-without sheet: 2.7 square, its top and bottom 1.56 square, the band
// 0.9 deep about 2.01, from 0.99 up to 3.03 (Mandel's heights), its inner side 1.77 out from the middle (a block
// holds it off the section's side at 1.70).  Built for the port side about its own middle along the craft, it is
// every point inside the octagon in plan, the octagon seen from ahead and the one seen from the side -- which
// make the band and the slopes -- and inside an octahedron about its middle, whose faces are the triangles that
// run from each corner of the top or the bottom down to a corner cut of the band.
EagleLegPodShape = intersection {
    extrusion {
        path {
            move to -0.78, 1.77  line to 0.78, 1.77  line to 1.35, 2.34  line to 1.35, 3.9
            line to 0.78, 4.47  line to -0.78, 4.47  line to -1.35, 3.9  line to -1.35, 2.34  close
        }
        min Y 0.99  max Y 3.03
    }
    extrusion {
        path {
            move to -0.99, 2.34  line to -0.99, 3.9  line to -1.56, 4.47  line to -2.46, 4.47
            line to -3.03, 3.9  line to -3.03, 2.34  line to -2.46, 1.77  line to -1.56, 1.77  close
        }
        min Y -1.4  max Y 1.4
        rotate Z -90
    }
    extrusion {
        path {
            move to -0.78, -0.99  line to 0.78, -0.99  line to 1.35, -1.56  line to 1.35, -2.46
            line to 0.78, -3.03  line to -0.78, -3.03  line to -1.35, -2.46  line to -1.35, -1.56  close
        }
        min Y 1.7  max Y 4.55
        rotate X 90
    }
    cube { scale [1.4896, 50, 50]  rotate Z 35.264  rotate Y -135  translate [0, 2.01, 3.12] }
    cube { scale [1.4896, 50, 50]  rotate Z 35.264  rotate Y -45  translate [0, 2.01, 3.12] }
    cube { scale [1.4896, 50, 50]  rotate Z 35.264  rotate Y 45  translate [0, 2.01, 3.12] }
    cube { scale [1.4896, 50, 50]  rotate Z 35.264  rotate Y 135  translate [0, 2.01, 3.12] }
}

// A thruster's bell, its throat at the origin, opening up along +Y.
EagleThrusterBell = lathe {
    path { move to 0.04, 0  quad 0.05, 0.15 to 0.09, 0.22  line to 0.075, 0.22  quad 0.037, 0.15 to 0.025, 0  close }
}

// A cluster of thrusters about the origin, facing +Z: a block with a bell pointing up, down and either way along the
// face it stands on, and a round lamp on its own face.
EagleThrusters = group {
    cube { scale [0.2, 0.145, 0.1]  material EagleGray }
    sphere { scale 0.075  translate Z 0.1  material EagleGlass }
    group {
        object EagleThrusterBell { translate [0, 0.145, 0.02] }
        object EagleThrusterBell { rotate Z 180  translate [0, -0.145, 0.02] }
        object EagleThrusterBell { rotate Z -90  translate [0.2, 0, 0.02] }
        object EagleThrusterBell { rotate Z 90  translate [-0.2, 0, 0.02] }
        material EagleBell
    }
}

// A leg pod with what stands on it, for the port side, its outer end along +X:
//   - in the middle of its outer face, the thrusters: a block with a bell pointing up, down, fore and aft along the
//     face and a round lamp on its own face (Mandel's profile and plan; the dark X they stand in is a marking);
//   - on top, a beacon toward the middle of the craft and a hatch toward the end (his plan, and the beacon's bump in
//     his bow elevation);
//   - a round porthole in the corner cut between the outer face and the outer end (his profile and bow elevation);
//   - a grille of four slots in the slope above the outer face, toward the middle of the craft (his profile and
//     plan);
//   - a slot of a window across the outer end (his bow and stern elevations);
//   - the cutout in its underside its landing leg stands out of and its pad is drawn up into: the pad's shape,
//     0.17 deep and 0.23 more in the middle, its wings opening through the pod's four lower slopes;
//   - the block that holds it to its section.
EagleLegPodFitted = group {
    difference {
        object EagleLegPodShape
        material inherited {
            decal { path EagleLegPodCross  color EagleBlack  planar  min Y 4.35  max Y 4.6  rotate X 90 }
        }
        union {
            extrusion {
                path {
                    move to -0.55, -1.2  line to 0.55, -1.2  line to 0.55, -0.55  line to 1.2, -0.55
                    line to 1.2, 0.55  line to 0.55, 0.55  line to 0.55, 1.2  line to -0.55, 1.2
                    line to -0.55, 0.55  line to -1.2, 0.55  line to -1.2, -0.55  line to -0.55, -0.55  close
                }
                min Y 0.9  max Y 1.16
            }
            cube { scale [0.55, 0.16, 0.55]  translate Y 1.06 }
            translate Z 3.12
        }
    }
    cube { scale [0.55, 0.42, 0.05]  translate [0, 2.01, 1.73] }
    object EagleThrusters { translate [0, 2.01, 4.55] }
    cylinder { min Y 3.0  max Y 3.06  scale [0.12, 1, 0.12]  translate [-0.46, 0, 2.68]  material EagleGray }
    sphere { scale [0.09, 0.1, 0.09]  translate [-0.46, 3.06, 2.68] }
    difference {
        cylinder { min Y 3.0  max Y 3.06  scale [0.26, 1, 0.26] }
        cylinder { min Y 2.9  max Y 3.2  scale [0.21, 1, 0.21] }
        translate [0.5, 0, 2.68]
        material EagleGray
    }
    group {
        difference {
            cylinder { min Y -0.03  max Y 0.025  scale [0.19, 1, 0.19] }
            cylinder { min Y -0.1  max Y 0.1  scale [0.15, 1, 0.15] }
            material EagleGray
        }
        cylinder { min Y -0.03  max Y 0.01  scale [0.155, 1, 0.155]  material EagleGlass }
        rotate Z -90  rotate Y -45
        translate [1.065, 2.01, 4.185]
    }
    group {
        cube { scale [0.18, 0.012, 0.15]  material EagleDark }
        for u in list(-0.09, 0, 0.09) {
            cube { scale [0.012, 0.02, 0.15]  translate [u, 0, 0] }
        }
        rotate X 45
        translate [-0.35, 2.745, 4.185]
    }
    cube { scale [0.01, 0.1, 0.285]  translate [1.35, 2.075, 3.12]  material EagleGlass }
}

// A leg pod about `middle` along the craft, its outer end toward `end` (1 the bow, -1 the stern), `side` 1 to port
// and -1 to starboard.
primitive EagleLegPod(middle, end, side) -> group {
    return group {
        object EagleLegPodFitted
        scale [end, 1, side]
        translate [middle, 0, 0]
    }
}

// -- The landing legs --------------------------------------------------------------------------------

// The landing gear's metal: the struts and links painted gray, the shock strut's piston bare and bright.
EagleChrome = material { metal 'chromium' }

// How far a leg's shock strut runs out from where it stands, loaded, to where it hangs free, in the drawings'
// meters: the knee link it is held by straightens at 0.20.
EagleLegTravel = 0.15

// The pad a leg stands on, about the leg's middle: a raised plate 1.1 square, a wing along each of its sides, the
// corners between the wings open, and each wing's outer face cut back toward the middle at 45 degrees, so that a
// leg drawn up into its pod fills the cutout in the pod's underside, the pad's sole flush with the pod's bottom and
// its four faces lying in the pod's four lower slopes.  It is 1.9 square across the wings' tops and 1.56 at the
// ground (the pod's bottom), 0.17 deep to the wings' tops: Mandel draws it 2.07 long and 1.7 across, and its sides
// cut back, and the pods it stows in are square.  Four slots run along each wing, as the 44-inch model's pads have.
EagleLegPad = group {
    difference {
        intersection {
            extrusion {
                path {
                    move to -0.55, -0.95  line to 0.55, -0.95  line to 0.55, -0.55  line to 0.95, -0.55
                    line to 0.95, 0.55  line to 0.55, 0.55  line to 0.55, 0.95  line to -0.55, 0.95
                    line to -0.55, 0.55  line to -0.95, 0.55  line to -0.95, -0.55  line to -0.55, -0.55  close
                }
                min Y 0  max Y 0.17
            }
            cube { scale 50  translate X -50  rotate Z -45  translate [0.78, 0, 0] }
            cube { scale 50  translate X 50  rotate Z 45  translate [-0.78, 0, 0] }
            cube { scale 50  translate Z -50  rotate X 45  translate [0, 0, 0.78] }
            cube { scale 50  translate Z 50  rotate X -45  translate [0, 0, -0.78] }
        }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, 0.62] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, -0.62] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, 0.70] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, -0.70] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, 0.78] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, -0.78] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, 0.86] }
        cube { scale [0.5, 0.02, 0.0175]  translate [0, 0.17, -0.86] }
        cube { scale [0.0175, 0.02, 0.5]  translate [0.62, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [-0.62, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [0.70, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [-0.70, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [0.78, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [-0.78, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [0.86, 0.17, 0] }
        cube { scale [0.0175, 0.02, 0.5]  translate [-0.86, 0.17, 0] }
    }
    cube { scale [0.55, 0.025, 0.55]  translate Y 0.195 }
}

// A gusset of a leg's foot: a wedge standing on the pad, out along +X from the piston, falling from 0.38 at the
// piston to 0.22 at its end `reach` out.
primitive EagleLegGusset(reach) -> extrusion {
    return extrusion {
        path { move to 0.06, 0.22  line to reach, 0.22  line to 0.06, 0.38  close }
        min Y -0.04  max Y 0.04
        rotate X -90
    }
}

// A landing leg, standing on the ground under its pod's middle, `along` the craft and `side` 1 to port and -1 to
// starboard, `extension` 0 standing and 1 hanging free, `stowed` 0 out and 1 drawn up into the pod, its pad filling
// the cutout there (whatever is above the pad then stands inside the pod, out of sight).  As Mandel draws it, and
// the 44-inch model has it:
//   - an inverted pyramid of four struts from the ceiling of the cutout in the pod's underside (Mandel's profile and
//     bow elevation) down to a collar round the shock strut, 0.70 up;
//   - the shock strut: a sleeve from the pod to the collar and a bright piston running out of it to the foot;
//   - the foot: four wedges standing round the piston on the pad's raised plate;
//   - the knee link, aft of the piston on both legs: an upper link from the collar and a lower one to the aft
//     wedge, hinged at a knee that folds as the strut runs in and opens as it runs out.  The two links are joints,
//     the upper about the collar and the lower about the knee, reaching for the pin on the wedge wherever the
//     strut has put it.
primitive EagleLeg(along, side, extension, stowed) -> group {
    drop = extension * EagleLegTravel
    return group {
        // drawn up as one into the pod when it is stowed
        group {
            // the mounting plate in the pod's cutout, the struts down to the collar and the collar's four bars
            cube { scale [0.5, 0.015, 0.5]  translate Y 1.205 }
            tube { radius 0.035 at [-0.5, 1.2, -0.43]  radius 0.035 at [-0.3, 0.7, -0.16] }
            tube { radius 0.035 at [-0.5, 1.2, 0.43]  radius 0.035 at [-0.3, 0.7, 0.16] }
            tube { radius 0.035 at [0.5, 1.2, -0.43]  radius 0.035 at [0.3, 0.7, -0.16] }
            tube { radius 0.035 at [0.5, 1.2, 0.43]  radius 0.035 at [0.3, 0.7, 0.16] }
            tube {
                discontinuous
                radius 0.03 at [-0.3, 0.7, -0.16]  radius 0.03 at [0.3, 0.7, -0.16]  radius 0.03 at [0.3, 0.7, 0.16]
                radius 0.03 at [-0.3, 0.7, 0.16]  radius 0.03 at [-0.3, 0.7, -0.16]
            }
            tube { radius 0.03 at [-0.3, 0.7, 0]  radius 0.03 at [0.3, 0.7, 0] }
            // the shock strut's sleeve, ringed below the pod
            cylinder { min Y 0.68  max Y 1.2  scale [0.1, 1, 0.1] }
            cylinder { min Y 0.86  max Y 0.93  scale [0.125, 1, 0.125] }
            // the knee link: the upper link about the collar, the lower about the knee, reaching for the heel's pin
            joint {
                pivot [-0.3, 0.7, 0]  axis Z  limits -5 to 30
                reach 'EagleHeelPin' with 'EagleHeel'
                tube { radius 0.03 at [-0.3, 0.7, 0]  radius 0.03 at [-0.5, 0.35, 0] }
                joint {
                    pivot [-0.5, 0.35, 0]  axis Z  limits -80 to 5
                    tube { radius 0.028 at [-0.5, 0.35, 0]  radius 0.028 at [-0.28, 0.26, 0] }
                    cylinder { min Y -0.05  max Y 0.05  scale [0.04, 1, 0.04]  rotate X 90  translate [-0.5, 0.35, 0] }
                    mark 'EagleHeel' at [-0.28, 0.26, 0]
                }
                material EagleGray
            }
            // what the strut carries down: the piston, the foot and the pad
        group {
                cylinder { min Y 0.22  max Y 0.95  scale [0.07, 1, 0.07]  material EagleChrome }
                object EagleLegGusset(0.42)
                object EagleLegGusset(0.42) { rotate Y 180 }
                object EagleLegGusset(0.32) { rotate Y 90 }
                object EagleLegGusset(0.32) { rotate Y -90 }
                cylinder { min Y -0.05  max Y 0.05  scale [0.03, 1, 0.03]  rotate X 90  translate [-0.28, 0.26, 0] }
                mark 'EagleHeelPin' at [-0.28, 0.26, 0]
                object EagleLegPad
                translate Y -drop
            }
            material EagleGray
            translate Y stowed * (0.99 + drop)
        }
        translate [along, 0, side * 3.12]
    }
}

// -- The spine ---------------------------------------------------------------------------------------

// The spine is a truss down either side, leaning in, so that seen from ahead it is a trapezoid: the top chords
// 0.50 out from the middle at 4.14, the bottom chords 0.97 out at 3.65 (Mandel's bow elevation, and Briedis's
// plan, where the bottom chords are the outer rails and the top chords the inner).  Along it, as Mandel's profile
// has it: posts at ten stations, about 1.6 meters apart but for a short square bay a little aft of the middle;
// diagonals zigzagging between them, each running from the top of one post to the foot of the next, but in the
// end bays, where two meet at the foot in a V; and at either end a sloped member from the top chord's end down to
// the bottom chord's, which runs on over the fore and aft sections to 7.85 aft and 7.55 forward.  The bottom
// chords lie on the pod's roof.  At every post a member runs across between the top chords and another between the
// bottom ones, and a sleeve clasps each top chord.  Every member is a rod with rounded ends, so the joints read as
// welded.
EagleSpineTop = 4.14
EagleSpineBottom = 3.65
EagleSpineInner = 0.5
EagleSpineOuter = 0.97

// The warning bands round one of the spine's sloped ends, from `a` at the top chord toward `b` at the bottom one:
// red, black, red and black, each an eighth of a meter, from a sixth of the way down.
primitive EagleSpineBands(ax, ay, az, bx, by, bz) -> group {
    return group {
        tube { radius 0.068 at [ax + 0.16 * (bx - ax), ay + 0.16 * (by - ay), az + 0.16 * (bz - az)]
               radius 0.068 at [ax + 0.26 * (bx - ax), ay + 0.26 * (by - ay), az + 0.26 * (bz - az)]  material EagleRedPaint }
        tube { radius 0.068 at [ax + 0.26 * (bx - ax), ay + 0.26 * (by - ay), az + 0.26 * (bz - az)]
               radius 0.068 at [ax + 0.36 * (bx - ax), ay + 0.36 * (by - ay), az + 0.36 * (bz - az)]  material EagleBlackPaint }
        tube { radius 0.068 at [ax + 0.36 * (bx - ax), ay + 0.36 * (by - ay), az + 0.36 * (bz - az)]
               radius 0.068 at [ax + 0.46 * (bx - ax), ay + 0.46 * (by - ay), az + 0.46 * (bz - az)]  material EagleRedPaint }
        tube { radius 0.068 at [ax + 0.46 * (bx - ax), ay + 0.46 * (by - ay), az + 0.46 * (bz - az)]
               radius 0.068 at [ax + 0.56 * (bx - ax), ay + 0.56 * (by - ay), az + 0.56 * (bz - az)]  material EagleBlackPaint }
    }
}

// One side of the spine, `side` 1 to port and -1 to starboard.
primitive EagleSpineSide(side) -> group {
    t = EagleSpineTop
    b = EagleSpineBottom
    i = EagleSpineInner * side
    o = EagleSpineOuter * side
    return group {
        // the chords, and the sloped ends between them
        tube { radius 0.07 at [-6.775, t, i]  radius 0.07 at [6.47, t, i] }
        tube { radius 0.045 at [-7.85, b, o]  radius 0.045 at [7.55, b, o] }
        tube { radius 0.06 at [-6.775, t, i]  radius 0.06 at [-7.85, b, o] }
        tube { radius 0.06 at [6.47, t, i]  radius 0.06 at [7.55, b, o] }
        object EagleSpineBands(-6.775, t, i, -7.85, b, o)
        object EagleSpineBands(6.47, t, i, 7.55, b, o)
        // black sleeves on the chords: on the top ones over the pod's ends, on the bottom ones further in
        for x in list(-4.25, 3.92) {
            tube { radius 0.078 at [x - 0.08, t, i]  radius 0.078 at [x + 0.08, t, i]  material EagleBlackPaint }
        }
        for x in list(-2.66, 2.34) {
            tube { radius 0.053 at [x - 0.08, b, o]  radius 0.053 at [x + 0.08, b, o]  material EagleBlackPaint }
        }
        // the posts, and a sleeve round the top chord at each
        for x in list(-6.775, -5.17, -3.556, -1.96, -0.35, 0.158, 1.654, 3.265, 4.868, 6.47) {
            tube { radius 0.06 at [x, b, o]  radius 0.06 at [x, t, i] }
            cube { scale [0.21, 0.095, 0.095]  translate [x, t, i] }
        }
        // the diagonals, aft of the square bay and forward of it
        tube {
            discontinuous
            radius 0.05 at [-6.775, t, i]  radius 0.05 at [-5.97, b, o]  radius 0.05 at [-5.17, t, i]
            radius 0.05 at [-3.556, b, o]  radius 0.05 at [-1.96, t, i]  radius 0.05 at [-0.35, b, o]
        }
        tube {
            discontinuous
            radius 0.05 at [0.158, b, o]  radius 0.05 at [1.654, t, i]  radius 0.05 at [3.265, b, o]
            radius 0.05 at [4.868, t, i]  radius 0.05 at [5.67, b, o]  radius 0.05 at [6.47, t, i]
        }
    }
}

// The spine: its two sides, the members across between them at every post, and the blocks its bottom chords are
// mounted on over the sections, where Mandel draws them.
EagleSpine = group {
    object EagleSpineSide(1)
    object EagleSpineSide(-1)
    for x in list(-7.7, -6.765, -5.965, -5.155, 4.87, 5.685, 6.5, 7.35) {
        for side in [-1, 1] by 2 {
            cube { scale [0.2, 0.065, 0.08]  translate [x, 3.585, side * EagleSpineOuter] }
        }
    }
    for x in list(-6.775, -5.17, -3.556, -1.96, -0.35, 0.158, 1.654, 3.265, 4.868, 6.47) {
        tube { radius 0.06 at [x, EagleSpineTop, -EagleSpineInner]  radius 0.06 at [x, EagleSpineTop, EagleSpineInner] }
        tube { radius 0.045 at [x, EagleSpineBottom, -EagleSpineOuter]  radius 0.045 at [x, EagleSpineBottom, EagleSpineOuter] }
    }
}

// -- Doors -------------------------------------------------------------------------------------------

// The door in an end of the passenger module and in the end of each section the pod meets, cut into a face at x = 0
// that faces +X (turn it to face -X): a trapezoid 1.0 wide at its foot and 0.7 at its head, from 1.45 up to 3.3,
// recessed 1.5 cm, and in it eight triangles recessed 5 cm between the bars of an upright, a level and its two
// diagonals, all crossing where the diagonals do.
EagleEndDoor = union {
    extrusion { path { move to -0.5000, 1.4500  line to 0.5000, 1.4500  line to 0.3500, 3.3000  line to -0.3500, 3.3000  close }  min Y -0.0150  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to -0.0350, 2.3782  line to -0.4454, 1.4850  line to -0.0350, 1.4850  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to 0.0350, 2.3782  line to 0.0350, 1.4850  line to 0.4454, 1.4850  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to 0.0546, 2.5032  line to 0.4491, 1.6446  line to 0.3795, 2.5032  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to 0.0546, 2.5732  line to 0.3738, 2.5732  line to 0.3259, 3.1638  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to 0.0350, 2.6982  line to 0.2954, 3.2650  line to 0.0350, 3.2650  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to -0.0350, 2.6982  line to -0.0350, 3.2650  line to -0.2954, 3.2650  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to -0.0546, 2.5732  line to -0.3259, 3.1638  line to -0.3738, 2.5732  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
    extrusion { path { move to -0.0546, 2.5032  line to -0.3795, 2.5032  line to -0.4491, 1.6446  close }  min Y -0.0500  max Y 0.05  rotate X -90  rotate Y -90 }
}

// -- The sections ------------------------------------------------------------------------------------

// The two sections the spine stands on and the leg pods hang from, aft the engineering module and forward the
// service module, are alike: open cages of rods round the equipment packed inside, octagons in section.  Upright
// sides 1.70 out from the middle (Mandel's plan), from 1.54 up to 3.09, where the leg pods are held off them on
// blocks; above, a band leaning in to the roof's edge beside the spine's bottom chords, 1.0 out at 3.48, an X in
// each of its two bays (Mandel's profile has the X's above the pods, Briedis's plan the cells running from beside
// the spine to the edge); the same band below, leaning in to the floor at 1.15; the roof and floor between.  Rails
// run along every corner, and at either end and between the bays an octagon of rods frames the section, the ends
// against the pod as the outer ones are, since a craft may fly with no pod.  The equipment packed inside has a door
// in the end the pod meets, the passenger module's end door, facing the door in the module's end.
EagleSectionWide = 1.7
EagleSectionInner = 1.0
EagleSectionRoof = 3.48
EagleSectionHigh = 3.09
EagleSectionLow = 1.54
EagleSectionFloor = 1.15

// The X across one bay of one leaning band, from `back` to `front`, between the corner at `az` across and `ay` up
// and the one at `bz` and `by`.
primitive EagleSectionCross(back, front, az, ay, bz, by) -> group {
    return group {
        tube { radius 0.035 at [back, ay, az]  radius 0.035 at [front, by, bz] }
        tube { radius 0.035 at [back, by, bz]  radius 0.035 at [front, ay, az] }
    }
}

// A section from `back` to `front`, its two bays meeting at `middle`, the door into the pod in its front end (`door`
// 1) or its back end (-1).
primitive EagleSection(back, front, middle, door) -> group {
    w = EagleSectionWide
    i = EagleSectionInner
    r = EagleSectionRoof
    h = EagleSectionHigh
    l = EagleSectionLow
    f = EagleSectionFloor
    return group {
        // the equipment within, an octagon set in from the cage, and the door through it to the pod
        difference {
            extrusion {
                path {
                    move to -3.41, 0.94  line to -3.05, 1.6  line to -1.59, 1.6  line to -1.23, 0.94
                    line to -1.23, -0.94  line to -1.59, -1.6  line to -3.05, -1.6  line to -3.41, -0.94  close
                }
                min Y back + 0.08  max Y front - 0.08
                rotate Z -90
            }
            object EagleEndDoor {
                scale [door, 1, 1]
                translate X (front - 0.08) * (1 + door) / 2 + (back + 0.08) * (1 - door) / 2
            }
            material EagleWorks
        }
        // along every corner
        for z in list(-i, i) {
            tube { radius 0.04 at [back, r, z]  radius 0.04 at [front, r, z] }
            tube { radius 0.04 at [back, f, z]  radius 0.04 at [front, f, z] }
        }
        for z in list(-w, w) {
            tube { radius 0.04 at [back, h, z]  radius 0.04 at [front, h, z] }
            tube { radius 0.04 at [back, l, z]  radius 0.04 at [front, l, z] }
        }
        // an octagon at either end and between the bays
        for x in list(back, middle, front) {
            tube {
                discontinuous
                radius 0.045 at [x, r, i]  radius 0.045 at [x, h, w]  radius 0.045 at [x, l, w]
                radius 0.045 at [x, f, i]  radius 0.045 at [x, f, -i]  radius 0.045 at [x, l, -w]
                radius 0.045 at [x, h, -w]  radius 0.045 at [x, r, -i]  radius 0.045 at [x, r, i]
            }
        }
        // an X in each bay of the leaning bands, above and below, either side
        for z in list(-1, 1) {
            object EagleSectionCross(back, middle, i * z, r, w * z, h)
            object EagleSectionCross(middle, front, i * z, r, w * z, h)
            object EagleSectionCross(back, middle, i * z, f, w * z, l)
            object EagleSectionCross(middle, front, i * z, f, w * z, l)
        }
    }
}

// The command module's hull, an egg drawn about the X axis and widened across.
//
// **Its outline is Mandel's profile, scanned**: half-heights about a center line that runs level at 2.607 from the
// flat back to the rounded point, deepest (1.247) at 8.75 and drawn through the points by Catmull-Rom curves.  It
// is the same widened across: the plan's half-widths run 1.6 times the profile's half-heights nearly all along it
// (1.62 to 1.65 in Mandel's plan, 1.55 to 1.59 in Briedis's drawings of the studio model), so one lathe, widened,
// is its shape.  Mandel's bow elevation draws it flatter, 1.88 times as wide as tall, and disagrees there with
// his own profile and plan; it is not followed.
EagleCommandOutline = path {
        move to 0, 0
        line to 0.72, 0
        curve 0.7400, 0.0067, 0.8050, 0.0200 to 0.84, 0.04
        curve 0.8750, 0.0600, 0.8997, 0.0767 to 0.93, 0.12
        curve 0.9603, 0.1633, 0.9984, 0.2450 to 1.022, 0.3
        curve 1.0456, 0.3550, 1.0467, 0.3833 to 1.0715, 0.45
        curve 1.0963, 0.5167, 1.1440, 0.6167 to 1.171, 0.7
        curve 1.1980, 0.7833, 1.2209, 0.8667 to 1.2335, 0.95
        curve 1.2461, 1.0333, 1.2457, 1.1167 to 1.2465, 1.2
        curve 1.2472, 1.2833, 1.2416, 1.3667 to 1.238, 1.45
        curve 1.2344, 1.5333, 1.2327, 1.6167 to 1.225, 1.7
        curve 1.2173, 1.7833, 1.2127, 1.8667 to 1.192, 1.95
        curve 1.1712, 2.0333, 1.1288, 2.1167 to 1.1005, 2.2
        curve 1.0722, 2.2833, 1.0517, 2.3667 to 1.022, 2.45
        curve 0.9923, 2.5333, 0.9601, 2.6167 to 0.922, 2.7
        curve 0.8839, 2.7833, 0.8371, 2.8667 to 0.7935, 2.95
        curve 0.7499, 3.0333, 0.7062, 3.1167 to 0.6605, 3.2
        curve 0.6148, 3.2833, 0.5626, 3.3750 to 0.519, 3.45
        curve 0.4754, 3.5250, 0.4418, 3.5833 to 0.399, 3.65
        curve 0.3562, 3.7167, 0.3002, 3.8000 to 0.262, 3.85
        curve 0.2238, 3.9000, 0.1987, 3.9242 to 0.17, 3.95
        curve 0.1413, 3.9758, 0.1183, 3.9917 to 0.09, 4.005
        curve 0.0617, 4.0183, 0.0150, 4.0258 to 0.0, 4.03
    }

// **The seams between its panels are grooves**, a channel 2 cm wide and 1.8 cm deep whose lips are rounded to 8 mm,
// so each shows 3.6 cm across.  A ring round the hull is cut by a lathe of that profile in the hull lathe's own
// space, stood along the outline's normal where it falls, and cut to its angles by a wedge where it runs only part
// way round; every other groove by a sweep of the profile along a run of places on the hull, stood with its depth
// along the hull's normal where it starts.  They were worked out by a script from the outline above and the places
// below, not drawn by hand.
//
// In its round space the module is four-fold, as Briedis draws it from the side and from above alike:
//   - a band 0.32 either side of the middle of each face (bottom, top and either flank), widening to 0.72 from 8.40
//     to 8.64, round the hatch, and running on between the windows to the nose;
//   - an outlined plate at the back of each band, against the core (all three drawings have it);
//   - a panel in each quarter between the bands, ending at 8.64, with an outlined plate on it nearer the top or the
//     bottom than the flank (28 degrees from the middle of the top or bottom: his two views, averaged);
//   - behind each window a strip between the widened bands, with two vents on its diagonal, one behind the other (a
//     row of them shows beside the band in his side view and in his plan, a little differently placed in each, and
//     one row on the diagonal is where both put it to within his drawing);
//   - round each window a light frame 5 cm wide inside a groove, closed ahead of the glass by the nose cap's at
//     11.12 (Mandel draws it through the windows' tips) and behind it by one at 9.07;
//   - rings at 7.96 right round, and at 9.72 and 10.53 across the bands from frame to frame (Mandel's and Briedis's
//     places, averaged);
//   - on the top only, an access panel in the port corner of the first panel between the windows.
EagleCommandGrooves = union {
    group {
        lathe { path { move to 1.0811, 0.3839  line to 1.0524, 0.3928  curve 1.0538, 0.3970, 1.0514, 0.4015 to 1.0472, 0.4028  line to 1.0376, 0.4058  line to 1.0436, 0.4249  line to 1.0532, 0.4219  curve 1.0574, 0.4206, 1.0619, 0.4230 to 1.0632, 0.4272  line to 1.0918, 0.4182  close } }
        lathe { path { move to 0.4836, 3.5700  line to 0.4579, 3.5546  curve 0.4556, 3.5584, 0.4507, 3.5596 to 0.4469, 3.5573  line to 0.4383, 3.5522  line to 0.4280, 3.5693  line to 0.4366, 3.5745  curve 0.4404, 3.5767, 0.4416, 3.5816 to 0.4393, 3.5854  line to 0.4651, 3.6009  close } }
        intersection { lathe { path { move to 1.1456, 2.1637  line to 1.1175, 2.1531  curve 1.1160, 2.1573, 1.1114, 2.1594 to 1.1072, 2.1578  line to 1.0979, 2.1543  line to 1.0909, 2.1731  line to 1.1002, 2.1766  curve 1.1044, 2.1781, 1.1065, 2.1827 to 1.1049, 2.1869  line to 1.1330, 2.1974  close } }  cube { scale 50  translate Z 50  rotate Y 19.097 }  cube { scale 50  translate Z 50  rotate Y 160.903 } }
        intersection { lathe { path { move to 0.8127, 2.9780  line to 0.7861, 2.9641  curve 0.7841, 2.9680, 0.7793, 2.9695 to 0.7753, 2.9674  line to 0.7665, 2.9628  line to 0.7572, 2.9805  line to 0.7661, 2.9851  curve 0.7700, 2.9872, 0.7715, 2.9920 to 0.7694, 2.9959  line to 0.7960, 3.0099  close } }  cube { scale 50  translate Z 50  rotate Y 23.480 }  cube { scale 50  translate Z 50  rotate Y 156.520 } }
        intersection { lathe { path { move to 1.1456, 2.1637  line to 1.1175, 2.1531  curve 1.1160, 2.1573, 1.1114, 2.1594 to 1.1072, 2.1578  line to 1.0979, 2.1543  line to 1.0909, 2.1731  line to 1.1002, 2.1766  curve 1.1044, 2.1781, 1.1065, 2.1827 to 1.1049, 2.1869  line to 1.1330, 2.1974  close } }  cube { scale 50  translate Z 50  rotate Y -73.355 }  cube { scale 50  translate Z 50  rotate Y 73.355 } }
        intersection { lathe { path { move to 0.8127, 2.9780  line to 0.7861, 2.9641  curve 0.7841, 2.9680, 0.7793, 2.9695 to 0.7753, 2.9674  line to 0.7665, 2.9628  line to 0.7572, 2.9805  line to 0.7661, 2.9851  curve 0.7700, 2.9872, 0.7715, 2.9920 to 0.7694, 2.9959  line to 0.7960, 3.0099  close } }  cube { scale 50  translate Z 50  rotate Y -71.860 }  cube { scale 50  translate Z 50  rotate Y 71.860 } }
        intersection { lathe { path { move to 1.1456, 2.1637  line to 1.1175, 2.1531  curve 1.1160, 2.1573, 1.1114, 2.1594 to 1.1072, 2.1578  line to 1.0979, 2.1543  line to 1.0909, 2.1731  line to 1.1002, 2.1766  curve 1.1044, 2.1781, 1.1065, 2.1827 to 1.1049, 2.1869  line to 1.1330, 2.1974  close } }  cube { scale 50  translate Z 50  rotate Y -160.903 }  cube { scale 50  translate Z 50  rotate Y -19.097 } }
        intersection { lathe { path { move to 0.8127, 2.9780  line to 0.7861, 2.9641  curve 0.7841, 2.9680, 0.7793, 2.9695 to 0.7753, 2.9674  line to 0.7665, 2.9628  line to 0.7572, 2.9805  line to 0.7661, 2.9851  curve 0.7700, 2.9872, 0.7715, 2.9920 to 0.7694, 2.9959  line to 0.7960, 3.0099  close } }  cube { scale 50  translate Z 50  rotate Y -156.520 }  cube { scale 50  translate Z 50  rotate Y -23.480 } }
        intersection { lathe { path { move to 1.1456, 2.1637  line to 1.1175, 2.1531  curve 1.1160, 2.1573, 1.1114, 2.1594 to 1.1072, 2.1578  line to 1.0979, 2.1543  line to 1.0909, 2.1731  line to 1.1002, 2.1766  curve 1.1044, 2.1781, 1.1065, 2.1827 to 1.1049, 2.1869  line to 1.1330, 2.1974  close } }  cube { scale 50  translate Z 50  rotate Y 106.645 }  cube { scale 50  translate Z 50  rotate Y 253.355 } }
        intersection { lathe { path { move to 0.8127, 2.9780  line to 0.7861, 2.9641  curve 0.7841, 2.9680, 0.7793, 2.9695 to 0.7753, 2.9674  line to 0.7665, 2.9628  line to 0.7572, 2.9805  line to 0.7661, 2.9851  curve 0.7700, 2.9872, 0.7715, 2.9920 to 0.7694, 2.9959  line to 0.7960, 3.0099  close } }  cube { scale 50  translate Z 50  rotate Y 108.140 }  cube { scale 50  translate Z 50  rotate Y 251.860 } }
        intersection { lathe { path { move to 1.2744, 1.0711  line to 1.2444, 1.0720  curve 1.2445, 1.0764, 1.2411, 1.0801 to 1.2366, 1.0802  line to 1.2266, 1.0805  line to 1.2272, 1.1005  line to 1.2372, 1.1002  curve 1.2417, 1.1001, 1.2453, 1.1036 to 1.2455, 1.1080  line to 1.2755, 1.1071  close } }  cube { scale 50  translate Z 50  rotate Y -35.334 }  cube { scale 50  translate Z 50  rotate Y 125.334 } }
        intersection { lathe { path { move to 1.2659, 1.5031  line to 1.2359, 1.5020  curve 1.2358, 1.5064, 1.2320, 1.5099 to 1.2276, 1.5097  line to 1.2176, 1.5093  line to 1.2169, 1.5293  line to 1.2269, 1.5297  curve 1.2313, 1.5299, 1.2347, 1.5336 to 1.2346, 1.5380  line to 1.2645, 1.5391  close } }  cube { scale 50  translate Z 50  rotate Y -19.219 }  cube { scale 50  translate Z 50  rotate Y 107.887 } }
        intersection { lathe { path { move to 1.2744, 1.0711  line to 1.2444, 1.0720  curve 1.2445, 1.0764, 1.2411, 1.0801 to 1.2366, 1.0802  line to 1.2266, 1.0805  line to 1.2272, 1.1005  line to 1.2372, 1.1002  curve 1.2417, 1.1001, 1.2453, 1.1036 to 1.2455, 1.1080  line to 1.2755, 1.1071  close } }  cube { scale 50  translate Z 50  rotate Y -125.334 }  cube { scale 50  translate Z 50  rotate Y 35.334 } }
        intersection { lathe { path { move to 1.2659, 1.5031  line to 1.2359, 1.5020  curve 1.2358, 1.5064, 1.2320, 1.5099 to 1.2276, 1.5097  line to 1.2176, 1.5093  line to 1.2169, 1.5293  line to 1.2269, 1.5297  curve 1.2313, 1.5299, 1.2347, 1.5336 to 1.2346, 1.5380  line to 1.2645, 1.5391  close } }  cube { scale 50  translate Z 50  rotate Y -107.887 }  cube { scale 50  translate Z 50  rotate Y 19.219 } }
        intersection { lathe { path { move to 1.2744, 1.0711  line to 1.2444, 1.0720  curve 1.2445, 1.0764, 1.2411, 1.0801 to 1.2366, 1.0802  line to 1.2266, 1.0805  line to 1.2272, 1.1005  line to 1.2372, 1.1002  curve 1.2417, 1.1001, 1.2453, 1.1036 to 1.2455, 1.1080  line to 1.2755, 1.1071  close } }  cube { scale 50  translate Z 50  rotate Y 54.666 }  cube { scale 50  translate Z 50  rotate Y 215.334 } }
        intersection { lathe { path { move to 1.2659, 1.5031  line to 1.2359, 1.5020  curve 1.2358, 1.5064, 1.2320, 1.5099 to 1.2276, 1.5097  line to 1.2176, 1.5093  line to 1.2169, 1.5293  line to 1.2269, 1.5297  curve 1.2313, 1.5299, 1.2347, 1.5336 to 1.2346, 1.5380  line to 1.2645, 1.5391  close } }  cube { scale 50  translate Z 50  rotate Y 72.113 }  cube { scale 50  translate Z 50  rotate Y 199.219 } }
        intersection { lathe { path { move to 1.2744, 1.0711  line to 1.2444, 1.0720  curve 1.2445, 1.0764, 1.2411, 1.0801 to 1.2366, 1.0802  line to 1.2266, 1.0805  line to 1.2272, 1.1005  line to 1.2372, 1.1002  curve 1.2417, 1.1001, 1.2453, 1.1036 to 1.2455, 1.1080  line to 1.2755, 1.1071  close } }  cube { scale 50  translate Z 50  rotate Y 144.666 }  cube { scale 50  translate Z 50  rotate Y 305.334 } }
        intersection { lathe { path { move to 1.2659, 1.5031  line to 1.2359, 1.5020  curve 1.2358, 1.5064, 1.2320, 1.5099 to 1.2276, 1.5097  line to 1.2176, 1.5093  line to 1.2169, 1.5293  line to 1.2269, 1.5297  curve 1.2313, 1.5299, 1.2347, 1.5336 to 1.2346, 1.5380  line to 1.2645, 1.5391  close } }  cube { scale 50  translate Z 50  rotate Y 160.781 }  cube { scale 50  translate Z 50  rotate Y 287.887 } }
        intersection { lathe { path { move to 0.9475, 2.7166  line to 0.9204, 2.7037  curve 0.9185, 2.7077, 0.9137, 2.7094 to 0.9097, 2.7075  line to 0.9007, 2.7033  line to 0.8921, 2.7213  line to 0.9012, 2.7256  curve 0.9052, 2.7275, 0.9069, 2.7323 to 0.9050, 2.7363  line to 0.9321, 2.7491  close } }  cube { scale 50  translate Z 50  rotate Y -158.997 }  cube { scale 50  translate Z 50  rotate Y 11.454 } }
