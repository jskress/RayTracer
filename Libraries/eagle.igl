    tube { radius 0.035 at [-3.9525, 1.47, 1.46]  radius 0.035 at [-3.9525, 3.555, 0] }
    tube { radius 0.035 at [-3.9525, 2.5542, -0.70]  radius 0.035 at [-3.9525, 2.5542, 0.70] }
    tube { radius 0.03 at [-3.9525, 2.5542, -0.70]  radius 0.03 at [-3.9525, 1.47, -0.82] }
    tube { radius 0.03 at [-3.9525, 2.5542, 0.70]  radius 0.03 at [-3.9525, 1.47, 0.82] }
    for z in list(-0.75, 0.75) {
        cube { scale [3.9025, 0.04, 0.04]  translate [0, 1.23, z] }
    }
    for x in list(-3, -2, -1, 0, 1, 2, 3) {
        cube { scale [0.04, 0.04, 2.1250]  translate [x, 1.23, 0] }
    }
    for x in list(-3.45, 3.45) {
        for z in list(-0.8, 0.8) {
            object EaglePodFoot { translate [x, 0.08, z] }
        }
    }
    for x in list(-2.3, 2.3) {
        for z in list(-1.55, 1.55) {
            cube { scale [0.38, 0.02, 0.38]  translate [x, 0.94, z]  material EagleBell }
            cylinder { min Y 0.96  max Y 1.27  scale [0.06, 1, 0.06]  translate [x, 0, z]  material EagleGray }
        }
    }
    translate X -0.1425
}

// The pod by its name; see the Eagle.
primitive EaglePod(pod) -> group {
    if (pod == 'transporter') { return group { object EaglePassengerModule } }
    else if (pod == 'rescue') {
        return group {
            group {
                object EaglePassengerModule
                material inherited {
                    decal { path EagleRescueSides  color EagleRed  planar  min Y -2.4  max Y 2.4  rotate X 90 }
                    decal { path EagleRescueTop  color EagleRed  planar  min Y 2.9  max Y 3.7 }
                    decal {
                        path { move to -3.75, -2.45  line to -1.15, -2.45  line to -1.15, 2.45  line to -3.75, 2.45  close }
                        color EagleRed  planar  min Y 3.8  max Y 4.0  rotate Z -90
                    }
                    decal {
                        path { move to -3.75, -2.45  line to -1.15, -2.45  line to -1.15, 2.45  line to -3.75, 2.45  close }
                        color EagleRed  planar  min Y 4.1  max Y 4.3  rotate Z -90  scale [-1, 1, 1]
                    }
                }
            }
        }
    }
    else if (pod == 'laboratory') { return group { object EagleLaboratoryPod } }
    else if (pod == 'freighter') { return group { object EagleCargoPallet } }
    else { return group { } }
}

// -- The Eagle ----------------------------------------------------------------------------------------

// The whole craft, at the particulars' size, scaled to the length asked for, carrying the pod named, its legs run
// out as far as asked and stowed as far as asked.
primitive Eagle(length = EagleFullLength, pod = 'transporter', extension = 0, stowed = 0) -> group {
    return group {
        object EagleEngine(3.40, 0)
        object EagleEngine(1.74, 0)
        object EagleEngine(2.53, 1.63)
        object EagleEngine(2.53, -1.63)
        object EagleEngineFrame

        // the aft engineering module and the forward service module, the cages the leg pods stand out from
        object EagleSection(-7.8, -4.195, -5.86, 1)
        object EagleSection(3.91, 7.3, 5.7, -1)

        object EagleLegPod(-5.9, -1, 1)
        object EagleLegPod(-5.9, -1, -1)
        object EagleLegPod(5.625, 1, 1)
        object EagleLegPod(5.625, 1, -1)

        object EagleLeg(-5.9, 1, extension, stowed)
        object EagleLeg(-5.9, -1, extension, stowed)
        object EagleLeg(5.625, 1, extension, stowed)
        object EagleLeg(5.625, -1, extension, stowed)

        object EaglePod(pod)

        object EagleSpine
        object EagleCommandModule

        material EagleWhite
        scale length / EagleLength
    }
}

// -- The launch pad ----------------------------------------------------------------------------------

// A launch pad of Moonbase Alpha, from a schematic of one at 1:762 with scales in feet and meters (the two agree to
// 3%; their mean is used), cited, not reproduced.  It is written in meters, east along +X and north along +Z, about
// the middle of the pad, which stands on the ground at y = 0:
//   - the flight deck (G): a platform 31.1 in radius at the ground, its side sloping in to 30.0 at its top, 4.6 up;
//     its middle dark to 27.1, the hangar's doors under it, a pale band round that, ticked;
//   - the elevator to the technical section (H): the cross in the deck, bars 15 wide, 46 from end to end east to west
//     and from the south end north to the flight control complex, set in a seam and lit round by the landing lights
//     (I), 43 of them, 1.2 outside its edges and 3.8 apart;
//   - the flight control complex (B) at the north edge, a block at the deck's height, and on it the travel tube
//     terminal (C), its sides and north end sloping to a flat top 11.2 up; from its south face the boarding tube (D)
//     reaches toward the deck's middle, retracted, its cab and door at its end;
//   - the travel tube (A), from the terminal north toward the base, on pylons;
//   - the service platform (F) to the east, 25 wide at the ground, its sides and end sloping, with the long-range
//     antenna (K) along its middle and the entrance to the service stairway (J), a vault, near its end.  The radar and
//     tracking installation (E) is inside the platform and shows nothing outside.
// An Eagle lands on the cross's east-to-west bar, nose east or west, its port or starboard side to the boarding tube,
// on the deck (4.6 up) with its door square with the tube: its pod hangs 0.1875 aft of its middle at its usual length,
// so nose west it stands at x = -0.1875 and nose east at 0.1875.  `tube` runs the tube's cab out from 0, retracted, to
// 1, its face against the bullnose along the eave of such an Eagle's pod -- the furthest out its side reaches within
// the cab's height, 3.07 from the middle, the upright wall below it 2.99 -- and its door at the Eagle's.

// The pad's paints: pale concrete, the dark flight deck, the elevator's gray, the travel tube's white, and the landing
// lights' glow.
EaglePadConcrete = material { pigment [0.52, 0.52, 0.5]  specular 0.08  shininess 10 }
EaglePadDark = color [0.16, 0.16, 0.17]
EaglePadGray = color [0.36, 0.36, 0.37]
EaglePadWhite = material { pigment [0.78, 0.78, 0.76]  specular 0.2  shininess 30 }
EaglePadGlow = material { pigment [1, 0.93, 0.78]  emission 2.5  diffuse 0.2 }

// One landing light: a lens flush with the deck in a dark rim.
EaglePadLamp = group {
    cylinder { min Y 4.5  max Y 4.62  scale [0.36, 1, 0.36]  material { pigment EaglePadDark } }
    cylinder { min Y 4.5  max Y 4.64  scale [0.3, 1, 0.3]  material EaglePadGlow }
}

// The deck's markings and the elevator's seam, and the landing lights' places.
EaglePadDeck = path {
    move to 27.1000, 0.0000  curve 27.1000, 3.5588, 26.3990, 7.0828 to 25.0371, 10.3707  curve 23.6752, 13.6586, 21.6791, 16.6461 to 19.1626, 19.1626  curve 16.6461, 21.6791, 13.6586, 23.6752 to 10.3707, 25.0371
    curve 7.0828, 26.3990, 3.5588, 27.1000 to 0.0000, 27.1000  curve -3.5588, 27.1000, -7.0828, 26.3990 to -10.3707, 25.0371  curve -13.6586, 23.6752, -16.6461, 21.6791 to -19.1626, 19.1626  curve -21.6791, 16.6461, -23.6752, 13.6586 to -25.0371, 10.3707
    curve -26.3990, 7.0828, -27.1000, 3.5588 to -27.1000, 0.0000  curve -27.1000, -3.5588, -26.3990, -7.0828 to -25.0371, -10.3707  curve -23.6752, -13.6586, -21.6791, -16.6461 to -19.1626, -19.1626  curve -16.6461, -21.6791, -13.6586, -23.6752 to -10.3707, -25.0371
    curve -7.0828, -26.3990, -3.5588, -27.1000 to -0.0000, -27.1000  curve 3.5588, -27.1000, 7.0828, -26.3990 to 10.3707, -25.0371  curve 13.6586, -23.6752, 16.6461, -21.6791 to 19.1626, -19.1626  curve 21.6791, -16.6461, 23.6752, -13.6586 to 25.0371, -10.3707
    curve 26.3990, -7.0828, 27.1000, -3.5588 to 27.1000, -0.0000  close
}

