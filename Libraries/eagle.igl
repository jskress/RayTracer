// The platform: the flight deck's drum, the service platform and the flight control complex's block, the elevator's
// seam cut round the cross.  The platform and the block stand a millimeter below the deck so that no face of one lies
// in a face of the other.
EaglePadPlatform = group {
    difference {
        union {
            lathe { path { move to 0, 0  line to 31.1, 0  line to 30.0, 4.6  line to 0, 4.6  close } }
            intersection {
                extrusion {
                    path { move to 0, -12.6  line to 0, 12.6  line to -4.599, 10.3  line to -4.599, -10.3  close }
                    min Y 20  max Y 79
                    rotate Z -90
                }
                extrusion {
                    path { move to 20, 0  line to 78.8, 0  line to 75.6, -4.599  line to 20, -4.599  close }
                    min Y -13  max Y 13
                    rotate X 90
                }
            }
            cube { scale [14.2, 2.2995, 15.6]  translate [0, 2.2995, 39.9] }
        }
        extrusion { path EaglePadSeam  min Y 4.52  max Y 4.7 }
    }
    material inherited {
        decal { path EaglePadDeck  color EaglePadDark  planar  min Y 4.4  max Y 4.8 }
        decal { path EaglePadCross  color EaglePadGray  planar  min Y 4.4  max Y 4.8 }
        decal { path EaglePadTicks  color EaglePadDark  planar  min Y 4.4  max Y 4.8 }
    }
}

// The travel tube terminal on the flight control complex: sides sloping from 12.8 out at the deck to 10.2 at its flat
// top, 11.2 up, its south face upright over the deck's edge at 24.3, its north end sloping from 40 down to the
// complex's north wall at 55.5; and on its top, the complex's plant.
EaglePadTerminal = group {
    intersection {
        extrusion {
            path { move to -4.6, -12.8  line to -4.6, 12.8  line to -11.2, 10.2  line to -11.2, -10.2  close }
            min Y 24.3  max Y 55.5
            rotate Z -90
            rotate Y -90
        }
        extrusion {
            path { move to 24.3, -4.6  line to 55.5, -4.6  line to 40, -11.2  line to 24.3, -11.2  close }
            min Y -13  max Y 13
            rotate X 90
            rotate Y -90
        }
    }
    cube { scale [2.8, 0.35, 1.8]  translate [-6.2, 11.55, 29.5] }
    cube { scale [2.8, 0.35, 1.8]  translate [6.2, 11.55, 29.5] }
    cube { scale [0.5, 0.25, 4.5]  translate [0, 11.45, 32.5] }
    cube { scale [1.7, 0.25, 0.5]  translate [-6.2, 11.45, 35.3] }
    cube { scale [1.7, 0.25, 0.5]  translate [6.2, 11.45, 35.3] }
}

// The boarding tube, `reach` meters out from where it is retracted: its housing, tapering from the terminal's face to
// 12.5 in front of it; its cab and its door, run out toward the deck's middle; and between them a sleeve.
primitive EaglePadBoardingTube(reach) -> group {
    return group {
        extrusion {
            path { move to -7.6, 24.31  line to 7.6, 24.31  line to 4.6, 12.5  line to -4.6, 12.5  close }
            min Y 4.6  max Y 10.0
        }
        cube { scale [1.6, 0.15, 4.5]  translate [-3.6, 10.15, 18.6] }
        cube { scale [1.6, 0.15, 4.5]  translate [3.6, 10.15, 18.6] }
        cube { scale [0.5, 0.2, 5.4]  translate [0, 10.2, 18.6] }
        cube { scale [2.55, 0.85, (reach + 0.5) / 2]  translate [0, 7.65, 13.0 - (reach + 0.5) / 2] }
        group {
            cube { scale [2.8, 0.95, 0.75]  translate [0, 7.65, 11.75] }
            difference {
                cube { scale [1.2, 1.6, 1.0]  translate [0, 7.6, 10.0] }
                cube { scale [0.9, 1.4, 0.2]  translate [0, 7.6, 9.0] }
            }
            cube { scale [0.9, 1.4, 0.02]  translate [0, 7.6, 9.17]  material { pigment EaglePadDark } }
            translate Z -reach
        }
        material EaglePadWhite
    }
}

// The travel tube, from inside the terminal north toward the base, 3.3 round and level with the terminal's top, on a
// pylon every 20 meters, each standing 3 m into the ground so that ground a little low under it leaves no gap.
EaglePadTravelTube = group {
    cylinder { min Y 44  max Y 420  scale [3.3, 1, 3.3]  rotate X 90  translate Y 7.9 }
    for z in [60, 400] by 20 {
        cylinder { min Y -3  max Y 4.7  scale [0.7, 1, 0.7]  translate Z z  material EaglePadConcrete }
        cube { scale [2.2, 0.2, 0.9]  translate [0, 4.7, z]  material EaglePadConcrete }
    }
    material EaglePadWhite
}

// The service platform's fittings: the long-range antenna, a low block 15.7 long with its array along its top and a
// raised housing at its east end, and the entrance to the service stairway, a vault 2.4 round across the platform with
// a door in each end.
EaglePadServiceFittings = group {
    cube { scale [7.85, 1.3, 2.4]  translate [60.75, 5.9, 0] }
    cube { scale [7.3, 0.1, 1.75]  translate [60.45, 7.25, 0.15]  material { pigment EaglePadDark  specular 0.4  shininess 60 } }
    cube { scale [0.55, 1.7, 2.4]  translate [68.05, 6.3, 0] }
    difference {
        cylinder { min Y -6.1  max Y 6.5  scale [2.4, 1, 2.4]  rotate X 90 }
        cube { scale [5, 5, 10]  translate Y -5 }
        cube { scale [0.6, 0.9, 0.3]  translate [0, 0.9, -6.1] }
        cube { scale [0.6, 0.9, 0.3]  translate [0, 0.9, 6.5] }
        translate [72.5, 4.6, 0]
    }
    cube { scale [0.6, 0.9, 0.02]  translate [72.5, 5.5, -5.82]  material { pigment EaglePadDark } }
    cube { scale [0.6, 0.9, 0.02]  translate [72.5, 5.5, 6.22]  material { pigment EaglePadDark } }
    for z in list(-2.6, 3.8) {
        difference {
            cylinder { min Y -0.15  max Y 0.15  scale [2.48, 1, 2.48]  rotate X 90 }
            cube { scale [5, 5, 1]  translate Y -5 }
            translate [72.5, 4.6, z]
        }
    }
    material EaglePadWhite
}

// A launch pad, its boarding tube run out as far as `tube` says.
primitive EagleLaunchPad(tube = 0) -> group {
    return group {
        object EaglePadPlatform
        object EaglePadLamps
        object EaglePadTerminal { material EaglePadWhite }
        object EaglePadBoardingTube(5.92 * tube)
        object EaglePadTravelTube
        object EaglePadServiceFittings
        material EaglePadConcrete
    }
}
