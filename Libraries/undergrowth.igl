// What grows under the trees.
//
//     import 'undergrowth' { Grass, Boxwood }
//
//     Lawn = path { move to -4, -4  line to 4, -4  line to 4, 4  line to -4, 4  close }
//
//     object Grass(Lawn)
//     object Boxwood(1.2, 'winter') { translate X 3 }
//
// The `trees` library gives a scene its trees and leaves it standing on a flat green plane.  This one
// is the rest of it: the grass underfoot and the shrubs between, which is most of what separates a
// picture of some trees from a picture of somewhere.
//
// Everything here takes the same three things a tree does, in the same order and with the same
// meanings -- **how big**, **what time of year**, and **which one of that kind** -- so a scene that has
// planted an autumn stand can plant autumn undergrowth beneath it without learning a second set of
// habits.  Only the first is ever required.  `Grass` takes two more after those, and they come after
// rather than among them precisely so that the first three mean what they mean everywhere else.
//
// | `Grass` | An area of it, filling any outline you draw. |
// | `Tuft` | One clump on its own, for putting somewhere in particular. |
// | `Boxwood` | A dense clipped dome.  Evergreen, and takes snow in winter. |
// | `Bramble` | Arching canes with leaves along them; berries in autumn, bare in winter. |
// | `Lavender` | A mound of fine stems, in flower through the summer. |
// | `Fern` | Fronds arching from one crown.  A woodland floor without them reads as a lawn. |
// | `Reed` | Tall stiff blades and a seed head; `Reeds` fills an outline with them. |
// | `Stalk` | One stalk of wheat with its ear; `Wheat` fills an outline in drills. |
// | `Wildflower` | A stem, a nodding ring of petals and a heart.  The tint is yours to give. |
//
// **The seasons are the same words**: 'summer', 'autumn' (or 'fall'), 'winter', or anything else for
// spring.  What each does differs by plant, as it does in a garden.  Grass goes tawny and then to pale
// straw; a bramble turns, fruits, and finally stands as bare canes; lavender flowers and fades.  A
// boxwood is evergreen and so does what the fir in the `trees` library does -- three of its four
// seasons look alike, and in winter it takes snow.
//
// -- A word about what grass costs -----------------------------------------------------------------
//
// It is the one thing here that can make a scene slow, and it is worth being plain about why rather
// than letting it be discovered.  A blade of grass is a ribbon of four patches; a tuft is ten blades;
// an area of it is a tuft every fifth of a unit in both directions.  So a lawn eight units square is
// on the order of seventy thousand surfaces, which this ray tracer handles perfectly well -- a group
// hands a ray a bounding box and the ray never looks inside -- but it is seventy thousand rather than
// seventy.
//
// The last number is what to turn when that matters:
//
//     object Grass(Lawn, 'summer', 1, 0.3, 0.5)  // half as many tufts, a quarter the surfaces
//
// Halving it quarters the count, since the tufts thin out in both directions at once.  Grass seen from
// across a field does not need what grass seen from a foot away needs.
//
// -- What is here for the library and not for you --------------------------------------------------
//
// Everything beginning with `Under` is the machinery, and a scene that imports `Grass` does not get any
// of it.  The materials are the exception, for the reason the trees library gives: a material is
// looked up where it is used rather than where it was written, so it has to travel with what it
// belongs to.  They are all prefixed so they will not collide with anything of yours.

// -- Leaf, blade, stem and snow --------------------------------------------------------------------

UnderBladeGreen = material { pigment [0.22, 0.36, 0.13]  specular 0.12  shininess 25  ambient 0.20 }
UnderBladeSpring = material { pigment [0.30, 0.48, 0.16]  specular 0.14  shininess 25  ambient 0.20 }
UnderBladeTawny = material { pigment [0.40, 0.32, 0.13]  specular 0.10  shininess 20  ambient 0.20 }
UnderBladeStraw = material { pigment [0.50, 0.46, 0.32]  specular 0.08  shininess 16  ambient 0.22 }
UnderBoxLeaf = material { pigment [0.15, 0.27, 0.13]  specular 0.16  shininess 34  ambient 0.18 }
UnderBoxLeafLit = material { pigment [0.24, 0.40, 0.18]  specular 0.20  shininess 40  ambient 0.20 }
UnderCaneWood = material { pigment [0.36, 0.28, 0.21]  specular 0.10  shininess 18 }
UnderCaneLeaf = material { pigment [0.26, 0.42, 0.19]  specular 0.12  shininess 24  ambient 0.18 }
UnderCaneTurned = material { pigment [0.44, 0.22, 0.09]  specular 0.12  shininess 24  ambient 0.18 }
UnderCaneBud = material { pigment [0.54, 0.66, 0.34]  specular 0.14  shininess 26  ambient 0.18 }
UnderBerry = material { pigment [0.13, 0.04, 0.10]  specular 0.60  shininess 140 }
UnderLavStem = material { pigment [0.44, 0.48, 0.36]  specular 0.10  shininess 20  ambient 0.18 }
UnderLavFlower = material { pigment [0.45, 0.31, 0.63]  specular 0.22  shininess 45  ambient 0.20 }
UnderLavFaded = material { pigment [0.50, 0.46, 0.44]  specular 0.10  shininess 20  ambient 0.20 }
UnderSnowWhite = material { pigment [0.93, 0.94, 0.97]  specular 0.30  shininess 60 }
UnderFernFrond = material { pigment [0.17, 0.33, 0.16]  specular 0.14  shininess 28  ambient 0.19 }
UnderFernTurned = material { pigment [0.44, 0.36, 0.16]  specular 0.10  shininess 20  ambient 0.20 }
UnderFernNew = material { pigment [0.34, 0.52, 0.26]  specular 0.18  shininess 32  ambient 0.20 }
UnderFernDead = material { pigment [0.40, 0.31, 0.22]  specular 0.08  shininess 16  ambient 0.20 }
UnderFernStem = material { pigment [0.30, 0.34, 0.19]  specular 0.10  shininess 20 }
UnderReedBlade = material { pigment [0.31, 0.42, 0.22]  specular 0.16  shininess 30  ambient 0.20 }
UnderReedNew = material { pigment [0.38, 0.52, 0.25]  specular 0.20  shininess 34  ambient 0.20 }
UnderReedHead = material { pigment [0.34, 0.24, 0.16]  specular 0.12  shininess 22  ambient 0.20 }
UnderWheatStalk = material { pigment [0.62, 0.58, 0.34]  specular 0.14  shininess 26  ambient 0.22 }
UnderWheatEar = material { pigment [0.72, 0.62, 0.32]  specular 0.20  shininess 34  ambient 0.22 }
UnderWheatGreen = material { pigment [0.42, 0.52, 0.24]  specular 0.16  shininess 28  ambient 0.21 }
UnderWheatNew = material { pigment [0.36, 0.54, 0.26]  specular 0.20  shininess 32  ambient 0.21 }
UnderWheatStubble = material { pigment [0.55, 0.51, 0.38]  specular 0.10  shininess 20  ambient 0.22 }
UnderWheatEarGreen = material { pigment [0.50, 0.58, 0.26]  specular 0.18  shininess 30  ambient 0.21 }
UnderWheatEarNew = material { pigment [0.44, 0.56, 0.28]  specular 0.20  shininess 32  ambient 0.21 }
UnderWheatEarSpent = material { pigment [0.60, 0.55, 0.40]  specular 0.12  shininess 22  ambient 0.22 }
UnderFlowerStem = material { pigment [0.26, 0.38, 0.20]  specular 0.12  shininess 24  ambient 0.19 }
UnderFlowerHeart = material { pigment [0.72, 0.62, 0.20]  specular 0.30  shininess 50  ambient 0.22 }

// What color the grass is, which is the whole of what a season does to it.
primitive UnderBladeSkin(season) -> material {
    switch (season) {
        case 'autumn', 'fall' { return material UnderBladeTawny }
        case 'winter' { return material UnderBladeStraw }
        case 'summer' { return material UnderBladeGreen }
        default { return material UnderBladeSpring }
    }
}

// Grass does not only change color over the year; it lies down.  Winter grass is half the height of
// summer grass and bent much further over, which reads at a distance where the color alone does not.
function UnderBladeHeight(season) -> number {
    switch (season) {
        case 'autumn', 'fall' { return 0.9 }
        case 'winter' { return 0.55 }
        case 'summer' { return 1 }
        default { return 0.8 }
    }
}

function UnderBladeBend(season) -> number {
    switch (season) {
        case 'winter' { return 2.1 }
        case 'autumn', 'fall' { return 1.35 }
        default { return 1 }
    }
}

// -- Grass -----------------------------------------------------------------------------------------

// A blade of grass: one `ribbon`, arching over and tapering to a point.
//
// **It was two tubes until the ribbon surface existed, and the difference is not the count.**  A tube
// is a rod, and a rod looks the same from every side; a real blade is flat, so it flashes broad as it
// turns towards you and very nearly vanishes as it turns edge-on.  That flicker across a field is
// most of what grass looks like, and a rod cannot do it at all -- it has no edge to turn.
//
// The arch is a circular arc, which is what lets the shape be written down rather than fitted: bend a
// length `tall` through a total angle, and it lies on a circle of radius `tall / angle`.  So each
// point is that circle at its own fraction of the way round, and the whole blade is five of them.
//
// **The twist is not decoration either.**  Without it every blade is flat-on or edge-on along its
// whole length at once, and a tuft reads as a set of cut-out shapes; a little turn along the length
// means each blade catches the light somewhere and loses it somewhere else, which is what a blade
// does when it grows.
primitive UnderCoat(kind, season) -> material {
    switch (kind) {
        case 'fern' {
            switch (season) {
                case 'winter' { return material UnderFernDead }
                case 'autumn', 'fall' { return material UnderFernTurned }
                // Spring fronds are fresh and light; summer's have hardened off.  These were the
                // same colour until a test held one season against the other.
                case 'summer' { return material UnderFernFrond }
                default { return material UnderFernNew }
            }
        }
        case 'reed' {
            switch (season) {
                case 'winter' { return material UnderBladeStraw }
                case 'autumn', 'fall' { return material UnderBladeTawny }
                case 'summer' { return material UnderReedBlade }
                // New growth, as with the fern: spring and summer were one colour until a test put
                // them side by side.  **Every arm of a season switch has to answer for itself**, and
                // a `default` that quietly serves two of them is the way that goes wrong.
                default { return material UnderReedNew }
            }
        }
        default {
            switch (season) {
                case 'autumn', 'fall' { return material UnderWheatStalk }
                case 'winter' { return material UnderWheatStubble }
                case 'summer' { return material UnderWheatGreen }
                default { return material UnderWheatNew }
            }
        }
    }
}

// And its ear, which ripens on the same clock.
primitive UnderWheatGrain(season) -> material {
    switch (season) {
        case 'autumn', 'fall' { return material UnderWheatEar }
        case 'winter' { return material UnderWheatEarSpent }
        case 'summer' { return material UnderWheatEarGreen }
        default { return material UnderWheatEarNew }
    }
}

primitive UnderStrap(kind, season, tall, wide, bend, over, turn) -> ribbon {
    lean = (bend + over) * 0.01745
    r = tall / lean
    w = wide * 2.6

    return ribbon {
        material UnderCoat(kind, season)

        width w              at [r * (1 - cos(lean * 0.00)), r * sin(lean * 0.00), 0]
        width w * 0.94       at [r * (1 - cos(lean * 0.30)), r * sin(lean * 0.30), 0]
        width w * 0.76       at [r * (1 - cos(lean * 0.58)), r * sin(lean * 0.58), 0]
        width w * 0.46       at [r * (1 - cos(lean * 0.82)), r * sin(lean * 0.82), 0]
        width w * 0.04       at [r * (1 - cos(lean * 1.00)), r * sin(lean * 1.00), 0]

        twist 0.7
        rotate Y turn
    }
}

primitive UnderBlade(season, tall, wide, bend, over, turn) -> ribbon {
    lean = (bend + over) * 0.01745
    r = tall / lean
    w = wide * 2.6

    return ribbon {
        material UnderBladeSkin(season)

        width w              at [r * (1 - cos(lean * 0.00)), r * sin(lean * 0.00), 0]
        width w * 0.94       at [r * (1 - cos(lean * 0.30)), r * sin(lean * 0.30), 0]
        width w * 0.76       at [r * (1 - cos(lean * 0.58)), r * sin(lean * 0.58), 0]
        width w * 0.46       at [r * (1 - cos(lean * 0.82)), r * sin(lean * 0.82), 0]
        width w * 0.04       at [r * (1 - cos(lean * 1.00)), r * sin(lean * 1.00), 0]

        twist 0.7
        rotate Y turn
    }
}

// One clump.  The blades start from nearly the same place and go their own ways.
//
// A blade is a fortieth of its own length across, which is about right for grass and is also the
// thing that decides whether a patch can be seen at all.  A blade thinner than the pixel it lands on
// does not draw as a blade; it draws as a speck, and a field of specks draws as wire wool.
//
// That is worth knowing because it makes **height the setting that matters most**.  Ankle-high grass
// seen from across a field has blades a third of a pixel wide and will always look like noise, however
// many of them there are.  Knee-high grass in the same picture has blades that land on a pixel and
// reads immediately -- and costs less, since taller tufts stand further apart.  If a patch looks like
// static, make it taller before making it denser.
primitive Tuft(height = 0.3, season = 'summer', variant = 1) -> group {
    tall = height * UnderBladeHeight(season)
    bend = UnderBladeBend(season)

    return group {
        for blade in [0, 9] {
            object UnderBlade(season,
                              tall * (0.7 + random(variant, blade, 1) * 0.6), height * 0.038,
                              (5 + random(variant, blade, 2) * 9) * bend,
                              (16 + random(variant, blade, 3) * 22) * bend,
                              random(variant, blade, 4) * 360) {
                translate [(random(variant, blade, 5) - 0.5) * height * 0.55, 0,
                           (random(variant, blade, 6) - 0.5) * height * 0.55]
            }
        }
    }
}

// An area of it, filling whatever outline it is given.  The outline is read on the X/Z plane, so a
// patch is the shape you draw, standing where you draw it.
//
// **A square is the wrong shape surprisingly often**, and for a long time the choice was a square or a
// circle.  Anything laid against anything else -- a verge along a road, an island in a roundabout, the
// ground a building does not stand on -- was a patch overhanging its neighbor at the corners or leaving
// bare ground short of it, and for a square there is no size that does neither: its corners are always
// 1.41 times its half-width out.  A patch is now cut to the ground it actually covers.
//
// The obvious way to cut one to shape would be to intersect it with something, and that does not work
// at all: a patch is hundreds of separate tufts, and a `CsgSurface` -- unlike a `Group` -- has no
// bounded traversal for a shadow query, so every shadow ray walks every tuft with no distance pruning.
// Under a sky light a modest one had not finished rendering after ten minutes.  Deciding each tuft as
// it is placed costs nothing at all, which is what a `field` does.
//
// The tufts stand on a grid and are then thrown nearly a whole cell off it, which is what stops the
// grid from being the thing you see.  A lattice is very easy to notice and impossible to unsee.  Each
// tuft takes its height and its own arrangement of blades from its number within the patch, so no two
// are the same and the patch does not repeat.
primitive Grass(shape, season = 'summer', variant = 1, height = 0.3, density = 1) -> field {
    return field {
        of Tuft(height * (0.75 + random(variant, n, 1) * 0.5), season, variant * 7919 + n)
        within shape
        spacing height * 0.63 / density
        jitter 1.8
        index in n
    }
}

// -- Boxwood ---------------------------------------------------------------------------------------

// What settles on it, which is nothing at all for three seasons of the four.  A boxwood is evergreen,
// so it would otherwise be the one plant here that took the word and ignored it -- and a clipped dome
// under snow is what a garden looks like in January.
// -- What a leaf is ---------------------------------------------------------------------------------

// The blade of one leaf, authored growing along +Y from its base to a point at its tip, its width
// across X and a shallow cup lifting toward +Z.  It is drawn at a length of one and scaled where it
// is used.
//
// **These were spheres**, in a shrub built as a dome of them, and a dome of spheres reads as a bunch
// of grapes rather than as foliage however carefully the dome is shaped.  The `trees` library carried
// the same fault and was fixed the same way; this is the rest of that job.  A leaf is a `patch`, a
// bicubic sheet pulled into shape by sixteen control points, and the point of it over a flat shape is
// the **cup**: a leaf that is dead flat takes the light evenly across its whole face and reads as
// plastic, where a cupped one catches the light along one edge and turns away from it along the
// other.
//
// Berries and buds are left as spheres on purpose.  A berry *is* a small ball, and a bud very nearly
// is; the sphere was only ever wrong where it stood in for a leaf.
primitive UnderLeaf(kind) -> group {
    switch (kind) {
        // A bramble leaf: ovate and drawn to a point, longer than it is broad.
        case 'bramble' {
            return group { patch {
                points
                    [-0.0600, 0.0000, 0.0000], [-0.0200, 0.0000, 0.0000], [0.0200, 0.0000, 0.0000], [0.0600, 0.0000, 0.0000],
                    [-0.2800, 0.2800, 0.0000], [-0.0933, 0.2800, 0.0533], [0.0933, 0.2800, 0.0533], [0.2800, 0.2800, 0.0000],
                    [-0.2000, 0.6200, 0.0000], [-0.0667, 0.6200, 0.0427], [0.0667, 0.6200, 0.0427], [0.2000, 0.6200, 0.0000],
                    [-0.0200, 1.0000, 0.0000], [-0.0067, 1.0000, 0.0000], [0.0067, 1.0000, 0.0000], [0.0200, 1.0000, 0.0000]
                uSteps 3
                vSteps 3
            } }
        }

        // A boxwood leaf: small, broad and blunt.  Buxus carries hundreds of little rounded ovals,
        // which is what gives a clipped box its density.
        default {
            return group { patch {
                points
                    [-0.1000, 0.0000, 0.0000], [-0.0333, 0.0000, 0.0000], [0.0333, 0.0000, 0.0000], [0.1000, 0.0000, 0.0000],
                    [-0.3000, 0.2500, 0.0000], [-0.1000, 0.2500, 0.0489], [0.1000, 0.2500, 0.0489], [0.3000, 0.2500, 0.0000],
                    [-0.2600, 0.6500, 0.0000], [-0.0867, 0.6500, 0.0400], [0.0867, 0.6500, 0.0400], [0.2600, 0.6500, 0.0000],
                    [-0.0500, 1.0000, 0.0000], [-0.0167, 1.0000, 0.0000], [0.0167, 1.0000, 0.0000], [0.0500, 1.0000, 0.0000]
                uSteps 3
                vSteps 3
            } }
        }
    }
}

// How many rings of leaves a boxwood's dome is built from.  It is a function rather than a number in
// two places because the snow is laid along the very same rings, and the two must agree: raise the
// leaves to fifteen rings while the snow still counts in tens and the snow settles between the
// leaves instead of on them.
function UnderBoxRings() -> number { return 15 }

primitive UnderBoxwoodSnow(season, height, variant) -> group {
    switch (season) {
        case 'winter' {
            return group {
                // Laid along the same rings the foliage is, and only the upper ones: snow settles on
                // what faces the sky.  Sitting it at a fixed height instead put it *inside* the dome,
                // where it was worth nothing at all.
                for ring in [floor(UnderBoxRings() * 0.6), UnderBoxRings() - 1] {
                    up = ring / (UnderBoxRings() - 1)
                    wide = height * 0.46 * sqrt(1 - up * up * 0.93)
                    round = wide / height * 58

                    for step in [0, round] {
                        if (random(ring, step, variant + 5) > 0.42) {
                            sphere {
                                material UnderSnowWhite
                                scale [height * 0.075, height * 0.035, height * 0.075]
                                translate X wide
                                rotate Y step * 360 / (round + 1) + ring * 23 +
                                       random(ring, step, variant + 1) * 18
                                translate Y height * (0.13 + up * 0.81) + height * 0.055
                            }
                        }
                    }
                }
            }
        }
        default { return group { } }
    }
}

// Which of the two greens a given cluster wears.  One flat green over the whole dome reads as a
// green ball; a dome made of two, sprinkled, reads as a great many small leaves catching the light
// differently, which is what a clipped shrub actually looks like.
primitive UnderBoxShade(pick) -> material {
    if (pick > 0.58) {
        return material UnderBoxLeafLit
    }
    else {
        return material UnderBoxLeaf
    }
}

// A clipped dome: rings of leaf clusters, each ring higher and narrower than the one below.  The
// narrowing follows a circle rather than a straight taper, which is what gives it a shoulder instead
// of a cone.
//
// How many clusters go round a ring is worked out from how wide that ring is, rather than being the
// same number all the way up.  A fixed count crowds them at the top and leaves the bottom bald, which
// is the tell-tale of a shape made by a loop that was not thinking.
primitive Boxwood(height, season = 'summer', variant = 1) -> group {
    rings = UnderBoxRings()

    return group {
        // The stem it was grown from, just showing under the skirt.  A dome sitting straight on the
        // ground is a ball; a dome on a stem is a shrub.
        tube {
            material UnderCaneWood
            radius height * 0.035 at [0, 0, 0]
            radius height * 0.025 at [0, height * 0.22, 0]
        }

        for ring in [0, rings - 1] {
            up = ring / (rings - 1)
            wide = height * 0.46 * sqrt(1 - up * up * 0.93)
            round = wide / height * 58

            for step in [0, round] {
                object UnderLeaf('boxwood') {
                    material UnderBoxShade(random(ring, step, variant + 9))
                    scale height * 0.155 * (0.7 + random(ring, step, variant) * 0.6)
                    // The blade grows along +Y and the shell is built out along +X, so it is turned a
                    // quarter to face outward, then tipped by a random amount so the surface of the
                    // bush is leaves at every angle rather than a tiled sphere.
                    rotate X random(ring, step, variant + 5) * 60 - 30
                    rotate Z -68 - random(ring, step, variant + 6) * 44
                    translate X wide * (0.94 + random(ring, step, variant + 3) * 0.12)
                    rotate Y step * 360 / (round + 1) + ring * 23 +
                           random(ring, step, variant + 1) * 18
                    translate Y height * (0.13 + up * 0.81)
                }
            }
        }

        // A few larger clusters set inside, so that a gap between the outer ones shows more foliage
        // rather than showing the sky through the middle of the bush.
        for ring in [0, 5] {
            up = ring / 5
            deep = height * 0.30 * sqrt(1 - up * up * 0.9)

            for step in [0, 6] {
                object UnderLeaf('boxwood') {
                    material UnderBoxLeaf
                    scale height * 0.20
                    rotate Z -70
                    translate X deep
                    rotate Y step * 51 + ring * 29
                    translate Y height * (0.18 + up * 0.68)
                }
            }
        }

        object UnderBoxwoodSnow(season, height, variant)
    }
}

// -- Bramble ---------------------------------------------------------------------------------------

// What hangs on a cane, which is the whole of what a season is to a bramble.
primitive UnderCaneLeaves(season, thick, id, variant) -> group {
    switch (season) {
        case 'summer' {
            return group {
                for leaf in [0, 4] {
                    object UnderLeaf('bramble') {
                        material UnderCaneLeaf
                        scale thick * (5.5 + random(id, leaf, variant) * 3.5)
                        rotate X random(id, leaf, variant + 6) * 50 - 25
                        rotate Z -62 - random(id, leaf, variant + 7) * 40
                        translate X thick * 2.4
                        rotate Y leaf * 72 + random(id, leaf, variant + 1) * 45
                    }
                }
            }
        }
        case 'autumn', 'fall' {
            return group {
                for leaf in [0, 3] {
                    object UnderLeaf('bramble') {
                        material UnderCaneTurned
                        scale thick * (5 + random(id, leaf, variant + 2) * 3)
                        // Further over than in summer: a turned leaf hangs from its stalk.
                        rotate X random(id, leaf, variant + 8) * 40 - 10
                        rotate Z -78 - random(id, leaf, variant + 9) * 34
                        translate X thick * 2.4
                        rotate Y leaf * 90 + random(id, leaf, variant + 3) * 55
                    }
                }
                // The fruit, which is why anybody looks at a bramble in September.
                if (random(id, 31, variant) > 0.45) {
                    for berry in [0, 2] {
                        sphere {
                            material UnderBerry
                            scale thick * 1.5
                            translate X thick * 2.2
                            rotate Y berry * 120 + 40
                            translate Y thick * -2
                        }
                    }
                }
            }
        }
        case 'winter' {
            // Bare, which is the point of a bramble in winter: the arch is the whole of what is left.
            return group { }
        }
        default {
            return group {
                for bud in [0, 1] {
                    sphere {
                        material UnderCaneBud
                        scale thick * (2 + random(id, bud, variant + 4) * 1.2)
                        translate X thick * 2.4
                        rotate Y bud * 140 + random(id, bud, variant + 5) * 80
                    }
                }
            }
        }
    }
}

// One length of cane, and then the rest of the cane carrying on from its tip.  Written as a recursion
// rather than a loop because that is what an arch is: each length leans a little further than the one
// it grew from, and only the thing that grew from it knows where that was.
primitive UnderCane(season, left, length, thick, bend, id, variant) -> group {
    if (left < 1) {
        return group { }
    }
    else {
        return group {
            // A tube, which is a tapering rod with a sphere at each end of it, and the ends are the
            // point.  A cone finishes in a flat disc: set the next length of cane growing at an angle
            // from it and the disc stands proud, edge-on to the light, so every joint in the arch gets
            // a dark band across it and the cane reads as a row of sticks.  A hemisphere looks the
            // same from every direction, so the next length leaves it at any angle without a seam.
            tube {
                material UnderCaneWood
                radius thick at [0, 0, 0]
                radius thick * 0.90 at [0, length, 0]
            }

            object UnderCaneLeaves(season, thick, id, variant) { translate Y length * 0.72 }

            object UnderCane(season, left - 1, length * 0.88, thick * 0.90, bend,
                             id * 3 + 1, variant) {
                rotate Z bend
                translate Y length
            }
        }
    }
}

primitive Bramble(height, season = 'summer', variant = 1) -> group {
    return group {
        for cane in [0, 8] {
            reach = height * (0.26 + random(cane, 41, variant) * 0.10)

            // A group of its own, because the turn that sets this cane apart from its neighbours
            // belongs to the cane; a loop is a way of writing and has nothing for a transform to be
            // about.
            group {
                object UnderCane(season, 5, reach, height * 0.022,
                                 13 + random(cane, 42, variant) * 9, cane, variant)
                rotate Z 6 + random(cane, 43, variant) * 10
                rotate Y cane * 40 + random(cane, 44, variant) * 30
            }
        }
    }
}

// -- Lavender --------------------------------------------------------------------------------------

// What tops a stem: a flower head in summer, faded in autumn, nothing at all in winter, and a green
// tip in spring.
primitive UnderLavenderHead(season, height, thick) -> group {
    switch (season) {
        case 'summer' {
            return group {
                tube {
                    material UnderLavFlower
                    radius thick * 2.6 at [0, 0, 0]
                    radius thick * 0.4 at [0, height * 0.26, 0]
                }
            }
        }
        case 'autumn', 'fall' {
            return group {
                tube {
                    material UnderLavFaded
                    radius thick * 2 at [0, 0, 0]
                    radius thick * 0.4 at [0, height * 0.18, 0]
                }
            }
        }
        case 'winter' { return group { } }
        default {
            return group {
                sphere { material UnderCaneBud  scale thick * 1.8 }
            }
        }
    }
}

// How far a lavender has been cut back, which is a winter fact and no season else.
function UnderLavenderCut(season) -> number {
    switch (season) {
        case 'winter' { return 0.55 }
        default { return 1 }
    }
}

// A mound of fine stems, each carrying whatever the season puts on it.  Winter takes the flowers away
// and cuts the stems back, which is what a lavender actually looks like after it has been pruned.
primitive Lavender(height, season = 'summer', variant = 1) -> group {
    short = UnderLavenderCut(season)

    return group {
        for stem in [0, 19] {
            tall = height * short * (0.6 + random(variant, stem, 51) * 0.55)
            thick = height * 0.013

            group {
                tube {
                    material UnderLavStem
                    radius thick at [0, 0, 0]
                    radius thick * 0.75 at [0, tall, 0]
                }
                object UnderLavenderHead(season, height * short, thick) { translate Y tall }
                rotate Z 5 + random(variant, stem, 52) * 22
                rotate Y random(variant, stem, 53) * 360
                translate [(random(variant, stem, 54) - 0.5) * height * 0.42, 0,
                           (random(variant, stem, 55) - 0.5) * height * 0.42]
            }
        }
    }
}

// -- Fern ------------------------------------------------------------------------------------------

// One frond: a stem arching up and over, with leaflets in pairs down its length, smaller toward the
// tip.  The leaflets sit at points on the stem's *own* curve, evaluated from the same quadratic the
// tube was made from, so they grow out of it rather than near it.
primitive UnderFrond(season, long, id, variant) -> group {
    leaflets = 13

    // The rachis: up steeply, then arching over.  It used to run out to 0.86 of its length while
    // rising only 0.56, which is an elevation of 33 degrees -- a frond lying down rather than a fern
    // standing up, and the reason a crown of seven of them read as a doily on the ground.
    tipX = long * 0.58
    tipY = long * 0.60
    midX = long * 0.14
    midY = long * 0.85

    return group {
        tube {
            material UnderFernStem
            radius long * 0.015 at [0, 0, 0]
            quad radius long * 0.009 at [midX, midY, 0]
                 radius long * 0.003 at [tipX, tipY, 0]
        }

        for pair in [0, leaflets - 1] {
            along = (pair + 1) / (leaflets + 1)
            middle = 2 * (1 - along) * along
            last = along * along
            leaf = long * 0.26 * (1 - along * 0.68)

            for side in [0, 1] {
                // **Out to one side of the rachis, not merely turned on the spot.**  A strap grows
                // along its own +Y and `turn` only spins it about that axis, so both of a pair used
                // to stand in the same place wearing different faces -- a caterpillar, not a frond.
                // Laying it over about X sends it out along Z, which is across the rachis.
                object UnderStrap('fern', season, leaf, leaf * 0.13, 18, 28,
                                  random(id, pair, variant) * 30) {
                    rotate X (side * 2 - 1) * (70 + random(id, pair, variant + 1) * 14)
                    translate [middle * midX + last * tipX,
                               middle * midY + last * tipY,
                               0]
                }
            }
        }
    }
}

// A fern: fronds from one crown, arching out and over.  **The shape nothing else here had** --
// everything else is a blade, a dome, an arching cane or a mound of stems, and a woodland floor
// without ferns reads as a lawn under trees.
primitive Fern(height = 0.6, season = 'summer', variant = 1) -> group {
    fronds = 7

    return group {
        for frond in [0, fronds - 1] {
            // Measured: a frond arches over, so it stands about three quarters of its own length
            // and is built a third again as long to reach the height asked for.
            object UnderFrond(season, height * 1.314 * (0.84 + random(frond, 11, variant) * 0.34),
                              frond, variant) {
                // Barely tilted out.  The frond's own curve does the arching now, so tipping it
                // over as well simply laid the plant down again.
                rotate Z -1 - random(frond, 12, variant) * 7
                rotate Y frond * 360 / fronds + random(frond, 13, variant) * 40
            }
        }
    }
}

// -- Reeds -----------------------------------------------------------------------------------------

// One reed: a few tall stiff blades and a seed head on the tallest.  Stiffer and far taller than
// grass, which is the whole difference -- a reed stands where water stood.
primitive Reed(height = 1.8, season = 'summer', variant = 1) -> group {
    // Measured: the head overshoots the tallest blade, so a reed built to the height asked for stands about a ninth over it.
    tall = height * 0.898
    blades = 5

    return group {
        for blade in [0, blades - 1] {
            tall = tall * (0.68 + random(blade, 21, variant) * 0.40)

            object UnderStrap('reed', season, tall, tall * 0.022, 4, 9,
                              random(blade, 22, variant) * 360) {
                translate [(random(blade, 23, variant) - 0.5) * tall * 0.10, 0,
                           (random(blade, 24, variant) - 0.5) * tall * 0.10]
            }
        }

        // The head, on a stem of its own, which is what says reed rather than tall grass.
        group {
            tube {
                material UnderReedHead
                radius tall * 0.010 at [0, 0, 0]
                quad radius tall * 0.008 at [tall * 0.010, tall * 0.55, 0]
                     radius tall * 0.007 at [tall * 0.026, tall * 0.96, 0]
            }
            sphere {
                material UnderReedHead
                scale [tall * 0.026, tall * 0.10, tall * 0.026]
                translate [tall * 0.028, tall * 1.02, 0]
            }
            rotate Y random(1, 25, variant) * 360
        }
    }
}

// An area of them, filling whatever outline it is given -- a margin, a ditch, the shallow end of a
// pond.  The same arrangement `Grass` uses.
primitive Reeds(shape, season = 'summer', variant = 1, height = 1.8, density = 1) -> field {
    return field {
        of Reed(height * (0.78 + random(variant, n, 1) * 0.44), season, variant * 5477 + n)
        within shape
        spacing height * 0.30 / density
        jitter 1.5
        index in n
    }
}

// -- Wheat -----------------------------------------------------------------------------------------

// One stalk with its ear, which ripens: green in spring, greening still in summer, straw and gold in
// autumn, and grey stubble in winter.
//
// **It was straw the year round until a test held one season against another.**  The reasoning was
// that a crop is cut rather than turned -- true, but a crop is *green* for most of the time it is
// standing, and a scene wanting a ripe field can say `'autumn'` and get one.
primitive Stalk(height = 1.1, season = 'summer', variant = 1) -> group {
    grains = 9

    return group {
        tube {
            material UnderCoat('wheat', season)
            radius height * 0.011 at [0, 0, 0]
            quad radius height * 0.009 at [height * 0.02, height * 0.50, 0]
                 radius height * 0.007 at [height * 0.07, height * 0.78, 0]
        }

        for leaf in [0, 1] {
            object UnderStrap('wheat', season, height * 0.34, height * 0.020, 22, 34,
                              leaf * 170 + random(leaf, 31, variant) * 40) {
                translate [0, height * (0.22 + leaf * 0.24), 0]
            }
        }

        // The ear: grains up a short spike, each a little ellipsoid, tapering to the top.
        group {
            for grain in [0, grains - 1] {
                up = grain / (grains - 1)

                sphere {
                    material UnderWheatGrain(season)
                    scale height * 0.030 * (1 - up * 0.45)
                    scale [1, 1.7, 1]
                    translate [0, height * 0.80 + up * height * 0.19,
                               height * 0.012 * (1 - 2 * (grain % 2))]
                }
            }
            translate [height * 0.07, 0, 0]
            rotate Y random(2, 32, variant) * 360
        }
    }
}

// A field of it, in drills.  **Give this a jitter near nought**: a crop is drilled, and the rows are
// the whole look of one -- which is the opposite of what grass wants from the same clause.
primitive Wheat(shape, season = 'summer', variant = 1, height = 1.1, density = 1) -> field {
    return field {
        of Stalk(height * (0.88 + random(variant, n, 1) * 0.24), season, variant * 8623 + n)
        within shape
        spacing height * 0.13 / density
        jitter 0.35
        index in n
    }
}

// -- Wildflowers -----------------------------------------------------------------------------------

// One flower: a stem, a ring of petals and a heart.  The tint is handed in as a color, because a
// color is an ordinary value and a material is not -- a material may be named in an expression but a
// material-making primitive may not be called in one.
primitive Wildflower(height = 0.34, tint = [0.78, 0.72, 0.30], variant = 1) -> group {
    // Measured: the petals sit above the stem head, so the flower stands taller than its stem.
    tall = height * 0.852
    petals = 6

    // Cast once, because a tuple cannot be scaled and a scene will hand this a bare triple as often
    // as a color.
    paint = color tint

    return group {
        tube {
            material UnderFlowerStem
            radius tall * 0.022 at [0, 0, 0]
            quad radius tall * 0.018 at [tall * 0.03, tall * 0.52, 0]
                 radius tall * 0.014 at [tall * 0.09, tall * 0.90, 0]
        }

        object UnderStrap('wheat', 'summer', tall * 0.30, tall * 0.045, 26, 38,
                          random(1, 41, variant) * 360) {
            translate [0, tall * 0.24, 0]
        }

        group {
            for petal in [0, petals - 1] {
                parallelogram {
                    material {
                        pigment paint * (0.86 + random(petal, 42, variant) * 0.28)
                        specular 0.22  shininess 40  ambient 0.24
                    }
                    at [0, 0, 0]
                    sides [tall * 0.34, tall * 0.07, 0], [0, tall * 0.04, tall * 0.13]
                    rotate Y petal * 360 / petals
                }
            }
            sphere {
                material UnderFlowerHeart
                scale tall * 0.060
            }
            // Nodding, so the face shows to anyone not directly above it.  A ring of flat petals
            // seen exactly edge-on is a line, which is what the first of these looked like.
            rotate Z -34
            translate [tall * 0.09, tall * 0.90, 0]
        }
    }
}
