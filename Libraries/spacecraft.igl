OvBlackTile = color [0.055, 0.055, 0.06]
OvCarbon = color [0.30, 0.30, 0.31]
OvGray = material { pigment [0.5, 0.5, 0.52]  specular 0.2  shininess 40  ambient 0.2 }
OvBlack = material { pigment OvBlackTile  specular 0.12  shininess 20  ambient 0.15 }
OvGlass = color [0.025, 0.03, 0.045]
OvSeam = color [0.42, 0.42, 0.42]
OvLettering = color [0.05, 0.05, 0.05]
OvFlagRedColor = color [0.62, 0.06, 0.09]
OvFlagBlue = color [0.06, 0.09, 0.30]

// The white skin: tile and blanket, barely glossy.
OvWhite = material { pigment [0.88, 0.88, 0.86]  specular 0.1  shininess 20  ambient 0.15 }

// What both her skins carry: the bay doors' seams and the crew hatch on her port side.
OvSeamed = material OvWhite {
    decal { path OvDoorSeamsSide  color OvSeam  planar  min Y -4  max Y 4  rotate X -90 }
    decal { path OvDoorSeamsTop  color OvSeam  planar  min Y 0  max Y 4 }
    decal { path OvHatchRing  color OvSeam  planar  min Y -4  max Y 0  rotate X -90 }
    decal { path OvHatchWindow  color OvGlass  planar  min Y -4  max Y 0  rotate X -90 }
}

// Her skin, white, with what she wears however she is dressed: the black tile of her belly and of her nose's lower
// front, her name and her country's, her nose cap's gray and her base's black.
OvMarked = material OvSeamed {
    decal { path OvSideBlack  color OvBlackTile  planar  min Y -4  max Y 4  rotate X -90 }
    decal { path { move to -5, -5  line to 5, -5  line to 5, 5  line to -5, 5  close }
            color OvBlackTile  planar  min Y -4  max Y -2.1  scale [4, 1, 1] }
    // Her name and her country's, as she wore them in 1977: on her starboard side reading aft to forward, the
    // flag forward of the lettering with its union forward; on her port side the same, read forward to aft.
    decal { path { text { text 'United States'  font 'Arimo' } }  color OvLettering  planar  min Y 0  max Y 4
            scale 0.94  rotate X -90  translate [-5.03, -0.62, 0] }
    decal { path { text { text 'United States'  font 'Arimo' } }  color OvLettering  planar  min Y 0  max Y 4
            scale 0.94  rotate X -90  rotate Y 180  translate [0.6, -0.62, 0] }
    decal { path OvFlagRed  color OvFlagRedColor  planar  min Y 0  max Y 4  scale [-0.74, 1, 0.74]  rotate X -90
            translate [2.36, -0.62, 0] }
    decal { path OvFlagUnion  color OvFlagBlue  planar  min Y 0  max Y 4  scale [-0.74, 1, 0.74]  rotate X -90
            translate [2.36, -0.62, 0] }
    decal { path OvFlagStars  color White  planar  min Y 0  max Y 4  scale [-0.74, 1, 0.74]  rotate X -90
            translate [2.36, -0.62, 0] }
    decal { path OvFlagRed  color OvFlagRedColor  planar  min Y 0  max Y 4  scale 0.74  rotate X -90  rotate Y 180
            translate [2.36, -0.62, 0] }
    decal { path OvFlagUnion  color OvFlagBlue  planar  min Y 0  max Y 4  scale 0.74  rotate X -90  rotate Y 180
            translate [2.36, -0.62, 0] }
    decal { path OvFlagStars  color White  planar  min Y 0  max Y 4  scale 0.74  rotate X -90  rotate Y 180
            translate [2.36, -0.62, 0] }
    decal { path OvNasa  color OvLettering  planar  min Y 0  max Y 4  scale 0.48  rotate X -90
            translate [-5.0, 0.28, 0] }
    decal { path OvNasa  color OvLettering  planar  min Y 0  max Y 4  scale 0.48  rotate X -90  rotate Y 180
            translate [-3.64, 0.28, 0] }
    decal { path { text { text 'Enterprise'  font 'Arimo' } }  color OvLettering  planar  min Y 0  max Y 4
            scale 0.4  rotate X -90  translate [9.95, 0.5, 0] }
    decal { path { text { text 'Enterprise'  font 'Arimo' } }  color OvLettering  planar  min Y 0  max Y 4
            scale 0.4  rotate X -90  rotate Y 180  translate [11.85, 0.5, 0] }
    decal { path { move to -5, -5  line to 5, -5  line to 5, 5  line to -5, 5  close }
            color OvCarbon  planar  min Y 17.95  max Y 20  rotate Z -90 }
    decal { path { move to -5, -5  line to 5, -5  line to 5, 5  line to -5, 5  close }
            color OvBlackTile  planar  min Y -15.1  max Y -14.0  rotate Z -90 }
}

// As she would have flown: black tile over the top of her nose and round her windows, and their glass.
OvHull = material OvMarked {
    decal { path OvNoseTopBlack  color OvBlackTile  planar  min Y -0.6  max Y 3.5 }
    decal { path OvThrusterPlate  color OvBlackTile  planar  min Y -0.6  max Y 3.5 }
    decal { path OvNoseStripe  color OvBlackTile  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindowMask  color OvBlackTile  planar  min Y -0.6  max Y 3.5 }
    decal { path OvOverheadFrames  color OvBlackTile  planar  min Y 1  max Y 3.5 }
    decal { path OvOverheadFramesPort  color OvBlackTile  planar  min Y 1  max Y 3.5 }
    decal { path OvWindshieldCenter  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindshieldCenterPort  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindshieldSide  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindshieldSidePort  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvOverheadWindow  color OvGlass  planar  min Y 1  max Y 3.5 }
    decal { path OvOverheadWindowPort  color OvGlass  planar  min Y 1  max Y 3.5 }
}

// As she was in 1977: white over her nose, and only her windows' glass dark.
OvHull1977 = material OvMarked {
    decal { path OvWindshieldCenter  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindshieldCenterPort  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindshieldSide  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvWindshieldSidePort  color OvGlass  planar  min Y -0.6  max Y 3.5 }
    decal { path OvOverheadWindow  color OvGlass  planar  min Y 1  max Y 3.5 }
    decal { path OvOverheadWindowPort  color OvGlass  planar  min Y 1  max Y 3.5 }
}

// The tail: white, with black tile along its leading edge and its speed brake's trailing edge, and the line of the
// rudder's hinge.
OvTailSkin = material OvWhite {
    decal { path OvTailLeading  color OvBlackTile  planar  min Y -1  max Y 1  rotate X -90 }
    decal { path OvTailTrailing  color OvBlackTile  planar  min Y -1  max Y 1  rotate X -90 }
    decal { path OvRudderHinge  color [0.25, 0.25, 0.25]  planar  min Y -1  max Y 1  rotate X -90 }
}

OvWingTopSkin = material OvWhite {
    decal { path OvWingLeadingBlack  color OvBlackTile  planar  min Y -4  max Y 0 }
    decal { path OvWingLeadingCarbon  color OvCarbon  planar  min Y -4  max Y 0 }
    decal { path OvWingTrailingBlack  color OvBlackTile  planar  min Y -4  max Y 0 }
    decal { path OvElevonHinge  color [0.2, 0.2, 0.2]  planar  min Y -4  max Y 0 }
    decal { path OvElevonSplit  color [0.2, 0.2, 0.2]  planar  min Y -4  max Y 0 }
}

// Her port wing says USA over the flag, and her starboard wing NASA, read from above with her nose up.
OvPortWingTopSkin = material OvWingTopSkin {
    decal { path { text { text 'USA'  font 'Arimo' } }  color OvLettering  planar  min Y -4  max Y 0
            scale 1.57  rotate Y 90  translate [-7.3, 0, 8.75] }
    decal { path OvFlagRed  color OvFlagRedColor  planar  min Y -4  max Y 0  rotate Y 90  translate [-9.0, 0, 8.6] }
    decal { path OvFlagUnion  color OvFlagBlue  planar  min Y -4  max Y 0  rotate Y 90  translate [-9.0, 0, 8.6] }
    decal { path OvFlagStars  color White  planar  min Y -4  max Y 0  rotate Y 90  translate [-9.0, 0, 8.6] }
}

OvStarboardWingTopSkin = material OvWhite {
    decal { path OvWingLeadingBlackStarboard  color OvBlackTile  planar  min Y -4  max Y 0 }
    decal { path OvWingLeadingCarbonStarboard  color OvCarbon  planar  min Y -4  max Y 0 }
    decal { path OvWingTrailingBlackStarboard  color OvBlackTile  planar  min Y -4  max Y 0 }
    decal { path OvElevonHingeStarboard  color [0.2, 0.2, 0.2]  planar  min Y -4  max Y 0 }
    decal { path OvElevonSplitStarboard  color [0.2, 0.2, 0.2]  planar  min Y -4  max Y 0 }
    decal { path OvNasa  color OvLettering  planar  min Y -4  max Y 0  scale 1.1  rotate Y 90
            translate [-7.9, 0, -5.4] }
}

OvWingUnderSkin = material OvBlack {
    decal { path OvWingLeadingCarbon  color OvCarbon  planar  min Y -4  max Y 0 }
    decal { path OvWingLeadingCarbonStarboard  color OvCarbon  planar  min Y -4  max Y 0 }
}

// A wing: its upper half white and its lower half black, each lofted from root to break to tip, along +Z for the
// port wing and along -Z for the starboard one, so that each wing's markings are laid in the ship's own frame.
primitive OvPortWing() -> group {
    return group {
        group {
            loft {
                section { path OvWingTop0  translate Z 2.4384 }
                section { path OvWingTop1  translate Z 5.08 }
                section { path OvWingTop2  translate Z 11.8872 }
                straight
            }
            material OvPortWingTopSkin
        }
        group {
            loft {
                section { path OvWingUnder0  translate Z 2.4384 }
                section { path OvWingUnder1  translate Z 5.08 }
                section { path OvWingUnder2  translate Z 11.8872 }
                straight
            }
            material OvWingUnderSkin
        }
    }
}

primitive OvStarboardWing() -> group {
    return group {
        group {
            loft {
                section { path OvWingTop0  translate Z -2.4384 }
                section { path OvWingTop1  translate Z -5.08 }
                section { path OvWingTop2  translate Z -11.8872 }
                straight
            }
            material OvStarboardWingTopSkin
        }
        group {
            loft {
                section { path OvWingUnder0  translate Z -2.4384 }
                section { path OvWingUnder1  translate Z -5.08 }
                section { path OvWingUnder2  translate Z -11.8872 }
                straight
            }
            material OvWingUnderSkin
        }
    }
}

primitive OvPod() -> loft {
    return loft {
        section { path OvPod0  translate Z -8.3058 }
        section { path OvPod1  translate Z -8.7122 }
        section { path OvPod2  translate Z -9.4234 }
        section { path OvPod3  translate Z -10.6934 }
        section { path OvPod4  translate Z -12.4714 }
        section { path OvPod5  translate Z -14.1986 }
        section { path OvPod6  translate Z -14.9098 }
        rotate Y 90
    }
}

primitive OvBody() -> loft {
    return loft {
        section { path OvStation0  translate Z 18.5928 }
        section { path OvStation1  translate Z 18.5420 }
        section { path OvStation2  translate Z 18.4658 }
        section { path OvStation3  translate Z 18.3134 }
        section { path OvStation4  translate Z 18.0848 }
        section { path OvStation5  translate Z 17.7038 }
        section { path OvStation6  translate Z 17.3228 }
        section { path OvStation7  translate Z 16.9418 }
        section { path OvStation8  translate Z 16.5608 }
        section { path OvStation9  translate Z 15.7988 }
        section { path OvStation10  translate Z 15.0368 }
        section { path OvStation11  translate Z 14.3002 }
        section { path OvStation12  translate Z 13.5382 }
        section { path OvStation13  translate Z 12.7762 }
        section { path OvStation14  translate Z 12.0142 }
        section { path OvStation15  translate Z 11.2522 }
        section { path OvStation16  translate Z 10.4902 }
        section { path OvStation17  translate Z 9.8298 }
        section { path OvStation18  translate Z -8.5852 }
        section { path OvStation19  translate Z -10.9474 }
        section { path OvStation20  translate Z -14.1986 }
        rotate Y 90
        }
}

// The bay's lining: white blankets over the mid fuselage's frames, a frame every 1.45 m along her (the cylinder the
// bay is cut with runs along its own Y), each blanket a little quilted.
OvLiner = material {
    pigment linear Y gradient {
        [0, [0.55, 0.55, 0.53], 0.035, [0.78, 0.78, 0.76], 0.5, [0.84, 0.84, 0.82], 0.965, [0.78, 0.78, 0.76],
         1, [0.55, 0.55, 0.53]]
        scale [1, 1.45, 1]
    }
    specular 0.06  ambient 0.15
    normal wrinkles { depth 0.25  scale 0.18 }
}

// Her bay's forward bulkhead: the two windows of her aft flight deck, looking aft into the bay.
OvBulkheadWindows = material OvLiner {
    decal { path { move to 0.12, 1.55  line to 0.68, 1.55  line to 0.68, 2.2  line to 0.12, 2.2  close }
            color OvGlass  planar  min Y -10  max Y -9.6  rotate X -90  rotate Y 90 }
    decal { path { move to -0.68, 1.55  line to -0.12, 1.55  line to -0.12, 2.2  line to -0.68, 2.2  close }
            color OvGlass  planar  min Y -10  max Y -9.6  rotate X -90  rotate Y 90 }
}
// The radiators: silvered film over the doors' inner faces, a mirror that shows mostly the black it faces.
OvRadiatorPanel = material {
    pigment [0.62, 0.64, 0.68]  diffuse 0.5  specular 0.8  shininess 120  reflective 0.35  ambient 0.1
}

// A payload bay door, the starboard one, closed: its shell and the four radiator panels lining it.
primitive OvDoor() -> group {
    return group {
        loft {
            section { path OvDoorShell  translate Z 9.8298 }
            section { path OvDoorShell  translate Z -8.5852 }
            straight
            rotate Y 90
            material OvWhite
        }
        for k in [0, 3] {
            loft {
                section { path OvRadiator  translate Z (9.73 - k * 4.62) }
                section { path OvRadiator  translate Z (9.73 - k * 4.62 - 4.52) }
                straight
                rotate Y 90
                material OvRadiatorPanel
            }
        }
    }
}

OvNozzle = material { pigment [0.42, 0.41, 0.40]  specular 0.55  shininess 35  reflective 0.08  ambient 0.15 }
OvNozzleInside = material { pigment [0.06, 0.055, 0.05]  specular 0.3  shininess 30  ambient 0.1 }
OvBoot = material { pigment [0.86, 0.85, 0.82]  specular 0.05  ambient 0.15 }

// A main engine's bell, about its own axis along -X from the base: 2.39 m across its exit, 2.9 m long.
primitive OvMainEngine() -> group {
    return group {
        lathe {
            path {
                move to 0.42, 0
                curve 0.70, 0.5, 1.05, 1.6 to 1.195, 2.9
                line to 1.165, 2.9
                curve 1.02, 1.6, 0.67, 0.5 to 0.39, 0
                close
            }
            material OvNozzle
        }
        cylinder { min Y -0.1  max Y 0.3  scale [0.72, 1, 0.72]  material OvBoot }
        cylinder { min Y 0.2  max Y 0.3  scale [0.4, 1, 0.4]  material OvNozzleInside }
        rotate Z 90
    }
}

// A pod's maneuvering engine, its bell 1.1 m across and 1.2 m long, aft from the pod's end.
primitive OvPodEngine() -> group {
    return group {
        lathe {
            path {
                move to 0.16, 0
                curve 0.3, 0.25, 0.48, 0.7 to 0.55, 1.2
                line to 0.53, 1.2
                curve 0.46, 0.7, 0.28, 0.25 to 0.14, 0
                close
            }
            material OvNozzle
        }
        rotate Z 90
    }
}

// Her fuselage in the skin she wore: as she would have flown, or as she was in 1977.
primitive OvSkinnedBody(flown) -> group {
    return group {
        if (flown > 0) { group { object OvBody()  material OvHull } }
        else { group { object OvBody()  material OvHull1977 } }
    }
}

primitive ShuttleEnterprise(doors = 0, cone = 0, flown = 1) -> group {
    return group {
        if (doors > 0) {
            difference {
                object OvSkinnedBody(flown)
                cube { scale [9.2075, 2, 3.2]  translate [0.6223, 2.9144, 0] }
                cylinder { min Y -9.8298  max Y 8.5852  scale [2.286, 1, 2.286]  rotate Z 90  translate Y 0.9144 }
                material OvBulkheadWindows
            }
            object OvDoor() {
                translate [0, -0.9144, 2.6924]  rotate X (-175.5 * doors)  translate [0, 0.9144, -2.6924]
            }
            object OvDoor() {
                scale [1, 1, -1]
                translate [0, -0.9144, -2.6924]  rotate X (175.5 * doors)  translate [0, 0.9144, 2.6924]
            }
        } else {
            object OvSkinnedBody(flown)
        }
        if (flown < 1) {
            // the air data boom her test flights carried ahead of her nose
            cylinder { min Y 0  max Y 4.2  scale [0.045, 1, 0.045]  rotate Z -90  translate [18.4, -1.0, 0]
                       material OvGray }
        }
        object OvPortWing()
        object OvStarboardWing()
        group {
            loft {
                section { path OvTail0  translate Z 2.54 }
                section { path OvTail1  translate Z 10.8204 }
                straight
                rotate X -90
            }
            material OvTailSkin
        }
        object OvPod() { material OvWhite }
        object OvPod() { scale [1, 1, -1]  material OvWhite }
        // the body flap: a wedge under her base, thick at its hinge and thin at its trailing edge
        loft {
            section { path OvBodyFlap  translate Z -3.05 }
            section { path OvBodyFlap  translate Z 3.05 }
            straight
            material OvBlack
        }
        if (cone > 0) {
            loft {
                section { path OvCone0  translate Z -14.097 }
                section { path OvCone1  translate Z -16.0274 }
                section { path OvCone2  translate Z -18.5674 }
                section { path OvCone3  translate Z -21.1074 }
                section { path OvCone4  translate Z -23.1394 }
                section { path OvCone5  translate Z -24.6634 }
                section { path OvCone6  translate Z -25.5524 }
                rotate Y 90
                material OvWhite
            }
        } else {
            // her three main engines, the upper pitched up and the lower two out, each in a white boot
            object OvMainEngine() { rotate Z 10  translate [-14.2, 1.75, 0] }
            object OvMainEngine() { rotate Y -3.5  rotate Z 10  translate [-14.2, -0.22, -1.85] }
            object OvMainEngine() { rotate Y 3.5  rotate Z 10  translate [-14.2, -0.22, 1.85] }
            // and the pods' maneuvering engines
            object OvPodEngine() { translate [-14.9, 2.36, -2.0] }
            object OvPodEngine() { translate [-14.9, 2.36, 2.0] }
        }
    }
}

// -- Her arm ------------------------------------------------------------------------------------------------------

// The Remote Manipulator System, Canada's arm, in her own frame: its shoulder on her port sill at Xo 679.5, and
// stowed -- every angle nought -- it lies aft along the sill.  It is 50 ft long and 13 in thick, shoulder to elbow
// 6.37 m and elbow to wrist 7.06 m (NASA, 1985).  `yaw` swings it inboard over the bay; `pitch` raises the upper
// arm; `elbow` turns the lower arm on in the same sense, so a negative elbow folds it back down; the wrist pitches,
// yaws and rolls the end effector.  NASA's limits: shoulder pitch -2 to 145, yaw either way 180, elbow 2.4 to -161,
// wrist pitch and yaw 121 either way.  Place it as she is placed:
//
//     object ShuttleEnterprise(1)
//     object ShuttleArm(20, 70, -95, -40)

OvArmBlanket = material { pigment [0.90, 0.89, 0.86]  specular 0.08  ambient 0.2 }
OvArmJoint = material { pigment [0.72, 0.72, 0.70]  specular 0.25  shininess 40  ambient 0.2 }
OvArmMetal = material { metal 'aluminum'  roughness 0.35 }
OvArmGold = material { metal 'gold'  roughness 0.4 }

primitive OvBoom(length) -> group {
    return group {
        cylinder { min Y 0  max Y length  scale [0.165, 1, 0.165]  rotate Z 90  material OvArmBlanket }
        // the blanket's joints, a band every couple of meters
        for k in [1, 3] {
            cylinder { min Y -0.03  max Y 0.03  scale [0.172, 1, 0.172]  rotate Z 90  translate X (-length * k / 4)
                       material OvArmJoint }
        }
    }
}

primitive ShuttleArm(yaw = 0, pitch = 0, elbow = 0, wristPitch = 0, wristYaw = 0, wristRoll = 0) -> group {
    return group {
        // the shoulder's pedestal and its yaw joint
        cylinder { min Y -0.45  max Y 0  scale [0.24, 1, 0.24]  material OvArmJoint }
        group {
            cylinder { min Y -0.05  max Y 0.25  scale [0.26, 1, 0.26]  material OvArmJoint }
            group {
                // the shoulder pitch joint, across the arm, and the upper arm aft from it
                cylinder { min Y -0.3  max Y 0.3  scale [0.25, 1, 0.25]  rotate X 90  material OvArmJoint }
                object OvBoom(6.0) { translate X -0.3 }
                group {
                    cylinder { min Y -0.27  max Y 0.27  scale [0.23, 1, 0.23]  rotate X 90  material OvArmJoint }
                    // the elbow's camera, on its pan-and-tilt head
                    cube { scale [0.12, 0.09, 0.1]  translate [0.05, 0.36, 0]  material OvArmJoint }
                    cylinder { min Y 0  max Y 0.2  scale [0.05, 1, 0.05]  translate [0, 0.22, 0]  material OvArmMetal }
                    object OvBoom(6.6) { translate X -0.25 }
                    group {
                        // wrist pitch, yaw and roll, then the end effector
                        cylinder { min Y -0.22  max Y 0.22  scale [0.2, 1, 0.2]  rotate X 90  material OvArmJoint }
                        group {
                            sphere { scale 0.2  material OvArmJoint }
                            group {
                                cylinder { min Y 0  max Y 0.55  scale [0.19, 1, 0.19]  rotate Z 90
                                           material OvArmJoint }
                                cylinder { min Y 0.55  max Y 1.45  scale [0.21, 1, 0.21]  rotate Z 90
                                           material OvArmBlanket }
                                cylinder { min Y 1.45  max Y 1.85  scale [0.2, 1, 0.2]  rotate Z 90
                                           material OvArmMetal }
                                cube { scale [0.12, 0.09, 0.09]  translate [-0.9, 0, 0.25]  material OvArmGold }
                                rotate X wristRoll
                            }
                            rotate Y wristYaw
                        }
                        rotate Z (-wristPitch)
                        translate X -7.06
                    }
                    rotate Z (-elbow)
                    translate X -6.37
                }
                rotate Z (-pitch)
            }
            rotate Y (-yaw)
        }
        translate [7.353, 1.37, 2.48]
    }
}

// -- A satellite in her bay ---------------------------------------------------------------------------------------

// A spin-stabilized communications satellite of the early 1980s, a drum of cells on its upper stage, and the clamshell
// sunshield cradle it rode up in: origin on the cradle's floor, its axis up +Y.  In her bay the floor is 1.37 m under
// her middle, so a cradle in the aft half of it stands at `translate [-4.6, -1.37, 0]`.

SatShieldBlanket = material { pigment [0.86, 0.86, 0.84]  specular 0.1  ambient 0.2 }
SatMotorCase = material { pigment [0.16, 0.16, 0.17]  specular 0.3  shininess 50  ambient 0.15 }
SatCradleWhite = material { pigment [0.82, 0.82, 0.80]  specular 0.15  ambient 0.2 }

// The cells' drum: dark blue, its rows of cells catching the light in bands.
SatDrumCells = material {
    pigment linear Y gradient {
        [0, [0.04, 0.06, 0.16], 0.92, [0.04, 0.06, 0.16], 0.92, [0.30, 0.30, 0.32], 1, [0.30, 0.30, 0.32]]
        scale 0.11
    }
    specular 0.7  shininess 180  ambient 0.12  reflective 0.05  fresnel
}

primitive SpinSatellite() -> group {
    return group {
        // the spin table and the upper stage's motor, its case dark, its nozzle down in the table
        cylinder { min Y 0  max Y 0.28  scale [1.15, 1, 1.15]  material SpacecraftMetal }
        sphere { scale [0.64, 0.78, 0.64]  translate Y 1.05  material SatMotorCase }
        conic { min Y 0.5  max Y 1.2  scale [0.62, 0.55, 0.62]  translate Y 1.2  open  material SpacecraftFoil }
        // the satellite: its aft band of foil, the drum of cells, and its antenna folded down over the top
        cylinder { min Y 1.86  max Y 2.12  scale [1.08, 1, 1.08]  material SpacecraftFoil }
        cylinder { min Y 2.12  max Y 4.05  scale [1.08, 1, 1.08]  material SatDrumCells }
        cylinder { min Y 4.05  max Y 4.16  scale [1.09, 1, 1.09]  material SpacecraftMetal }
        cylinder { min Y 4.16  max Y 4.30  scale [0.95, 1, 0.95]  material SpacecraftFoil }
        difference {
            sphere { scale [0.92, 0.22, 0.92] }
            sphere { scale [0.88, 0.2, 0.88]  translate Y 0.03 }
            cube { scale 1  translate Y -1 }
            translate Y 4.30
            material SpacecraftHull
        }
        cylinder { min Y 4.3  max Y 4.62  scale [0.07, 1, 0.07]  material SpacecraftMetal }
    }
}

// The sunshield cradle: a frame across the bay (4.4 m), the satellite standing in it, and the sunshield's two halves,
// each half a cylinder hinged along its outer foot, swung out by `open` (1 is fully, 35 degrees).
primitive SatelliteCradle(open = 1) -> group {
    return group {
        // the frame, its sill trunnions and its floor
        cube { scale [1.2, 0.35, 2.2]  translate Y 0.35  material SatCradleWhite }
        for side in [0, 1] {
            cube { scale [1.2, 0.9, 0.12]  translate [0, 1.2, (side * 2 - 1) * 2.1]  material SatCradleWhite }
            cylinder { min Y -0.25  max Y 0.25  scale [0.12, 1, 0.12]  rotate X 90
                       translate [0.9, 2.05, (side * 2 - 1) * 2.25]  material SpacecraftMetal }
            cylinder { min Y -0.25  max Y 0.25  scale [0.12, 1, 0.12]  rotate X 90
                       translate [-0.9, 2.05, (side * 2 - 1) * 2.25]  material SpacecraftMetal }
        }
        object SpinSatellite() { translate Y 0.7 }
        // the sunshield halves: half cylinders about the satellite's axis, each hinged along its outer foot and
        // swung out 35 degrees, its inner edges dipping as it goes but staying over the floor
        for side in [0, 1] {
            difference {
                cylinder { min Y 0.9  max Y 2.3  scale [1.32, 1, 1.32] }
                cylinder { min Y 0.8  max Y 2.4  scale [1.27, 1, 1.27] }
                cube { scale [1.6, 2, 1.6]  translate [0, 1.6, (side * 2 - 1) * -1.6] }
                translate [0, -0.9, (side * 2 - 1) * -1.32]
                rotate X ((side * 2 - 1) * -35 * open)
                translate [0, 0.9, (side * 2 - 1) * 1.32]
                material SatShieldBlanket
            }
        }
    }
}
