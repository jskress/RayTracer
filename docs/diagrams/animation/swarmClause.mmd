railroad-ebnf-beta
title "A swarm"

swarm = "swarm" [ name ] "{" { "of" shape | "from" point | "toward" vector | "spread" angle
      | ( "rate" | "since" | "bounce" | "friction" | "drag" | "radius" ) number
      | ( "speed" | "life" ) number [ "to" number ] | property } "}" ;

shape = name [ "(" [ expression { "," expression } ] ")" [ "{" { property } "}" ] ] ;
