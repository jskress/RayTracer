railroad-ebnf-beta
title "Roughening a surface"

normal = "normal" [ "with" "seed" number ] ( name | picture ) "{" [ turbulence ] [ shaping ]
         { "depth" number | transform } "}"
       | "normal" "map" filename [ mapping ] [ "directx" ] "{" { "depth" number | transform } "}" ;

picture = [ "uncached" ] "image" filename [ mapping ] [ "channel" ( "red" | "green" | "blue" | "alpha" ) ] ;

mapping = "planar" [ "once" | shuffle ] | "spherical" | "cylindrical" [ "once" ] | "toroidal"
        | "triplanar" [ "blend" number ] [ shuffle ] ;

shuffle = "shuffled" [ "size" number ] [ "turned" angle ] ;
