railroad-ebnf-beta
title "A material"

material = "material" "{" { pigment | normal | finish | brushing | metallic | interior | decal | film | subsurface
                           | coat | sheen } "}"
         | "material" "inherited" [ "{" { decal } "}" ] ;

finish = ( "ambient" | "diffuse" | "specular" | "shininess" | "reflective"
         | "roughness" | "transparency" | "brilliance" | "grain" ) number
       | "emission" ( number | color ) ;

metallic = "metallic" [ number ] ;

brushing = "anisotropy" number [ ( "along" | "around" ) ( "X" | "Y" | "Z" | vector ) ] ;

film = "film" "{" { "thickness" number [ "to" number "by" pattern ]
                  | ( "ior" | "index" "of" "refraction" ) number } "}" ;

subsurface = "subsurface" "{" { "radius" ( number | color ) | "thickness" number } "}" ;

coat = "coat" "{" { "roughness" number | ( "ior" | "index" "of" "refraction" ) number
                  | "tint" ( number | color ) } "}" ;

sheen = "sheen" "{" { "color" ( number | color ) | "roughness" number } "}" ;

pattern = name [ "with" "seed" number ] "{" [ turbulence ] [ shaping ] { transform } "}" ;
