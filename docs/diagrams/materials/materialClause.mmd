railroad-ebnf-beta
title "A material"

material = "material" "{" { pigment | normal | finish | brushing | metal | metallic | interior | decal | film
                           | subsurface | coat | sheen } "}"
         | "material" "inherited" [ "{" { decal } "}" ]
         | "material" "blend" pattern "{" [ weathering ] ( map | materials ) { transform } "}" ;

map = "[" number "," entry { "," number "," entry } "]" ;

materials = entry { "," entry } ;

entry = name | material ;

weathering = "radius" number | "toward" ( "X" | "Y" | "Z" | vector ) ;

finish = ( "ambient" | "diffuse" | "specular" | "shininess" | "reflective"
         | "transparency" | "brilliance" | "grain" ) number
       | "roughness" number [ "to" number "by" pattern ]
       | "emission" ( number | color ) ;

metal = "metal" ( string | color [ "edge" color ] ) ;

metallic = "metallic" [ number [ "to" number "by" pattern ] ] ;

brushing = "anisotropy" number [ ( "along" | "around" ) ( "X" | "Y" | "Z" | vector ) ] ;

film = "film" "{" { "thickness" number [ "to" number "by" pattern ]
                  | ( "ior" | "index" "of" "refraction" ) number } "}" ;

subsurface = "subsurface" "{" { "radius" ( number | color ) | "thickness" number } "}" ;

coat = "coat" "{" { "roughness" number | ( "ior" | "index" "of" "refraction" ) number
                  | "tint" ( number | color ) } "}" ;

sheen = "sheen" "{" { "color" ( number | color ) | "roughness" number } "}" ;

pattern = ( name [ "with" "seed" number ] | picture ) "{" [ turbulence ] [ shaping ] { transform } "}" ;

picture = [ "uncached" ] "image" filename [ mapping ] [ "channel" ( "red" | "green" | "blue" | "alpha" ) ] ;

mapping = "planar" [ "once" ] | "spherical" | "cylindrical" [ "once" ] | "toroidal" ;
