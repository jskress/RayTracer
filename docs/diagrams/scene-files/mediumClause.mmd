railroad-ebnf-beta
title "A medium"

medium = "medium" [ name ] "{" { ( "absorption" | "scattering" ) color | "emission" emission
       | "anisotropy" number | "density" density | ( "samples" | "bounces" ) number | "phase" "rayleigh" } "}" ;

emission = color | pigment | "by" "density" map ;

density = number | "function" "{" expression "}" | pattern "{" { property } "}" ;

map = [ "banded" ] "[" number "," color { "," number "," color } "]" ;
