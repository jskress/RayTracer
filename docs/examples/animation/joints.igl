// Joints, a second in.  On the left, a door on its hinge, swung by the time and stopped at its limit.  Next, a
// turret turned about its upright to aim its barrel at a ball going round it.  Then an arm of two links reaching
// for the gold bead, turned at the shoulder and the elbow until its tip is on it.  On the right, a wheel turned
// by the time and a strut stretched from the pin in its face to a post, lengthening and shortening as it goes
// round.
context { angles are degrees  no gamma  animation length 2  still 30 }

camera {
    location [0.2, 2.0, -8.4]
    look at [0.2, 0.8, 0]
    field of view 64
}

background [0.66, 0.74, 0.84]

point light { location [-4, 8, -6]  color [1, 0.97, 0.93] }
point light { location [5, 3, -5]   color [0.30, 0.31, 0.35] }

plane { material { pigment checker { color [0.62, 0.62, 0.60], color [0.50, 0.50, 0.48] scale 0.5 }  specular 0 } }

Wood = material { pigment color [0.60, 0.40, 0.22] }
Steel = material { pigment color [0.42, 0.44, 0.50]  specular 0.5 }

// A door, hung on a post: turned about its own left edge, the hinge, by 60 degrees a second, but never past 50.
cylinder { min Y 0  max Y 1.7  scale [0.05, 1, 0.05]  translate [-4.1, 0, 0]  material Steel }
joint {
    axis Y  angle time * 60  limits 0 to 50
    cube { scale [0.55, 0.8, 0.04]  translate [0.55, 0.85, 0]  material Wood }
    translate [-4.1, 0, 0]
}

// A ball going round, and a turret aiming at it by its name: its barrel lies along its +X, the way it faces.
sphere {
    named 'ball'
    scale 0.16
    translate [-1.6 + 1.0 * cos(time * 120), 0.16, 1.0 * sin(time * 120)]
    material { pigment color [0.85, 0.30, 0.20] }
}
joint {
    axis Y  aim at 'ball'
    cylinder { min Y 0  max Y 0.35  scale [0.25, 1, 0.25]  material Steel }
    cylinder { min Y 0  max Y 0.6  scale [0.05, 1, 0.05]  rotate Z -90  translate Y 0.24  material Steel }
    translate [-1.6, 0, 0]
}

// An arm of two links, a shoulder and an elbow, each about Z, reaching with the mark at its tip for the bead.
Bead = [1.95, 1.55 + 0.35 * sin(time * 180), 0]
sphere { scale 0.07  translate Bead  material { pigment color [0.95, 0.75, 0.15]  specular 0.6 } }
cylinder { min Y 0  max Y 0.5  scale [0.12, 1, 0.12]  translate X 0.4  material Steel }
joint {
    pivot [0, 0.5, 0]  axis Z  angle 60  limits -90 to 120
    reach point Bead with 'tip'
    cube { scale [0.55, 0.05, 0.05]  translate [0.55, 0.5, 0]  material { pigment color [0.25, 0.55, 0.30] } }
    joint {
        pivot [1.1, 0.5, 0]  axis Z  angle -90  limits -160 to 0
        cube { scale [0.5, 0.04, 0.04]  translate [1.6, 0.5, 0]  material { pigment color [0.20, 0.45, 0.25] } }
        mark 'tip' at [2.1, 0.5, 0]
    }
    translate X 0.4
}

// A wheel turning half a turn a second, and a strut from the pin in its face to the top of a post, stretched: a
// cylinder one long along X, its ends on the two marks however far apart they are.
group {
    joint {
        axis Z  angle time * -180
        cylinder { min Y -0.05  max Y 0.05  scale [0.45, 1, 0.45]  rotate X 90  material Steel }
        mark 'pin' at [0.3, 0, -0.1]
    }
    cylinder { min Y -0.75  max Y 0.3  scale [0.04, 1, 0.04]  translate [1.3, 0, 0.1]  material Steel }
    mark 'post' at [1.3, 0.3, -0.1]
    cylinder {
        min Y 0  max Y 1  scale [0.03, 1, 0.03]  rotate Z -90
        span from 'pin' to 'post' stretched
        material { pigment color [0.30, 0.45, 0.85] }
    }
    translate [3.3, 0.75, 0]
}
