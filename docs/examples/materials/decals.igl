// Decals: markings painted over a material's pigment, each one color inside an outline.
context { angles are degrees  no gamma }

camera {
    location [0, 7.5, -10]
    look at [0, -0.6, 0.8]
    field of view 40
}

point light { location [7, 7, -6]   color [1, 0.97, 0.93] }
point light { location [-8, 5, -6]  color [0.3, 0.31, 0.36] }

plane {
    material { pigment color [0.5, 0.5, 0.54]  specular 0.1 }
    translate [0, -1, 0]
}

// One material on a group of three differently shaped parts.  Its decals are placed in the group's
// space, so the stripe and the lettering run straight across the joins at one size, rather than
// being stretched by each part's own scale.
group {
    material {
        pigment color [0.9, 0.9, 0.88]
        specular 0.6  shininess 80

        decal {
            path { move to -4, -0.12  line to 4, -0.12  line to 4, 0.12  line to -4, 0.12  close }
            color [0.7, 0.1, 0.08]
            planar
            min Y 0  max Y 1        // the top half only, so it does not print through underneath
        }
        decal {
            path {
                text {
                    text 'RT-42'
                    font 'Merriweather'
                    layout { horizontal position center  vertical position center }
                }
            }
            color [0.08, 0.08, 0.1]
            planar
            min Y 0  max Y 1
            scale 0.32
            translate [0.4, 0, -0.42]
        }
    }

    cylinder { min Y -2  max Y 2  scale [0.8, 1, 0.8]  rotate Z 90 }
    sphere { scale [1.6, 0.8, 0.8]  translate [2, 0, 0] }
    sphere { scale [0.9, 0.8, 0.8]  translate [-2, 0, 0] }

    scale 0.85
    rotate Y 12
    translate [-2.5, -0.2, 0.9]
}

// A pane of clear glass with paint on it.  The glass lets light through and the paint does not,
// so the lettering is seen on the pane and again in its shadow.  The glass is clear by way of its
// pigment rather than its transparency, which is what lets the paint stop the light.
group {
    material {
        pigment color [1, 1, 1, 0]
        specular 0.9  shininess 300  reflective 0.06
        interior { ior 1.5 }

        decal {
            path {
                text {
                    text 'OPEN'
                    font 'Merriweather'
                    layout { horizontal position center  vertical position center }
                }
            }
            color [0.75, 0.12, 0.1]
            planar
            min Y -0.1  max Y 0.1   // straight through the pane's thickness, and no further
            scale 0.5
            rotate X -90            // turned to face the camera, so it projects along Z
            translate [0, 0.5, 0]   // and raised toward the top of the pane
        }
    }

    cube { scale [1.3, 1, 0.03] }

    rotate Y -40
    translate [2.6, 0, 0.9]
}
