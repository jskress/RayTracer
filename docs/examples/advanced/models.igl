// Models read from Wavefront files, each with the material library it names: a crate in two materials, its front
// stenciled; a die laid from one picture of all six faces; a barrel, its staves bump-mapped and its hoops iron; and a
// plant whose leaves are cut out by their picture's alpha.  The models are the gallery's, made by its make-models.py.
context { angles are degrees  no gamma }

camera {
    location [0, 1.35, -5.4]
    look at [0, 0.45, 0]
    field of view 54
}

background [0.66, 0.74, 0.84]

point light { location [-5, 7, -7]  color [1, 0.97, 0.93] }
point light { location [6, 3, -5]   color [0.30, 0.31, 0.35] }

plane { material { pigment color [0.55, 0.55, 0.52]  specular 0 } }

Models = '../../../gallery/Local/interiors/models/'

object file { source Models + 'crate.obj'  scale 0.9  rotate Y -20  translate [-1.95, 0.45, 0] }
object file { source Models + 'die.obj'  scale 0.45  rotate Y 25  translate [-0.65, 0.225, -0.3] }
object file { source Models + 'barrel.obj'  rotate Y 15  translate [0.55, 0, 0.3] }
object file { source Models + 'plant.obj'  scale 1.3  translate [1.85, 0, 0] }
