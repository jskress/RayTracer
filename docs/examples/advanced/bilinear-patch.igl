// A bilinear patch: the warped quadrilateral that four corners span.  Left, four corners in one
// plane, which is a flat quadrilateral and nothing more; middle, one corner lifted; right, two
// opposite corners lifted, which is the saddle.
//
// The surface between them is found by mixing the corners along one direction and then the other,
// so every line of constant "u" -- and every line of constant "v" -- is *straight*.  A patch is
// woven out of two families of straight lines even when no part of it is flat, which is why a
// sail, a flag or a twisted panel is naturally one of these.
context { angles are degrees  no gamma }

camera {
    location [1.5, 1.4, -7.1]
    look at [0.25, -0.05, 0]
    field of view 50
}

point light { location [-2.5, 11, -9]  color [1, 0.97, 0.93] }
point light { location [7, 3, -6]   color [0.55, 0.53, 0.5] }

plane {
    material { pigment checker { color [0.6,0.6,0.64], color [0.2,0.2,0.25] scale 1.2 } }
    translate [0, -1.5, 0]
}

Cloth = material { pigment color [0.85, 0.55, 0.3]  specular 0.5  shininess 70 }

// Flat: all four corners in one plane.
bilinear patch {
    points [-1, -1, 0], [1, -1, 0], [1, 1, 0], [-1, 1, 0]
    material Cloth
    translate [-2.35, 0, 0]
}

// One corner lifted.  Nothing else moves, and the whole surface warps.
bilinear patch {
    points [-1, -1, 0], [1, -1, 0], [1, 1, -1.3], [-1, 1, 0]
    material Cloth
}

// Two opposite corners lifted and the other two left down: the saddle.
bilinear patch {
    points [-1, -1, -0.8], [1, -1, 0.8], [1, 1, -0.8], [-1, 1, 0.8]
    material Cloth
    translate [2.35, 0, 0]
}
