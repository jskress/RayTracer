// A generic shape: an arbitrary closed 2D path, flat in its own X/Y plane.  Where an extrusion
// gives a path thickness, a generic shape leaves it flat.
context { angles are degrees  no gamma }

camera {
    location [0, 0.4, -5]
    look at [0, 0.1, 0]
    field of view 42
}

point light { location [-5, 7, -8]  color [1, 0.97, 0.93] }
point light { location [6, 3, -6]   color [0.35, 0.36, 0.4] }

generic shape {
    material { pigment color [0.85, 0.7, 0.2]  specular 0.4  shininess 60 }

    path {
        move to -1, 0.6
        curve -0.55, 1.3, 0.55, 1.3 to 1, 0.6     // a rounded top, from a cubic curve
        line to 1, -0.6
        quad 0.3, -0.3 to 0, -1.1                  // a notch, from two quadratics
        quad -0.3, -0.3 to -1, -0.6
        close
    }

    rotate Y 180
}
