// The three fractals that stand beside the Julia set, each found by marching a ray in strides as long as the
// shape says it is far: from the left a Mandelbulb of the eighth power, a Mandelbox of factor two, and a Menger
// sponge cut four times.
context { parallel pixel scanner  angles are degrees }

camera { location [0.1, 2.4, -9.6]  look at [0.1, 0.05, 0]  field of view 56 }

point light { location [-7, 9, -8]  color [1, 0.96, 0.9] }
point light { location [6, 4, -6]   color [0.32, 0.34, 0.42] }

background [0.07, 0.08, 0.11]

plane { translate Y -1.05  material { pigment [0.16, 0.16, 0.18]  specular 0.1 } }

mandelbulb {
    power 8
    iterations 10
    rotate Y 20
    translate [-2.6, 0.05, 0]
    material { pigment [0.82, 0.62, 0.34]  specular 0.5  shininess 120 }
}

mandelbox {
    factor 2
    iterations 12
    detail 0.03
    scale 1 / 6
    rotate Y 35
    material { pigment [0.52, 0.68, 0.82]  specular 0.4  shininess 80 }
}

menger {
    iterations 4
    rotate Y 30
    translate [2.7, 0, 0]
    material { pigment [0.86, 0.82, 0.74]  specular 0.2 }
}
