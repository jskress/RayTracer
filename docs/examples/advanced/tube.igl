// A tube: a pipe threaded through a series of points, each with a radius of its own, so it may
// taper along its length.
context { angles are degrees  no gamma }

camera {
    location [0, 3, -9]
    look at [0, 1.3, 0]
    field of view 42
}

point light { location [-6, 9, -8]  color [1, 0.97, 0.93] }
point light { location [7, 4, -4]   color [0.3, 0.31, 0.36] }

plane {
    material { pigment checker { color [0.6,0.6,0.64], color [0.2,0.2,0.25] scale 1.2 } }
}

tube {
    // The segments meet at slight angles rather than flowing smoothly into one another.  A tube
    // checks for that and refuses unless the kinks are declared, so say they are meant.
    discontinuous

    material { pigment color [0.8, 0.55, 0.25]  specular 0.5  shininess 140  reflective 0.12 }

    radius 0.45 at [-2.8, 0.6, 0.5]
    radius 0.38 at [-1.4, 1.6, 0]
    quad  radius 0.3  at [-0.2, 2.5, -0.4]  radius 0.24 at [1.2, 1.9, 0.2]
    curve radius 0.18 at [1.9, 1.6, 0.6]  radius 0.1 at [2.6, 0.9, 0.9]  radius 0.05 at [3, 0.7, 1]
}
