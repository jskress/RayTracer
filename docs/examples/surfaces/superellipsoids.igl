// The same superellipsoid at three pairs of exponents, to show the range the shape covers.
context { angles are degrees  no gamma }

camera {
    location [0, 1.2, -13]
    look at [0, 0, 0]
    field of view 40
}

point light { location [-6, 8, -7]  color [1, 0.97, 0.93] }
point light { location [7, 3, -3]   color [0.28, 0.29, 0.33] }

// Small exponents: a box with rounded edges.
superellipsoid {
    material { pigment color [0.85, 0.55, 0.35]  specular 0.5  shininess 60 }
    east 0.2
    north 0.2
    translate [-2.6, 0, 0]
}

// One and one: a sphere.
superellipsoid {
    material { pigment color [0.5, 0.7, 0.5]  specular 0.5  shininess 60 }
    east 1
    north 1
}

// Larger than one: pinched inward into a star.
superellipsoid {
    material { pigment color [0.5, 0.6, 0.85]  specular 0.5  shininess 60 }
    east 2.5
    north 2.5
    translate [2.6, 0, 0]
}
