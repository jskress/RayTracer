// The sphere taken out of the cube.  Compare with csg-difference-swapped.igl, where the two
// children change places and the result is entirely different.
context { angles are degrees  no gamma }

camera {
    location [2.6, 2.2, -4.2]
    look at [0, 0, 0]
    field of view 42
}

point light { location [-5, 7, -6]  color [1, 0.97, 0.93] }
point light { location [6, 3, -3]   color [0.28, 0.29, 0.34] }

plane {
    material { pigment checker { color [0.6,0.6,0.64], color [0.2,0.2,0.24] scale 0.9 } }
    translate [0, -1.3, 0]
}

difference {
    sphere {
        material { pigment color [0.4, 0.65, 0.85]  specular 0.5  shininess 60 }
        scale 1.32
    }
    cube {
        material { pigment color [0.85, 0.4, 0.35]  specular 0.5  shininess 60 }
    }
}
