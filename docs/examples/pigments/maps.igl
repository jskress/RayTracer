// Three ways of reading the same color map.
context { angles are degrees  no gamma }

camera {
    location [0, 1.2, -13]
    look at [0, 0, 0]
    field of view 42
}

point light { location [-7, 9, -9]  color [1, 0.97, 0.93] }
point light { location [8, 4, -5]   color [0.28, 0.29, 0.34] }

// Blended, which is the default: each color fades into the next.
sphere {
    material {
        pigment linear X gradient {
            frequency 1.2
            [0, [0.85, 0.35, 0.3], 0.5, [0.9, 0.8, 0.35], 1, [0.35, 0.55, 0.8]]
        }
        specular 0.4  shininess 60
    }
    translate [-2.6, 0, 0]
}

// Banded: each entry holds until the next, so the map reads as stripes rather than a fade.
sphere {
    material {
        pigment linear X gradient {
            frequency 1.2
            banded [0, [0.85, 0.35, 0.3], 0.5, [0.9, 0.8, 0.35], 1, [0.35, 0.55, 0.8]]
        }
        specular 0.4  shininess 60
    }
}

// Bouncing: the value runs up and back down rather than snapping from the end to the start,
// so there is no seam where the map wraps.
sphere {
    material {
        pigment linear X bouncing gradient {
            frequency 1.2
            [0, [0.85, 0.35, 0.3], 0.5, [0.9, 0.8, 0.35], 1, [0.35, 0.55, 0.8]]
        }
        specular 0.4  shininess 60
    }
    translate [2.6, 0, 0]
}
