// Rough metal on a slate slab under an overcast sky: a raw cast-iron pot, a bead-blasted aluminum flask, a
// gilded ball as rough as chalk, a hammered copper bowl, a turned steel canister, and one ball of polished
// chrome among them.
//
// **A rough metal keeps its light.**  Each is made of facets too small to see, each a mirror, and on a rough
// surface much of what a facet mirrors lands on another before it gets out.  Followed for one mirroring only,
// that light was lost, and the rougher the metal the more: in this even gray light the gilded ball, rough as
// it is, came out under half as bright as gold should, the iron pot nearly black.  What the facets mirror
// among themselves is given back now, so each shows the brightness of its own metal however rough it is, as
// the chrome ball shows its metal's without any roughness at all.
//
// **And a rough metal's color is deeper than a polished one's.**  Light that goes round the facets is
// colored again by the metal at every one it meets, so the gold is a deeper gold than a polished gold
// would be, and the copper a deeper copper; the aluminum, which mirrors every color nearly alike, only grows
// brighter.
//
// **The canister is turned**, its grooves running round it, so the sky shows in it as a band down its
// length rather than as a blur.

import 'daylight' { Overcast, OvercastLight }

context {
    parallel pixel scanner
    angles are degrees
    antialiasing depth 1
    antialiasing threshold 0.2
    reflection samples 32
    info {
        title 'Metals on a Gray Day'
        author 'J. Stephen Kress'
        description 'Rough cast iron, aluminum, gold, copper and steel, and a ball of polished chrome, on slate under an overcast sky.'
        copyright true
        software __software__
    }
}

camera {
    location [0.02, 0.74, -0.8]
    look at [0.02, 0.54, 0.12]
    field of view 56
    exposure 0.2
}

background Overcast
// More of the overcast's places than the library's, so that what each throws onto the wall behind runs together.
light OvercastLight { samples 96 }

// The slab's top.
Top = 0.45

// -- The setting ----------------------------------------------------------------------------------

// Gravel round the slab and beyond the wall.
plane {
    material {
        pigment granite { [0, [0.32, 0.31, 0.29], 0.5, [0.44, 0.42, 0.39], 1, [0.24, 0.23, 0.22]]  scale 0.03 }
        specular 0
    }
}

// A low garden wall of pale stone behind, for the metals to show something warm below the sky.
cube {
    scale [5, 0.36, 0.15]
    translate [0, 0.36, 2.6]
    material {
        pigment granite { [0, [0.62, 0.55, 0.45], 0.55, [0.70, 0.63, 0.52], 1, [0.52, 0.46, 0.38]]  scale 0.08 }
        specular 0
    }
}

// The slab: slate, dark and a little rough.
cube {
    scale [0.78, Top / 2, 0.5]
    translate [0, Top / 2, 0]
    material {
        pigment granite { [0, [0.17, 0.18, 0.20], 0.6, [0.22, 0.23, 0.25], 1, [0.14, 0.15, 0.16]]  scale [0.4, 0.02, 0.4] }
        roughness 0.55
    }
}

// -- The metals -----------------------------------------------------------------------------------

// Raw cast iron: a pot with a fitted lid and a knob.
lathe {
    path {
        move to 0, 0
        line to 0.1, 0
        quad 0.118, 0 to 0.118, 0.018
        line to 0.118, 0.112
        line to 0.124, 0.116
        line to 0.124, 0.122
        line to 0.11, 0.122
        line to 0.11, 0.018
        quad 0.11, 0.008 to 0.1, 0.008
        line to 0, 0.008
    }
    material { metal 'iron'  roughness 0.7 }
    translate [-0.33, Top, 0.16]
}
lathe {
    path {
        move to 0, 0.122
        line to 0.122, 0.122
        quad 0.118, 0.15 to 0.06, 0.16
        line to 0.016, 0.162
        line to 0.016, 0.176
        quad 0.03, 0.18 to 0.022, 0.19
        line to 0, 0.19
    }
    material { metal 'iron'  roughness 0.7 }
    translate [-0.33, Top, 0.16]
}

// Bead-blasted aluminum: a flask with a narrow neck and a cap.
lathe {
    path {
        move to 0, 0
        line to 0.042, 0
        quad 0.05, 0 to 0.05, 0.008
        line to 0.05, 0.19
        curve 0.05, 0.215, 0.022, 0.215 to 0.02, 0.232
        line to 0.02, 0.24
        line to 0.023, 0.24
        line to 0.023, 0.268
        quad 0.023, 0.272 to 0.019, 0.272
        line to 0, 0.272
    }
    material { metal 'aluminum'  roughness 0.6 }
    translate [-0.13, Top, 0.24]
}

// Gilding as rough as chalk.
sphere {
    material { metal 'gold'  roughness 0.85 }
    scale 0.075
    translate [0.04, Top + 0.075, 0.26]
}

// Polished chrome, for what the light is.
sphere {
    material { metal 'chromium'  roughness 0.02 }
    scale 0.04
    translate [-0.05, Top + 0.04, -0.04]
}

// Hammered copper: a shallow bowl.
lathe {
    path {
        move to 0, 0
        line to 0.05, 0
        curve 0.09, 0.004, 0.118, 0.03 to 0.122, 0.07
        line to 0.116, 0.07
        curve 0.112, 0.034, 0.088, 0.008 to 0.05, 0.006
        line to 0, 0.006
    }
    material { metal 'copper'  roughness 0.6 }
    translate [0.22, Top, 0.06]
}

// Turned steel: a canister, its grooves running round it.
lathe {
    path {
        move to 0, 0
        line to 0.052, 0
        line to 0.052, 0.17
        line to 0.054, 0.17
        line to 0.054, 0.21
        line to 0, 0.21
    }
    material { metal 'iron'  roughness 0.45  anisotropy 0.8 around Y }
    translate [0.42, Top, 0.24]
}
