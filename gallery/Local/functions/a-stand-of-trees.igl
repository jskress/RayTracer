// Nine trees, and this file describes none of them.
//
// Everything standing here came from two lines:
//
//     import 'trees'    { Elm, Oak, Birch }
//     import 'daylight' { ClearMorning, ClearMorningLight }
//
// and then nine calls saying how tall, what time of year, and which of that kind.  There is no bark
// in this file, no leaf, no branching rule, no sun elevation and no turbidity.  Those are somebody
// else's problem, which is the entire point: a scene should be able to say *put an elm there* without
// its author knowing how an elm is put together or what a clear evening sky is made of.
//
// That sentence has been the goal for a long while and everything under it had to be built first.  A
// language to describe a tree in -- primitives that call themselves, a choice to stop the recursion, a
// selection for the seasons, a loop for the leaves, a keyed random so no two limbs match.  Then a way
// to hand such things out: libraries that ship with the ray tracer, and libraries that keep their own
// workings so a scene asking for an elm does not also inherit `TreeWilt` and `TreeSway`.
//
// **The third number is which tree you want.**  Same species, same height, different tree, and the
// same one every time you render it.  A row of identical elms reads as a diagram; that number is what
// makes a row read as trees.  Take it out and this picture becomes three trees repeated three times.
//
// **The seasons are a word.**  The birches on the right are in autumn and the oak behind them has
// already lost its leaves, which is a thing this file says by writing 'autumn' and 'winter'.
//
// What is worth noticing about the sky is what it does *not* say.  `ClearMorning` is a real physical
// sky -- the color of every part of the dome worked out from the way air scatters sunlight -- and the
// numbers behind it are a sun thirty-eight degrees up, an azimuth of 110, and a turbidity of 2.2.
// Nobody knows they want a turbidity of 2.2.  The light comes with it, by name, because a sky and the
// light it casts are two halves of one thing and a scene that takes one without the other gets a
// picture that quietly disagrees with itself.
//
// You will need both libraries, which is a thing to ask for once:
//
//     dotnet run -- libraries --install

import 'trees'    { Elm, Oak, Birch }
import 'daylight' { ClearMorning, ClearMorningLight }

context {
    parallel pixel scanner
    angles are degrees
    info {
        title 'A Stand of Trees'
        author 'J. Stephen Kress'
        description 'Nine trees and a sky, every one of them taken by name from a library.'
        copyright true
        software __software__
    }
}

camera {
    location [21, 9.5, -31]
    look at [-2, 4.5, 2]
    field of view 46
}

background ClearMorning
light ClearMorningLight

// The ground, mottled so that a flat sheet does not give the trees away.
GroundDull = color [0.28, 0.31, 0.19]
GroundLit = color [0.36, 0.38, 0.24]

plane {
    material {
        pigment bozo {
            turbulence 0.4
            [0, GroundDull, 1, GroundLit]
            scale 3.5
        }
        specular 0.03
    }
}

// The stand.  Three kinds, nine trees, no two alike.
object Elm(11, 'summer', 1) { translate [-9, 0, 4] }
object Elm(9, 'summer', 2) { translate [-14, 0, -3] }
object Oak(10, 'summer', 3) { translate [-2, 0, -1] }
object Oak(8, 'winter', 4) { translate [4, 0, 9] }
object Birch(9, 'autumn', 5) { translate [7, 0, -2] }
object Birch(8, 'autumn', 6) { translate [10, 0, 3] }
object Birch(7, 'autumn', 7) { translate [12.5, 0, -5] }
object Elm(7, 'summer', 8) { translate [1, 0, 12] }
object Oak(6, 'summer', 9) { translate [-6, 0, 14] }
