// The Utah Teapot -- Martin Newell, 1975.
//
// Every ray tracer gets around to this eventually.  Newell needed a test object for the group at
// Utah, sketched his own teapot on graph paper over tea, and digitized the profile as Bezier
// control points -- and because it was one of the very few models anyone had, it turned up in
// everybody's papers and became the standard against which renderers are compared.  It earns that
// place: it is curved everywhere, it is concave, it has a hole through the handle, it casts shadows
// on itself, and the spout passes through the body rather than being glued to it.  A renderer that
// draws a convincing sphere may still make a mess of this.
//
// **The thirty-two bicubic patches at the bottom of this file are the classic dataset**, transcribed
// verbatim from POV-Ray's `teapot.inc` (the Newell/Blinn/Enzmann data, adapted for POV-Ray by
// Alexander Enzmann), which is licensed under Creative Commons Attribution 3.0:
// http://creativecommons.org/licenses/by/3.0/
//
// The numbers are unaltered.  Newell's data stands up in Z, so `rotate X -90` turns it rather than
// the coordinates being rewritten -- that keeps them checkable against the source, and a rotation
// costs nothing at render time.
//
// **On `flatness`, which is the whole reason this scene looks right.**  A patch is drawn by
// splitting it until each piece is flat enough to treat as two triangles, and `flatness` is how
// flat is flat enough.  At the default of 0.01 this teapot came out speckled with fifty-odd black
// pixels scattered over the body and lid.  They are not noise: neighbouring pieces stop splitting at
// different depths, so a coarse piece's straight edge and a fine piece's curved one leave a
// lens-shaped crack between them, and a ray through the crack sails on and strikes the *inside* of
// the far wall, which faces away from every light.  Hence a teapot-colored pixel lit by ambient
// alone.  At `flatness 0.0001` the pieces are fine enough that the cracks close: fifty-two stray
// pixels become three, for about a third more render time.  POV-Ray's own copy of this file carries
// a changelog entry making exactly this change, for what one presumes was exactly this reason.

context {
    parallel pixel scanner
    angles are degrees
    no gamma
    info {
        title 'The Utah Teapot'
        author 'J. Stephen Kress'
        description $'Newell\'s teapot in brass, from the classic thirty-two Bezier patches.'
        copyright true
        software __software__
    }
}

// Low and close, the way a thing on a counter is actually looked at.
camera {
    location [9.6, 4.4, -10.2]
    look at [0.1, 1.25, 0.4]
    field of view 36
}

// A window off to the left, given a real size so the shadow on the stone has a soft edge and the
// highlight along the shoulder of the pot is a broad sweep rather than a dot.  Brass with a dot of
// white on it reads as plastic.
area light {
    location [-7, 7.5, -5.5]
    axisU [4.5, 0, 0]
    axisV [0, 3.6, 0]
    steps 10
    color [1.35, 1.28, 1.15]
}

// Daylight coming back off the room, cool and dim, so the shadowed side is not simply black.
point light {
    location [11, 5.5, -3]
    color [0.13, 0.15, 0.21]
}

background [0.055, 0.058, 0.068]

// The wall behind. It earns its place by being reflected: a mirror-finish object in an empty room
// mirrors the emptiness, and brass that reflects nothing looks like painted tin.
plane {
    material {
        pigment [0.40, 0.365, 0.325]
        ambient 0.20
        diffuse 0.75
        specular 0.02
    }
    rotate X -90
    translate Z 6.5
}

// The softbox.  Product photographers do not light metal so much as light something *for the metal
// to reflect*, and this is that thing: a broad bright panel above and behind the camera.  It is not a
// light -- it is a surface with its ambient turned up, so reflection rays that find it come back
// bright while it casts no light and no shadow of its own.
//
// Where it stands took three tries, and the two failures are the useful part.  Directly behind the
// camera it reflected as a small hard-edged diamond on the belly of the pot -- a panel far away and
// square-on to a curved surface subtends almost nothing.  Off to the left it made exactly the long
// sweep down the shoulder that brass wants, and stood in the frame as a white slab.  So: off to the
// left, and far enough forward to be out of the frame, which puts it about forty degrees off the
// camera's axis where the widest thing it can be seen in is the teapot itself.
cube {
    material {
        pigment [1.0, 0.97, 0.92]
        ambient 1
        diffuse 0
        specular 0
    }
    scale [0.05, 2.9, 2.6]
    translate [-6.4, 3.5, -7.4]
}

// The counter: dark granite, honed rather than mirror-polished, so the pot's reflection in it is
// present but soft.  A slab with an edge rather than an endless plane, since the front edge is what
// says "counter".
cube {
    material {
        // The stops are close together on purpose.  A wider spread gives a handsome speckle on its
        // own and then turns up a second time in the brass, which mirrors the counter across its
        // whole lower body -- and salt-and-pepper reflected in a mirror-finish curve reads as a dirty
        // pot rather than as stone.  Granite's own output runs about 0.09 to 0.41, so those are the
        // ends worth mapping.
        pigment granite {
            [0.09, [0.098, 0.095, 0.104],
             0.20, [0.120, 0.116, 0.126],
             0.30, [0.142, 0.137, 0.142],
             0.41, [0.172, 0.166, 0.158]]
            scale 0.14
        }
        ambient 0.10
        diffuse 0.62
        specular 0.28
        shininess 110
        reflective 0.09
    }
    scale [9, 0.45, 5.5]
    translate Y -0.45
}

// ---------------------------------------------------------------------------------------------
// The dataset.  Thirty-two patches: sixteen for the body, four for the lid, four for the handle,
// four for the spout, and four underneath.  See the note at the top of this file for its source
// and license.  The four lid patches and the four bottom ones each collapse an entire row of
// control points onto a single point -- the apex and the center of the base -- which is a pole, and
// perfectly legal.
// ---------------------------------------------------------------------------------------------

primitive Teapot() -> group {
    return group {
        patch {
            points
                [1.40000, 0.00000, 2.40000], [1.40000, -0.78400, 2.40000], [0.78400, -1.40000, 2.40000], [0.00000, -1.40000, 2.40000],
                [1.33750, 0.00000, 2.53125], [1.33750, -0.74900, 2.53125], [0.74900, -1.33750, 2.53125], [0.00000, -1.33750, 2.53125],
                [1.43750, 0.00000, 2.53125], [1.43750, -0.80500, 2.53125], [0.80500, -1.43750, 2.53125], [0.00000, -1.43750, 2.53125],
