// Brass.  `metallic` is what separates a metal from a shiny dielectric: a metal tints the highlight
// with its own color, where plastic and glaze reflect the light's color whatever they are underneath.
// Without it, this comes out looking like yellow porcelain.
object Teapot() {
    material {
        pigment [0.86, 0.63, 0.26]
        ambient 0.08
        diffuse 0.30
        specular 1
        shininess 260
        reflective 0.62
        metallic 1
        brilliance 1.6
    }
    rotate Y -16
    translate [0.2, 0, 0.2]
}
