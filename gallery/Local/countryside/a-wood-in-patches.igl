// A mixed wood seen from above, the way a wood really grows: in groves of one kind among another, with
// clearings in it and scrub in the clearings.  Three patterns do all of that, each read as a map laid
// over the ground -- one cuts the clearings, one picks the kind of tree, and one sets how tall each grows.

context {
    parallel pixel scanner
    angles are degrees
    info {
        title 'A Wood in Patches'
        author 'J. Stephen Kress'
        description 'Groves of oak, birch and fir with clearings between, all from patterns laid over the ground.'
        copyright true
        software __software__
    }
}

import 'trees'       { Oak, Birch, Fir }
import 'undergrowth' { Boxwood, Bramble }
import 'daylight'    { ClearAfternoonFrom, ClearAfternoonLight }

// High over the wood and looking well down into it, so the patterns read as a map does; the horizon is
// kept out of the picture.
camera {
    location [0, 100, -95]
    look at [0, 0, 22]
    field of view 68.81
}

// From the left and well down the sky, so every crown throws its shadow across the next and the
// clearings show as light against the wood.
background ClearAfternoonFrom(260)
light ClearAfternoonLight

// -- The ground ------------------------------------------------------------------------------------

heightfield {
    function {
        22 * noise(x * 3, 0, z * 3) + 7 * noise(x * 9, 0, z * 9)
    }
    samples 400
    material {
        pigment bozo { [0, [0.27, 0.36, 0.15], 1, [0.36, 0.43, 0.19]]  scale 4 }
        specular 0.03  shininess 8
    }
    translate [-0.5, 0, -0.5]
    scale [600, 1, 600]
    named 'land'
}

// -- The wood ---------------------------------------------------------------------------------------

// What the camera sees of the ground and a margin round it: narrow near the camera, wide far off.
// Worked out from the camera rather than by eye, since a wood ending in a straight line is the one thing
// a wood never does.
Country = path { move to -80, -75  line to 80, -75  line to 260, 300  line to -260, 300  close }

// Three patterns, each its own -- one shared would put every clearing at the edge of the same kind of
// tree.
//
// `picked by` sets the groves: oak where the pattern is lowest, birch in the middle and fir where it is
// highest, a third each, since the weights say so whatever the pattern's own values do.  Where two
// groves meet they mingle a little.
//
// `patches ... from 0.38 to 0.41` cuts the clearings: nothing stands where the pattern is below 0.38,
// the wood is whole above 0.41, and it thins over a few trees between.
//
// `sized ... by` sets how tall each grows, in stands of taller and shorter trees rather than tree by tree.
field {
    of Oak(9, 'summer', 1), Oak(8, 'summer', 2), Birch(9, 'summer', 3), Birch(8, 'summer', 4),
       Fir(10, 'summer', 5), Fir(9, 'summer', 6)
    picked by bozo { scale 55  translate [17, 0, 4] }
    within Country
    spacing 7  jitter 0.9  turned 360
    patches bozo { scale 45 } from 0.38 to 0.41
    sized 0.75 to 1.3 by bozo { scale 30  translate [-9, 0, 23] }
    over 'land'
    sink 0.3
}

// Scrub in the clearings and nowhere else: the clearings' own pattern with its edge turned about, so it
// grows as thickly as the wood thins.  (On a grid of its own it fills the clearings by chance, not place
// for place; given the wood's own spacing it would take exactly the places the wood leaves.)
field {
    of Boxwood(1.6, 'summer', 1), Bramble(1.4, 'summer', 2)
    within Country
    spacing 9  jitter 0.95  turned 360  sized 0.7 to 1.4
    patches bozo { scale 45 } from 0.41 to 0.38
    over 'land'
}
