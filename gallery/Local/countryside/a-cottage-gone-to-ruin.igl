// A cottage left to fall, and everything about it broken.
//
// Nothing here is modeled stone by stone.  Every wall is a solid broken into pieces by a `fracture`:
// seeds scattered through it, and each stone the part of it nearer its own seed than any other -- a
// Voronoi cell, which is a convex polyhedron, solved exactly.  So the stones fit as laid stone does,
// worn round at their edges and set a shade off true, each in a stone of four and a grain of its own.
//
//     import 'rocks'   { DryStoneWall, Rubble }
//     import 'roads'   { CrazyPaving }
//     import 'windows' { Sash, Casement }
//
// **The cottage's walls** are written here, broken stretched along their length so their stones lie in
// rough courses, with mortar showing in the joints.  The gables are the side walls' tops cut by the
// planes the roof lies in: boxes cut by boxes, so still broken exactly.
//
// **The yard wall** is the rocks library's dry stone wall, battered and coped, and where its middle has
// come down there is its `Rubble`: a heap broken *whole*, never cut by the mound it fills, so its
// outline is whole stones lying where they fell.
//
// **The windows** are the windows library's, asked for broken -- five panes of the sash's twelve, one
// of the casement's three -- each pane struck at a point and shattered round a hole into the dark of
// the room, in rings and spokes as glass breaks.
//
// **The roof** has fallen in.  Its near slope is a slab of slate broken round where it gave way, the
// pieces about the hole knocked askew, and the boards under the far slope showing through it.
//
// **The path** to the door is the roads library's crazy paving: a slab broken flat, every joint running
// straight down to the mortar.

import 'rocks'    { DryStoneWall, Rubble, RockWallGray, RockWallBuff, RockWallBlue, RockWallBrown }
import 'roads'    { CrazyPaving }
import 'windows'  { Sash, Casement }
import 'undergrowth' { Grass }
import 'daylight' { LateAfternoonFrom, LateAfternoonLight }

context {
    parallel pixel scanner
    angles are degrees
    info {
        title 'A Cottage Gone to Ruin'
        author 'J. Stephen Kress'
        description 'A stone cottage left to fall: walls, roof, windows, a yard wall and a path, every one of them broken.'
        copyright true
        software __software__
    }
}

camera {
    location [2.4, 1.6, -7.0]
    look at [-2.0, 1.45, 3.0]
    field of view 56
}

background LateAfternoonFrom(-40)
light LateAfternoonLight

plane {
    material {
        pigment bozo { turbulence 0.4  [0, color [0.20, 0.22, 0.13], 1, color [0.28, 0.29, 0.18]]  scale 2.5 }
        specular 0.02
    }
}

LeftOfThePath = path { move to -14, -9  line to -1.35, -9  line to -1.35, 2.5  line to -14, 2.5  close }
RightOfThePath = path { move to 0.15, -9  line to 9, -9  line to 9, 3.5  line to 0.15, 3.5  close }
object Grass(LeftOfThePath, 'summer', 1, 0.22)
object Grass(RightOfThePath, 'summer', 2, 0.22)

Mortar = material { pigment [0.42, 0.40, 0.36]  specular 0  ambient 0.04 }
Slate = material { pigment [0.13, 0.14, 0.16]  specular 0.12  shininess 30 }
Timber = material { pigment [0.34, 0.26, 0.18]  specular 0.04 }
Dark = material { pigment [0.01, 0.01, 0.01]  specular 0  ambient 0 }

// The front of the cottage: a wall with a door cut through it, which makes it no longer a box -- so
// its stones are each cut from it, rather than bounded by its own six planes.
Front = difference {
    cube { scale [3, 1.3, 0.25]  translate [0, 1.3, 0] }
    cube { scale [0.48, 1.0, 0.4]  translate [-0.6, 0.95, 0] }
}

group {
    // The front, with its door.
    fracture {
        solid Front
        pieces 520  gap 0.014  rounded 0.02  stretched [2, 1, 1.2]  tumble 2  loose
        materials RockWallGray, RockWallBuff, RockWallBlue, RockWallBrown
        with seed 11
    }
    difference {
        cube { scale [2.96, 1.28, 0.17]  translate [0, 1.3, 0] }
        cube { scale [0.48, 1.0, 0.4]  translate [-0.6, 0.95, 0] }
        material Mortar
    }
    // The dark of the room, through the door.
    cube { material Dark  scale [0.47, 0.95, 0.02]  translate [-0.6, 0.95, 0.24] }

    object Sash(0.36, 0.48, 0.25, 'summer', 4, 5) { translate [1.7, 1.45, -0.25] }
    object Casement(0.32, 0.30, 0.25, 'summer', 2, 1) { translate [-2.1, 1.6, -0.25] }

    // The side and back walls, and the gable over the front.
    fracture {
        solid { cube { scale [0.25, 1.3, 2.0]  translate [-2.75, 1.3, 2.25] } }
        pieces 380  gap 0.014  rounded 0.02  stretched [1.2, 1, 2]  tumble 2  loose
        materials RockWallGray, RockWallBuff, RockWallBlue, RockWallBrown
        with seed 12
    }
    fracture {
        solid { cube { scale [0.25, 1.3, 2.0]  translate [2.75, 1.3, 2.25] } }
        pieces 380  gap 0.014  rounded 0.02  stretched [1.2, 1, 2]  tumble 2  loose
        materials RockWallGray, RockWallBuff, RockWallBlue, RockWallBrown
        with seed 13
    }
    fracture {
        solid { cube { scale [3, 1.3, 0.25]  translate [0, 1.3, 4.5] } }
        pieces 450  gap 0.014  rounded 0.02  stretched [2, 1, 1.2]  tumble 2  loose
        materials RockWallGray, RockWallBuff, RockWallBlue, RockWallBrown
        with seed 14
    }
    cube { material Mortar  scale [0.17, 1.28, 2.2]  translate [-2.75, 1.3, 2.25] }
    cube { material Mortar  scale [0.17, 1.28, 2.2]  translate [2.75, 1.3, 2.25] }
    cube { material Mortar  scale [2.96, 1.28, 0.17]  translate [0, 1.3, 4.5] }

    // The gables, on the side walls, under the roof's two slopes: each the wall's top cut by the planes
    // the slopes lie in -- a box cut by boxes, so broken exactly.
    for side in [0, 1] {
        fracture {
            solid {
                intersection {
                    cube { scale [0.25, 1.05, 2.0]  translate [side * 5.5 - 2.75, 3.65, 2.25] }
                    cube { scale [4, 3, 10]  rotate X -38  translate [0, -0.934, 0] }
                    cube { scale [4, 3, 10]  rotate X 38  translate [0, 2.582, 0] }
                }
            }
            pieces 160  gap 0.014  rounded 0.02  stretched [1.2, 1, 2]  tumble 2  loose
            materials RockWallGray, RockWallBuff, RockWallBlue, RockWallBrown
            with seed 15 + side
        }
    }

    // The roof: slate over boarding.  The far slope is whole; the near one has fallen in, broken round
    // where it gave way, its slates hanging askew at the edge of the hole and the boards under the far
    // slope showing through it, lit by what comes in.
    cube { material Slate  scale [3.15, 0.03, 1.65]  rotate X 38  translate [0, 3.66, 3.55] }
    cube { material Timber  scale [3.1, 0.012, 1.6]  rotate X 38  translate [0, 3.6, 3.57] }
    fracture {
        solid { cube { scale [3.15, 0.03, 1.65]  rotate X -38  translate [0, 3.66, 0.95] } }
        pieces 80
        gap 0.012
        toward [0.9, 3.75, 1.1]
        hole 1.1
        tumble 5
        with seed 21
        material Slate
    }
    fracture {
        solid { cube { scale [3.1, 0.012, 1.6]  rotate X -38  translate [0, 3.6, 0.97] } }
        pieces 40
        gap 0.01
        toward [0.9, 3.68, 1.12]
        hole 1.25
        tumble 4
        with seed 22
        material Timber
    }
    for rafter in [0, 3] {
        cube { material Timber  scale [0.05, 0.07, 1.65]  rotate X -38  translate [rafter * 0.6 - 0.1, 3.53, 1.0] }
    }
    translate [0, 0, 4]
}

// The yard wall, running off along the line of the cottage's front, fallen in its middle.
object DryStoneWall(3, 1.15, 'summer', 3) { translate [-4.9, 0, 3.0] }
object Rubble(1.8, 'summer', 5) { rotate Y 10  translate [-7.15, 0, 3.0] }
object DryStoneWall(3.6, 1.15, 'summer', 4) { translate [-9.7, 0, 3.0] }

// The path to the door.
object CrazyPaving(7.4, 1.1, 'summer', 2) { rotate Y 90  translate [-0.6, 0, 0.0] }
