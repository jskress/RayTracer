// A car on a winter morning after fresh snow, brushed clear, the low sun beyond it catching the flakes in its
// paint and the ice grains in the snow.
//
// **Both sparkles are glints**: facets counted under each pixel rather than averaged.  The car's metallic paint
// is a rough metallic mirror under a clear coat whose flakes, a few hundredths of a millimeter across, glint;
// the snow is white and matte, with grains of ice of its own a millimeter across that glint.  Near, a few
// pixels of either blaze and the rest are dark; far off, every pixel holds so many that the count is its mean,
// and the sparkle settles into the smooth sheen it averages to.  The `vehicles` library's metallic paints and
// all the libraries' snow carry them.
//
// **Snow glitters most looking toward a low sun**, where its grains need lean only a little to send the sun on to
// the eye; with the sun behind the eye they must lean far, and few do.  So the sun is beyond the car, and the
// wall and the firs stand aside from it: at sixteen degrees their shadows run three and a half times their height.
context {
    parallel pixel scanner
    angles are degrees
    antialiasing depth 1
    antialiasing threshold 0.25
    info {
        title 'A Car on a Winter Morning'
        author 'J. Stephen Kress'
        description 'A metallic car after fresh snow in a low winter sun, the flakes in its paint and the grains of the snow glinting.'
        copyright true
        software __software__
    }
}

import 'vehicles' { Car }
import 'trees' { Fir, Birch }
import 'rocks' { DryStoneWall }

camera { location [7.2, 1.3, -4.4]  look at [0.3, 0.7, 0.6]  field of view 46  exposure 0.8 }

background physical sky { sun elevation 16  sun azimuth 200  turbidity 2.5  brightness 3 }
sky light { samples 24 }

// Fresh snow, drifted a little: white and matte, its ice grains a millimeter across glinting as the libraries'
// snow does.
Snow = material {
    pigment [0.93, 0.94, 0.97]
    normal bozo with seed 3 { depth 0.25  scale [2.5, 1, 1.6] }
    specular 0
    glints { size 0.0008  roughness 0.7 }
}

plane { material Snow }

object Car(4.4, 'summer', 1) { translate [0.3, 0, 0] }

// The lane's wall, and trees beyond it, standing aside from the sun.
object DryStoneWall(16, 1.2, 'winter', 3) { translate [-1, 0, 6] }

object Fir(9, 'winter', 1) { translate [-14, 0, 9] }
object Fir(11, 'winter', 2) { translate [6.5, 0, 10] }
object Fir(8, 'winter', 3) { translate [10, 0, 14] }
object Birch(10, 'winter', 2) { translate [-12, 0, 5] }
