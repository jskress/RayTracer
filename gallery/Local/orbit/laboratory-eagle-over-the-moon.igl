// A laboratory Eagle, low over the Moon: the science pod, its airlocks standing out to either side.
//
//     dotnet run -- -i laboratory-eagle-over-the-moon.igl -o laboratory-eagle-over-the-moon.png -w 800 -h 600
//
// The flight itself is eagle-over-the-moon-setup.igl, shared by an Eagle carrying each of the five pods and one
// carrying none; it tells how the ground is made, and names the two pictures it needs that are not in the repository.

sceneTitle = 'Laboratory Eagle over the Moon'
sceneDescription = 'A laboratory Eagle flying low over a cratered plain, the Earth over the mountains beyond.'
pod = 'laboratory'

include 'eagle-over-the-moon-setup.igl'
