// The Eagle, low over the Moon: a transporter skimming a cratered plain, the Earth over the mountains on the
// horizon and the stars out in the black.
//
//     dotnet run -- -i eagle-over-the-moon.igl -o eagle-over-the-moon.png -w 800 -h 600
//
// **It needs two pictures that are not in the repository**, both kept beside the solar system's: the Earth's,
// earth-satellite.png, from https://www.solarsystemscope.com/textures/ as the inner planets take it, and Plato's
// far height map, plato-far.png, made as gallery/Local/animation/an-eagle-lands.igl tells.
//
// The ground is made here: two height fields from one function of craters, a fine one under the camera and a
// coarse one out to the horizon, the coarse one sunk where the fine one lies.  Beyond them, the rim of Plato from
// the landing scene's far map.

context {
    angles are degrees
    scale ambient by 0.35
    antialiasing depth 1
    antialiasing threshold 0.5
    info {
        title 'Eagle over the Moon'
        author 'J. Stephen Kress'
        description 'An Eagle transporter flying low over a cratered plain, the Earth over the mountains beyond.'
        copyright true
        software __software__
    }
}

import 'eagle' { Eagle }

camera {
    location [0, 23.9, 0]
    look at [0.8807, 16.4369, -99.7172]
    field of view 23.5
}

// -- The sky ------------------------------------------------------------------------------------------

// Stars: a granite pattern whose map shows only its highest values.
background granite {
    [0, Black, 0.548, Black, 0.57, [0.30, 0.32, 0.40], 0.61, White, 1, White]
    scale 0.025
}

// The sun, low behind the camera and to its left; and earthshine, faint and blue, from the Earth's way.
distant light { direction [0.4066, -0.2756, -0.871]  color [1.08, 1.06, 1.02] }
point light { location [4.8108e+07, 2.0788e+07, -3.8081e+08]  color [0.05, 0.06, 0.09] }

// The Earth, clouds and all, where it would be at its true size: a little under two degrees across.  It casts no
// shadow, since at that distance there is nothing it could fall on.
sphere {
    material {
        // Clouds over the land and sea: swirled wisps whose map goes clear between them, laid over the picture.
        pigment layer {
            bozo {
                turbulence { amplitude 1.7  octaves 7 }
                [0, color [1, 1, 1, 0], 0.5, color [1, 1, 1, 0], 0.6, color [1, 1, 1, 0.4],
                 0.74, color [0.98, 0.98, 1, 0.9], 1, color [1, 1, 1, 1]]
                scale [0.24, 0.1, 0.24]
            },
            image '../solar-system/images/earth-satellite.png'
        }
        specular 0.1  ambient 0
    }
    no shadow
    rotate Y 90.0
    rotate Z -23.4
    scale 6371000
    translate [4.8108e+07, 2.0788e+07, -3.8081e+08]
}

// -- The ground ---------------------------------------------------------------------------------------

// A crater `r` across its rim's middle at (cx, cz): a bowl `d` deep below the plain, a rim `h` above it, and the
// ejecta falling away outside.
function Crater(px, pz, cx, cz, r, d, h) -> number {
    return h * exp(-2.5 * max(0, sqrt((px - cx) * (px - cx) + (pz - cz) * (pz - cz)) / r - 1))
           - (d + h) * max(0, 1 - ((px - cx) * (px - cx) + (pz - cz) * (pz - cz)) / (r * r))
}

// The plain: a slow swell, and the Moon's curvature taken off it, so the horizon is where it is.
function Plain(px, pz) -> number {
    return 7 * (noise(px / 520 + 3.1, 0, pz / 520 + 7.7) - 0.5)
           + 2.2 * (noise(px / 130 + 11.3, 0, pz / 130 + 1.9) - 0.5)
           - (px * px + pz * pz) / 3474800
}

// The big craters, out to the horizon.
function BigCraters(px, pz) -> number {
    return Crater(px, pz, 150, -950, 220, 50, 14)
           + Crater(px, pz, -420, -2300, 520, 95, 30)
           + Crater(px, pz, 900, -5200, 1100, 170, 60)
           + Crater(px, pz, -2213, -1.33e+04, 122.2, 30.44, 7.17)
           + Crater(px, pz, -325.3, -930.9, 358.3, 84.91, 21.27)
           + Crater(px, pz, -690.6, -1.431e+04, 152, 21.37, 7.36)
           + Crater(px, pz, -347.4, -4718, 100.7, 24.35, 6.643)
           + Crater(px, pz, 168.6, -1.408e+04, 40.48, 8.127, 1.946)
           + Crater(px, pz, -729.3, -7362, 472, 67.54, 19.6)
           + Crater(px, pz, -53.54, -3923, 237.7, 32.41, 14.66)
