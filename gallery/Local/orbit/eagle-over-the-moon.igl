           + 0.5 * (noise(px / 11 + 5, 0, pz / 11 + 9) - 0.5)
           + 0.18 * (noise(px / 3.3 + 2, 0, pz / 3.3 + 4) - 0.5)
}

// How far inside the near field a place is, in meters (negative outside it).
function InsideNear(px, pz) -> number {
    return min(min(px + 360, 360 - px), min(pz + 1500, -40 - pz))
}

// The regolith, fine-grained and lighter and darker over tens of meters, read in meters in a field scaled by
// `sx` across and `sz` along.
primitive Regolith(sx, sz) -> material {
    return material {
        pigment bozo {
            turbulence 0.4
            [0, granite { [0, [0.25, 0.25, 0.245], 1, [0.36, 0.355, 0.345]]  scale [6 / sx, 6, 6 / sz] },
             1, granite { [0, [0.37, 0.365, 0.355], 1, [0.47, 0.465, 0.45]]  scale [6 / sx, 6, 6 / sz] }]
            scale [45 / sx, 45, 45 / sz]
        }
        specular 0
    }
}

// Near: 720 m across, from 40 m in front of the camera to 1.5 km, a point every 0.56 m across and 1.14 along.
heightfield {
    function {
        Plain(720 * x - 360, 1460 * z - 1500) + BigCraters(720 * x - 360, 1460 * z - 1500)
            + clamp(InsideNear(720 * x - 360, 1460 * z - 1500) / 30, 0, 1)
              * SmallCraters(720 * x - 360, 1460 * z - 1500)
    }
    samples 1280
    open  smooth
    named 'near'
    material Regolith(720, 1460)
    scale [720, 1, 1460]
    translate [-360, 0, -1500]
}

// Far: 8 km across, out to 15 km, sunk six meters where the near field lies.
heightfield {
    function {
        Plain(8000 * x - 4000, 14970 * z - 15000) + BigCraters(8000 * x - 4000, 14970 * z - 15000)
            - 6 * clamp(InsideNear(8000 * x - 4000, 14970 * z - 15000) / 20, 0, 1)
    }
    samples 1024
    open  smooth
    material Regolith(8000, 14970)
    scale [8000, 1, 14970]
    translate [-4000, 0, -15000]
}

// Plato's rim, fifty kilometers off all round, from the landing scene's far map.
heightfield {
    image '../solar-system/images/plato-far.png'
    open  smooth
    material {
        pigment bozo {
            turbulence 0.4
            [0, [0.30, 0.30, 0.295], 1, [0.42, 0.415, 0.40]]
            scale 0.0003
        }
        specular 0
    }
    translate [-0.5, 0, -0.5]
    scale [150000, 24571.64, 150000]
    translate Y -3721.36
}

// -- Rocks --------------------------------------------------------------------------------------------

// A rock a meter across: a ball cut by two boxes tipped every which way, flattened, and a third of it buried, as
// the rocks thrown out of a crater lie.
MoonStone = material {
    pigment granite { [0, [0.24, 0.24, 0.235], 1, [0.40, 0.395, 0.385]]  scale 0.15 }
    specular 0.02
}

primitive MoonRock(variant) -> group {
    flat = 0.45 + random(variant, 21) * 0.35
    return group {
        intersection {
            sphere { }
            cube {
                scale 0.85  rotate X (random(variant, 22) - 0.5) * 80  rotate Y random(variant, 23) * 360
                translate [(random(variant, 24) - 0.5) * 0.45, 0, (random(variant, 25) - 0.5) * 0.45]
            }
            cube {
                scale 0.8  rotate Z (random(variant, 26) - 0.5) * 80  rotate Y random(variant, 27) * 360
                translate [0, (random(variant, 28) - 0.5) * 0.45, (random(variant, 29) - 0.5) * 0.45]
            }
            material MoonStone
            scale [0.5, 0.5 * flat, 0.5 * (0.8 + random(variant, 30) * 0.35)]
            translate Y 0.5 * flat * 0.35
        }
    }
}

// The ground the camera sees in front of the Eagle and under it.
Strewn = path { move to -24, -90  line to 24, -90  line to 74, -320  line to -74, -320  close }

// Pebbles thickly, and rocks a meter or so across here and there, each dropped onto the ground and laid along it.
field {
    of MoonRock(1), MoonRock(2), MoonRock(3), MoonRock(4), MoonRock(5), MoonRock(6), MoonRock(7), MoonRock(8)
    within Strewn
    spacing 1.6  jitter 0.9
    turned 360  sized 0.1 to 0.4
    over 'near'  tilted
}
field {
    of MoonRock(11), MoonRock(12), MoonRock(13), MoonRock(14), MoonRock(15), MoonRock(16)
    within Strewn
    spacing 9  jitter 0.9
    turned 360  sized 0.5 to 1.6
    over 'near'  tilted
}

// -- The Eagle ----------------------------------------------------------------------------------------

// In flight, its legs hanging free, nose a touch down and rolled a little toward the camera.
object Eagle(30.48, 'transporter', 1) {
    rotate Z -2  rotate X 3  rotate Y -35
    translate [0, 15, -69.7]
}
