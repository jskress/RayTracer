// The Eagle, low over the Moon: a transporter, its passenger module slung under its spine.
//
//     dotnet run -- -i eagle-over-the-moon.igl -o eagle-over-the-moon.png -w 800 -h 600
//
// The flight itself is eagle-over-the-moon-setup.igl, shared by an Eagle carrying each of the five pods and one
// carrying none; it tells how the ground is made, and names the two pictures it needs that are not in the repository.

sceneTitle = 'Eagle over the Moon'
sceneDescription = 'An Eagle transporter flying low over a cratered plain, the Earth over the mountains beyond.'
pod = 'transporter'

include 'eagle-over-the-moon-setup.igl'
