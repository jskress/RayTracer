           + Crater(px, pz, -807, -2852, 65.45, 14.47, 2.821)
           + Crater(px, pz, 96.6, -1753, 73.72, 11.54, 4.161)
           + Crater(px, pz, 1185, -1.49e+04, 1059, 170.5, 66.26)
