           + Crater(px, pz, -759.1, -4622, 443.6, 100.5, 22.5)
           + Crater(px, pz, -213.2, -1.447e+04, 1040, 246.6, 55.79)
           + Crater(px, pz, -1295, -7674, 963.3, 188.6, 38.94)
           + Crater(px, pz, -1305, -8138, 64.26, 11.36, 4.199)
