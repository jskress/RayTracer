// Eighty-four soldiers in a hollow square, and the scene never says where one of them stands.
//
// What places them is a `field`: an outline, a spacing, and the name of the thing to fill it with.
// Every position in this picture comes out of those three lines and nothing else -- there is no loop
// here, and no arithmetic on a rank and a file.
//
// **The outline is the part worth looking at.**  A grid of soldiers in a plain square is something a
// pair of nested loops does in three lines, and if that were all a field did it would not be worth
// having.  What a loop cannot do cheaply is stop at a shape.  This regiment is drawn up in an infantry
// square, which is hollow because what it is guarding stands inside it, and the hollow is simply a
// second subpath: a point inside two rings is outside the shape.  A loop would have needed a
// containment test written and got right by hand, which is exactly the code the two grass patches in
// `undergrowth` used to be.
//
// **The jitter is the other half.**  Grass wants most of a cell of it, because a lattice is the one
// thing that gives an area of grass away; a regiment wants none at all, because the lattice *is* the
// subject.  The same clause serves both, and the difference between a parade and a meadow is one
// number.
//
// **And the copies.**  The eighty-four in the square are all the same man, so they are eighty-four
// wrappers around one soldier built once -- measured at 0.147s against 0.192s for the same picture
// with each built for its place, and that gap widens with anything more expensive than seventeen
// turned pieces.  The handful still coming up are the opposite: `index in n` hands each its number, so
// each is built with its own height and its own facing.  One primitive, two fields, and the choice
// between them is a single word.
//
// The officer inside the square is placed by hand, because there is one of him, and he is the same
// primitive in a different coat -- a material being a thing a primitive can be handed, like a number
// or an outline.  A field is for the many; the exception is still worth writing out.

context {
    parallel pixel scanner
    angles are degrees
    info {
        title 'The Hollow Square'
        author 'J. Stephen Kress'
        description 'A regiment drawn up in a hollow square, placed by an outline and a spacing.'
        copyright true
        software __software__
    }
}

ToyRed   = material { pigment [0.62, 0.11, 0.10]  specular 0.30  shininess 40 }
ToyBlue  = material { pigment [0.13, 0.17, 0.38]  specular 0.24  shininess 34 }
ToyBlack = material { pigment [0.09, 0.09, 0.11]  specular 0.36  shininess 60 }
ToyGold  = material { pigment [0.72, 0.58, 0.18]  specular 0.60  shininess 120 }
ToySkin  = material { pigment [0.82, 0.63, 0.50]  specular 0.16  shininess 26 }
ToyDress = material { pigment [0.16, 0.13, 0.30]  specular 0.42  shininess 80 }

// One soldier, authored a unit tall from his boots to the top of his plume and scaled where he is
// used.  Cylinders and spheres, because a toy soldier is a turned thing.
//
// The coat is a parameter like any other, and a material may be handed to a primitive the same way a
// number can.  That is what lets one primitive serve both the ranks and the officer standing in the
// middle of them: nothing about him differs except what he is wearing.
primitive Soldier(height = 1, turn = 0, coat = ToyRed) -> group {
    return group {
        cylinder { min Y 0  max Y 1  scale [0.075, 0.055, 0.075]  translate [-0.072, 0, 0]  material ToyBlack }
        cylinder { min Y 0  max Y 1  scale [0.075, 0.055, 0.075]  translate [ 0.072, 0, 0]  material ToyBlack }

        cylinder { min Y 0  max Y 1  scale [0.062, 0.38, 0.062]  translate [-0.072, 0.05, 0]  material ToyBlue }
        cylinder { min Y 0  max Y 1  scale [0.062, 0.38, 0.062]  translate [ 0.072, 0.05, 0]  material ToyBlue }

        cylinder { min Y 0  max Y 1  scale [0.145, 0.30, 0.145]  translate [0, 0.41, 0]  material coat }
        cylinder { min Y 0  max Y 1  scale [0.153, 0.045, 0.153]  translate [0, 0.43, 0]  material ToyBlack }

        cylinder { min Y 0  max Y 1  scale [0.042, 0.26, 0.042]  translate [-0.174, 0.44, 0]  material coat }
        cylinder { min Y 0  max Y 1  scale [0.042, 0.26, 0.042]  translate [ 0.174, 0.44, 0]  material coat }
        sphere { scale 0.046  translate [-0.174, 0.44, 0]  material ToySkin }
        sphere { scale 0.046  translate [ 0.174, 0.44, 0]  material ToySkin }

        sphere { scale 0.028  translate [0, 0.52, -0.140]  material ToyGold }
        sphere { scale 0.028  translate [0, 0.60, -0.136]  material ToyGold }
        sphere { scale 0.028  translate [0, 0.68, -0.128]  material ToyGold }

        sphere { scale 0.078  translate [0, 0.755, 0]  material ToySkin }

        cylinder { min Y 0  max Y 1  scale [0.104, 0.025, 0.104]  translate [0, 0.812, 0]  material ToyBlack }
        cylinder { min Y 0  max Y 1  scale [0.086, 0.155, 0.086]  translate [0, 0.818, 0]  material ToyBlack }
        sphere { scale 0.052  translate [0, 0.988, 0]  material ToyGold }

        rotate Y turn
        scale height
    }
}

camera { location [10.5, 11.5, -16]  look at [1.2, 0.6, -1.5]  field of view 50 }
point light { location [-14, 18, -16]  color [1.0, 0.97, 0.90] }
point light { location [16, 9, 6]  color [0.26, 0.29, 0.36] }

// The parade ground, worn where a regiment has been standing on it.
plane {
    material {
        pigment granite with seed 11 {
            [0.10, color [0.38, 0.36, 0.31],
             0.30, color [0.44, 0.42, 0.36],
             0.55, color [0.49, 0.47, 0.41]]
            scale 2.4
        }
        ambient 0.20  specular 0.03
    }
}

// The regiment.  An outline, a spacing, and nothing else says where a man stands.
//
// **The hole is the formation.**  An infantry square is hollow because what it is guarding stands
// inside it, and a patch that could only be a rectangle could not have said so -- leaving the middle
// out would have meant a loop with a containment test written by hand.  Here it is a second subpath,
// and a point inside two rings is outside the shape.
//
Parade = path {
    move to -7, -7
    line to 7, -7
    line to 7, 7
    line to -7, 7
    close

    move to -2.8, -2.8
    line to 2.8, -2.8
    line to 2.8, 2.8
    line to -2.8, 2.8
    close
}

field {
    of Soldier(0.95)
    within Parade
    spacing 1.4
}

// What the square is hollow for.  He is placed by hand, because there is one of him and he is the
// exception the formation is drawn around -- a field is for the many, not for the one.
object Soldier(1.25, 14, ToyDress) { translate [0, 0, -0.4] }

// And the ones still coming up, which is the same primitive and the opposite of the same clause.
//
// `index in n` gives each copy its number, so each of these is built for its place rather than being
// an instance of one shape: a different height, facing a different way.
LateArrivals = path {
    move to -0.8, -8.8
    quad 0.2, -10.8 to 2.2, -10.6
    quad 4.4, -10.4 to 4.8, -8.7
    quad 5.0, -7.7 to 2.0, -7.6
    quad -0.5, -7.6 to -0.8, -8.8
    close
}

field {
    of Soldier(0.80 + random(n, 1) * 0.28, random(n, 2) * 360)
    within LateArrivals
    spacing 1.7
    jitter 0.85
    index in n
}
