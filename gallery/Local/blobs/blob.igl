// A scene to test blob objects.

context {
    parallel pixel scanner
    angles are degrees
    info {
        title 'Blob Test'
        author 'J. Stephen Kress'
        description 'A scene to test the blob primitive.'
        copyright true
        software __software__
    }
}

camera {
    location [0, 3.2, -7]
    look at [0, 1.3, 0]
    field of view 40
}

point light {
    location [-6, 8, -6]
}

// Floor
plane {
    material {
        pigment checker { White, [0.2, 0.2, 0.25] scale 2 }
    }
}

// A little "molecule": three sphere components at the corners of a triangle, joined by three
// cylinder components (the "bonds").
//
// The bonds carry a strength of 1.825 where the balls carry 1, and the odd-looking number is the
// bonds being put back the width they used to be.  A component's field falls off as the *cube* of
// its bracket, which reaches less far than the square it was once written as, so the same
// `radius 0.45  strength 1` came out at 0.259 across where it had been 0.303.  Solving
// `strength = threshold / (1 - (d/radius)^2)^3` for the width it had gives 1.8257.
//
// Nothing about the joints depends on this.  They are smooth because of the cubed falloff, which
// brings a component's value, slope *and* curvature to nothing together at its influence radius --
// see the note on blobs in docs/surfaces.md.  This number is only about how thick a bond looks.
blob {
    threshold 0.3
    sphere {
        center [-1.6, 0, -0.9]
        radius 1.1
        strength 1
    }
    sphere {
        center [1.6, 0, -0.9]
        radius 1.1
        strength 1
    }
    sphere {
        center [0, 0, 1.8]
        radius 1.1
        strength 1
    }
    cylinder {
        from [-1.6, 0, -0.9]
        to [1.6, 0, -0.9]
        radius 0.45
        strength 1.825
    }
    cylinder {
        from [1.6, 0, -0.9]
        to [0, 0, 1.8]
        radius 0.45
        strength 1.825
    }
    cylinder {
        from [0, 0, 1.8]
        to [-1.6, 0, -0.9]
        radius 0.45
        strength 1.825
    }
    material {
        pigment [0.85, 0.35, 0.25]
        diffuse 0.7
        specular 0.5
        shininess 100
        reflective 0.1
    }
    translate [0, 1.3, 0]
}
