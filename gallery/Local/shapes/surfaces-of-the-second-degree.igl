// The other three named quadrics, each doing the job its shape is actually used for.
//
// `saddle` -- a hyperbolic paraboloid -- is the roof.  This is the doubly-curved shell that reads as
// modern the moment it appears, and the reason it gets built is in the surface itself: it is ruled
// twice over, so the whole double curve can be made from straight members.  Nothing here bends.
//
// **Its four corners are all at the same height**, which is the thing about this shape that catches
// people out: `y = x² - z²` is nought wherever `x` and `z` are equal in size, so the posts are four
// of a kind.  What rises and falls is the middle of each edge -- two sides arch up, the other two
// dip -- and the roof is level exactly where it is held.
//
// `hyperboloid` is the stools.  A waisted surface of revolution is what a stool, a wastepaper basket
// and a cooling tower all are, and like the roof it is ruled by straight lines -- which is why real
// concrete ones are built from straight reinforcing bars.
//
// `quadric` is the sculpture on the plinth: `x² + z² - y² = -1`, the two-sheet hyperboloid, a pair
// of opposed bowls.  It is the case the named forms deliberately leave out, and the reason the
// general form is worth having at all.
//
// None of the three is given a shape number.  Each is the unit form of its family -- `y = x² - z²`,
// `x² + z² - y² = 1` -- and every proportion in the picture comes from a scale.
context { angles are degrees  no gamma }

camera {
    location [10.5, 5.4, -15.0]
    look at [0, 1.9, 0]
    field of view 40
}

point light { location [-7, 11, -9]  color [1, 0.97, 0.90] }
point light { location [4, 8, -12]   color [0.35, 0.36, 0.40] }
point light { location [9, 5, -4]    color [0.24, 0.28, 0.36] }

background linear Y bouncing gradient {
    [0, [0.42, 0.55, 0.72], 0.6, [0.68, 0.78, 0.88], 1, [0.82, 0.87, 0.92]]
}

plane {
    material {
        pigment checker {
            [0.60, 0.58, 0.55], [0.70, 0.68, 0.64]
            scale 1.5
        }
        specular 0.05
    }
}

// -- The shelter ---------------------------------------------------------------------------------

Concrete = material { pigment [0.80, 0.78, 0.73]  specular 0.12  shininess 30  ambient 0.16 }

group {
    saddle {
        width 7  depth 7
        material Concrete
        scale [1, 0.105, 1]
        translate Y 3.0
    }

    // A post under each corner.  The corner heights differ -- the roof rises along X and falls along
    // Z -- so each post is cut to its own corner rather than all four being the same.
    for corner in [0, 3] {
        cornerX = (mod(corner, 2) * 2 - 1) * 3.5
        cornerZ = (floor(corner / 2) * 2 - 1) * 3.5
        // Worked out from the shell rather than assumed, even though `x² - z²` comes to nought at
        // every corner: written this way the posts follow the roof if either is ever changed.
        cornerY = 3.0 + 0.105 * (cornerX * cornerX - cornerZ * cornerZ)

        cylinder {
            material Concrete
            min Y 0  max Y 1
            scale [0.12, cornerY * 0.5, 0.12]
            translate [cornerX, cornerY * 0.5, cornerZ]
        }
    }
}

// -- The stools ----------------------------------------------------------------------------------

for stool in [0, 2] {
    hyperboloid {
        material { pigment [0.46, 0.48, 0.52]  specular 0.25  shininess 60  ambient 0.14 }
        min Y -1  max Y 1
        scale [0.34, 0.30, 0.34]
        translate [stool * 1.5 - 1.5, 0.30, 1.6]
    }
}

// -- The sculpture -------------------------------------------------------------------------------

cube {
    material { pigment [0.66, 0.64, 0.60]  specular 0.1 }
    scale [0.85, 0.30, 0.85]
    translate [2.6, 0.30, -5.6]
}
// A stem to lift the sculpture off its plinth.  The two sheets are turned on their side, which is
// how both of them come to be lit: stood upright, the upper bowl shows the renderer nothing but its
// underside and goes black against the shadow.
cylinder {
    material { pigment [0.66, 0.64, 0.60] }
    min Y 0  max Y 1
    scale [0.06, 0.35, 0.06]
    translate [2.6, 0.60, -5.6]
}
quadric {
    // Two opposed bowls: nothing exists between y = -1 and y = 1, which is what makes it two sheets.
    squares [1, -1, 1]
    constant 1
    bounded by [-2.2, -2.2, -2.2], [2.2, 2.2, 2.2]
    material { pigment [0.34, 0.48, 0.60]  specular 0.7  shininess 220  reflective 0.20  ambient 0.12 }
    scale 0.30
    rotate X 90
    rotate Y 18
    translate [2.6, 1.30, -5.6]
}
