// The street `a-block-of-buildings` could not build.
//
//     import 'buildings'   { House, Row, Tower }
//     import 'trees'       { Elm, Birch }
//     import 'undergrowth' { Grass, Tuft }
//     import 'roads'       { Road, Curb }
//     import 'daylight'    { SoftAfternoonFrom, SoftAfternoonLight }
//
// That earlier scene raises eleven buildings out of one loop and no two alike, and it is about the two
// small things in the language that let a loop vary what it makes.  It says of its own buildings that
// they are *boxes with lights on, not architecture* -- and it is right.  A real building has a plan, a
// frontage, and a way of meeting the ground.  This scene is what that sentence turns into once a
// library has been written to answer it.
//
// **Four cheap things do most of the work**, and every one of them is here to be looked at:
//
// **A plinth.**  A wall that meets the ground in a line reads as a sheet standing on grass.  The
// course at the foot of each house, a little proud of the wall and a little lighter, is the whole of
// what makes these sit down rather than stand on the lawn.
//
// **Depth in the window.**  A dark rectangle painted on a wall is a picture of a window.  What reads is
// the reveal -- glass set back, a frame standing proud around it, and a sill overhanging far enough to
// throw its own small shadow.  Look along the terrace: the sills are what you are actually seeing.
//
// **An overhang.**  The eaves reach past the wall, and the shadow line they lay along the top of each
// facade is what puts the roof above the wall rather than glued to it.
//
// **A top that is not a cut.**  Every house here ends in a gable and every tower in a parapet.  A box
// ended flat at the top is the strongest single tell that a thing is a box.
//
// **The gable is one `intersection`, and its pitch is not a style choice.**  At forty-five degrees the
// end wall is exactly the top half of a square stood on its corner, so a diamond met with a box that
// starts at the wall top leaves the triangle wanted and nothing else.  A cube turned a quarter is a
// *diamond*, not a triangle: turning one and hoping leaves a diamond sticking up through the ridge.
//
// **The terrace is counted, not measured.**  `Row(5)` is five houses, where the first number everywhere
// else in these libraries is a size.  A terrace was built at once, so its houses share a height and a
// depth; they differ in their walls, their roofs and their doors, because the people in them did not
// share anything else.
//
// The trees and the grass are here because a street is not a display shelf.  They also do the job of
// saying how big everything is: a house that stands a little above the elms behind it is a house.
//
// You will need the libraries, which is a thing to ask for once:
//
//     dotnet run -- libraries --install

import 'buildings'   { House, Row, Tower }
import 'trees'       { Elm, Birch }
import 'undergrowth' { Grass, Tuft }
import 'roads'       { Road, Curb }
import 'daylight'    { SoftAfternoonFrom, SoftAfternoonLight }

context {
    parallel pixel scanner
    angles are degrees
    info {
        title 'A Street at the Edge of Town'
        author 'J. Stephen Kress'
        description 'Houses, a terrace and two blocks, on an afternoon at the edge of town.'
        copyright true
        software __software__
    }
}

camera {
    location [-6.5, 5.2, -21]
    look at [1.4, 3.0, 2]
    field of view 52
}

// The sun is round on the near side, which is what lights a frontage.  Swing the azimuth and the whole
// street turns to shadow -- a facade is only a facade while something is falling on it.
//
// **The azimuth is given here and the rest of the sky is not**, which is the split `daylight` makes: the
// hour and the air belong to the sky's name, and which way the sun lies belongs to whoever framed the
// shot.  These houses face -Z, so it takes an azimuth within ninety degrees of nought to light a
// frontage at all; 36 puts the sun round on the near side and far enough off the camera's axis to rake.
//
// This scene used to write the whole sky out, because no stock sky in that library stood anywhere near
// here -- and it used to *import* `HazyAfternoon` and never use it, which read as though a sky at
// azimuth 220 were the one in force.  `SoftAfternoon` is now that missing sky, and it is these very
// numbers: the library learned them from this scene.
background SoftAfternoonFrom(36)

light SoftAfternoonLight

// The verge.
plane {
    material {
        pigment bozo {
            turbulence 0.35
            [0, color [0.30, 0.36, 0.22], 1, color [0.38, 0.44, 0.28]]
            scale 3.5
        }
        ambient 0.05
        specular 0.02
    }
}

// The road, from the library rather than as a slab of gray.  It arrives cambered, worn where the wheels
// run, dirty in the channels, and with a line down the middle.
//
// **It is lifted by its own crown.**  A cambered road dips below its crown everywhere except along the
// middle, and the verge here is a `plane` at y = 0 -- so laid at the library's own datum the verge would
// cut straight through the carriageway and leave only a strip of it showing.  Lifting the whole road by
// the crown puts its *channels* at the verge instead, which is where a road meets a verge anyway.
object Road(80, 6.4, 'summer', 1)  { translate [0, 0.08, -8.0] }
object Curb(80)                    { translate Z -4.8 }
object Curb(80)                    { rotate Y 180  translate Z -11.2 }

// -- The near side of the street ------------------------------------------------------------------

// Two houses of their own, then the terrace.  They are set at slightly different distances from the
// road, because a street built one house at a time is never quite a line.
object House(4.2, 'summer', 0) { translate [-12.5, 0, 0.4] }
object House(3.8, 'summer', 3) { translate [-8.6, 0, -0.3] }

object Row(5, 'summer', 2)     { translate [-0.6, 0, 0.2] }

object House(4.0, 'summer', 5) { translate [8.4, 0, -0.2] }

// -- Behind them ----------------------------------------------------------------------------------

// Two blocks standing back from the street, which is what gives the houses something to be smaller
// than.  They are turned off square from each other and from the road.
object Tower(13.5, 'summer', 3) { rotate Y -14  translate [14.5, 0, 13] }
object Tower(10.5, 'summer', 6) { rotate Y 9    translate [22, 0, 9] }

// -- What grows between --------------------------------------------------------------------------

// Elms along the back of the plots, birches nearer the road.  The trees are the expensive thing in
// this picture; there are few of them for that reason, and they are placed where they do the most.
object Elm(6.4, 'summer', 4)   { translate [-15.5, 0, 6.5] }
object Elm(5.8, 'summer', 9)   { translate [-4.5, 0, 7.2] }
object Elm(6.1, 'summer', 12)  { translate [6.5, 0, 6.8] }

object Birch(4.6, 'summer', 7) { translate [-10.2, 0, -3.4] }
object Birch(4.2, 'summer', 2) { translate [4.2, 0, -3.6] }

// Grass on the verge between the houses and the road.
//
// A verge is a *strip*, and it is asked for as one.  The curb edge is straight, because a curb is; the
// edge against the houses wanders, because nothing there is mown to a line.
//
// This was seven narrow squares shoulder to shoulder, which is what a strip cost when a patch could
// only be a square centered where it was put -- two proper ones laid along the frontage reached four
// and a half units back from their line and put grass across the whole carriageway.
Verge = path {
    move to -13.7, -1.15
    line to 10.1, -1.15
    line to 10.1, -3.9
    quad 3.0, -4.8 to -3.5, -4.1
    quad -9.0, -3.5 to -13.7, -4.4
    close
}

object Grass(Verge, 'summer', 21)

// Tufts at the curb, where the mower does not reach.  They sit a little clear of the road's edge, on
// the grass side of it.
for i in [0, 7] {
    object Tuft(0.34 + random(i, 31, 5) * 0.22, 'summer', i + 40) {
        translate [i * 3.6 - 13 + random(i, 32, 5) * 1.4, 0,
                   -4.62 + random(i, 33, 5) * 0.32]
    }
}
