// A Newton's cradle, swinging.
//
//     dotnet run -- -i newtons-cradle.igl -o newtons-cradle.webp -w 400 -h 300
//     dotnet run -- -i newtons-cradle.igl -o newtons-cradle.png --still
//
// **Nothing here says how the balls move.**  Each is a `body`: a steel ball of sixty-four grams tied by its two
// strings to two pins on the rails, and the first is held out to the left at thirty-two degrees and let go.
// Gravity swings it down -- slowing at the top of each swing and fastest at the bottom, a pendulum's pace for
// strings fourteen centimeters long -- and it strikes the next ball; the strike passes along the row as one
// impulse after another, ball to ball, and the last ball flies out while the middle three hardly stir.  Each ball
// keeps 995 parts in a thousand of its speed in a strike, as hardened steel does, and the air drags a little, so
// the swing dies slowly: by a fifth down in four seconds.  The animation is five swings long, 115 frames, ending
// as the first ball comes back to the top, so the movie begins again where the ball stands still.
//
// **A body is drawn about its middle.**  The world moves a body from its own origin and turns it about it, so
// each pendulum is drawn about its ball's middle -- the strings reaching up from it to where the pins are -- and
// put in its place by the call.  The strings are part of the body, and a body held by strings turns with them,
// so they keep running to their pins as it swings.
//
// **The blur is free.**  The camera's shutter is open half a frame, as a film camera's is, and the world is
// moved on through it, so each ball is blurred along its own arc: most at the bottom of its swing, where it
// strikes, and not at all at the top, where it stops.

context {
    angles are degrees
    animation frames 115  still 11
    info {
        title "A Newton's Cradle"
        author 'J. Stephen Kress'
        description 'A desk toy swinging under gravity, its strike passed from ball to ball.'
        copyright true
        software __software__
    }
}

camera {
    location [-0.30, 0.21, -0.58]
    look at [0.01, 0.105, 0]
    field of view 33
    shutter 0.5
    blur samples 24
}

background [0.10, 0.11, 0.13]

// A softbox above and to the left, and a dim fill from the right.  The panel the softbox light comes from is
// there to be seen in the chrome; without something bright to mirror, chrome is black.
area light { location [-0.35, 0.55, -0.35]  axisU [0.3, 0, 0]  axisV [0, 0, 0.3]  steps 4  color [1, 0.97, 0.92] }
point light { location [0.6, 0.3, -0.4]  color [0.18, 0.19, 0.22] }
parallelogram {
    material { pigment White  emission 1.4  ambient 0  diffuse 0  specular 0 }
    at [-0.5, 0.56, -0.5]  sides [0.3, 0, 0], [0, 0, 0.3]
    no shadow
}

Chrome = material { pigment [0.80, 0.81, 0.83]  metallic reflective 0.92  roughness 0.04  specular 0.8  shininess 300 }
Steel = material { pigment [0.62, 0.63, 0.65]  metallic reflective 0.6  roughness 0.25 }
String = material { pigment [0.85, 0.84, 0.80]  specular 0.1 }
Walnut = material {
    pigment wood {
        turbulence { amplitude 0.4  octaves 2 }
        [0, [0.30, 0.17, 0.09], 0.6, [0.24, 0.13, 0.07], 1, [0.30, 0.17, 0.09]]
        scale [0.006, 0.006, 0.4]  rotate Y 90
    }
    specular 0.35  shininess 60  reflective 0.03  fresnel
}

// The desk, and a wall behind it in the same paint, so there is no horizon to look at.
plane { material { pigment [0.42, 0.40, 0.37]  specular 0.05 } }
plane { material { pigment [0.30, 0.30, 0.32]  specular 0 }  rotate X -90  translate Z 0.45 }

// The base and the two arches the strings hang from, front and back.
cube { material Walnut  scale [0.15, 0.01, 0.075]  translate Y 0.01 }

for side in [0, 1] {
    tube {
        discontinuous
        material Steel
        radius 0.004 at [-0.115, 0.02, (side - 0.5) * 0.09]
        radius 0.004 at [-0.115, 0.20, (side - 0.5) * 0.09]
        radius 0.004 at [0.115, 0.20, (side - 0.5) * 0.09]
        radius 0.004 at [0.115, 0.02, (side - 0.5) * 0.09]
    }
}

// Where a ball hangs: fourteen centimeters below the line between its pins, swung out by an angle.
function BallX(x, swing) -> number { return x + 0.14 * sin(swing) }
function BallY(swing) -> number { return 0.20 - 0.14 * cos(swing) }

// One pendulum: a ball and the two strings it hangs by, up to the pins on the front and back rails.  It is drawn
// about the ball's middle, which is where the world moves a body from and what it turns it about, and put in its
// place by the call; the strings are part of it, and a body held by strings is turned with them, so they keep
// running to their pins.
primitive Pendulum(x, swing) -> group {
    return group {
        sphere { material Chrome  scale 0.0125 }
        for side in [0, 1] {
            tube {
                material String
                radius 0.0004 at [0, 0.0115, 0]
                radius 0.0004 at [x - BallX(x, swing), 0.20 - BallY(swing), (side - 0.5) * 0.09]
            }
        }
    }
}

// The five balls, a tenth of a millimeter apart, each a body: steel, keeping nearly all its speed in a strike,
// and tied by its two strings to its two pins.  The first is held out to the left and let go.
Spacing = 0.0251
Held = -32 * π / 180

for ball in [0, 4] {
    object Pendulum((ball - 2) * Spacing, ball == 0 ? Held : 0) {
        translate [BallX((ball - 2) * Spacing, ball == 0 ? Held : 0), BallY(ball == 0 ? Held : 0), 0]
        body {
            mass 0.064  bounce 0.995  friction 0.1  radius 0.0125
            tether to [(ball - 2) * Spacing, 0.20, -0.045]
            tether to [(ball - 2) * Spacing, 0.20, 0.045]
        }
    }
}
