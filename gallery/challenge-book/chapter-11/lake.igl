// This holds the information for how to render our image for chapter 11 (new language).

// The "lake" here ends up looking like fog.  The background is asked about by direction, so
// its gradient runs up the Y axis and one unit of it carries you from the horizon to straight
// overhead; that is why it needs no scaling.  The water reflects the sky and so agrees with
// it.  You also get an interesting effect if you remove the "no shadow" from the water.

chapter = 11
title = 'A Lake, Kind of'

include '../defaults.igl'

context {
    apply gamma
}

background linear Y bouncing gradient {
    [0, LightSkyBlue, 1, DeepSkyBlue]
}

// Floor
plane {
    material {
        pigment SandyBrown
    }
    translate Y -2
}

rockMaterial = material {
    pigment DarkSlateGray
    specular 0
}

// Rocks
sphere {
    material rockMaterial
    scale [1, 0.25, 0.45]
    rotate Y 12
    translate [0, -1.75, 4]
}

sphere {
    material rockMaterial
    scale [1, 0.25, 0.45]
    rotate Y -45
    translate [-2, -1.75, 6]
}

sphere {
    material rockMaterial
    scale [1, 0.25, 0.45]
    rotate Y -50
    translate [4, -1.75, 5]
}

sphere {
    material rockMaterial
    scale [1, 0.25, 0.45]
    rotate Y 85
    translate [2, -1.75, 6.5]
}

// Water
plane {
    material {
        pigment Black
        reflective 0.9
        transparency 0.9
        diffuse 0.4
        shininess 300
        interior {
            index of refraction Water
        }
    }
    no shadow
}
